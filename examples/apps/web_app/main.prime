// A small single-threaded web app on /std/http. Build and run:
//   primec --emit=optexe examples/apps/web_app/main.prime -o server \
//     --link-arg stdlib/std/net/native/net_shim.cpp --link-arg stdlib/std/os/os_posix.cpp
//   PORT=8080 ./server        (PORT=0 picks a free port; BIND=loopback listens on 127.0.0.1 only)
// Routes:
//   GET  /healthz          200 "ok"
//   GET  /hello?name=Ada   200 "hello, Ada" (the name is decoded: ?name=Ada%20L greets "Ada L"); without one,
//                          "hello, world"
//   POST /echo             200 with the request body as the response body
//   GET  /static/<path>    the file under $STATIC_DIR (default "public"): 403 for an unsafe path, 404 if missing
// Any other path is 404 and a known path under another method is 405. Every request is logged to stderr as
// "METHOD target STATUS Nms". The server stops with exit code 0 on SIGTERM or SIGINT.
import /std/http/*
import /std/http/files/*
import /std/http/server/*
import /std/os/*
import /std/text/*
import /std/text/view/*

[return<Router> effects(heap_alloc, file_read)]
app_routes() {
  [Router mut] router{Router{}}
  router.get("/healthz", []([Request] request, [Reference<Response>] response) {
    response.text("ok\n", "text/plain")
  })
  router.get("/hello", []([Request] request, [Reference<Response>] response) {
    [String] name{request.queryParam("name")}
    response.body.append("hello, ")
    if(name.empty()) {
      response.body.append("world")
    } else {
      response.body.appendBytes(name.data, name.count())
    }
    response.body.append("\n")
    response.header("Content-Type", "text/plain")
  })
  router.post("/echo", []([Request] request, [Reference<Response>] response) {
    response.text(request.body, "application/octet-stream")
  })
  router.get("/static/*", []([Request] request, [Reference<Response>] response) {
    [String] root{envOr(stringFrom("STATIC_DIR"), stringFrom("public"))}
    serve_file(response, root.view(), request.path.slice(8i32, request.path.count()), 1048576i32)
  })
  return(router)
}

// Prints why the server could not start; `main` then exits with the error code.
[effects(io_err)]
log_serve_error([ServeError] err) {
  print_line_error(err.why())
}

[return<int> effects(heap_alloc, io_err, net_io, file_read) on_error<ServeError, log_serve_error>]
main() {
  [String] portText{envOr(stringFrom("PORT"), stringFrom("8080"))}
  [String] bind{envOr(stringFrom("BIND"), stringFrom("all"))}
  [ServerConfig] config{ServerConfig{[port] portText.view().parseI32Or(8080i32), [loopbackOnly] bind.equalsText("loopback")}}
  [Router mut] router{app_routes()}
  serve(withRequestLog(router), config)?
  return(0i32)
}
