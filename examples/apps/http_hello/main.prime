// A single-threaded HTTP hello-world server on /std/http. Build and run:
//   primec --emit=optexe examples/apps/http_hello/main.prime -o http_hello \
//     --link-arg stdlib/std/net/native/net_shim.cpp --link-arg stdlib/std/os/os_posix.cpp
//   PORT=8080 ./http_hello        (PORT=0 picks a free port; BIND=loopback listens on 127.0.0.1 only)
// `GET /` answers 200 with "hello\n", `GET /greet?<name>` greets <name> and counts visitors, and any other path 404.
// Malformed requests get 400 from the server loop without reaching a handler. Every request is logged to stderr, and
// the server exits with 0 on SIGTERM or SIGINT.
import /std/http/*
import /std/http/server/*
import /std/os/*
import /std/text/*
import /std/text/view/*

// The routes of the app.
[return<Router> effects(heap_alloc)]
hello_routes() {
  [Router mut] router{Router{}}
  router.get("/", Function<void, Request, Reference<Response>>{[]([Request] request, [Reference<Response>] response) {
    response.text(textOf("hello\n"), textOf("text/plain"))
  }})
  router.get("/greet", Function<void, Request, Reference<Response>>{[mut greeted{0i32}]([Request] request, [Reference<Response>] response) {
    greeted = greeted + 1i32
    response.body.append("hello, ")
    response.body.appendBytes(request.query.data, request.query.count())
    response.body.append(" (visitor ")
    response.body.appendI64(convert<i64>(greeted))
    response.body.append(")\n")
    response.header(textOf("Content-Type"), textOf("text/plain"))
  }})
  return(router)
}

// Prints why the server could not start; `main` then exits with the error code.
[effects(io_err)]
log_serve_error([ServeError] err) {
  print_line_error(err.why())
}

[return<int> effects(heap_alloc, io_err, net_io) on_error<ServeError, log_serve_error>]
main() {
  [String] portText{envOr(stringFrom("PORT"), stringFrom("8080"))}
  [String] bind{envOr(stringFrom("BIND"), stringFrom("all"))}
  // BIND=loopback keeps the server on 127.0.0.1 (tests, local use); a container needs every interface.
  [ServerConfig] config{ServerConfig{[port] portText.view().parseI32Or(8080i32), [loopbackOnly] bind.equalsText("loopback")}}
  [Router mut] router{hello_routes()}
  serve(withRequestLog(router), config)?
  return(0i32)
}
