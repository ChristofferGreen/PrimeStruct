import /std/text/*
import /std/ui/native/*

// PrimeScroll: a plain-text editor with one native tab per document
// (docs/NativeUiPlan.md section 6). Editing, selection, clipboard and undo come
// from the platform's own text view. This program owns the documents' life
// cycle: Open/Save/Save As, and asking before unsaved text is discarded. Each
// tab is a window whose document path the backend stores, so the program keeps
// no per-document variables and works on the active tab.
//
//   primestruct_app examples/apps/text_editor/main.prime
//
// A file named after the program on the command line opens in the first tab.

[return<i32>]
command_new() {
  return(1i32)
}

[return<i32>]
command_open() {
  return(2i32)
}

[return<i32>]
command_save() {
  return(3i32)
}

[return<i32>]
command_save_as() {
  return(4i32)
}

[return<i32>]
command_close() {
  return(5i32)
}

[return<i32>]
command_quit() {
  return(6i32)
}

// View > Show Line Numbers toggles the bar of line numbers in every tab; the application menu's
// Settings... (Command-Comma) opens the settings window, where that and the other preferences live.
[return<i32>]
command_line_numbers() {
  return(7i32)
}

[return<i32>]
command_settings() {
  return(8i32)
}

// View > Wrap Lines (on by default) and File > Open Recent: the recent files are the commands
// command_recent() + 0 ... + 9, and Clear Menu empties the list.
[return<i32>]
command_wrap() {
  return(9i32)
}

// View > Show Markdown Preview (Command-Shift-M) splits the active tab into its text and the rendered
// markdown; the item's check mark follows the active tab, and the preview follows the text.
[return<i32>]
command_preview() {
  return(10i32)
}

[return<i32>]
command_recent() {
  return(200i32)
}

[return<i32>]
command_recent_clear() {
  return(210i32)
}

// Cmd+1 ... Cmd+9 are command_tab() + 1 ... + 9.
[return<i32>]
command_tab() {
  return(100i32)
}

// 0 = Save, 1 = Don't Save, 2 = Cancel.
[return<i32> effects(heap_alloc)]
ask_to_save([App] app) {
  return(app.alert("Do you want to save the changes?",
                   stringFrom("Your changes will be lost if you do not save them."),
                   "Save\nDon't Save\nCancel"))
}

// Selects the number-th tab (1 to 9) of the tab's group; 9 is the last tab, as in
// other macOS apps. Numbers past the last tab do nothing.
[return<bool>]
select_tab([Window] tab, [i32] number) {
  [i32] count{tab.tabCount()}
  [i32 mut] index{number - 1i32}
  if(number == 9i32) {
    index = count - 1i32
  }
  [bool mut] selected{false}
  if(index >= 0i32 && index < count) {
    [Window] target{tab.tabAt(index)}
    selected = target.select()
  }
  return(selected)
}

// The preferences, kept between runs (the settings window changes them): the first value of each is the
// default of a first launch. Every text view shows the editor ones.
[return<bool>]
apply_preferences([App] app, [TextView] view) {
  view.setLineNumbers(app.boolPref("lineNumbers", false))
  view.setWrapping(app.boolPref("wrapLines", true))
  view.setFontSize(app.intPref("fontSize", 13i32))
  return(true)
}

// The sizes the settings window's pop-up offers, in its order.
[return<i32>]
font_size_at([i32] index) {
  [i32 mut] size{13i32}
  if(index == 0i32) {
    size = 11i32
  }
  if(index == 1i32) {
    size = 12i32
  }
  if(index == 3i32) {
    size = 14i32
  }
  if(index == 4i32) {
    size = 16i32
  }
  if(index == 5i32) {
    size = 18i32
  }
  if(index == 6i32) {
    size = 20i32
  }
  if(index == 7i32) {
    size = 24i32
  }
  return(size)
}

[return<i32>]
font_size_index([i32] size) {
  [i32 mut] index{2i32}
  if(size == 11i32) {
    index = 0i32
  }
  if(size == 12i32) {
    index = 1i32
  }
  if(size == 14i32) {
    index = 3i32
  }
  if(size == 16i32) {
    index = 4i32
  }
  if(size == 18i32) {
    index = 5i32
  }
  if(size == 20i32) {
    index = 6i32
  }
  if(size == 24i32) {
    index = 7i32
  }
  return(index)
}

// The settings window and the controls the program reads back; every handle is 0 while it is closed.
[struct]
Settings() {
  [public u64] window{0u64}
  [public u64] restore{0u64}
  [public u64] numbers{0u64}
  [public u64] wrap{0u64}
  [public u64] size{0u64}
  [public u64] preview{0u64}
  [public u64] lock{0u64}
}

// Builds the settings window (tabs General, Editor and Markdown) from the current preferences.
[return<Settings>]
build_settings([App] app) {
  [Window] created{app.window("Settings", 420i32, 260i32)}
  created.setSettingsStyle()

  [Form] general{app.form()}
  general.heading("Startup")
  [CheckBox] restore{app.checkBox("Reopen the files of the last session", app.boolPref("restoreSession", true))}
  general.control(restore.widget())

  [Form] editor{app.form()}
  editor.heading("Text")
  [CheckBox] numbers{app.checkBox("Show line numbers", app.boolPref("lineNumbers", false))}
  editor.control(numbers.widget())
  [CheckBox] wrap{app.checkBox("Wrap long lines", app.boolPref("wrapLines", true))}
  editor.control(wrap.widget())
  [Popup] size{app.popup()}
  size.addItem("11")
  size.addItem("12")
  size.addItem("13")
  size.addItem("14")
  size.addItem("16")
  size.addItem("18")
  size.addItem("20")
  size.addItem("24")
  size.select(font_size_index(app.intPref("fontSize", 13i32)))
  editor.row("Font size", size.widget())

  [Form] markdown{app.form()}
  markdown.heading("Preview")
  [CheckBox] preview{app.checkBox("Show the preview when a markdown file opens", app.boolPref("previewMarkdown", false))}
  markdown.control(preview.widget())
  [CheckBox] lock{app.checkBox("Scroll the preview with the text", app.boolPref("lockScroll", true))}
  markdown.control(lock.widget())

  [Tabs] tabs{app.tabs()}
  tabs.add("General", general.widget())
  tabs.add("Editor", editor.widget())
  tabs.add("Markdown", markdown.widget())
  created.setContentWidget(tabs.widget())
  created.show()
  return(Settings{[window] created.handle, [restore] restore.handle, [numbers] numbers.handle,
                  [wrap] wrap.handle, [size] size.handle, [preview] preview.handle, [lock] lock.handle})
}

// Documents are the windows other than the settings window.
[return<i32>]
count_documents([App] app, [u64] settingsWindow) {
  [i32 mut] count{0i32}
  [i32 mut] index{0i32}
  while(index < app.windowCount()) {
    [Window] each{app.windowAt(index)}
    if(each.handle != settingsWindow) {
      count = count + 1i32
    }
    index = index + 1i32
  }
  return(count)
}

// The window the user works on: the active one, or the first document while the settings window is active.
[return<Window>]
document_window([App] app, [u64] settingsWindow) {
  [Window mut] found{app.activeWindow()}
  if(found.handle == settingsWindow) {
    [i32 mut] index{app.windowCount() - 1i32}
    while(index >= 0i32) {
      [Window] each{app.windowAt(index)}
      if(each.handle != settingsWindow) {
        found = each
      }
      index = index - 1i32
    }
  }
  return(found)
}

// Every document shows the editor preferences; the View menu and the settings window show them too.
[return<bool>]
refresh_preferences([App] app, [Menu] viewMenu, [Settings] settings) {
  [i32 mut] index{0i32}
  while(index < app.windowCount()) {
    [Window] each{app.windowAt(index)}
    if(each.handle != settings.window) {
      [TextView] eachView{each.content()}
      apply_preferences(app, eachView)
    }
    index = index + 1i32
  }
  viewMenu.setChecked(command_line_numbers(), app.boolPref("lineNumbers", false))
  viewMenu.setChecked(command_wrap(), app.boolPref("wrapLines", true))
  [CheckBox] numbersBox{[handle] settings.numbers}
  numbersBox.setChecked(app.boolPref("lineNumbers", false))
  [CheckBox] wrapBox{[handle] settings.wrap}
  wrapBox.setChecked(app.boolPref("wrapLines", true))
  return(true)
}

// A file named *.md or *.markdown shows its preview when the preference asks for it.
[return<bool>]
ends_with_text([String] text, [string] suffix, [i32] length) {
  [i32] size{text.count()}
  [bool mut] same{false}
  if(size >= length) {
    [String] tail{text.substr(size - length, size)}
    same = tail.equalsText(suffix)
  }
  return(same)
}

[return<bool>]
preview_if_markdown([App] app, [Window] tab, [String] path) {
  [bool mut] shown{false}
  if(app.boolPref("previewMarkdown", false)) {
    if(ends_with_text(path, ".md", 3i32) || ends_with_text(path, ".markdown", 9i32)) {
      shown = tab.setPreview(true)
    }
  }
  return(shown)
}

// A new document: a window with its own text view, joined to host's tabs.
[return<Window>]
new_tab([App] app, [Window] host) {
  [Window] created{app.window("Untitled", 720i32, 480i32)}
  [TextView] view{app.textView()}
  view.setMonospace(true)
  apply_preferences(app, view)
  created.setContent(view)
  host.addTab(created)
  created.show()
  return(created)
}

// Writes the tab's text to its file (asking for one with Save As, or when it has
// none yet). True when the text was saved.
[return<bool>]
save_document([App] app, [Window] tab, [bool] chooseFile) {
  [TextView] view{tab.content()}
  [bool mut] saved{false}
  if(chooseFile || !tab.hasPath()) {
    [String] chosen{app.savePanel("Save", "Untitled.txt")}
    if(app.panelChosen()) {
      if(view.saveFile(chosen)) {
        tab.setPath(chosen)
        saved = true
      } else {
        app.alert("The file could not be saved.", app.lastError(), "OK")
      }
    }
  } else {
    if(view.saveFile(tab.path())) {
      saved = true
    } else {
      app.alert("The file could not be saved.", app.lastError(), "OK")
    }
  }
  if(saved) {
    tab.setTitle(tab.path())
    app.addRecent(tab.path())
    view.highlight(tab.path())
    view.clearModified()
    tab.setEdited(false)
  }
  return(saved)
}

// True when the tab's unsaved text is dealt with (saved or given up).
[return<bool>]
confirm_discard([App] app, [Window] tab) {
  [TextView] view{tab.content()}
  [bool mut] go{true}
  if(view.isModified()) {
    [i32] answer{ask_to_save(app)}
    if(answer == 2i32) {
      go = false
    }
    if(answer == 0i32) {
      go = save_document(app, tab, false)
    }
  }
  return(go)
}

[return<bool>]
close_tab([App] app, [Window] tab) {
  [bool] go{confirm_discard(app, tab)}
  if(go) {
    tab.close()
  }
  return(go)
}

// Opens `chosen` in a new tab, or in this one while it is still an untouched
// untitled document; a file that opened joins the recent files.
[return<bool>]
open_path([App] app, [Window] tab, [String] chosen) {
  if(!chosen.empty()) {
    [TextView] current{tab.content()}
    [bool] reuse{!tab.hasPath() && !current.isModified()}
    [Window mut] target{tab}
    if(!reuse) {
      target = new_tab(app, tab)
    }
    [TextView] view{target.content()}
    if(view.loadFile(chosen)) {
      target.setPath(chosen)
      target.setTitle(chosen)
      app.addRecent(chosen)
      view.highlight(chosen)
      target.setEdited(false)
      target.refreshPreview()
      [bool] previewed{preview_if_markdown(app, target, chosen)}
    } else {
      app.alert("The file could not be opened.", app.lastError(), "OK")
      if(!reuse) {
        target.close()
      }
    }
  }
  return(true)
}

// Asks for a file and opens it.
[return<bool>]
open_document([App] app, [Window] tab) {
  [String] chosen{app.openPanel("Open")}
  [bool mut] opened{false}
  if(app.panelChosen()) {
    opened = open_path(app, tab, chosen)
  }
  return(opened)
}

// Remembers the files the tabs hold (in tab-bar order) and which tab is active, so the next launch
// brings them back. Untitled tabs have nothing to reopen.
[return<bool>]
save_session([App] app, [Window] current) {
  app.listClear("session.files")
  [i32] count{current.tabCount()}
  [i32 mut] active{0i32}
  [i32 mut] saved{0i32}
  [i32 mut] index{0i32}
  while(index < count) {
    [Window] each{current.tabAt(index)}
    if(each.hasPath()) {
      app.listAdd("session.files", each.path())
      if(each.handle == current.handle) {
        active = saved
      }
      saved = saved + 1i32
    }
    index = index + 1i32
  }
  app.setIntPref("session.active", active)
  return(true)
}

// Opens the files the last session had open, one tab each in the same order, and selects the tab
// that was active. A file that is gone is skipped. Returns how many tabs it opened.
[return<i32>]
restore_session([App] app, [Window] first, [TextView] firstView) {
  [i32] saved{app.listCount("session.files")}
  [i32 mut] opened{0i32}
  [i32 mut] position{0i32}
  while(position < saved) {
    [String] path{app.listGet("session.files", position)}
    if(opened == 0i32) {
      if(firstView.loadFile(path)) {
        first.setPath(path)
        first.setTitle(path)
        firstView.highlight(path)
        [bool] firstPreviewed{preview_if_markdown(app, first, path)}
        opened = 1i32
      }
    } else {
      [Window] extra{new_tab(app, first)}
      [TextView] extraView{extra.content()}
      if(extraView.loadFile(path)) {
        extra.setPath(path)
        extra.setTitle(path)
        extraView.highlight(path)
        [bool] extraPreviewed{preview_if_markdown(app, extra, path)}
        opened = opened + 1i32
      } else {
        extra.close()
      }
    }
    position = position + 1i32
  }
  [i32] active{app.intPref("session.active", 0i32)}
  if(active > 0i32 && active < first.tabCount()) {
    [Window] chosen{first.tabAt(active)}
    chosen.select()
  }
  return(opened)
}

// Rebuilds File > Open Recent from the recent files list; returns how many files it shows.
[return<i32>]
refresh_recent([Menu] recent) {
  recent.clear()
  [i32] shown{recent.addRecentFiles(command_recent(), 10i32)}
  if(shown > 0i32) {
    recent.separator()
  }
  recent.item("Clear Menu", "", command_recent_clear())
  return(shown)
}

[return<int> effects(heap_alloc)]
main([array<string>] args) {
  [App] app{start_app("PrimeScroll")}
  [Settings mut] settings{Settings{}}
  app.setPreviewScrollLock(app.boolPref("lockScroll", true))
  [Window] first{app.window("Untitled", 720i32, 480i32)}
  first.setAutosaveName("PrimeScroll")
  [TextView] firstView{app.textView()}
  firstView.setMonospace(true)
  apply_preferences(app, firstView)
  first.setContent(firstView)

  [Menu] application{app.menu("PrimeScroll")}
  application.about()
  application.separator()
  application.item("Settings...", "cmd+,", command_settings())
  application.separator()
  application.hide()
  application.hideOthers()
  application.separator()
  application.quit()
  application.addToBarAsApp()

  [Menu] file{app.menu("File")}
  file.item("New Tab", "cmd+t", command_new())
  file.item("New", "cmd+n", command_new())
  file.item("Open...", "cmd+o", command_open())
  [Menu] recentMenu{app.menu("Open Recent")}
  file.submenu("Open Recent", recentMenu)
  file.separator()
  file.item("Save", "cmd+s", command_save())
  file.item("Save As...", "cmd+shift+s", command_save_as())
  file.separator()
  file.item("Close", "cmd+w", command_close())
  file.addToBar()

  [Menu] edit{app.menu("Edit")}
  edit.undo()
  edit.redo()
  edit.separator()
  edit.cut()
  edit.copy()
  edit.paste()
  edit.selectAll()
  edit.separator()
  edit.find()
  edit.addToBar()

  [Menu] viewMenu{app.menu("View")}
  viewMenu.fullScreen()
  viewMenu.showTabBar()
  viewMenu.item("Show Line Numbers", "cmd+shift+l", command_line_numbers())
  viewMenu.item("Wrap Lines", "", command_wrap())
  viewMenu.item("Show Markdown Preview", "cmd+shift+m", command_preview())
  viewMenu.followPreview(command_preview())
  viewMenu.addToBar()

  [Menu] windowMenu{app.menu("Window")}
  windowMenu.minimize()
  windowMenu.zoom()
  windowMenu.separator()
  windowMenu.nextTab()
  windowMenu.previousTab()
  windowMenu.moveTabToNewWindow()
  windowMenu.mergeAllWindows()
  windowMenu.separator()
  windowMenu.item("Show Tab 1", "cmd+1", command_tab() + 1i32)
  windowMenu.item("Show Tab 2", "cmd+2", command_tab() + 2i32)
  windowMenu.item("Show Tab 3", "cmd+3", command_tab() + 3i32)
  windowMenu.item("Show Tab 4", "cmd+4", command_tab() + 4i32)
  windowMenu.item("Show Tab 5", "cmd+5", command_tab() + 5i32)
  windowMenu.item("Show Tab 6", "cmd+6", command_tab() + 6i32)
  windowMenu.item("Show Tab 7", "cmd+7", command_tab() + 7i32)
  windowMenu.item("Show Tab 8", "cmd+8", command_tab() + 8i32)
  windowMenu.item("Show Last Tab", "cmd+9", command_tab() + 9i32)
  windowMenu.separator()
  windowMenu.bringAllToFront()
  windowMenu.addToBarAsWindow()

  [Menu] helpMenu{app.menu("Help")}
  helpMenu.help()
  helpMenu.addToBarAsHelp()

  // A file named on the command line opens in the first tab.
  if(args.count() > 1i32) {
    [String] named{argumentText(1i32)}
    if(firstView.loadFile(named)) {
      first.setPath(named)
      first.setTitle(named)
      app.addRecent(named)
      firstView.highlight(named)
      [bool] namedPreviewed{preview_if_markdown(app, first, named)}
    } else {
      app.alert("The file could not be opened.", app.lastError(), "OK")
    }
  }

  [bool] shown{refresh_preferences(app, viewMenu, settings)}
  [i32] recentShown{refresh_recent(recentMenu)}

  first.show()

  // Without a file on the command line the last session comes back, unless the preferences say no.
  if(args.count() <= 1i32 && app.boolPref("restoreSession", true)) {
    [i32] restored{restore_session(app, first, firstView)}
  }

  [bool mut] running{true}
  while(running) {
    [i32 mut] intent{0i32}
    [u64 mut] changedControl{0u64}
    [Window mut] tab{app.activeWindow()}
    pick(app.waitEvent()) {
      command(id) {
        intent = id
        [Window] active{app.activeWindow()}
        tab = active
      }
      windowCloseRequested(w) {
        intent = command_close()
        [Window] closing{w}
        tab = closing
      }
      textChanged(w) {
        [Window] changed{w}
        changed.setEdited(true)
        [TextView] view{changed.content()}
        view.highlight(changed.path())
        changed.refreshPreview()
      }
      controlChanged(widget) {
        [Widget] changed{widget}
        changedControl = changed.handle
      }
      quitRequested {
        intent = command_quit()
      }
    }

    // Commands of the settings window's menu act on a document, except closing the window itself.
    if(tab.handle == settings.window && intent != command_close()) {
      [Window] working{document_window(app, settings.window)}
      tab = working
    }

    // The settings window's controls are the preferences, applied at once.
    if(changedControl != 0u64) {
      [CheckBox] restoreBox{[handle] settings.restore}
      [CheckBox] numbersBox{[handle] settings.numbers}
      [CheckBox] wrapBox{[handle] settings.wrap}
      [CheckBox] previewBox{[handle] settings.preview}
      [CheckBox] lockBox{[handle] settings.lock}
      [Popup] sizeChoice{[handle] settings.size}
      if(changedControl == settings.restore) {
        app.setBoolPref("restoreSession", restoreBox.isChecked())
      }
      if(changedControl == settings.numbers) {
        app.setBoolPref("lineNumbers", numbersBox.isChecked())
      }
      if(changedControl == settings.wrap) {
        app.setBoolPref("wrapLines", wrapBox.isChecked())
      }
      if(changedControl == settings.preview) {
        app.setBoolPref("previewMarkdown", previewBox.isChecked())
      }
      if(changedControl == settings.lock) {
        app.setBoolPref("lockScroll", lockBox.isChecked())
        app.setPreviewScrollLock(lockBox.isChecked())
      }
      if(changedControl == settings.size) {
        app.setIntPref("fontSize", font_size_at(sizeChoice.selected()))
      }
      [bool] controlsApplied{refresh_preferences(app, viewMenu, settings)}
    }

    [bool mut] recentsChanged{false}
    if(intent == command_settings()) {
      if(settings.window == 0u64) {
        settings = build_settings(app)
      } else {
        [Window] again{[handle] settings.window}
        again.show()
      }
    }
    if(intent == command_new()) {
      [Window] fresh{new_tab(app, tab)}
    }
    if(intent == command_open()) {
      [bool] opened{open_document(app, tab)}
      recentsChanged = true
    }
    if(intent >= command_recent() && intent < command_recent() + 10i32) {
      [String] picked{app.recentPath(intent - command_recent())}
      [bool] reopened{open_path(app, tab, picked)}
      recentsChanged = true
    }
    if(intent == command_recent_clear()) {
      app.clearRecent()
      recentsChanged = true
    }
    if(intent == command_preview()) {
      [bool] previewing{tab.setPreview(!tab.hasPreview())}
    }
    if(intent == command_wrap()) {
      app.setBoolPref("wrapLines", !app.boolPref("wrapLines", true))
      [bool] wrapped{refresh_preferences(app, viewMenu, settings)}
    }
    if(intent == command_line_numbers()) {
      app.setBoolPref("lineNumbers", !app.boolPref("lineNumbers", false))
      [bool] numbered{refresh_preferences(app, viewMenu, settings)}
    }
    if(intent == command_save()) {
      [bool] saved{save_document(app, tab, false)}
      recentsChanged = true
    }
    if(intent == command_save_as()) {
      [bool] saved{save_document(app, tab, true)}
      recentsChanged = true
    }
    if(recentsChanged) {
      [i32] shownNow{refresh_recent(recentMenu)}
    }
    if(intent == command_close()) {
      [bool] closed{close_tab(app, tab)}
      if(closed && tab.handle == settings.window) {
        settings = Settings{}
      }
    }
    if(intent > command_tab() && intent <= command_tab() + 9i32) {
      [bool] switched{select_tab(tab, intent - command_tab())}
    }
    // Closing the last tab ends the app like Quit does, so the session stays as it was before it closed.
    if(intent != 0i32 && intent != command_quit() && count_documents(app, settings.window) > 0i32) {
      [bool] remembered{save_session(app, document_window(app, settings.window))}
    }
    if(intent == command_quit()) {
      // The session is what the tabs hold now; every tab gets its say, and Cancel stops the quit.
      [bool] rememberedQuit{save_session(app, document_window(app, settings.window))}
      [bool mut] go{true}
      while(go && count_documents(app, settings.window) > 0i32) {
        [Window] next{document_window(app, settings.window)}
        go = close_tab(app, next)
      }
      if(count_documents(app, settings.window) > 0i32) {
        [bool] again{save_session(app, document_window(app, settings.window))}
      }
    }
    // The settings window is not a document: it goes with the last one.
    if(count_documents(app, settings.window) == 0i32) {
      if(settings.window != 0u64) {
        [Window] leaving{[handle] settings.window}
        leaving.close()
      }
      running = false
    }
  }
  return(0i32)
}
