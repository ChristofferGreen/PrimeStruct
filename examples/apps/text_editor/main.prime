import /std/text/*
import /std/ui/events/*
import /std/ui/native/*

// PrimeScroll: a plain-text editor with one native tab per document
// (docs/NativeUiPlan.md section 6). Editing, selection, clipboard and undo come
// from the platform's own text view. This program owns the documents' life
// cycle: Open/Save/Save As, and asking before unsaved text is discarded. Each
// tab is a window whose document path the backend stores, so the program keeps
// no per-document variables and works on the active tab. Every menu item, toolbar
// button and control has its own handler (`AppHandlers<Editor>`, docs/NativeUiPlan.md
// section 5); `app.run(handlers)` dispatches the events.
//
//   primestruct_app examples/apps/text_editor/main.prime
//
// A file named after the program on the command line opens in the first tab.

// The editor's commands, which `AppHandlers` hands out in the order `main` registers them (from 1000000); a menu item
// and a toolbar button that do the same share one. A range is a row of commands with one handler, which gets the
// offset of the chosen one:
// - `scroll`: View > Scroll Preview, the scroll modes (independently, linearly, by block, with the cursor); the chosen
//   one carries a check mark and is the `scrollMode` preference.
// - `mode`: View > Editor, Split View and Preview, and the markdown toolbar's segments (docs/NativeUiPlan.md
//   section 17).
// - `format`: the operation of ps_ui_text_view_markdown_edit (bold 0, italic 1, ... table format 14); `heading`: the
//   level, 0 for a paragraph; `table`: Insert Table 2 by 2, 3 by 3, 4 by 3, 5 by 4; `align`: left, center, right.
// - `tab`: Cmd+1 ... Cmd+8 and Cmd+9, the last tab; `recent`: File > Open Recent, most recent first.
// With the ids in this order, tests and the snapshot harness (`PRIMESTRUCT_UI_COMMANDS`) name a command by number:
// New 1000000, Open 1000001, Save 1000002, Save As 1000003, Close 1000004, Show Line Numbers 1000005, Settings
// 1000006, Wrap Lines 1000007, Show Markdown Preview 1000008, `scroll` 1000009, `mode` 1000013, `format` 1000016,
// `heading` 1000038, `table` 1000042, `align` 1000046, `tab` 1000049, Run 1000058, Stop 1000059, Show Output 1000060,
// `scriptDone` 1000061, `recent` 1000062, Clear Menu 1000072.
// Running a script (docs/NativeUiPlan.md section 18): `run` executes the tab's text on the embedded interpreter and
// shows its output in the pane under the editor, `stop` ends a run that does not end, `output` toggles the pane, and
// the end of a run arrives as `scriptDone` (the pane already shows how it ended).
[struct]
EditorCommands() {
  [public Command] newTab{Command{}}
  [public Command] open{Command{}}
  [public Command] save{Command{}}
  [public Command] saveAs{Command{}}
  [public Command] close{Command{}}
  // View > Show Line Numbers toggles the bar of line numbers in every tab; the application menu's Settings...
  // (Command-Comma) opens the settings window, where that and the other preferences live; View > Wrap Lines is on by
  // default.
  [public Command] lineNumbers{Command{}}
  [public Command] settings{Command{}}
  [public Command] wrap{Command{}}
  // View > Show Markdown Preview (Command-Shift-M) splits the active tab into its text and the rendered markdown; the
  // item's check mark follows the active tab, and the preview follows the text.
  [public Command] preview{Command{}}
  [public CommandRange] scroll{CommandRange{}}
  [public CommandRange] mode{CommandRange{}}
  [public CommandRange] format{CommandRange{}}
  [public CommandRange] heading{CommandRange{}}
  [public CommandRange] table{CommandRange{}}
  [public CommandRange] align{CommandRange{}}
  [public CommandRange] tab{CommandRange{}}
  [public Command] run{Command{}}
  [public Command] stop{Command{}}
  [public Command] output{Command{}}
  [public Command] scriptDone{Command{}}
  [public CommandRange] recent{CommandRange{}}
  [public Command] recentClear{Command{}}
}

// 0 = Save, 1 = Don't Save, 2 = Cancel.
[return<i32> effects(heap_alloc)]
ask_to_save([App] app) {
  return(app.alert("Do you want to save the changes?",
                   stringFrom("Your changes will be lost if you do not save them."),
                   "Save\nDon't Save\nCancel"))
}

// Selects the number-th tab (1 to 9) of the tab's group; 9 is the last tab, as in
// other macOS apps. Numbers past the last tab do nothing.
[return<bool>]
select_tab([Window] tab, [i32] number) {
  [i32] count{tab.tabCount()}
  [i32 mut] index{number - 1i32}
  if(number == 9i32) {
    index = count - 1i32
  }
  [bool mut] selected{false}
  if(index >= 0i32 && index < count) {
    [Window] target{tab.tabAt(index)}
    selected = target.select()
  }
  return(selected)
}

// The preferences, kept between runs (the settings window changes them): the first value of each is the
// default of a first launch. Every text view shows the editor ones.
[return<bool>]
apply_preferences([App] app, [TextView] view) {
  view.setLineNumbers(app.boolPref("lineNumbers", false))
  view.setWrapping(app.boolPref("wrapLines", true))
  view.setFontSize(app.intPref("fontSize", 13i32))
  view.setMarkdownEditing(true)
  return(true)
}

// The sizes the settings window's pop-up offers, in its order.
[return<i32>]
font_size_at([i32] index) {
  [i32 mut] size{13i32}
  if(index == 0i32) {
    size = 11i32
  }
  if(index == 1i32) {
    size = 12i32
  }
  if(index == 3i32) {
    size = 14i32
  }
  if(index == 4i32) {
    size = 16i32
  }
  if(index == 5i32) {
    size = 18i32
  }
  if(index == 6i32) {
    size = 20i32
  }
  if(index == 7i32) {
    size = 24i32
  }
  return(size)
}

[return<i32>]
font_size_index([i32] size) {
  [i32 mut] index{2i32}
  if(size == 11i32) {
    index = 0i32
  }
  if(size == 12i32) {
    index = 1i32
  }
  if(size == 14i32) {
    index = 3i32
  }
  if(size == 16i32) {
    index = 4i32
  }
  if(size == 18i32) {
    index = 5i32
  }
  if(size == 20i32) {
    index = 6i32
  }
  if(size == 24i32) {
    index = 7i32
  }
  return(index)
}

// True when both texts are the same bytes.
[return<bool>]
same_text([String] a, [String] b) {
  [bool mut] same{a.count() == b.count()}
  [i32 mut] index{0i32}
  while(same && index < a.count()) {
    if(a.byteAt(index) != b.byteAt(index)) {
      same = false
    }
    index = index + 1i32
  }
  return(same)
}

// "/Applications/Xcode.app" is "Xcode".
[return</std/text/String> effects(heap_alloc)]
application_name([String] path) {
  [i32] size{path.count()}
  [i32 mut] start{0i32}
  [i32 mut] index{0i32}
  while(index < size) {
    if(convert<i32>(path.byteAt(index)) == 47i32) {
      start = index + 1i32
    }
    index = index + 1i32
  }
  [i32 mut] end{size}
  if(size - start > 4i32) {
    [String] tail{path.substr(size - 4i32, size)}
    if(tail.equalsText(".app")) {
      end = size - 4i32
    }
  }
  [String mut] name{path.substr(start, end)}
  if(name.empty()) {
    name = stringFrom("this app")
  }
  return(name)
}

// "md,markdown" starts with "md".
[return</std/text/String> effects(heap_alloc)]
first_extension([String] list) {
  [i32] size{list.count()}
  [i32 mut] end{0i32}
  while(end < size && convert<i32>(list.byteAt(end)) != 44i32) {
    end = end + 1i32
  }
  return(list.substr(0i32, end))
}

// The row of a file type in the Files list: "✓ Markdown (.md, .markdown) - TextEdit": a check mark when the chosen
// application already is the default of the type's first extension, then the application that is.
[return</std/text/String> effects(heap_alloc)]
type_line([App] app, [i32] index, [String] chosen) {
  [String] extensionList{app.documentTypeExtensions(index)}
  [String] current{app.defaultApp(first_extension(extensionList))}
  [String mut] line{String{}}
  if(!current.empty() && same_text(current, chosen)) {
    line.append("✓ ")
  } else {
    line.append("  ")
  }
  [String] typeName{app.documentTypeName(index)}
  line.appendString(typeName)
  line.append(" (.")
  [i32 mut] at{0i32}
  while(at < extensionList.count()) {
    if(convert<i32>(extensionList.byteAt(at)) == 44i32) {
      line.append(", .")
    } else {
      line.pushByte(extensionList.byteAt(at))
    }
    at = at + 1i32
  }
  line.append(") - ")
  if(current.empty()) {
    line.append("no default")
  } else {
    [String] currentName{application_name(current)}
    line.appendString(currentName)
  }
  return(line)
}

// Shows, for every file type, which application is its default (a check mark when it is PrimeScroll). These are the
// only system lookups of the file types, and they happen when the settings window is built or its button was pressed.
[return<bool> effects(heap_alloc)]
refresh_files([App] app, [u64] listHandle) {
  [String] thisApp{app.appPath()}
  [ItemList] list{[handle] listHandle}
  [i32] count{app.documentTypeCount()}
  [i32 mut] index{0i32}
  while(index < count) {
    list.setItem(index, type_line(app, index, thisApp))
    index = index + 1i32
  }
  return(true)
}

// The settings window and the controls the program reads back; every handle is 0 while it is closed.
[struct]
Settings() {
  [public u64] window{0u64}
  [public u64] restore{0u64}
  [public u64] numbers{0u64}
  [public u64] wrap{0u64}
  [public u64] size{0u64}
  [public u64] preview{0u64}
  [public u64] lock{0u64}
  [public u64] list{0u64}        // the file types
  [public u64] apply{0u64}       // the button that makes the application the default of the selected types
}

// Builds the settings window (tabs General, Editor and Markdown) from the current preferences.
[return<Settings> effects(heap_alloc)]
build_settings([App] app) {
  [Window] created{app.window("Settings", 420i32, 260i32)}
  created.setSettingsStyle()

  [Form] general{app.form()}
  general.heading("Startup")
  [CheckBox] restore{app.checkBox("Reopen the files of the last session", app.boolPref("restoreSession", true))}
  general.control(restore.widget())

  [Form] editor{app.form()}
  editor.heading("Text")
  [CheckBox] numbers{app.checkBox("Show line numbers", app.boolPref("lineNumbers", false))}
  editor.control(numbers.widget())
  [CheckBox] wrap{app.checkBox("Wrap long lines", app.boolPref("wrapLines", true))}
  editor.control(wrap.widget())
  [Popup] size{app.popup()}
  size.addItem("11")
  size.addItem("12")
  size.addItem("13")
  size.addItem("14")
  size.addItem("16")
  size.addItem("18")
  size.addItem("20")
  size.addItem("24")
  size.select(font_size_index(app.intPref("fontSize", 13i32)))
  editor.row("Font size", size.widget())

  [Form] markdown{app.form()}
  markdown.heading("Preview")
  [CheckBox] preview{app.checkBox("Show the preview when a markdown file opens", app.boolPref("previewMarkdown", false))}
  markdown.control(preview.widget())
  [Popup] lock{app.popup()}
  lock.addItem("Independently")
  lock.addItem("Linearly")
  lock.addItem("By block")
  lock.addItem("With the cursor")
  lock.select(app.intPref("scrollMode", 2i32))
  markdown.row("Scroll source and preview", lock.widget())

  [Tabs] tabs{app.tabs()}

  [Form] files{app.form()}
  files.heading("File types")
  [Label] hint{app.label("Select file types, then press Make Default. macOS asks you to confirm each type.")}
  files.control(hint.widget())
  [ItemList] types{app.itemList()}
  [String] chosenNow{app.appPath()}
  [i32] typeCount{app.documentTypeCount()}
  [i32 mut] typeIndex{0i32}
  while(typeIndex < typeCount) {
    types.addItem(type_line(app, typeIndex, chosenNow))
    typeIndex = typeIndex + 1i32
  }
  files.control(types.widget())
  [Button] apply{app.button("Make Default")}
  files.control(apply.widget())

  tabs.add("General", general.widget())
  tabs.add("Editor", editor.widget())
  tabs.add("Markdown", markdown.widget())
  tabs.add("Files", files.widget())
  created.setContentWidget(tabs.widget())
  created.show()
  return(Settings{[window] created.handle, [restore] restore.handle, [numbers] numbers.handle,
                  [wrap] wrap.handle, [size] size.handle, [preview] preview.handle, [lock] lock.handle,
                  [list] types.handle, [apply] apply.handle})
}

// Documents are the windows other than the settings window.
[return<i32>]
count_documents([App] app, [u64] settingsWindow) {
  [i32 mut] count{0i32}
  [i32 mut] index{0i32}
  while(index < app.windowCount()) {
    [Window] each{app.windowAt(index)}
    if(each.handle != settingsWindow) {
      count = count + 1i32
    }
    index = index + 1i32
  }
  return(count)
}

// The window the user works on: the active one, or the first document while the settings window is active.
[return<Window>]
document_window([App] app, [u64] settingsWindow) {
  [Window mut] found{app.activeWindow()}
  if(found.handle == settingsWindow) {
    [i32 mut] index{app.windowCount() - 1i32}
    while(index >= 0i32) {
      [Window] each{app.windowAt(index)}
      if(each.handle != settingsWindow) {
        found = each
      }
      index = index - 1i32
    }
  }
  return(found)
}

// A file named *.md or *.markdown shows its preview when the preference asks for it.
[return<bool> effects(heap_alloc)]
ends_with_text([String] text, [string] suffix, [i32] length) {
  [i32] size{text.count()}
  [bool mut] same{false}
  if(size >= length) {
    [String] tail{text.substr(size - length, size)}
    same = tail.equalsText(suffix)
  }
  return(same)
}

[return<bool> effects(heap_alloc)]
preview_if_markdown([App] app, [Window] tab, [String] path) {
  [bool mut] shown{false}
  if(app.boolPref("previewMarkdown", false)) {
    if(ends_with_text(path, ".md", 3i32) || ends_with_text(path, ".markdown", 9i32)) {
      shown = tab.setPreview(true)
    }
  }
  return(shown)
}

// The Heading and Table menus, built once for the toolbar and once for the Format menu (a menu has one parent).
[return<bool>]
add_heading_items([Menu] menu, [CommandRange] heading) {
  menu.commandItem("Heading 1", "", heading.at(1i32))
  menu.commandItem("Heading 2", "", heading.at(2i32))
  menu.commandItem("Heading 3", "", heading.at(3i32))
  menu.separator()
  menu.commandItem("Paragraph", "", heading.at(0i32))
  return(true)
}

[return<bool>]
add_block_items([Menu] menu, [CommandRange] format) {
  menu.commandItem("Bulleted List", "", format.at(7i32))
  menu.commandItem("Numbered List", "", format.at(8i32))
  menu.commandItem("Task List", "", format.at(9i32))
  menu.separator()
  menu.commandItem("Quote", "", format.at(10i32))
  menu.commandItem("Code Block", "", format.at(11i32))
  menu.commandItem("Horizontal Rule", "", format.at(12i32))
  return(true)
}

[return<bool>]
add_table_items([Menu] menu, [EditorCommands] commands) {
  menu.commandItem("Insert 2 by 2", "", commands.table.at(0i32))
  menu.commandItem("Insert 3 by 3", "", commands.table.at(1i32))
  menu.commandItem("Insert 4 by 3", "", commands.table.at(2i32))
  menu.commandItem("Insert 5 by 4", "", commands.table.at(3i32))
  menu.separator()
  menu.commandItem("Format Table", "", commands.format.at(14i32))
  menu.commandItem("Add Row", "", commands.format.at(15i32))
  menu.commandItem("Add Column", "", commands.format.at(16i32))
  menu.commandItem("Delete Row", "", commands.format.at(17i32))
  menu.commandItem("Delete Column", "", commands.format.at(18i32))
  menu.separator()
  menu.commandItem("Align Left", "", commands.align.at(0i32))
  menu.commandItem("Align Center", "", commands.align.at(1i32))
  menu.commandItem("Align Right", "", commands.align.at(2i32))
  return(true)
}

// The toolbar of a markdown window, built when the first one needs it: the view mode, the inline marks, a heading menu,
// a menu of block formats and the tables (menus keep it short enough for a window of the default width).
[return<Toolbar>]
build_toolbar([App] app, [EditorCommands] commands) {
  [Toolbar] bar{app.toolbar()}
  bar.commandSegments("Editor|Split|Preview", commands.mode)
  bar.separator()
  bar.commandButton("Bold", "bold", commands.format.at(0i32))
  bar.commandButton("Italic", "italic", commands.format.at(1i32))
  bar.commandButton("Strikethrough", "strikethrough", commands.format.at(2i32))
  bar.commandButton("Code", "chevron.left.forwardslash.chevron.right", commands.format.at(3i32))
  bar.commandButton("Link", "link", commands.format.at(4i32))
  bar.commandButton("Image", "photo", commands.format.at(5i32))
  bar.separator()
  [Menu] headings{app.menu("Heading")}
  [bool] headingItems{add_heading_items(headings, commands.heading)}
  bar.menu("Heading", "textformat.size", headings)
  [Menu] blocks{app.menu("Blocks")}
  [bool] blockItems{add_block_items(blocks, commands.format)}
  bar.menu("Blocks", "list.bullet", blocks)
  bar.separator()
  [Menu] tables{app.menu("Table")}
  [bool] tableItems{add_table_items(tables, commands)}
  bar.menu("Table", "tablecells", tables)
  return(bar)
}

// The toolbar of a script window: Run and Stop, and a button that hides or shows the output pane.
[return<Toolbar>]
build_script_toolbar([App] app, [EditorCommands] commands) {
  [Toolbar] bar{app.toolbar()}
  bar.commandButton("Run", "play.fill", commands.run)
  bar.commandButton("Stop", "stop.fill", commands.stop)
  bar.separator()
  bar.commandButton("Output", "rectangle.bottomhalf.inset.filled", commands.output)
  return(bar)
}

// Which toolbar a window shows: 1 the markdown one (a markdown file, or its preview is on), 2 the script one (a
// PrimeStruct file), 0 none.
[return<i32> effects(heap_alloc)]
toolbar_kind([Window] tab) {
  [i32 mut] kind{0i32}
  if(tab.hasPreview()) {
    kind = 1i32
  }
  if(kind == 0i32 && tab.hasPath()) {
    [String] path{tab.path()}
    if(ends_with_text(path, ".md", 3i32) || ends_with_text(path, ".markdown", 9i32)) {
      kind = 1i32
    }
    if(ends_with_text(path, ".prime", 6i32)) {
      kind = 2i32
    }
  }
  return(kind)
}

// Shows the toolbar of kind `wanted` (1 markdown, 2 script) on the document windows that want it (building it on the
// first) and takes the toolbar off the windows that want none; returns the toolbar, which is built once. Call it once
// for each kind.
[return<Toolbar> effects(heap_alloc)]
sync_toolbars([App] app, [u64] settingsWindow, [Toolbar] known, [i32] wanted, [EditorCommands] commands) {
  [Toolbar mut] bar{known}
  [i32 mut] index{0i32}
  while(index < app.windowCount()) {
    [Window] each{app.windowAt(index)}
    if(each.handle != settingsWindow) {
      [i32] kind{toolbar_kind(each)}
      if(kind == wanted) {
        if(bar.handle == 0u64) {
          if(wanted == 1i32) {
            bar = build_toolbar(app, commands)
          } else {
            bar = build_script_toolbar(app, commands)
          }
        }
        [bool] shown{each.setToolbar(bar)}
        if(wanted == 1i32) {
          [Command] mode{commands.mode.at(each.previewMode())}
          [bool] selected{each.selectToolbarCommand(mode)}
        }
      }
      if(kind == 0i32) {
        [bool] hidden{each.hideToolbar()}
      }
    }
    index = index + 1i32
  }
  return(bar)
}

// Runs the tab's text as a script; the pane under the editor shows the output, and the end of the run is the command
// `done`.
[return<bool> effects(heap_alloc)]
run_script([Window] tab, [Command] done) {
  [TextView] view{tab.content()}
  [String] source{view.text()}
  [bool mut] started{false}
  if(tab.hasPath()) {
    [String] path{tab.path()}
    started = tab.runScriptCommand(path, source, done)
  } else {
    [String mut] untitled{String{}}
    untitled.append("untitled.prime")
    started = tab.runScriptCommand(untitled, source, done)
  }
  return(started)
}

// A format command acts on the text; in the preview-only mode there is no text to see, so the window shows both first.
[return<bool>]
format_text([Window] tab, [i32] operation, [i32] a, [i32] b) {
  if(tab.previewMode() == 2i32) {
    [bool] split{tab.setPreviewMode(1i32)}
  }
  [TextView] view{tab.content()}
  return(view.markdownEdit(operation, a, b))
}

// A new document: a window with its own text view, joined to host's tabs.
[return<Window>]
new_tab([App] app, [Window] host) {
  [Window] created{app.window("Untitled", 880i32, 480i32)}
  [TextView] view{app.textView()}
  view.setMonospace(true)
  apply_preferences(app, view)
  created.setContent(view)
  host.addTab(created)
  created.show()
  return(created)
}

// Writes the tab's text to its file (asking for one with Save As, or when it has
// none yet). True when the text was saved.
[return<bool>]
save_document([App] app, [Window] tab, [bool] chooseFile) {
  [TextView] view{tab.content()}
  [bool mut] saved{false}
  if(chooseFile || !tab.hasPath()) {
    [String] chosen{app.savePanel("Save", "Untitled.txt")}
    if(app.panelChosen()) {
      if(view.saveFile(chosen)) {
        tab.setPath(chosen)
        saved = true
      } else {
        app.alert("The file could not be saved.", app.lastError(), "OK")
      }
    }
  } else {
    if(view.saveFile(tab.path())) {
      saved = true
    } else {
      app.alert("The file could not be saved.", app.lastError(), "OK")
    }
  }
  if(saved) {
    tab.setTitle(tab.path())
    app.addRecent(tab.path())
    view.highlight(tab.path())
    view.clearModified()
    tab.setEdited(false)
  }
  return(saved)
}

// True when the tab's unsaved text is dealt with (saved or given up).
[return<bool> effects(heap_alloc)]
confirm_discard([App] app, [Window] tab) {
  [TextView] view{tab.content()}
  [bool mut] go{true}
  if(view.isModified()) {
    [i32] answer{ask_to_save(app)}
    if(answer == 2i32) {
      go = false
    }
    if(answer == 0i32) {
      go = save_document(app, tab, false)
    }
  }
  return(go)
}

[return<bool> effects(heap_alloc)]
close_tab([App] app, [Window] tab) {
  [bool] go{confirm_discard(app, tab)}
  if(go) {
    tab.close()
  }
  return(go)
}

// Opens `chosen` in a new tab, or in this one while it is still an untouched
// untitled document; a file that opened joins the recent files.
[return<bool> effects(heap_alloc)]
open_path([App] app, [Window] tab, [String] chosen) {
  if(!chosen.empty()) {
    [TextView] current{tab.content()}
    [bool] reuse{!tab.hasPath() && !current.isModified()}
    [Window mut] target{tab}
    if(!reuse) {
      target = new_tab(app, tab)
    }
    [TextView] view{target.content()}
    if(view.loadFile(chosen)) {
      target.setPath(chosen)
      target.setTitle(chosen)
      app.addRecent(chosen)
      view.highlight(chosen)
      target.setEdited(false)
      target.refreshPreview()
      [bool] previewed{preview_if_markdown(app, target, chosen)}
    } else {
      app.alert("The file could not be opened.", app.lastError(), "OK")
      if(!reuse) {
        target.close()
      }
    }
  }
  return(true)
}

// Opens `requested` (a file the system asks the app to open), or selects the tab that already holds it: macOS also
// reports a file named on the command line as such a request.
[return<bool> effects(heap_alloc)]
open_or_select([App] app, [Window] tab, [String] requested, [u64] settingsWindow) {
  [bool mut] found{false}
  [i32 mut] index{0i32}
  while(!found && index < app.windowCount()) {
    [Window] each{app.windowAt(index)}
    if(each.handle != settingsWindow && each.hasPath()) {
      if(same_text(each.path(), requested)) {
        found = each.select()
      }
    }
    index = index + 1i32
  }
  [bool mut] opened{found}
  if(!found) {
    opened = open_path(app, tab, requested)
  }
  return(opened)
}

// Asks for a file and opens it.
[return<bool> effects(heap_alloc)]
open_document([App] app, [Window] tab) {
  [String] chosen{app.openPanel("Open")}
  [bool mut] opened{false}
  if(app.panelChosen()) {
    opened = open_path(app, tab, chosen)
  }
  return(opened)
}

// Remembers the files the tabs hold (in tab-bar order) and which tab is active, so the next launch
// brings them back, with the preview mode of each tab ("0" the text alone, "1" split, "2" the preview alone, in the
// order of the files). Untitled tabs have nothing to reopen.
[return<bool> effects(heap_alloc)]
save_session([App] app, [Window] current) {
  app.listClear("session.files")
  app.listClear("session.previews")
  [i32] count{current.tabCount()}
  [i32 mut] active{0i32}
  [i32 mut] saved{0i32}
  [i32 mut] index{0i32}
  while(index < count) {
    [Window] each{current.tabAt(index)}
    if(each.hasPath()) {
      app.listAdd("session.files", each.path())
      if(each.previewMode() == 2i32) {
        app.listAdd("session.previews", stringFrom("2"))
      } else {
        if(each.previewMode() == 1i32) {
          app.listAdd("session.previews", stringFrom("1"))
        } else {
          app.listAdd("session.previews", stringFrom("0"))
        }
      }
      if(each.handle == current.handle) {
        active = saved
      }
      saved = saved + 1i32
    }
    index = index + 1i32
  }
  app.setIntPref("session.active", active)
  return(true)
}

// Shows the preview of a restored tab when the last session had it on.
[return<bool>]
restore_preview([App] app, [Window] tab, [i32] position) {
  [bool mut] shown{false}
  if(position < app.listCount("session.previews")) {
    [String] flag{app.listGet("session.previews", position)}
    if(flag.equalsText("1")) {
      shown = tab.setPreviewMode(1i32)
    }
    if(flag.equalsText("2")) {
      shown = tab.setPreviewMode(2i32)
    }
  }
  return(shown)
}

// Opens the files the last session had open, one tab each in the same order, and selects the tab that was active. A
// file that is gone is skipped. It runs after the first frame, so the window is on screen first: when the first window
// holds a document by then (the file the system asked the app to open at launch), the session's tabs open behind it,
// without that file twice, and the first window stays selected. Returns how many tabs hold a file of the session.
[return<i32> effects(heap_alloc)]
restore_session([App] app, [Window] first) {
  [TextView] firstView{first.content()}
  [bool] keepFirst{first.hasPath() || firstView.isModified()}
  [i32] saved{app.listCount("session.files")}
  [i32 mut] opened{0i32}
  [i32 mut] added{0i32}
  // Each tab opens right after the one before it (a tab joins its host's group just after the host).
  [Window mut] last{first}
  [i32 mut] position{0i32}
  while(position < saved) {
    [String] path{app.listGet("session.files", position)}
    [bool mut] already{false}
    if(first.hasPath()) {
      already = same_text(first.path(), path)
    }
    if(already) {
      opened = opened + 1i32
    } else {
      if(opened == 0i32 && !keepFirst) {
        if(firstView.loadFile(path)) {
          first.setPath(path)
          first.setTitle(path)
          firstView.highlight(path)
          [bool] firstPreviewed{preview_if_markdown(app, first, path)}
          [bool] firstRestored{restore_preview(app, first, position)}
          opened = 1i32
        }
      } else {
        [Window] extra{new_tab(app, last)}
        [TextView] extraView{extra.content()}
        if(extraView.loadFile(path)) {
          extra.setPath(path)
          extra.setTitle(path)
          extraView.highlight(path)
          [bool] extraPreviewed{preview_if_markdown(app, extra, path)}
          [bool] extraRestored{restore_preview(app, extra, position)}
          opened = opened + 1i32
          added = added + 1i32
          last = extra
        } else {
          extra.close()
        }
      }
    }
    position = position + 1i32
  }
  if(keepFirst) {
    if(added > 0i32) {
      [bool] reselected{first.select()}
    }
  } else {
    [i32] active{app.intPref("session.active", 0i32)}
    if(opened > 1i32 && active >= 0i32 && active < first.tabCount()) {
      [Window] chosen{first.tabAt(active)}
      chosen.select()
    }
  }
  return(opened)
}

// The state the handlers share: the app, the menus and toolbars that follow the documents and the preferences, the
// settings window, and the commands whose items they mark. Each tab keeps its own document path in the backend, so
// there are no per-document fields. A handler does its own work and says what else it changed; `afterEvent` then
// brings the menus, toolbars and session up to date once.
[struct]
Editor() {
  [public App] app{App{}}
  [public EditorCommands] commands{EditorCommands{}}
  [public Menu] viewMenu{Menu{}}
  [public Menu] scrollMenu{Menu{}}
  [public Menu] recentMenu{Menu{}}
  [public Settings mut] settings{Settings{}}
  // The toolbars, each built when the first window needs it.
  [public Toolbar mut] markdownBar{Toolbar{}}
  [public Toolbar mut] scriptBar{Toolbar{}}
  // What the last event changed: a command ran (the toolbars follow the windows, the session is saved), a file opened
  // by request (the toolbars follow), the preferences, the recent files.
  [public bool mut] commanded{false}
  [public bool mut] documentsChanged{false}
  [public bool mut] preferencesChanged{false}
  [public bool mut] recentChanged{false}
  // Quit was asked for: the tabs close after the event.
  [public bool mut] quitRequested{false}
  // The last session comes back after the first frame; until then the session is not saved over.
  [public bool mut] sessionPending{false}
  // False once the last document has closed: the app ends then.
  [public bool mut] running{true}

  // A command starts: the toolbars follow and the session is saved after it. Gives the window the command acts on: the
  // active one, or the first document while the settings window is active (the commands of its menu act on a
  // document), except that Close (`closing`) closes the settings window itself.
  [mut effects(heap_alloc) return<Window>]
  startCommand([bool] closing) {
    this.commanded = true
    [Window mut] tab{this.app.activeWindow()}
    if(tab.handle == this.settings.window && !closing) {
      tab = document_window(this.app, this.settings.window)
    }
    return(tab)
  }

  // Every document shows the editor preferences; the View menu and the settings window show them too.
  [return<bool>]
  refreshPreferences() {
    [i32 mut] index{0i32}
    while(index < this.app.windowCount()) {
      [Window] each{this.app.windowAt(index)}
      if(each.handle != this.settings.window) {
        [TextView] eachView{each.content()}
        apply_preferences(this.app, eachView)
      }
      index = index + 1i32
    }
    this.viewMenu.setCommandChecked(this.commands.lineNumbers, this.app.boolPref("lineNumbers", false))
    this.viewMenu.setCommandChecked(this.commands.wrap, this.app.boolPref("wrapLines", true))
    [CheckBox] numbersBox{[handle] this.settings.numbers}
    numbersBox.setChecked(this.app.boolPref("lineNumbers", false))
    [CheckBox] wrapBox{[handle] this.settings.wrap}
    wrapBox.setChecked(this.app.boolPref("wrapLines", true))
    [i32] mode{this.app.intPref("scrollMode", 2i32)}
    [i32 mut] choice{0i32}
    while(choice < 4i32) {
      [Command] scrollItem{this.commands.scroll.at(choice)}
      this.scrollMenu.setCommandChecked(scrollItem, choice == mode)
      choice = choice + 1i32
    }
    [Popup] scrollChoice{[handle] this.settings.lock}
    scrollChoice.select(mode)
    return(true)
  }

  // Rebuilds File > Open Recent from the recent files list; returns how many files it shows.
  [return<i32>]
  refreshRecent() {
    this.recentMenu.clear()
    [i32] shown{this.recentMenu.addRecentFileCommands(this.commands.recent)}
    if(shown > 0i32) {
      this.recentMenu.separator()
    }
    this.recentMenu.commandItem("Clear Menu", "", this.commands.recentClear)
    return(shown)
  }

  // The toolbars follow what each window holds: a markdown file or its preview, or a script.
  [mut effects(heap_alloc)]
  syncToolbars() {
    this.markdownBar = sync_toolbars(this.app, this.settings.window, this.markdownBar, 1i32, this.commands)
    this.scriptBar = sync_toolbars(this.app, this.settings.window, this.scriptBar, 2i32, this.commands)
  }

  // After every event: what the handlers changed shows, and the session is saved after a command. Closing the last
  // tab ends the app like Quit does, so the session stays as it was before it closed; the settings window is not a
  // document and goes with the last one. False when the app ends.
  [mut effects(heap_alloc) return<bool>]
  afterEvent() {
    if(this.preferencesChanged) {
      [bool] shown{this.refreshPreferences()}
    }
    if(this.recentChanged) {
      [i32] listed{this.refreshRecent()}
    }
    if(this.commanded || this.documentsChanged || this.quitRequested) {
      this.syncToolbars()
    }
    if(this.commanded && !this.sessionPending && count_documents(this.app, this.settings.window) > 0i32) {
      [bool] remembered{save_session(this.app, document_window(this.app, this.settings.window))}
    }
    if(this.quitRequested) {
      this.closeAll()
    }
    this.commanded = false
    this.documentsChanged = false
    this.preferencesChanged = false
    this.recentChanged = false
    this.quitRequested = false
    if(count_documents(this.app, this.settings.window) == 0i32) {
      if(this.settings.window != 0u64) {
        [Window] leaving{[handle] this.settings.window}
        leaving.close()
      }
      this.running = false
    }
    return(this.running)
  }

  // The first frame is on screen: the last session comes back now, when the launch asked for it.
  [mut effects(heap_alloc)]
  restoreSession([Window] first) {
    if(this.sessionPending) {
      this.sessionPending = false
      [i32] restored{restore_session(this.app, first)}
      this.documentsChanged = true
    }
  }

  [mut effects(heap_alloc)]
  showSettings() {
    this.commanded = true
    if(this.settings.window == 0u64) {
      this.settings = build_settings(this.app)
    } else {
      [Window] again{[handle] this.settings.window}
      again.show()
    }
  }

  [mut effects(heap_alloc)]
  newTab() {
    [Window] tab{this.startCommand(false)}
    new_tab(this.app, tab)
  }

  [mut effects(heap_alloc)]
  openDocument() {
    [Window] tab{this.startCommand(false)}
    [bool] opened{open_document(this.app, tab)}
    this.recentChanged = true
  }

  // File > Open Recent: `index` is the file's place in the list, most recent first.
  [mut effects(heap_alloc)]
  openRecent([i32] index) {
    [Window] tab{this.startCommand(false)}
    [String] picked{this.app.recentPath(index)}
    [bool] reopened{open_path(this.app, tab, picked)}
    this.recentChanged = true
  }

  [mut effects(heap_alloc)]
  clearRecent() {
    this.commanded = true
    this.app.clearRecent()
    this.recentChanged = true
  }

  // Save, or Save As (`chooseFile`).
  [mut effects(heap_alloc)]
  saveDocument([bool] chooseFile) {
    [Window] tab{this.startCommand(false)}
    [bool] saved{save_document(this.app, tab, chooseFile)}
    this.recentChanged = true
  }

  // File > Close: the active window closes, the settings window too.
  [mut effects(heap_alloc)]
  closeActive() {
    [Window] tab{this.startCommand(true)}
    this.closeWindow(tab)
  }

  // File > Close and a window's close button: `tab` asks about its unsaved text and closes.
  [mut effects(heap_alloc)]
  closeWindow([Window] tab) {
    this.commanded = true
    [bool] closed{close_tab(this.app, tab)}
    if(closed && tab.handle == this.settings.window) {
      this.settings = Settings{}
    }
  }

  [mut effects(heap_alloc)]
  togglePreview() {
    [Window] tab{this.startCommand(false)}
    tab.setPreview(!tab.hasPreview())
  }

  // View > Editor, Split View or Preview: `mode` 0, 1 or 2.
  [mut effects(heap_alloc)]
  showMode([i32] mode) {
    [Window] tab{this.startCommand(false)}
    [bool] moded{tab.setPreviewMode(mode)}
  }

  [mut effects(heap_alloc)]
  runScript() {
    [Window] tab{this.startCommand(false)}
    run_script(tab, this.commands.scriptDone)
  }

  [mut effects(heap_alloc)]
  stopScript() {
    [Window] tab{this.startCommand(false)}
    tab.stopScript()
  }

  [mut effects(heap_alloc)]
  toggleOutput() {
    [Window] tab{this.startCommand(false)}
    tab.setOutputVisible(!tab.outputVisible())
  }

  // Cmd+1 ... Cmd+9: `number` 1 to 9.
  [mut effects(heap_alloc)]
  selectTab([i32] number) {
    [Window] tab{this.startCommand(false)}
    [bool] switched{select_tab(tab, number)}
  }

  // A command that needs no window: the end of a script run (the pane already shows how it ended).
  [mut]
  noteCommand() {
    this.commanded = true
  }

  // A markdown edit of ps_ui_text_view_markdown_edit on the tab's text.
  [mut effects(heap_alloc)]
  formatText([i32] operation, [i32] a, [i32] b) {
    [Window] tab{this.startCommand(false)}
    [bool] formatted{format_text(tab, operation, a, b)}
  }

  // Insert Table: `size` 0 to 3 is 2 by 2, 3 by 3, 4 by 3 or 5 by 4 (columns by rows).
  [mut effects(heap_alloc)]
  insertTable([i32] size) {
    [i32 mut] columns{2i32}
    [i32 mut] rows{2i32}
    if(size == 1i32) {
      columns = 3i32
      rows = 3i32
    }
    if(size == 2i32) {
      columns = 4i32
      rows = 3i32
    }
    if(size == 3i32) {
      columns = 5i32
      rows = 4i32
    }
    this.formatText(13i32, columns, rows)
  }

  // The scroll mode 0 to 3: the settings window's choice, or View > Scroll Preview (`command`).
  [mut effects(heap_alloc)]
  chooseScrollMode([i32] mode, [bool] command) {
    if(command) {
      this.commanded = true
    }
    this.app.setIntPref("scrollMode", mode)
    this.app.setPreviewScrollMode(mode)
    this.preferencesChanged = true
  }

  // View > Show Line Numbers and Wrap Lines flip their preference (`fallback` before the first choice).
  [mut effects(heap_alloc)]
  togglePreference([string] name, [bool] fallback) {
    this.commanded = true
    this.setBoolPreference(name, !this.app.boolPref(name, fallback))
  }

  // A preference of the settings window, or of a View item that flips it.
  [mut effects(heap_alloc)]
  setBoolPreference([string] name, [bool] value) {
    this.app.setBoolPref(name, value)
    this.preferencesChanged = true
  }

  [mut effects(heap_alloc)]
  chooseFontSize([i32] index) {
    this.app.setIntPref("fontSize", font_size_at(index))
    this.preferencesChanged = true
  }

  // The system asks the app to open `requested`: a file dropped on its icon, opened with it, or named on the command
  // line.
  [mut effects(heap_alloc)]
  openRequested([String] requested) {
    [Window] target{document_window(this.app, this.settings.window)}
    [bool] opened{open_or_select(this.app, target, requested, this.settings.window)}
    this.recentChanged = true
    this.documentsChanged = true
  }

  // Quit: the session is what the tabs hold now; every tab gets its say, and Cancel stops the quit (the app ends when
  // no document is left).
  [mut effects(heap_alloc)]
  closeAll() {
    if(!this.sessionPending) {
      [bool] remembered{save_session(this.app, document_window(this.app, this.settings.window))}
    }
    [bool mut] go{true}
    while(go && count_documents(this.app, this.settings.window) > 0i32) {
      [Window] next{document_window(this.app, this.settings.window)}
      go = close_tab(this.app, next)
    }
    if(!this.sessionPending && count_documents(this.app, this.settings.window) > 0i32) {
      [bool] again{save_session(this.app, document_window(this.app, this.settings.window))}
    }
  }

  // A request to quit: `afterEvent` closes the tabs and ends the app when none is left, so the handler itself keeps
  // it running.
  [mut return<bool>]
  requestQuit() {
    this.quitRequested = true
    return(false)
  }

  // Make Default: the application becomes the default of the file types selected in the Files list.
  [mut effects(heap_alloc)]
  makeDefault() {
    [String] chosenApp{this.app.appPath()}
    [ItemList] picks{[handle] this.settings.list}
    [i32] pickCount{picks.count()}
    [i32 mut] pickAt{0i32}
    [String mut] pickedExtensions{String{}}
    while(pickAt < pickCount) {
      if(picks.isSelected(pickAt)) {
        [String] typeExtensions{this.app.documentTypeExtensions(pickAt)}
        if(!pickedExtensions.empty()) {
          pickedExtensions.append(",")
        }
        pickedExtensions.appendString(typeExtensions)
      }
      pickAt = pickAt + 1i32
    }
    if(!pickedExtensions.empty()) {
      this.app.setDefaultApp(pickedExtensions, chosenApp)
    }
    [bool] listed{refresh_files(this.app, this.settings.list)}
    this.preferencesChanged = true
  }
}

[return<int> effects(heap_alloc)]
main([array<string>] args) {
  [App] app{start_app("PrimeScroll")}

  // The commands, in the order of their ids (EditorCommands); each handler gets the editor.
  [AppHandlers<Editor> mut] handlers{AppHandlers<Editor>{[state] Editor{}}}
  [EditorCommands mut] commands{EditorCommands{}}
  commands.newTab = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.newTab() })
  commands.open = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.openDocument() })
  commands.save = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.saveDocument(false) })
  commands.saveAs = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.saveDocument(true) })
  commands.close = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.closeActive() })
  commands.lineNumbers = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) {
    editor.togglePreference("lineNumbers", false)
  })
  commands.settings = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.showSettings() })
  commands.wrap = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) {
    editor.togglePreference("wrapLines", true)
  })
  commands.preview = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.togglePreview() })
  commands.scroll = handlers.commandRange(4i32, []([Reference<Editor>] editor, [i32] mode) {
    editor.chooseScrollMode(mode, true)
  })
  commands.mode = handlers.commandRange(3i32, []([Reference<Editor>] editor, [i32] mode) { editor.showMode(mode) })
  commands.format = handlers.commandRange(22i32, []([Reference<Editor>] editor, [i32] operation) {
    editor.formatText(operation, 0i32, 0i32)
  })
  commands.heading = handlers.commandRange(4i32, []([Reference<Editor>] editor, [i32] level) {
    editor.formatText(6i32, level, 0i32)
  })
  commands.table = handlers.commandRange(4i32, []([Reference<Editor>] editor, [i32] size) { editor.insertTable(size) })
  commands.align = handlers.commandRange(3i32, []([Reference<Editor>] editor, [i32] side) {
    editor.formatText(19i32, side + 1i32, 0i32)
  })
  commands.tab = handlers.commandRange(9i32, []([Reference<Editor>] editor, [i32] index) {
    editor.selectTab(index + 1i32)
  })
  commands.run = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.runScript() })
  commands.stop = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.stopScript() })
  commands.output = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.toggleOutput() })
  commands.scriptDone = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) { editor.noteCommand() })
  commands.recent = handlers.commandRange(10i32, []([Reference<Editor>] editor, [i32] index) {
    editor.openRecent(index)
  })
  commands.recentClear = handlers.command([]([Reference<Editor>] editor, [PointerEvent] event) {
    editor.clearRecent()
  })

  // The settings window is built when it is first opened, so its controls are found in the editor.
  handlers.onCheckBoxChangeOf([]([Reference<Editor>] editor) { return(editor.settings.restore) },
                              []([Reference<Editor>] editor, [ChangeEvent] event) {
    editor.setBoolPreference("restoreSession", event.checked)
  })
  handlers.onCheckBoxChangeOf([]([Reference<Editor>] editor) { return(editor.settings.numbers) },
                              []([Reference<Editor>] editor, [ChangeEvent] event) {
    editor.setBoolPreference("lineNumbers", event.checked)
  })
  handlers.onCheckBoxChangeOf([]([Reference<Editor>] editor) { return(editor.settings.wrap) },
                              []([Reference<Editor>] editor, [ChangeEvent] event) {
    editor.setBoolPreference("wrapLines", event.checked)
  })
  handlers.onCheckBoxChangeOf([]([Reference<Editor>] editor) { return(editor.settings.preview) },
                              []([Reference<Editor>] editor, [ChangeEvent] event) {
    editor.setBoolPreference("previewMarkdown", event.checked)
  })
  handlers.onPopupChangeOf([]([Reference<Editor>] editor) { return(editor.settings.lock) },
                           []([Reference<Editor>] editor, [ChangeEvent] event) {
    editor.chooseScrollMode(event.index, false)
  })
  handlers.onPopupChangeOf([]([Reference<Editor>] editor) { return(editor.settings.size) },
                           []([Reference<Editor>] editor, [ChangeEvent] event) { editor.chooseFontSize(event.index) })
  // Every change in the settings window shows the preferences again, a new selection of file types too.
  handlers.onListChangeOf([]([Reference<Editor>] editor) { return(editor.settings.list) },
                          []([Reference<Editor>] editor, [ChangeEvent] event) { editor.preferencesChanged = true })
  handlers.onClickOf([]([Reference<Editor>] editor) { return(editor.settings.apply) },
                     []([Reference<Editor>] editor, [PointerEvent] event) { editor.makeDefault() })

  handlers.onWindowClose([]([Reference<Editor>] editor, [Window] closing) { editor.closeWindow(closing) })
  handlers.onTextChange([]([Reference<Editor>] editor, [Window] changed) {
    changed.setEdited(true)
    [TextView] view{changed.content()}
    view.highlight(changed.path())
    changed.refreshPreview()
  })
  handlers.onOpenFile([]([Reference<Editor>] editor, [String] requested) { editor.openRequested(requested) })
  handlers.onFirstFrame([]([Reference<Editor>] editor, [Window] drawn) { editor.restoreSession(drawn) })
  handlers.onQuit([]([Reference<Editor>] editor) {
    [bool] quitting{editor.requestQuit()}
    return(quitting)
  })
  handlers.afterEvent([]([Reference<Editor>] editor) {
    [bool] going{editor.afterEvent()}
    return(going)
  })

  app.setPreviewScrollMode(app.intPref("scrollMode", 2i32))
  [Window] first{app.window("Untitled", 880i32, 480i32)}
  first.setAutosaveName("PrimeScroll")
  [TextView] firstView{app.textView()}
  firstView.setMonospace(true)
  apply_preferences(app, firstView)
  first.setContent(firstView)

  [Menu] application{app.menu("PrimeScroll")}
  application.about()
  application.separator()
  application.commandItem("Settings...", "cmd+,", commands.settings)
  application.separator()
  application.hide()
  application.hideOthers()
  application.separator()
  application.quit()
  application.addToBarAsApp()

  [Menu] file{app.menu("File")}
  file.commandItem("New Tab", "cmd+t", commands.newTab)
  file.commandItem("New", "cmd+n", commands.newTab)
  file.commandItem("Open...", "cmd+o", commands.open)
  [Menu] recentMenu{app.menu("Open Recent")}
  file.submenu("Open Recent", recentMenu)
  file.separator()
  file.commandItem("Save", "cmd+s", commands.save)
  file.commandItem("Save As...", "cmd+shift+s", commands.saveAs)
  file.separator()
  file.commandItem("Close", "cmd+w", commands.close)
  file.addToBar()

  [Menu] edit{app.menu("Edit")}
  edit.undo()
  edit.redo()
  edit.separator()
  edit.cut()
  edit.copy()
  edit.paste()
  edit.selectAll()
  edit.separator()
  edit.find()
  edit.addToBar()

  [Menu] formatMenu{app.menu("Format")}
  formatMenu.commandItem("Bold", "cmd+b", commands.format.at(0i32))
  formatMenu.commandItem("Italic", "cmd+i", commands.format.at(1i32))
  formatMenu.commandItem("Strikethrough", "cmd+shift+x", commands.format.at(2i32))
  formatMenu.commandItem("Code", "cmd+e", commands.format.at(3i32))
  formatMenu.separator()
  formatMenu.commandItem("Link", "cmd+k", commands.format.at(4i32))
  formatMenu.commandItem("Image", "", commands.format.at(5i32))
  formatMenu.separator()
  [Menu] headingMenu{app.menu("Heading")}
  [bool] headingItems{add_heading_items(headingMenu, commands.heading)}
  formatMenu.submenu("Heading", headingMenu)
  formatMenu.commandItem("Bulleted List", "", commands.format.at(7i32))
  formatMenu.commandItem("Numbered List", "", commands.format.at(8i32))
  formatMenu.commandItem("Task List", "", commands.format.at(9i32))
  formatMenu.commandItem("Quote", "", commands.format.at(10i32))
  formatMenu.commandItem("Code Block", "", commands.format.at(11i32))
  formatMenu.commandItem("Horizontal Rule", "", commands.format.at(12i32))
  formatMenu.separator()
  [Menu] tableMenu{app.menu("Table")}
  [bool] tableItems{add_table_items(tableMenu, commands)}
  formatMenu.submenu("Table", tableMenu)
  formatMenu.addToBar()

  [Menu] runMenu{app.menu("Run")}
  runMenu.commandItem("Run", "cmd+r", commands.run)
  runMenu.commandItem("Stop", "cmd+.", commands.stop)
  runMenu.separator()
  runMenu.commandItem("Show Output", "cmd+alt+o", commands.output)
  runMenu.addToBar()

  [Menu] viewMenu{app.menu("View")}
  viewMenu.fullScreen()
  viewMenu.showTabBar()
  viewMenu.commandItem("Show Line Numbers", "cmd+shift+l", commands.lineNumbers)
  viewMenu.commandItem("Wrap Lines", "", commands.wrap)
  viewMenu.commandItem("Show Markdown Preview", "cmd+shift+m", commands.preview)
  viewMenu.followPreviewCommand(commands.preview)
  viewMenu.commandItem("Editor", "cmd+alt+1", commands.mode.at(0i32))
  viewMenu.commandItem("Split View", "cmd+alt+2", commands.mode.at(1i32))
  viewMenu.commandItem("Preview", "cmd+alt+3", commands.mode.at(2i32))
  [Menu] scrollMenu{app.menu("Scroll Preview")}
  scrollMenu.commandItem("Independently", "", commands.scroll.at(0i32))
  scrollMenu.commandItem("Linearly", "", commands.scroll.at(1i32))
  scrollMenu.commandItem("By Block", "", commands.scroll.at(2i32))
  scrollMenu.commandItem("With the Cursor", "", commands.scroll.at(3i32))
  viewMenu.submenu("Scroll Preview", scrollMenu)
  viewMenu.addToBar()

  [Menu] windowMenu{app.menu("Window")}
  windowMenu.minimize()
  windowMenu.zoom()
  windowMenu.separator()
  windowMenu.nextTab()
  windowMenu.previousTab()
  windowMenu.moveTabToNewWindow()
  windowMenu.mergeAllWindows()
  windowMenu.separator()
  windowMenu.commandItem("Show Tab 1", "cmd+1", commands.tab.at(0i32))
  windowMenu.commandItem("Show Tab 2", "cmd+2", commands.tab.at(1i32))
  windowMenu.commandItem("Show Tab 3", "cmd+3", commands.tab.at(2i32))
  windowMenu.commandItem("Show Tab 4", "cmd+4", commands.tab.at(3i32))
  windowMenu.commandItem("Show Tab 5", "cmd+5", commands.tab.at(4i32))
  windowMenu.commandItem("Show Tab 6", "cmd+6", commands.tab.at(5i32))
  windowMenu.commandItem("Show Tab 7", "cmd+7", commands.tab.at(6i32))
  windowMenu.commandItem("Show Tab 8", "cmd+8", commands.tab.at(7i32))
  windowMenu.commandItem("Show Last Tab", "cmd+9", commands.tab.at(8i32))
  windowMenu.separator()
  windowMenu.bringAllToFront()
  windowMenu.addToBarAsWindow()

  [Menu] helpMenu{app.menu("Help")}
  helpMenu.help()
  helpMenu.addToBarAsHelp()

  [Editor mut] editor{Editor{[app] app, [commands] commands, [viewMenu] viewMenu, [scrollMenu] scrollMenu,
                             [recentMenu] recentMenu}}

  // A file named on the command line opens in the first tab.
  if(args.count() > 1i32) {
    [String] named{argumentText(1i32)}
    if(firstView.loadFile(named)) {
      first.setPath(named)
      first.setTitle(named)
      app.addRecent(named)
      firstView.highlight(named)
      [bool] namedPreviewed{preview_if_markdown(app, first, named)}
    } else {
      app.alert("The file could not be opened.", app.lastError(), "OK")
    }
  }

  [bool] shown{editor.refreshPreferences()}
  [i32] recentShown{editor.refreshRecent()}

  // Without a file on the command line the last session comes back after the first frame (`restoreSession`), unless the
  // preferences say no: the window is on screen before the session's tabs, toolbars and previews are built.
  editor.sessionPending = args.count() <= 1i32 && app.boolPref("restoreSession", true)
  editor.syncToolbars()
  first.show()

  handlers.state = editor
  app.run(handlers)
  return(0i32)
}
