// `Vector`'s storage pointer is a `[private]` field, so safe code cannot hand one vector's storage to another.
// Two vectors that free the same storage are a double free.
import /std/collections/*

[effects(heap_alloc), return<int>]
main() {
  [/std/collections/vector/Vector<i32> mut] v{/std/collections/vector/vector<i32>(1i32, 2i32)}
  [/std/collections/vector/Vector<i32> mut] w{/std/collections/vector/vector<i32>(3i32)}
  w.data = v.data
  return(0i32)
}
