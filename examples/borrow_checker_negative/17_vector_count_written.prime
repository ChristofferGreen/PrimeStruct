// `Vector`'s element count is a `[private]` field, so safe code cannot claim more elements than the storage
// holds. Reading `at(500i32)` afterwards would be an out-of-bounds access.
import /std/collections/*

[effects(heap_alloc), return<int>]
main() {
  [/std/collections/vector/Vector<i32> mut] v{/std/collections/vector/vector<i32>(1i32, 2i32)}
  v.fieldCount = 1000i32
  return(v.at(500i32))
}
