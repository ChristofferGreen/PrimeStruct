// A brace constructor cannot build a `Vector` around chosen storage from outside the vector module: its fields
// are `[private]`, so naming them in `Vector<i32>{...}` is rejected.
import /std/collections/*

[effects(heap_alloc), return<int>]
main() {
  [/std/collections/vector/Vector<i32> mut] v{/std/collections/vector/vector<i32>(1i32, 2i32)}
  [/std/collections/vector/Vector<i32>] other{/std/collections/vector/Vector<i32>{2i32, 2i32, v.data}}
  return(0i32)
}
