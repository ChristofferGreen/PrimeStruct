// A pointer cannot cross to a task, not even inside a struct: the diagnostic names each field on the way.
[struct]
PixelRows() {
  [Pointer<u8>] bytes
  [i32] stride{0i32}
}

[struct]
Job() {
  [i32] id{0i32}
  [PixelRows] rows
}

[return<i32>]
render([Job] job) {
  return(job.id)
}

[effects(task), return<int>]
main() {
  [u8 mut] byte{1u8}
  [Job] job{Job{[id] 1i32, [rows] PixelRows{[bytes] location(byte)}}}
  [Task<i32>] task{[spawn] render(job)};
  return(wait(task))
}
