import /std/text/*

[return<int> effects(heap_alloc, io_out)]
main() {
  [i32 mut] total{0i32}
  for([i32 mut] i{0i32}, i < 1000000i32, i++) {
    [String mut] s{/std/text/stringFrom("GET")}
    s.append(" /index.html")
    total = total + s.count() + convert<i32>(s.byteAt(1i32))
  }
  print_line(total)
  return(0i32)
}
