import /std/text/*

[return<int> effects(heap_alloc, io_out)]
main() {
  [String mut] s{/std/text/stringFrom("")}
  for([i32 mut] i{0i32}, i < 200000i32, i++) {
    s.append("hello world, this is a longer chunk of text")
  }
  print_line(s.count() + convert<i32>(s.byteAt(4300000i32)))
  return(0i32)
}
