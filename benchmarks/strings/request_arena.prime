import /std/text/*
import /std/collections/vector/*

[return<int> effects(heap_alloc)]
handleRequest([i32] request) {
  [StringArena] arena{beginStringArena()}
  [vector<String> mut] parts{vector<String>()}
  for([i32 mut] k{0i32}, k < 400i32, k++) {
    [String mut] part{/std/text/stringFromI32(request * 400i32 + k)}
    part.append("/segment")
    parts.push(part)
  }
  [i32 mut] total{0i32}
  for([i32 mut] k{0i32}, k < 400i32, k++) {
    total = total + parts[k].count() + convert<i32>(parts[k].byteAt(0i32))
  }
  return(total)
}

[return<int> effects(heap_alloc, io_out)]
main() {
  [i32 mut] total{0i32}
  for([i32 mut] request{0i32}, request < 2000i32, request++) {
    total = total + handleRequest(request)
  }
  print_line(total)
  return(0i32)
}
