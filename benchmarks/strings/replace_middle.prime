import /std/text/*

[return<int> effects(heap_alloc, io_out)]
main() {
  [String mut] s{/std/text/stringFrom("")}
  for([i32 mut] i{0i32}, i < 2000i32, i++) {
    s.pushByte(convert<u8>(97i32 + i - i / 26i32 * 26i32))
  }
  for([i32 mut] i{0i32}, i < 50000i32, i++) {
    s.replace(100i32, 104i32, "abcdefgh")
    s.replace(100i32, 108i32, "wxyz")
  }
  print_line(s.count() + convert<i32>(s.byteAt(101i32)))
  return(0i32)
}
