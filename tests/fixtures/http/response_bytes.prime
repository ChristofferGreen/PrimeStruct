// /std/http responses and redirects, byte for byte (tests/unit/backend_host/test_http.cpp). The exit code is the
// number of the first case that failed, or 0.
import /std/http/*
import /std/text/*
import /std/text/view/*

[return<int> effects(heap_alloc)]
main() {
  [Response mut] response{Response{}}
  response.text(textOf("hello\n"), textOf("text/plain"))
  [String] hello{response.serialize()}
  if(!hello.equalsText("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 6\r\nConnection: close\r\n\r\nhello\n")) {
    return(1i32)
  }
  // A custom header, with a CR LF that must not split the head.
  response.clear()
  response.status = 201i32
  response.header(textOf("X-Id"), textOf("7\r\nInjected: yes"))
  [String] created{response.serialize()}
  if(!created.equalsText("HTTP/1.1 201 Created\r\nX-Id: 7Injected: yes\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(2i32)
  }
  // No body and no Content-Length for 204.
  response.clear()
  response.status = 204i32
  response.body.append("ignored")
  [String] empty{response.serialize()}
  if(!empty.equalsText("HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")) {
    return(3i32)
  }
  // A code without a reason phrase here keeps the space before the empty phrase.
  response.clear()
  response.status = 299i32
  [String] unknown{response.serialize()}
  if(!unknown.equalsText("HTTP/1.1 299 \r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(4i32)
  }
  [String] notFound{statusResponse(404i32)}
  if(!notFound.equalsText("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(5i32)
  }
  [String] tooLarge{statusResponse(413i32)}
  if(!tooLarge.equalsText("HTTP/1.1 413 Content Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(6i32)
  }
  // A redirect after a form POST: 303 with Location, and no body even if one was written.
  response.clear()
  response.body.append("stale")
  response.redirect("/todos")
  [String] seeOther{response.serialize()}
  if(!seeOther.equalsText("HTTP/1.1 303 See Other\r\nLocation: /todos\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(7i32)
  }
  response.clear()
  response.redirect(308i32, "/new\r\nInjected: yes")
  [String] permanent{response.serialize()}
  if(!permanent.equalsText("HTTP/1.1 308 Permanent Redirect\r\nLocation: /newInjected: yes\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(8i32)
  }
  return(0i32)
}
