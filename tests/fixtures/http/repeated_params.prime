// /std/http repeated query and form parameters and decoded path parameters (tests/unit/backend_host/test_http.cpp).
// The exit code is the number of the first case that failed, or 0.
import /std/collections/*
import /std/http/*
import /std/text/*
import /std/text/view/*

// The decoded value of the path parameter "name" of the request `raw` under the pattern "/f/:name".
[return<String> effects(heap_alloc)]
decoded_segment([string] raw) {
  [String] text{stringFrom(raw)}
  [Request mut] request{parseRequest(text.view(), 256i32)}
  [String] pattern{stringFrom("/f/:name")}
  request.route = pattern.view()
  return(request.pathParamDecoded("name"))
}

[return<int> effects(heap_alloc)]
main() {
  // 1-6: a repeated query parameter, in order, with decoded values and out-of-range indexes.
  [String] queryText{stringFrom("GET /p?tag=a&x=1&tag=b+c&tag=%C3%A9&y HTTP/1.1\r\n\r\n")}
  [Request] query{parseRequest(queryText.view(), 256i32)}
  if(query.queryParamCount("tag") != 3i32) {
    return(1i32)
  }
  if(!query.queryParamAt("tag", 0i32).equalsText("a")) {
    return(2i32)
  }
  if(!query.queryParamAt("tag", 1i32).equalsText("b c")) {
    return(3i32)
  }
  if(!query.queryParamAt("tag", 2i32).equalsText("é")) {
    return(4i32)
  }
  if(!query.queryParamAt("tag", 3i32).empty() || !query.queryParamAt("tag", -1i32).empty()) {
    return(5i32)
  }
  if(query.queryParamCount("x") != 1i32 || query.queryParamCount("none") != 0i32 || query.queryParamCount("y") != 1i32) {
    return(6i32)
  }
  // 7-11: the same for a form body; a body that is not a form has none.
  [String] formText{stringFrom("POST /p HTTP/1.1\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 26\r\n\r\ntag=a&tag=b%20c&tag=%C3%A9")}
  [Request] form{parseRequest(formText.view(), 256i32)}
  if(form.formParamCount("tag") != 3i32) {
    return(7i32)
  }
  if(!form.formParamAt("tag", 0i32).equalsText("a") || !form.formParamAt("tag", 1i32).equalsText("b c")) {
    return(8i32)
  }
  if(!form.formParamAt("tag", 2i32).equalsText("é")) {
    return(9i32)
  }
  if(!form.formParamAt("tag", 3i32).empty() || form.formParamCount("other") != 0i32) {
    return(10i32)
  }
  [String] plainText{stringFrom("POST /p HTTP/1.1\r\nContent-Type: text/plain\r\nContent-Length: 7\r\n\r\ntag=a&b")}
  [Request] plain{parseRequest(plainText.view(), 256i32)}
  if(plain.formParamCount("tag") != 0i32 || !plain.formParamAt("tag", 0i32).empty()) {
    return(11i32)
  }
  // 12-17: pathParamDecoded decodes "%XX" only; "+" stays; malformed or non-UTF-8 gives an empty String.
  if(!decoded_segment("GET /f/a%20b HTTP/1.1\r\n\r\n").equalsText("a b")) {
    return(12i32)
  }
  if(!decoded_segment("GET /f/a+b HTTP/1.1\r\n\r\n").equalsText("a+b")) {
    return(13i32)
  }
  if(!decoded_segment("GET /f/%C3%BCr HTTP/1.1\r\n\r\n").equalsText("ür")) {
    return(14i32)
  }
  if(!decoded_segment("GET /f/a%2 HTTP/1.1\r\n\r\n").empty() || !decoded_segment("GET /f/%G1 HTTP/1.1\r\n\r\n").empty()) {
    return(15i32)
  }
  if(!decoded_segment("GET /f/%FF HTTP/1.1\r\n\r\n").empty()) {
    return(16i32)
  }
  if(!decoded_segment("GET /f/plain HTTP/1.1\r\n\r\n").equalsText("plain")) {
    return(17i32)
  }
  return(0i32)
}
