// /std/http Response.setCookie and clearCookie, byte for byte (tests/unit/backend_host/test_http.cpp). The exit code is
// the number of the first case that failed, or 0.
import /std/http/*
import /std/text/*
import /std/text/view/*

[return<int> effects(heap_alloc)]
main() {
  [Response mut] response{Response{}}
  // One cookie: the attributes of a session cookie.
  if(!response.setCookie("sid", "abc123")) {
    return(1i32)
  }
  [String] one{response.serialize()}
  if(!one.equalsText("HTTP/1.1 200 OK\r\nSet-Cookie: sid=abc123; Path=/; HttpOnly; SameSite=Lax\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(2i32)
  }
  // With a lifetime.
  response.clear()
  if(!response.setCookie("sid", "abc123", 3600i32)) {
    return(3i32)
  }
  [String] aged{response.serialize()}
  if(!aged.equalsText("HTTP/1.1 200 OK\r\nSet-Cookie: sid=abc123; Path=/; HttpOnly; SameSite=Lax; Max-Age=3600\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(4i32)
  }
  // Dropping a cookie: an empty value and Max-Age=0.
  response.clear()
  if(!response.clearCookie("sid")) {
    return(5i32)
  }
  [String] cleared{response.serialize()}
  if(!cleared.equalsText("HTTP/1.1 200 OK\r\nSet-Cookie: sid=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(6i32)
  }
  // A value with a semicolon and a space is refused, and no header is written.
  response.clear()
  if(response.setCookie("sid", "a; Path=/evil")) {
    return(7i32)
  }
  if(response.setCookie("sid", "a;b")) {
    return(8i32)
  }
  if(response.setCookie("sid", "a b")) {
    return(9i32)
  }
  [String] refused{response.serialize()}
  if(!refused.equalsText("HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(10i32)
  }
  // Other bytes outside the cookie-octet set, a bad name, and a negative lifetime.
  if(response.setCookie("sid", "a,b") || response.setCookie("sid", "a\"b") || response.setCookie("sid", "a\\b")) {
    return(11i32)
  }
  if(response.setCookie("sid", "café")) {
    return(12i32)
  }
  if(response.setCookie("", "x") || response.setCookie("a b", "x") || response.setCookie("a=b", "x") ||
     response.setCookie("a;b", "x") || response.clearCookie("a;b") || response.clearCookie("")) {
    return(13i32)
  }
  if(response.setCookie("sid", "x", -1i32)) {
    return(14i32)
  }
  // A CR LF in a value is a control byte: refused, so no header is injected.
  if(response.setCookie("sid", "x\r\nInjected: yes")) {
    return(15i32)
  }
  [String] stillEmpty{response.serialize()}
  if(!stillEmpty.equalsText("HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(16i32)
  }
  // Two cookies are two header lines, in the order they were set.
  response.clear()
  if(!response.setCookie("a", "1") || !response.setCookie("b", "2", 60i32)) {
    return(17i32)
  }
  [String] two{response.serialize()}
  if(!two.equalsText("HTTP/1.1 200 OK\r\nSet-Cookie: a=1; Path=/; HttpOnly; SameSite=Lax\r\nSet-Cookie: b=2; Path=/; HttpOnly; SameSite=Lax; Max-Age=60\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(18i32)
  }
  // A visible value with the characters the set allows (`!`, `#`, `~`, `=` inside a value) is kept as it is.
  response.clear()
  if(!response.setCookie("token", "a=b!#~")) {
    return(19i32)
  }
  [String] odd{response.serialize()}
  if(!odd.equalsText("HTTP/1.1 200 OK\r\nSet-Cookie: token=a=b!#~; Path=/; HttpOnly; SameSite=Lax\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) {
    return(20i32)
  }
  return(0i32)
}
