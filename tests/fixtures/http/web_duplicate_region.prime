// /std/web: registering a second region with an id that is taken stops the program at setup
// (tests/unit/backend_host/test_web.cpp). Reaching the end is a failure: it exits 7.
import /std/html/*
import /std/http/*
import /std/web/*

[struct]
Counter() {
  [i32 mut] clicks{0i32}
}

[effects(heap_alloc)]
write_clicks([Reference<Writer>] page, [Reference<Counter>] counter) {
  page.element("p", "clicks")
}

[return<int> effects(heap_alloc, io_err)]
main() {
  [WebApp<Counter> mut] app{WebApp<Counter>{[state] Counter{}}}
  app.region("clicks", write_clicks)
  app.region("other", write_clicks)
  app.region("clicks", write_clicks)
  return(7i32)
}
