// A counter served by `serveWorkers`: WORKERS worker tasks answer, and every handler runs inside the app's mutex, so
// the counter is a plain field. GET /hold keeps its worker (and the mutex) busy for as long as the test wants: it
// connects to the test's own listener on HOLD_PORT and waits there for one byte. ACCEPT_TIMEOUT_MS is how long the
// loop waits when nothing happens.
import /std/http/*
import /std/http/server/*
import /std/net/*
import /std/os/*
import /std/text/*
import /std/text/view/*

[struct]
Counter() {
  [i32 mut] hits{0i32}
  [i32] holdPort{0i32}
}

[effects(io_err)]
log_serve_error([ServeError] err) {
  print_line_error(err.why())
}

[effects(heap_alloc)]
show_count([Reference<Counter>] counter, [Request] request, [Reference<Response>] response) {
  response.body.appendI64(convert<i64>(counter.hits))
}

[effects(heap_alloc)]
count_hit([Reference<Counter>] counter, [Request] request, [Reference<Response>] response) {
  counter.hits = counter.hits + 1i32
  response.body.append("ok")
}

[effects(heap_alloc, net_io)]
hold_turn([Reference<Counter>] counter, [Request] request, [Reference<Response>] response) {
  [i32] peer{connectLoopback(counter.holdPort, 60000i32)}
  [String mut] byte{String{}}
  byte.reserve(1i32)
  recv(peer, byte.data, 1u64, 60000i32)
  close(peer)
  response.body.append("held")
}

[return<int> effects(heap_alloc, io_err, net_io, task, lock, channel, atomic) on_error<ServeError, log_serve_error>]
main() {
  [String] workers{envOr(stringFrom("WORKERS"), stringFrom("4"))}
  [String] hold{envOr(stringFrom("HOLD_PORT"), stringFrom("0"))}
  [String] idle{envOr(stringFrom("ACCEPT_TIMEOUT_MS"), stringFrom("200"))}
  [AppRouter<Counter> mut] router{AppRouter<Counter>{Counter{[holdPort] hold.view().parseI32Or(0i32)}}}
  router.get("/count", show_count)
  router.post("/hit", count_hit)
  router.get("/hold", hold_turn)
  [ServerConfig] config{ServerConfig{[port] 0i32, [readTimeoutMs] 60000i32, [maxConnections] 32i32, [loopbackOnly] true,
                                     [acceptTimeoutMs] idle.view().parseI32Or(200i32),
                                     [workers] workers.view().parseI32Or(4i32)}}
  serveWorkers(router, config)?
  return(0i32)
}
