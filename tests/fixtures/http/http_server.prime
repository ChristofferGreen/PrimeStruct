// An HTTP server for the loopback test in tests/unit/backend_host/test_http.cpp: /std/http/server on 127.0.0.1 with a
// free port (printed as "listening on <port>"), small limits and a short read timeout. It stops with exit code 0 on
// SIGTERM. When it cannot listen it prints why and exits with the error code (the test skips when the reason is that
// sockets are not permitted). Build with the net and os shims.
import /std/http/*
import /std/http/server/*
import /std/text/*
import /std/text/view/*

[effects(io_err)]
log_serve_error([ServeError] err) {
  print_line_error(err.why())
}

[return<int> effects(heap_alloc, io_err, net_io) on_error<ServeError, log_serve_error>]
main() {
  [Router mut] router{Router{}}
  router.get("/", Function<void, Request, Reference<Response>>{[]([Request] request, [Reference<Response>] response) {
    response.text(textOf("hello\n"), textOf("text/plain"))
  }})
  router.post("/echo", Function<void, Request, Reference<Response>>{[mut posts{0i32}]([Request] request, [Reference<Response>] response) {
    posts = posts + 1i32
    response.body.appendI64(convert<i64>(posts))
    response.body.append(" ")
    response.body.appendBytes(request.body.data, request.body.count())
  }})
  [ServerConfig] config{ServerConfig{[port] 0i32, [maxRequestBytes] 1024i32, [readTimeoutMs] 300i32,
                                    [acceptTimeoutMs] 200i32, [loopbackOnly] true}}
  serve(router, config)?
  return(0i32)
}
