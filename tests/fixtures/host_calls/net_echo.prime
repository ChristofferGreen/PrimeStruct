// A loopback echo through /std/net in one process, for --emit=optexe with stdlib/std/net/native/net_shim.cpp linked
// (tests/unit/backend_host/test_net.cpp). Exit 0 is success, 77 means sockets are not allowed here (the test skips),
// and every other code names the step that failed. Every call has a timeout, so nothing waits forever.
import /std/collections/*
import /std/net/*

[return<int> effects(heap_alloc, net_io)]
main() {
  [i32] listener{listenLoopback(0i32, 4i32)}
  // EPERM (1) or EACCES (13): a sandbox that forbids sockets.
  if(listener == -101i32 || listener == -113i32) {
    return(77i32)
  }
  if(listener < 0i32) {
    return(1i32)
  }
  if(accept(listener, 50i32) != timeoutCode()) {
    return(2i32)
  }
  [i32] port{localPort(listener)}
  if(port <= 0i32) {
    return(3i32)
  }
  // The kernel queues the connection, so the same thread can accept it next.
  [i32] client{connectLoopback(port, 5000i32)}
  if(client < 0i32) {
    return(4i32)
  }
  [i32] server{accept(listener, 5000i32)}
  if(server < 0i32) {
    return(5i32)
  }
  [vector<u8> mut] message{vector<u8>(104u8, 101u8, 108u8, 108u8, 111u8)}
  [mut] outgoing{message.sliceMut(0i32, 5i32)}
  if(send(client, outgoing.data, 5u64, 5000i32) != 5i64) {
    return(6i32)
  }
  [vector<u8> mut] received{vector<u8>(0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8)}
  [mut] inbox{received.sliceMut(0i32, 8i32)}
  if(recv(server, inbox.data, 8u64, 5000i32) != 5i64) {
    return(7i32)
  }
  [mut] reply{received.sliceMut(0i32, 5i32)}
  if(send(server, reply.data, 5u64, 5000i32) != 5i64) {
    return(8i32)
  }
  [vector<u8> mut] echoed{vector<u8>(0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8)}
  [mut] answer{echoed.sliceMut(0i32, 8i32)}
  if(recv(client, answer.data, 8u64, 5000i32) != 5i64) {
    return(9i32)
  }
  [i32 mut] index{0i32}
  while(index < 5i32) {
    if(echoed[index] != message[index]) {
      return(10i32)
    }
    index = index + 1i32
  }
  // Once the client has closed, the server reads end of stream (0).
  if(close(client) != 0i32) {
    return(11i32)
  }
  if(recv(server, answer.data, 8u64, 5000i32) != 0i64) {
    return(12i32)
  }
  if(close(server) != 0i32 || close(listener) != 0i32) {
    return(13i32)
  }
  // A closed socket reports an error, not a crash.
  if(send(server, outgoing.data, 5u64, 100i32) >= 0i64) {
    return(14i32)
  }
  return(0i32)
}
