// The build graph (docs/BuildSystemPlan.md, docs/spec/stdlib-reference.md, /std/build). A build script calls a `Build`
// to add nodes to a `Graph`: compile steps, executables, static libraries and link edges. Nothing runs while the graph
// is built, and nothing here touches the file system or starts a process; `graph.export()` turns the graph into
// deterministic JSON. Node ids are derived from target names ("exe:app", "lib:core", "link:app>core") and the export
// lists the nodes sorted by id, so the order of the calls that built the graph does not show in the export.
import /std/text/*
import /std/text/view/*
import /std/collections/vector/*
import /std/json/*

// The two host calls behind `Graph.run` (the VM and `--emit=optexe` answer them like the `__pstext_*` text calls): the gate
// counts the calls of the process and says whether this one is the stage the runner asked for, and the stop prints the
// text and ends the process.
[host return<i32>]
__pstext_stage_gate([i32] target) {
}

[host return<i32>]
__pstext_stage_stop([Pointer<u8>] text, [u64] count) {
}

namespace std {
namespace build {

  // The version field of the export; it changes when the shape of the JSON changes.
  [public return<i32> effects(none)]
  export_version() {
    return(1i32)
  }

  // A snapshot of the compiler settings a compile step uses. Copy it and change one setting to get a second
  // configuration of the same program: `[Compiler mut] fast{cc}` then `fast.optimize(2i32)`.
  [public struct]
  Compiler() {
    // The `--emit` kind: "exe", "optexe", "vm", "ir", ...
    [public String mut] emitKind{stringFrom("exe")}
    // The optimization level, as in `-O<level>`.
    [public i32 mut] optimization{0i32}
    // The entry definition, as in `--entry`.
    [public String mut] entryPath{stringFrom("/main")}
    [public vector<String> mut] importPaths{vector<String>{}}
    [public vector<String> mut] transforms{vector<String>{}}
    [public vector<String> mut] defaultEffects{vector<String>{}}
    [public vector<String> mut] linkArgs{vector<String>{}}

    [mut effects(heap_alloc)]
    emit([StringView] kind) {
      this.emitKind = kind.toOwned()
    }

    [mut effects(none)]
    optimize([i32] level) {
      this.optimization = level
    }

    [mut effects(heap_alloc)]
    entry([StringView] path) {
      this.entryPath = path.toOwned()
    }

    // Adds an import path, as in `-I`; the order of the calls is the order of the search.
    [mut effects(heap_alloc)]
    importPath([StringView] path) {
      this.importPaths.push(path.toOwned())
    }

    [mut effects(heap_alloc)]
    transform([StringView] name) {
      this.transforms.push(name.toOwned())
    }

    // Adds an effect to the default effects, as in `--default-effects`.
    [mut effects(heap_alloc)]
    defaultEffect([StringView] name) {
      this.defaultEffects.push(name.toOwned())
    }

    // Adds an argument for the native link step, as in `--link-arg`.
    [mut effects(heap_alloc)]
    linkArg([StringView] arg) {
      this.linkArgs.push(arg.toOwned())
    }

    // The settings as one JSON object.
    [return<String> effects(heap_alloc)]
    toJson() {
      [Writer mut] json{Writer{}}
      this.write(json)
      return(json.out.view().toOwned())
    }

    [effects(heap_alloc)]
    write([Reference<Writer>] json) {
      json.beginObject()
      json.key("emit")
      json.stringValue(this.emitKind.view())
      json.key("optimize")
      json.i64Value(convert<i64>(this.optimization))
      json.key("entry")
      json.stringValue(this.entryPath.view())
      json.key("import_paths")
      this.writeImportPaths(json)
      json.key("transforms")
      this.writeTransforms(json)
      json.key("default_effects")
      this.writeDefaultEffects(json)
      json.key("link_args")
      this.writeLinkArgs(json)
      json.endObject()
    }

    // Each list as a JSON array of strings, in order. They are methods of their own because a vector cannot be the
    // parameter of a real call: one shared writer function would be inlined into every caller.
    [effects(heap_alloc)]
    writeImportPaths([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.importPaths.count(), i++) {
      json.stringValue(this.importPaths[i].view())
    }
    json.endArray()
    }

    [effects(heap_alloc)]
    writeTransforms([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.transforms.count(), i++) {
      json.stringValue(this.transforms[i].view())
    }
    json.endArray()
    }

    [effects(heap_alloc)]
    writeDefaultEffects([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.defaultEffects.count(), i++) {
      json.stringValue(this.defaultEffects[i].view())
    }
    json.endArray()
    }

    [effects(heap_alloc)]
    writeLinkArgs([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.linkArgs.count(), i++) {
      json.stringValue(this.linkArgs[i].view())
    }
    json.endArray()
    }
  }

  // One node of the graph. `kind` is "compile", "executable", "library" or "link". A compile step, an executable and
  // a library carry a compiler snapshot, a source file and an output name; a link edge names the executable and the
  // library it links. `runnable` is true for every node this runner executes.
  [public struct]
  Node() {
    [public String mut] id{String{}}
    [public String mut] kind{String{}}
    [public String mut] name{String{}}
    [public String mut] source{String{}}
    [public String mut] output{String{}}
    [public String mut] fromId{String{}}
    [public String mut] toId{String{}}
    [public bool mut] runnable{true}
    // The compiler snapshot of the target as JSON text, made when the target was added (empty for a link edge).
    [public String mut] compilerJson{String{}}
    // The directories whose listings the target depends on (`Build.watch`), sorted bytewise and without duplicates.
    [public vector<String> mut] inputDirs{vector<String>{}}
    // A function step (`Build.step`): the path of the definition the runner runs (the file is `source`), the files it
    // reads (relative to the project) and the files it writes (relative to the output directory).
    [public String mut] functionPath{String{}}
    [public vector<String> mut] inputs{vector<String>{}}
    [public vector<String> mut] outputs{vector<String>{}}
    // The ids of the steps this one waits for (`Build.after`), sorted bytewise and without duplicates.
    [public vector<String> mut] afterIds{vector<String>{}}

    [return<bool> effects(none)]
    isLink() {
      return(this.kind.equalsText("link"))
    }

    [return<bool> effects(none)]
    isFunction() {
      return(this.kind.equalsText("function"))
    }

    [effects(heap_alloc)]
    write([Reference<Writer>] json) {
      json.beginObject()
      json.key("id")
      json.stringValue(this.id.view())
      json.key("kind")
      json.stringValue(this.kind.view())
      if(this.isLink()) {
        json.key("from")
        json.stringValue(this.fromId.view())
        json.key("to")
        json.stringValue(this.toId.view())
      } else {
        json.key("name")
        json.stringValue(this.name.view())
        json.key("source")
        json.stringValue(this.source.view())
        if(this.isFunction()) {
          json.key("function")
          json.stringValue(this.functionPath.view())
          json.key("inputs")
          this.writeInputs(json)
          json.key("outputs")
          this.writeOutputs(json)
        } else {
          json.key("output")
          json.stringValue(this.output.view())
        }
        if(this.compilerJson.count() > 0i32) {
          json.key("compiler")
          json.rawValue(this.compilerJson.view())
        }
        if(this.inputDirs.count() > 0i32) {
          json.key("inputDirs")
          this.writeInputDirs(json)
        }
        if(this.afterIds.count() > 0i32) {
          json.key("after")
          this.writeAfter(json)
        }
      }
      json.key("runnable")
      json.boolValue(this.runnable)
      json.endObject()
    }

    [effects(heap_alloc)]
    writeInputs([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.inputs.count(), i++) {
      json.stringValue(this.inputs[i].view())
    }
    json.endArray()
    }

    [effects(heap_alloc)]
    writeOutputs([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.outputs.count(), i++) {
      json.stringValue(this.outputs[i].view())
    }
    json.endArray()
    }

    [effects(heap_alloc)]
    writeInputDirs([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.inputDirs.count(), i++) {
      json.stringValue(this.inputDirs[i].view())
    }
    json.endArray()
    }

    [effects(heap_alloc)]
    writeAfter([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.afterIds.count(), i++) {
      json.stringValue(this.afterIds[i].view())
    }
    json.endArray()
    }

    // This node alone as JSON text (the order of nodes with the same id is decided by it).
    [return<String> effects(heap_alloc)]
    render() {
      [Writer mut] json{Writer{}}
      this.write(json)
      return(json.out.view().toOwned())
    }
  }

  // The four parts as one text.
  [return<String> effects(heap_alloc)]
  problem_text([StringView] head, [StringView] first, [StringView] middle, [StringView] second) {
    [String mut] text{head.toOwned()}
    text.appendBytes(first.data, first.count())
    text.appendBytes(middle.data, middle.count())
    text.appendBytes(second.data, second.count())
    return(text)
  }

  // Inserts `item` into the sorted `items`, bytewise, unless it is there already (the vector is rebuilt: see TODO-6010).
  [effects(heap_alloc)]
  insert_sorted_unique([vector<String> mut] items, [String copy] item) {
    [i32 mut] slot{0i32}
    [bool mut] found{false}
    [bool mut] searching{true}
    while(searching && slot < items.count()) {
      [String] existing{items[slot]}
      [i32] order{existing.view().compare(item.view())}
      if(order == 0i32) {
        found = true
        searching = false
      } else {
        if(order < 0i32) {
          slot = slot + 1i32
        } else {
          searching = false
        }
      }
    }
    if(found) {
      return()
    }
    [vector<String> mut] merged{vector<String>{}}
    for([i32 mut] i{0i32}, i < slot, i++) {
      [String] headItem{items[i]}
      merged.push(headItem)
    }
    merged.push(item)
    for([i32 mut] i{slot}, i < items.count(), i++) {
      [String] tailItem{items[i]}
      merged.push(tailItem)
    }
    items.clear()
    for([i32 mut] i{0i32}, i < merged.count(), i++) {
      [String] moved{merged[i]}
      items.push(moved)
    }
  }

  // True when `text` is a decimal i32: an optional minus sign, then one to ten digits, within the i32 range.
  [return<bool> effects(none)]
  is_i32_text([String] text) {
    [i32 mut] start{0i32}
    if(text.count() > 0i32 && text.byteAt(0i32) == 45u8) {
      start = 1i32
    }
    [i32] digits{text.count() - start}
    if(digits < 1i32 || digits > 10i32) {
      return(false)
    }
    [i64 mut] value{0i64}
    for([i32 mut] i{start}, i < text.count(), i++) {
      [u8] byte{text.byteAt(i)}
      if(byte < 48u8 || byte > 57u8) {
        return(false)
      }
      value = value * 10i64 + convert<i64>(byte - 48u8)
    }
    if(start == 1i32) {
      return(value <= 2147483648i64)
    }
    return(value <= 2147483647i64)
  }

  // One option a script declared with `Build.option`: its name, type ("bool", "i32" or "String"), default and description
  // as text, the value this run gave it (`primec build --option name=value`, else the default) and the problem with the
  // value that was given, if any (the value is then the default).
  [public struct]
  OptionDecl() {
    [public String mut] name{String{}}
    [public String mut] kind{String{}}
    [public String mut] defaultText{String{}}
    [public String mut] description{String{}}
    [public String mut] value{String{}}
    [public String mut] problem{String{}}

    // Sets `value` from `argument`, the whole `name=value` text the runner passed (empty when the option was not given).
    [mut effects(heap_alloc)]
    resolve([String] argument) {
      this.value = this.defaultText
      if(argument.count() == 0i32) {
        return()
      }
      [String] given{argument.substr(this.name.count() + 1i32, argument.count())}
      if(this.kind.equalsText("bool")) {
        if(given.equalsText("true") || given.equalsText("false")) {
          this.value = given
        } else {
          this.problem = problem_text("expects true or false, got \"", given.view(), "\"", "")
        }
        return()
      }
      if(this.kind.equalsText("i32")) {
        if(is_i32_text(given)) {
          this.value = given
        } else {
          this.problem = problem_text("expects a 32-bit integer, got \"", given.view(), "\"", "")
        }
        return()
      }
      this.value = given
    }

    [effects(heap_alloc)]
    write([Reference<Writer>] json) {
      json.beginObject()
      json.key("name")
      json.stringValue(this.name.view())
      json.key("type")
      json.stringValue(this.kind.view())
      json.key("default")
      json.stringValue(this.defaultText.view())
      json.key("description")
      json.stringValue(this.description.view())
      json.key("value")
      json.stringValue(this.value.view())
      if(this.problem.count() > 0i32) {
        json.key("error")
        json.stringValue(this.problem.view())
      }
      json.endObject()
    }
  }

  // The whole `name=value` argument of the program for option `name` (the runner passes the options after the stage
  // number, from argument 2 on), or an empty String when the option was not given.
  [return<String> effects(heap_alloc)]
  option_argument([StringView] name) {
    [String] prefix{problem_text("", name, "=", "")}
    [String mut] found{String{}}
    [bool mut] searching{true}
    for([i32 mut] i{2i32}, searching && i < 4096i32, i++) {
      [String] argument{argumentText(i)}
      if(argument.count() == 0i32) {
        searching = false
      } else {
        if(argument.view().startsWith(prefix.view())) {
          found = argument
          searching = false
        }
      }
    }
    return(found)
  }

  // The indices of `options` ordered by name, bytewise.
  [return<vector<i32>> effects(heap_alloc)]
  sorted_option_order([Reference<vector<OptionDecl>>] options) {
    [vector<i32> mut] order{vector<i32>{}}
    for([i32 mut] i{0i32}, i < options.count(), i++) {
      [i32 mut] slot{order.count()}
      order.push(i)
      [String] mine{options[i].name}
      [bool mut] shifting{true}
      while(shifting && slot > 0i32) {
        // The names are copied into locals: a view of a vector element would not outlive the expression that made it.
        [String] other{options[order[slot - 1i32]].name}
        if(mine.view().compare(other.view()) < 0i32) {
          order[slot] = order[slot - 1i32]
          slot = slot - 1i32
        } else {
          shifting = false
        }
      }
      order[slot] = i
    }
    return(order)
  }

  // The nodes of a build, in the order they were added; `export` is the only reader that matters.
  [public struct]
  Graph() {
    [public vector<Node> mut] nodes{vector<Node>{}}
    // Problems found while the graph was built (a `watch` that names a missing target), in call order.
    [public vector<String> mut] buildProblems{vector<String>{}}
    // The folders `Build.subproject` named, sorted bytewise and without duplicates. The runner (`primec build`) runs
    // each folder's `make.prime` and merges its graph under that folder's name; the graph value only records them.
    [public vector<String> mut] subprojectDirs{vector<String>{}}
    // The options `Build.option` declared, with the values of this run; exported sorted by name.
    [public vector<OptionDecl> mut] options{vector<OptionDecl>{}}
    // The indices of `nodes` in export order, filled by `sortNodes`.
    [vector<i32> mut] order{vector<i32>{}}

    // Records an option. Declaring a name again with the same type and default is one declaration; with another type or
    // default it is a problem of the export.
    [mut effects(heap_alloc)]
    addOption([OptionDecl copy] decl) {
      for([i32 mut] i{0i32}, i < this.options.count(), i++) {
        [String] existing{this.options[i].name}
        if(existing.view().equals(decl.name.view())) {
          [bool] same{this.options[i].kind.view().equals(decl.kind.view()) && this.options[i].defaultText.view().equals(decl.defaultText.view())}
          if(!same) {
            this.buildProblems.push(problem_text("option ", decl.name.view(), " is declared twice with a different type or default", ""))
          }
          return()
        }
      }
      this.options.push(decl)
    }

    [return<i32> effects(none)]
    nodeCount() {
      return(this.nodes.count())
    }

    // True when some node is a function step: only the runner can execute the graph (the export says so).
    [return<bool> effects(none)]
    hasFunctionStep() {
      for([i32 mut] i{0i32}, i < this.nodes.count(), i++) {
        if(this.nodes[i].isFunction()) {
          return(true)
        }
      }
      return(false)
    }

    [mut effects(heap_alloc)]
    add([Node copy] node) {
      this.nodes.push(node)
    }

    // True when the node at `left` sorts before the node at `right`: by id, then by their JSON text, so even a graph with
    // two nodes of one id (which the export reports) exports the same whatever the order of the calls.
    [return<bool> effects(heap_alloc)]
    sortsBefore([i32] left, [i32] right) {
      [i32] byId{this.nodes[left].id.view().compare(this.nodes[right].id.view())}
      if(byId != 0i32) {
        return(byId < 0i32)
      }
      [String] leftText{this.nodes[left].render()}
      [String] rightText{this.nodes[right].render()}
      return(leftText.view().compare(rightText.view()) < 0i32)
    }

    // Fills `order` with the indices of `nodes` in export order.
    [mut effects(heap_alloc)]
    sortNodes() {
      this.order.clear()
      for([i32 mut] i{0i32}, i < this.nodes.count(), i++) {
        [i32 mut] slot{this.order.count()}
        this.order.push(i)
        while(slot > 0i32 && this.sortsBefore(i, this.order[slot - 1i32])) {
          this.order[slot] = this.order[slot - 1i32]
          slot = slot - 1i32
        }
        this.order[slot] = i
      }
    }

    [effects(heap_alloc)]
    writeSubprojects([Reference<Writer>] json) {
    json.beginArray()
    for([i32 mut] i{0i32}, i < this.subprojectDirs.count(), i++) {
      json.stringValue(this.subprojectDirs[i].view())
    }
    json.endArray()
    }

    // True when some node has the id `id`.
    [return<bool> effects(none)]
    hasNode([StringView] id) {
      for([i32 mut] i{0i32}, i < this.nodes.count(), i++) {
        [String] candidate{this.nodes[i].id}
        if(candidate.view().equals(id)) {
          return(true)
        }
      }
      return(false)
    }

    // The nodes in export order, as the elements of a JSON array.
    [effects(heap_alloc)]
    writeNodes([Reference<Writer>] json) {
      for([i32 mut] i{0i32}, i < this.order.count(), i++) {
        this.nodes[this.order[i]].write(json)
      }
    }

    // The index of the first node with the id `id`, or -1.
    [return<i32> effects(none)]
    indexOfNode([StringView] id) {
      for([i32 mut] i{0i32}, i < this.nodes.count(), i++) {
        [String] candidate{this.nodes[i].id}
        if(candidate.view().equals(id)) {
          return(i)
        }
      }
      return(-1i32)
    }

    // True when every step that node `index` waits for and that exists is marked in `done`.
    [return<bool> effects(none)]
    waitsOnlyForDone([i32] index, [Reference<vector<i32>>] done) {
      for([i32 mut] i{0i32}, i < this.nodes[index].afterIds.count(), i++) {
        [String] dependency{this.nodes[index].afterIds[i]}
        [i32] found{this.indexOfNode(dependency.view())}
        if(found >= 0i32 && done[found] == 0i32) {
          return(false)
        }
      }
      return(true)
    }

    // The problems of the `after` edges: a step that waits for an id that is not in the graph, and every step that is in
    // a cycle of edges or waits behind one (a step is done when everything it waits for is; what never is done is named).
    [effects(heap_alloc)]
    writeAfterProblems([Reference<Writer>] json) {
      [vector<i32> mut] done{vector<i32>{}}
      for([i32 mut] i{0i32}, i < this.nodes.count(), i++) {
        done.push(0i32)
      }
      [bool mut] progress{true}
      while(progress) {
        progress = false
        for([i32 mut] i{0i32}, i < this.nodes.count(), i++) {
          if(done[i] == 0i32 && this.waitsOnlyForDone(i, done)) {
            done[i] = 1i32
            progress = true
          }
        }
      }
      for([i32 mut] i{0i32}, i < this.order.count(), i++) {
        [i32] index{this.order[i]}
        [String] id{this.nodes[index].id}
        for([i32 mut] j{0i32}, j < this.nodes[index].afterIds.count(), j++) {
          [String] dependency{this.nodes[index].afterIds[j]}
          if(!this.hasNode(dependency.view())) {
            json.stringValue(problem_text("step ", id.view(), " waits for a missing step ", dependency.view()).view())
          }
        }
        if(done[index] == 0i32) {
          json.stringValue(problem_text("step ", id.view(), " is in a cycle of after edges or waits behind one", "").view())
        }
      }
    }

    // The problems of a graph, in node order: every id that two nodes share and every link edge that names a target that
    // is not in the graph. `order` is the export order of `nodes`.
    [effects(heap_alloc)]
    writeProblems([Reference<Writer>] json) {
      for([i32 mut] i{0i32}, i < this.order.count(), i++) {
        // The ids are copied into locals: a view of a vector element would not outlive the expression that made it.
        [String] id{this.nodes[this.order[i]].id}
        if(i > 0i32) {
          [String] previous{this.nodes[this.order[i - 1i32]].id}
          [bool] repeated{previous.view().equals(id.view())}
          if(repeated) {
            json.stringValue(problem_text("duplicate id ", id.view(), "", "").view())
          }
        }
        if(this.nodes[this.order[i]].isLink()) {
          [String] fromId{this.nodes[this.order[i]].fromId}
          [String] toId{this.nodes[this.order[i]].toId}
          [bool] hasExecutable{this.hasNode(fromId.view())}
          if(!hasExecutable) {
            json.stringValue(problem_text("link ", id.view(), " names a missing executable ", fromId.view()).view())
          }
          [bool] hasLibrary{this.hasNode(toId.view())}
          if(!hasLibrary) {
            json.stringValue(problem_text("link ", id.view(), " names a missing library ", toId.view()).view())
          }
        }
      }
    }

    // The graph as JSON: {"version":1,"nodes":[...],"problems":[...]}. Nodes are sorted by id. `problems` lists, in
    // that order, every id that two nodes share and every link edge that names a target that is not in the graph; a
    // graph with problems still exports, so a tool can show them. There are no hashes: those belong to the runner.
    [return<String> effects(heap_alloc)]
    export() {
      return(this.exportStage(false))
    }

    // Runs this graph now (docs/BuildSystemPlan.md section 3): the build stage that the script has reached. The runner
    // starts the script once per stage, giving the number of the stage it wants. A `run` before that stage returns at
    // once, because the runner built it already; the call of the wanted stage writes the export of this graph with
    // `"incomplete":true` and ends the script, so nothing after it runs (a `--dry-run` shows exactly that). Without a
    // stage number (the script runs as a plain program) it does nothing. A script that calls it must declare the
    // effect `build_run`, which the build profile grants to the root script.
    [effects(build_run, heap_alloc)]
    run() {
      [i32] decision{__pstext_stage_gate(stage_target())}
      if(decision == 1i32) {
        [String] text{this.exportStage(true)}
        [i32] stopped{__pstext_stage_stop(text.data, convert<u64>(text.count()))}
      }
    }

    // `export`, with `"incomplete":true` after the problems when `incomplete` is set: later stages follow.
    [return<String> effects(heap_alloc)]
    exportStage([bool] incomplete) {
      // The sort fills the `order` cache, a field, so it runs on a copy of the graph: an export reads this graph and
      // changes nothing in it, and a script holds its graph in a binding that is not `mut`.
      [Graph mut] sorted{this}
      sorted.sortNodes()
      [Writer mut] json{Writer{}}
      json.beginObject()
      json.key("version")
      json.i64Value(convert<i64>(export_version()))
      json.key("nodes")
      json.beginArray()
      sorted.writeNodes(json)
      json.endArray()
      json.key("problems")
      json.beginArray()
      sorted.writeProblems(json)
      sorted.writeAfterProblems(json)
      for([i32 mut] i{0i32}, i < this.buildProblems.count(), i++) {
        json.stringValue(this.buildProblems[i].view())
      }
      json.endArray()
      if(this.hasFunctionStep()) {
        json.key("selfContained")
        json.boolValue(false)
      }
      if(this.subprojectDirs.count() > 0i32) {
        json.key("subprojects")
        this.writeSubprojects(json)
      }
      if(this.options.count() > 0i32) {
        [vector<i32>] optionOrder{sorted_option_order(this.options)}
        json.key("options")
        json.beginArray()
        for([i32 mut] i{0i32}, i < optionOrder.count(), i++) {
          this.options[optionOrder[i]].write(json)
        }
        json.endArray()
      }
      if(incomplete) {
        json.key("incomplete")
        json.boolValue(true)
      }
      json.endObject()
      return(json.out.view().toOwned())
    }
  }

  // The stage the runner asked for: the first program argument as a number, or -1 when there is none.
  [return<i32> effects(heap_alloc)]
  stage_target() {
    [String] text{argumentText(1i32)}
    if(text.count() == 0i32) {
      return(-1i32)
    }
    [i32 mut] value{0i32}
    for([i32 mut] i{0i32}, i < text.count(), i++) {
      value = value * 10i32 + convert<i32>(text.byteAt(i) - 48u8)
    }
    return(value)
  }

  // `prefix` and `name` as one id.
  [return<String> effects(heap_alloc)]
  derive_id([StringView] prefix, [StringView] name) {
    [String mut] id{prefix.toOwned()}
    id.appendBytes(name.data, name.count())
    return(id)
  }

  // What a script receives: it creates compilers and adds targets, then returns `b.graph()`.
  [public struct]
  Build() {
    [Graph mut] collected{Graph{}}

    // A compiler with the defaults: emit "exe", no optimization, entry "/main", no paths, transforms, effects or link
    // arguments.
    [return<Compiler> effects(heap_alloc)]
    compiler() {
      return(Compiler{})
    }

    [mut effects(heap_alloc)]
    addTarget([StringView] prefix, [StringView] kind, [StringView] name, [Compiler copy] settings, [StringView] source) {
      [Node mut] node{Node{}}
      node.id = derive_id(prefix, name)
      node.kind = kind.toOwned()
      node.name = name.toOwned()
      node.source = source.toOwned()
      node.output = name.toOwned()
      node.compilerJson = settings.toJson()
      this.collected.add(node)
    }

    // A compile step named `name` that compiles `source` with the settings `cc` had at this call (id "compile:<name>").
    [mut effects(heap_alloc)]
    compile([StringView] name, [Compiler copy] cc, [StringView] source) {
      this.addTarget("compile:", "compile", name, cc, source)
    }

    // A compile step whose output is an executable (id "exe:<name>").
    [mut effects(heap_alloc)]
    executable([StringView] name, [Compiler copy] cc, [StringView] source) {
      this.addTarget("exe:", "executable", name, cc, source)
    }

    // A copy step (id "copy:<name>", docs/BuildSystemPlan.md section 3): the runner copies the file `from` (relative to the
    // project) to `to` inside the output directory, removing the target first so the copy is a new file (the kernel keeps
    // the signature of the pages of an old one). It runs in the runner, not in the compiler; it is cached by the content
    // hash of the source and of the copy, so an unchanged source is not copied again. The destination must stay inside the
    // output directory.
    [mut effects(heap_alloc)]
    copy([StringView] name, [StringView] from, [StringView] to) {
      [Node mut] node{Node{}}
      node.id = derive_id("copy:", name)
      node.kind = stringFrom("copy")
      node.name = name.toOwned()
      node.source = from.toOwned()
      node.output = to.toOwned()
      this.collected.add(node)
    }

    // A function step (id "step:<name>", docs/BuildSystemPlan.md section 4): the runner compiles the file `source` (relative
    // to the project) and runs the definition `function` (a path such as "/generate", taking no arguments and returning
    // i32; 0 is success) in its own process on a VM thread, next to the other steps. `inputs` are the files of the project it
    // reads and `outputs` the files it writes, relative to the output directory; the step writes them with
    // `/std/build_step` `write_output`, which refuses a path outside that directory. The graph is no longer
    // self-contained (the export says `"selfContained":false`): a plain program cannot run it.
    [mut effects(heap_alloc)]
    step([StringView] name, [vector<String>] inputs, [vector<String>] outputs, [StringView] source, [StringView] function) {
      [Node mut] node{Node{}}
      node.id = derive_id("step:", name)
      node.kind = stringFrom("function")
      node.name = name.toOwned()
      node.source = source.toOwned()
      node.functionPath = function.toOwned()
      for([i32 mut] i{0i32}, i < inputs.count(), i++) {
        [String] item{inputs[i]}
        node.inputs.push(item)
      }
      for([i32 mut] i{0i32}, i < outputs.count(), i++) {
        [String] item{outputs[i]}
        node.outputs.push(item)
      }
      if(outputs.count() == 0i32) {
        this.collected.buildProblems.push(problem_text("step ", name, " declares no outputs", ""))
      }
      this.collected.add(node)
    }

    // A static library target (id "lib:<name>", output "<name>.psa"): the runner compiles `source` with `--emit=lib`
    // whatever `cc` says, into the output directory. An executable or another library that names it with `link` or
    // `linkLibrary` is compiled against it, after it is built.
    [mut effects(heap_alloc)]
    library([StringView] name, [Compiler copy] cc, [StringView] source) {
      [Compiler mut] settings{cc}
      settings.emit("lib")
      [Node mut] node{Node{}}
      node.id = derive_id("lib:", name)
      node.kind = stringFrom("library")
      node.name = name.toOwned()
      node.source = source.toOwned()
      node.output = name.toOwned()
      node.output.append(".psa")
      node.compilerJson = settings.toJson()
      this.collected.add(node)
    }

    // The dependency of the executable `executableName` on the library `libraryName` (id "link:<exe>><lib>"). The
    // targets may be added before or after the edge; a name that never appears is reported by `export`.
    [mut effects(heap_alloc)]
    link([StringView] executableName, [StringView] libraryName) {
      [Node mut] node{Node{}}
      node.fromId = derive_id("exe:", executableName)
      node.toId = derive_id("lib:", libraryName)
      node.id = problem_text("link:", executableName, ">", libraryName)
      node.kind = stringFrom("link")
      this.collected.add(node)
    }

    // The dependency of the library `libraryName` on the library `dependencyName` (id "link:lib:<lib>><dependency>"): the
    // library is compiled against the other (`--emit=lib --library`), which its manifest records, and everything that
    // links the library links the dependency too. Libraries that link in a cycle are a problem of the build.
    [mut effects(heap_alloc)]
    linkLibrary([StringView] libraryName, [StringView] dependencyName) {
      [Node mut] node{Node{}}
      node.fromId = derive_id("lib:", libraryName)
      node.toId = derive_id("lib:", dependencyName)
      node.id = problem_text("link:lib:", libraryName, ">", dependencyName)
      node.kind = stringFrom("link")
      this.collected.add(node)
    }

    // Makes the step `targetId` ("compile:generated") start only when the step `dependencyId` ("step:gen") has finished
    // successfully (docs/BuildSystemPlan.md section 4); two steps of one stage otherwise run in parallel. Call it after the
    // target is added; a target that does not exist is a problem of the export, and so are a dependency that does not
    // exist and a cycle. The edges are kept sorted and without duplicates.
    [mut effects(heap_alloc)]
    after([StringView] targetId, [StringView] dependencyId) {
      [bool mut] found{false}
      for([i32 mut] i{0i32}, i < this.collected.nodes.count(), i++) {
        [String] nodeId{this.collected.nodes[i].id}
        if(nodeId.view().equals(targetId)) {
          found = true
          [String] dependency{dependencyId.toOwned()}
          insert_sorted_unique(this.collected.nodes[i].afterIds, dependency)
        }
      }
      if(!found) {
        this.collected.buildProblems.push(problem_text("after names a missing target ", targetId, "", ""))
      }
    }

    // Declares that the target `targetId` ("compile:app") depends on the listings of the directories `dirs`: pass the
    // `listed` vector of a `/std/glob` `glob` call, so a file that appears in or disappears from one of them runs the step
    // again (docs/spec/integration-and-tooling.md, build cache). Call it after the target is added; a target that does not
    // exist is a problem of the export. The directories are kept sorted and without duplicates.
    [mut effects(heap_alloc)]
    watch([StringView] targetId, [vector<String>] dirs) {
      [bool mut] found{false}
      for([i32 mut] i{0i32}, i < this.collected.nodes.count(), i++) {
        [String] nodeId{this.collected.nodes[i].id}
        if(nodeId.view().equals(targetId)) {
          found = true
          for([i32 mut] j{0i32}, j < dirs.count(), j++) {
            [String] dir{dirs[j]}
            insert_sorted_unique(this.collected.nodes[i].inputDirs, dir)
          }
        }
      }
      if(!found) {
        this.collected.buildProblems.push(problem_text("watch names a missing target ", targetId, "", ""))
      }
    }

    // Includes the graph of `<dir>/make.prime` (docs/BuildSystemPlan.md section 7). Nothing runs here: the export lists
    // the folder under `"subprojects"` and `primec build` runs that script (without the `build_run` effect, so it cannot
    // run steps), then merges its nodes with ids prefixed by `<dir>/` and every path of the nodes relative to the project.
    // A folder named twice is one inclusion.
    [mut effects(heap_alloc)]
    subproject([StringView] dir) {
      [String] owned{dir.toOwned()}
      insert_sorted_unique(this.collected.subprojectDirs, owned)
    }

    // Declares the option `name` and returns its value: `primec build --option name=value` when given, else the default.
    // The type is the type of the default (bool, i32 or String); a value that is not of that type is a diagnostic of
    // `primec build`. Every script of a build (the project's, its subprojects' and each stage) sees the same options.
    // The options and their values are listed in the export, and `primec build --list-options` prints them.
    [mut return<String> effects(heap_alloc)]
    declareOption([StringView] name, [StringView] kind, [StringView] defaultText, [StringView] description) {
      [OptionDecl mut] decl{OptionDecl{}}
      decl.name = name.toOwned()
      decl.kind = kind.toOwned()
      decl.defaultText = defaultText.toOwned()
      decl.description = description.toOwned()
      [String] argument{option_argument(name)}
      decl.resolve(argument)
      [String] resolved{decl.value}
      this.collected.addOption(decl)
      return(resolved)
    }

    [mut return<bool> effects(heap_alloc)]
    option([StringView] name, [bool] defaultValue, [StringView] description) {
      [String] resolved{this.declareOption(name, "bool", if(defaultValue, then() { "true" }, else() { "false" }), description)}
      return(resolved.equalsText("true"))
    }

    [mut return<bool> effects(heap_alloc)]
    option([StringView] name, [bool] defaultValue) {
      return(this.option(name, defaultValue, ""))
    }

    [mut return<i32> effects(heap_alloc)]
    option([StringView] name, [i32] defaultValue, [StringView] description) {
      [String mut] defaultText{String{}}
      defaultText.appendI64Radix(convert<i64>(defaultValue), 10i32)
      [String] resolved{this.declareOption(name, "i32", defaultText.view(), description)}
      [i32 mut] result{0i32}
      [bool] negative{resolved.count() > 0i32 && resolved.byteAt(0i32) == 45u8}
      for([i32 mut] i{if(negative, then() { 1i32 }, else() { 0i32 })}, i < resolved.count(), i++) {
        result = result * 10i32 + convert<i32>(resolved.byteAt(i) - 48u8) * if(negative, then() { -1i32 }, else() { 1i32 })
      }
      return(result)
    }

    [mut return<i32> effects(heap_alloc)]
    option([StringView] name, [i32] defaultValue) {
      return(this.option(name, defaultValue, ""))
    }

    [mut return<String> effects(heap_alloc)]
    option([StringView] name, [string] defaultValue, [StringView] description) {
      return(this.declareOption(name, "String", textOf(defaultValue), description))
    }

    [mut return<String> effects(heap_alloc)]
    option([StringView] name, [string] defaultValue) {
      return(this.option(name, defaultValue, ""))
    }

    // The graph built so far, as a value.
    [return<Graph> effects(heap_alloc)]
    graph() {
      return(this.collected)
    }
  }

}
}
