// Process environment, a monotonic clock and a stop flag for long-running programs (docs/spec/stdlib-reference.md,
// /std/os). The host side is the POSIX shim next to this file: build with
//   primec --emit=optexe app.prime -o app --link-arg <stdlib>/std/os/os_posix.cpp
// The shim installs SIGTERM and SIGINT handlers when the program starts: they set the stop flag and do not restart
// interrupted system calls, so a blocking socket call returns and the program can check stopRequested().

import /std/text/*

[host return<String>]
ps_os_env_or([String] name, [String] fallback) {
}

[host return<i64>]
ps_os_monotonic_ms() {
}

[host return<bool>]
ps_os_stop_requested() {
}

[host return<i32>]
ps_os_stop_signal_fd() {
}

[host return<i32>]
ps_os_cpu_count() {
}

[host return<i32>]
ps_os_block_stop_signals() {
}

[host return<i32>]
ps_os_log_line([String] line) {
}

[host return<i64>]
ps_os_file_size([String] path) {
}

[host return<i64>]
ps_os_read_file([String] path, [Pointer<u8>] buffer, [u64] capacity) {
}

// Fills `count` bytes at `buffer` from the operating system's entropy; 0, or -100 - errno.
[host return<i32>]
ps_os_random_bytes([Pointer<u8>] buffer, [u64] count) {
}

namespace std {
namespace os {

  // The value of environment variable `name`, or `fallback` when it is not set.
  [public return<String> effects(none)]
  envOr([String] name, [String] fallback) {
    return(ps_os_env_or(name, fallback))
  }

  // Milliseconds on a clock that never goes backwards (not wall-clock time); differences measure elapsed time.
  [public return<i64> effects(none)]
  monotonicMs() {
    return(ps_os_monotonic_ms())
  }

  // Whether the process has received SIGTERM or SIGINT.
  [public return<bool> effects(none)]
  stopRequested() {
    return(ps_os_stop_requested())
  }

  // A descriptor that is readable from the moment the process has received SIGTERM or SIGINT and stays readable,
  // whichever thread the signal was delivered to: a loop that waits in /std/net `poll` watches it while
  // `stopRequested()` is false, and then no signal can arrive unseen between its check and its wait. Do not read
  // from it or close it. A negative code when it cannot be opened.
  [public return<i32> effects(none)]
  stopSignalFd() {
    return(ps_os_stop_signal_fd())
  }

  // How many processors are online, at least 1: how many threads can run at once.
  [public return<i32> effects(none)]
  cpuCount() {
    return(ps_os_cpu_count())
  }

  // Blocks SIGTERM and SIGINT on the calling thread, for the worker tasks of a program whose main thread waits for
  // the signal in a blocking call: the signal then interrupts that call instead of a worker's. A signal that arrives
  // before the call may still be delivered to the worker; a loop that must not miss it watches `stopSignalFd()`.
  // Returns 0 or a negative code.
  [public return<i32> effects(none)]
  blockStopSignals() {
    return(ps_os_block_stop_signals())
  }

  // Writes `line` and a line feed to stderr at once (stderr is not buffered), for logs a supervisor reads as they
  // happen. Returns the bytes written, or -1.
  [public return<i32> effects(none)]
  logLine([String] line) {
    return(ps_os_log_line(line))
  }


  // `byteCount` (1 to 64) random bytes from the operating system's entropy (`getentropy`), as lower-case hex: twice as
  // many digits. An empty String when the call fails or `byteCount` is outside 1..64. It is the OS's cryptographic
  // generator, so it is fine for a session id. The result is built on the heap, so it takes `heap_alloc`.
  [public return<String> effects(heap_alloc)]
  randomHex([i32] byteCount) {
    [String mut] hex{String{}}
    if(byteCount < 1i32 || byteCount > 64i32) {
      return(hex)
    }
    [String mut] raw{String{}}
    raw.reserve(byteCount)
    if(ps_os_random_bytes(raw.data, convert<u64>(byteCount)) != 0i32) {
      return(hex)
    }
    raw.fieldLength = byteCount
    hex.reserve(byteCount * 2i32)
    [i32 mut] index{0i32}
    while(index < byteCount) {
      [i32] byte{convert<i32>(raw.byteAt(index))}
      [i32] high{byte / 16i32}
      hex.pushByte(hex_digit(high))
      hex.pushByte(hex_digit(byte - high * 16i32))
      index = index + 1i32
    }
    return(hex)
  }

  // The lower-case hex digit of `value`, 0 to 15.
  [return<u8> effects(none)]
  hex_digit([i32] value) {
    if(value < 10i32) {
      return(convert<u8>(48i32 + value))
    }
    return(convert<u8>(87i32 + value))
  }

  // The size in bytes of the regular file at `path`, or a negative code: -100 - errno when it cannot be read, -1 when
  // it is not a regular file.
  [public return<i64> effects(file_read)]
  fileSize([String] path) {
    return(ps_os_file_size(path))
  }

  // Replaces the contents of `out` with the file at `path`. Returns 0, -2 when the file is larger than `maxBytes`, or
  // the negative code of `fileSize` (-1 for a non-regular file such as a directory) / -100 - errno of a failed read. Binary safe; no text conversion.
  [public return<i32> effects(file_read, heap_alloc)]
  readFile([String] path, [String mut] out, [i32] maxBytes) {
    [i64] size{ps_os_file_size(path)}
    if(size < 0i64) {
      return(convert<i32>(size))
    }
    if(size > convert<i64>(maxBytes)) {
      return(-2i32)
    }
    [i32] wanted{convert<i32>(size)}
    out.clear()
    out.reserve(wanted)
    [i64] got{ps_os_read_file(path, out.data, convert<u64>(wanted))}
    if(got < 0i64) {
      return(convert<i32>(got))
    }
    out.fieldLength = convert<i32>(got)
    // Rewrites the byte after the text as the NUL terminator.
    out.pushByte(0u8)
    out.popByte()
    return(0i32)
  }

}
}
