// Process environment, a monotonic clock and a stop flag for long-running programs (docs/spec/stdlib-reference.md,
// /std/os). The host side is the POSIX shim next to this file: build with
//   primec --emit=optexe app.prime -o app --link-arg <stdlib>/std/os/os_posix.cpp
// The shim installs SIGTERM and SIGINT handlers when the program starts: they set the stop flag and do not restart
// interrupted system calls, so a blocking socket call returns and the program can check stopRequested().

import /std/text/*

[host return<String>]
ps_os_env_or([String] name, [String] fallback) {
}

[host return<i64>]
ps_os_monotonic_ms() {
}

[host return<bool>]
ps_os_stop_requested() {
}

[host return<i32>]
ps_os_cpu_count() {
}

[host return<i32>]
ps_os_block_stop_signals() {
}

[host return<i32>]
ps_os_log_line([String] line) {
}

[host return<i64>]
ps_os_file_size([String] path) {
}

[host return<i64>]
ps_os_read_file([String] path, [Pointer<u8>] buffer, [u64] capacity) {
}

namespace std {
namespace os {

  // The value of environment variable `name`, or `fallback` when it is not set.
  [public return<String>]
  envOr([String] name, [String] fallback) {
    return(ps_os_env_or(name, fallback))
  }

  // Milliseconds on a clock that never goes backwards (not wall-clock time); differences measure elapsed time.
  [public return<i64>]
  monotonicMs() {
    return(ps_os_monotonic_ms())
  }

  // Whether the process has received SIGTERM or SIGINT.
  [public return<bool>]
  stopRequested() {
    return(ps_os_stop_requested())
  }

  // How many processors are online, at least 1: how many threads can run at once.
  [public return<i32>]
  cpuCount() {
    return(ps_os_cpu_count())
  }

  // Blocks SIGTERM and SIGINT on the calling thread, for the worker tasks of a program whose main thread waits for
  // the signal in a blocking call: the signal then interrupts that call instead of a worker's. Returns 0 or a
  // negative code.
  [public return<i32>]
  blockStopSignals() {
    return(ps_os_block_stop_signals())
  }

  // Writes `line` and a line feed to stderr at once (stderr is not buffered), for logs a supervisor reads as they
  // happen. Returns the bytes written, or -1.
  [public return<i32>]
  logLine([String] line) {
    return(ps_os_log_line(line))
  }


  // The size in bytes of the regular file at `path`, or a negative code: -100 - errno when it cannot be read, -1 when
  // it is not a regular file.
  [public return<i64> effects(file_read)]
  fileSize([String] path) {
    return(ps_os_file_size(path))
  }

  // Replaces the contents of `out` with the file at `path`. Returns 0, -2 when the file is larger than `maxBytes`, or
  // the negative code of `fileSize` (-1 for a non-regular file such as a directory) / -100 - errno of a failed read. Binary safe; no text conversion.
  [public return<i32> effects(file_read, heap_alloc)]
  readFile([String] path, [String mut] out, [i32] maxBytes) {
    [i64] size{ps_os_file_size(path)}
    if(size < 0i64) {
      return(convert<i32>(size))
    }
    if(size > convert<i64>(maxBytes)) {
      return(-2i32)
    }
    [i32] wanted{convert<i32>(size)}
    out.clear()
    out.reserve(wanted)
    [i64] got{ps_os_read_file(path, out.data, convert<u64>(wanted))}
    if(got < 0i64) {
      return(convert<i32>(got))
    }
    out.fieldLength = convert<i32>(got)
    // Rewrites the byte after the text as the NUL terminator.
    out.pushByte(0u8)
    out.popByte()
    return(0i32)
  }

}
}
