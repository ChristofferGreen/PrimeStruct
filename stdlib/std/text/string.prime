// Owned UTF-8 text (docs/spec/strings-and-views.md, `String`). The bytes live in blocks of the VM's
// string heap, which the `__pstext_*` host functions below reach (the VM answers them itself; they
// need no binding). A block always holds one byte more than the text, so the text is NUL terminated,
// and `capacity()` is the block size less that byte.

import /std/panic/*

namespace std {
  namespace text {
  [host return<Pointer<u8>>]
  __pstext_alloc([u64] size) {
  }

  [host return<Pointer<u8>>]
  __pstext_try_alloc([u64] size) {
  }

  [host return<void>]
  __pstext_free([Pointer<u8>] block) {
  }

  [host return<u64>]
  __pstext_capacity([Pointer<u8>] block) {
  }

  [host return<u64>]
  __pstext_stat([u64] which) {
  }

  [host return<void>]
  __pstext_set_limit([u64] bytes) {
  }

  [host return<void>]
  __pstext_arena_begin() {
  }

  [host return<void>]
  __pstext_arena_end() {
  }

  // The entry argument at `index` (0 is the program name) copied into a fresh block; empty text when
  // there is no such argument.
  [host return</std/text/String>]
  __pstext_argument([i32] index) {
  }

  // Bulk byte operations over text blocks and other byte regions (the VM and the optimized C++ backend range-check
  // them once per call; the arm64 native backend runs plain loops). A count of 0 touches nothing.
  // move: copies `count` bytes, source and destination may overlap.
  [host return<void>]
  __pstext_move([Pointer<u8>] destination, [Pointer<u8>] source, [u64] count) {
  }

  // The address of a string literal's bytes (std/text/view.prime): `append` copies from it in one bulk move, one
  // range check per call, where a loop of `textStore` checked every byte (a few-byte `replace` costs more that way).
  [host return<Pointer<u8>>]
  __pstext_literal([string] text) {
  }

  // fill: sets `count` bytes to the low byte of `value`.
  [host return<void>]
  __pstext_fill([Pointer<u8>] destination, [u64] value, [u64] count) {
  }

  // compare: -1, 0 or 1 by the first differing byte (unsigned) of `count` bytes.
  [host return<i32>]
  __pstext_compare([Pointer<u8>] a, [Pointer<u8>] b, [u64] count) {
  }

  // find: the index of the first of `count` bytes equal to the low byte of `value`, or -1.
  [host return<i32>]
  __pstext_find([Pointer<u8>] address, [u64] count, [u64] value) {
  }

  // f64 to text with std::to_chars: the length of the text (-1 for a precision to_chars cannot do), written to
  // `destination` when `capacity` holds it. Style 0 shortest round trip (f64), 1 fixed and 2 scientific with
  // `precision` digits, 3 shortest round trip as an f32. The VM and the optimized C++ runtime answer it.
  [host return<i32>]
  __pstext_format_f64([f64] value, [i32] style, [i32] precision, [Pointer<u8>] destination, [u64] capacity) {
  }

  [unsafe return<void>]
  textStore([Pointer<u8> mut] block, [i32] index, [u8] value) {
    [Pointer<u8> mut] slot{/std/intrinsics/memory/at_unsafe(block, index)}
    *slot = value
  }

  [unsafe return<u8>]
  textLoad([Pointer<u8>] block, [i32] index) {
    return(*(/std/intrinsics/memory/at_unsafe(block, index)))
  }

  // The bulk operations with i32 counts: a count of 0 or less touches nothing (compare gives 0, find gives -1).
  [return<void>]
  moveBytes([Pointer<u8>] destination, [Pointer<u8>] source, [i32] count) {
    if(count > 0i32) {
      __pstext_move(destination, source, convert<u64>(count))
    }
  }

  [return<void>]
  fillBytes([Pointer<u8>] destination, [u8] value, [i32] count) {
    if(count > 0i32) {
      __pstext_fill(destination, convert<u64>(value), convert<u64>(count))
    }
  }

  [return<i32>]
  compareBytes([Pointer<u8>] a, [Pointer<u8>] b, [i32] count) {
    if(count <= 0i32) {
      return(0i32)
    }
    return(__pstext_compare(a, b, convert<u64>(count)))
  }

  [return<i32>]
  findByte([Pointer<u8>] address, [i32] count, [u8] value) {
    if(count <= 0i32) {
      return(-1i32)
    }
    return(__pstext_find(address, convert<u64>(count), convert<u64>(value)))
  }

  // The address `index` bytes into a block.
  [unsafe return<Pointer<u8>>]
  textAddress([Pointer<u8>] block, [i32] index) {
    return(/std/intrinsics/memory/at_unsafe(block, index))
  }

  // The usable bytes of a block for text (the block less its NUL byte).
  [return<i32>]
  textBlockCapacity([Pointer<u8>] block) {
    return(convert<i32>(__pstext_capacity(block)) - 1i32)
  }

  // Whether `index` lies between two code points of the `count` bytes at `data`, or at either end. Text is UTF-8, so a
  // byte of the form 10xxxxxx (128 to 191) continues a code point and is no place to cut.
  [return<bool>]
  isCodePointBoundary([Pointer<u8>] data, [i32] count, [i32] index) {
    if(index < 0i32 || index > count) {
      return(false)
    }
    if(index == 0i32 || index == count) {
      return(true)
    }
    return(convert<i32>(textLoad(data, index)) / 64i32 != 2i32)
  }

  // The code point that starts at `offset` in valid UTF-8 (an i32: code points stop at 0x10FFFF).
  [return<i32>]
  codePointAtBytes([Pointer<u8>] data, [i32] offset, [i32] count) {
    if(offset < 0i32 || offset >= count || !isCodePointBoundary(data, count, offset)) {
      panic(offset)
    }
    [i32] lead{convert<i32>(textLoad(data, offset))}
    [i32] width{if(lead < 192i32, then() { 1i32 }, else() { if(lead < 224i32, then() { 2i32 }, else() { if(lead < 240i32, then() { 3i32 }, else() { 4i32 }) }) })}
    if(offset + width > count) {
      panic(offset)
    }
    if(width == 1i32) {
      return(lead)
    }
    [i32 mut] value{lead - (if(width == 2i32, then() { 192i32 }, else() { if(width == 3i32, then() { 224i32 }, else() { 240i32 }) }))}
    for([i32 mut] k{1i32}, k < width, k++) {
      value = value * 64i32 + (convert<i32>(textLoad(data, offset + k)) - 128i32)
    }
    return(value)
  }

  [public struct sendable]
  String() {
    [public i32 mut] fieldLength{0i32}
    [public i32 mut] fieldCapacity{0i32}
    [public Pointer<u8> mut] data{__pstext_alloc(0u64)}
    [bool mut] ownsData{false}

    [return<i32>]
    count() {
      return(this.fieldLength)
    }

    [return<bool>]
    empty() {
      return(this.fieldLength == 0i32)
    }

    [return<i32>]
    capacity() {
      return(this.fieldCapacity)
    }

    [return<u8>]
    byteAt([i32] index) {
      if(index < 0i32 || index >= this.fieldLength) {
        panic(index)
      }
      return(textLoad(this.data, index))
    }

    [return<bool>]
    equalsText([string] text) {
      if(text.count() != this.fieldLength) {
        return(false)
      }
      for([i32 mut] i{0i32}, i < this.fieldLength, i++) {
        if(convert<i32>(textLoad(this.data, i)) != at(text, i)) {
          return(false)
        }
      }
      return(true)
    }

    // Moves the text into a block that holds at least `capacityWanted` bytes (and the NUL). Text
    // that already fits does not move.
    [mut effects(heap_alloc)]
    reserve([i32] capacityWanted) {
      if(capacityWanted < 0i32 || capacityWanted > 1073741823i32) {
        panic(capacityWanted)
      }
      if(capacityWanted > this.fieldCapacity) {
        this.moveToBlock(capacityWanted)
      }
    }

    // Moves the text to the smallest block that holds it.
    [mut effects(heap_alloc)]
    shrinkToFit() {
      if(this.ownsData) {
        if(this.fieldLength == 0i32) {
          __pstext_free(this.data)
          this.data = __pstext_alloc(0u64)
          this.fieldCapacity = 0i32
          this.ownsData = false
        } else {
          [Pointer<u8>] smaller{__pstext_alloc(convert<u64>(this.fieldLength) + 1u64)}
          if(textBlockCapacity(smaller) < this.fieldCapacity) {
            __pstext_move(smaller, this.data, convert<u64>(this.fieldLength))
            __pstext_free(this.data)
            this.data = smaller
            this.fieldCapacity = textBlockCapacity(smaller)
          } else {
            __pstext_free(smaller)
          }
        }
      }
    }

    [mut effects(heap_alloc)]
    moveToBlock([i32] capacityWanted) {
      this.adoptBlock(__pstext_alloc(convert<u64>(capacityWanted) + 1u64))
    }

    // Copies the text into `block` (a fresh text block) and frees the block it held.
    [mut effects(heap_alloc)]
    adoptBlock([Pointer<u8>] block) {
      if(this.fieldLength > 0i32) {
        __pstext_move(block, this.data, convert<u64>(this.fieldLength))
      }
      if(this.ownsData) {
        __pstext_free(this.data)
      }
      this.data = block
      this.fieldCapacity = textBlockCapacity(block)
      this.ownsData = true
    }

    // Capacity for `extra` more bytes: doubling, rounded up to the block size.
    [mut effects(heap_alloc)]
    growFor([i32] extra) {
      if(extra < 0i32 || extra > 1073741823i32 - this.fieldLength) {
        panic(extra)
      }
      [i32] needed{this.fieldLength + extra}
      if(needed > this.fieldCapacity) {
        [i32 mut] wanted{this.fieldCapacity * 2i32}
        if(wanted < needed) {
          wanted = needed
        }
        if(wanted > 1073741823i32) {
          wanted = 1073741823i32
        }
        this.moveToBlock(wanted)
      }
    }

    // Like reserve, but returns false instead of faulting when the string memory limit (or the
    // heap) cannot supply the block; the string is unchanged then.
    [mut effects(heap_alloc), return<bool>]
    tryReserve([i32] capacityWanted) {
      if(capacityWanted < 0i32 || capacityWanted > 1073741823i32) {
        return(false)
      }
      if(capacityWanted <= this.fieldCapacity) {
        return(true)
      }
      [Pointer<u8>] block{__pstext_try_alloc(convert<u64>(capacityWanted) + 1u64)}
      if(__pstext_capacity(block) == 0u64) {
        return(false)
      }
      this.adoptBlock(block)
      return(true)
    }

    // The byte after the text: always 0 (an empty string with no storage reports 0 too).
    [return<u8>]
    terminator() {
      if(this.ownsData) {
        return(textLoad(this.data, this.fieldLength))
      }
      return(0u8)
    }

    [mut]
    clear() {
      this.fieldLength = 0i32
      if(this.ownsData) {
        textStore(this.data, 0i32, 0u8)
      }
    }

    [mut effects(heap_alloc)]
    pushByte([u8] value) {
      this.growFor(1i32)
      textStore(this.data, this.fieldLength, value)
      this.fieldLength = this.fieldLength + 1i32
      textStore(this.data, this.fieldLength, 0u8)
    }

    // Appends the UTF-8 encoding of a code point; a surrogate or a value past U+10FFFF stops the program.
    [mut effects(heap_alloc)]
    pushCodePoint([i32] point) {
      if(point < 0i32 || point > 1114111i32 || (point >= 55296i32 && point <= 57343i32)) {
        panic(point)
      }
      if(point < 128i32) {
        this.pushByte(convert<u8>(point))
        return()
      }
      if(point < 2048i32) {
        this.pushByte(convert<u8>(192i32 + point / 64i32))
        this.pushByte(convert<u8>(128i32 + (point - point / 64i32 * 64i32)))
        return()
      }
      [i32] mid{point / 64i32}
      if(point < 65536i32) {
        this.pushByte(convert<u8>(224i32 + point / 4096i32))
        this.pushByte(convert<u8>(128i32 + (mid - mid / 64i32 * 64i32)))
        this.pushByte(convert<u8>(128i32 + (point - mid * 64i32)))
        return()
      }
      [i32] high{mid / 64i32}
      this.pushByte(convert<u8>(240i32 + point / 262144i32))
      this.pushByte(convert<u8>(128i32 + (high - high / 64i32 * 64i32)))
      this.pushByte(convert<u8>(128i32 + (mid - high * 64i32)))
      this.pushByte(convert<u8>(128i32 + (point - mid * 64i32)))
    }

    [mut effects(heap_alloc)]
    append([string] text) {
      [i32] extra{text.count()}
      if(extra > 0i32) {
        this.growFor(extra)
        __pstext_move(textAddress(this.data, this.fieldLength), __pstext_literal(text), convert<u64>(extra))
        this.fieldLength = this.fieldLength + extra
        textStore(this.data, this.fieldLength, 0u8)
      }
    }

    [mut effects(heap_alloc)]
    appendString([Reference<Self>] other) {
      [i32] extra{other.fieldLength}
      if(extra > 0i32) {
        this.growFor(extra)
        __pstext_move(textAddress(this.data, this.fieldLength), other.data, convert<u64>(extra))
        this.fieldLength = this.fieldLength + extra
        textStore(this.data, this.fieldLength, 0u8)
      }
    }

    // Replaces the bytes [start, end) with `text`.
    [mut effects(heap_alloc)]
    replace([i32] start, [i32] end, [string] text) {
      if(start < 0i32 || end < start || end > this.fieldLength) {
        panic(start)
      }
      [i32] inserted{text.count()}
      [i32] removed{end - start}
      [i32] newLength{this.fieldLength - removed + inserted}
      if(newLength > this.fieldCapacity) {
        this.growFor(newLength - this.fieldLength)
      }
      [i32] tailLength{this.fieldLength - end}
      if(inserted != removed && tailLength > 0i32) {
        __pstext_move(textAddress(this.data, start + inserted), textAddress(this.data, end), convert<u64>(tailLength))
      }
      for([i32 mut] i{0i32}, i < inserted, i++) {
        textStore(this.data, start + i, convert<u8>(at(text, i)))
      }
      this.fieldLength = newLength
      if(this.ownsData) {
        textStore(this.data, newLength, 0u8)
      }
    }

    [mut effects(heap_alloc)]
    insert([i32] position, [string] text) {
      this.replace(position, position, text)
    }

    [mut effects(heap_alloc)]
    erase([i32] start, [i32] end) {
      this.replace(start, end, "")
    }

    // A copy of the bytes [start, end).
    [return<String> effects(heap_alloc)]
    substr([i32] start, [i32] end) {
      if(start < 0i32 || end < start || end > this.fieldLength) {
        panic(start)
      }
      [String mut] out{String{}}
      [i32] size{end - start}
      if(size > 0i32) {
        out.reserve(size)
        __pstext_move(out.data, textAddress(this.data, start), convert<u64>(size))
        out.fieldLength = size
        textStore(out.data, size, 0u8)
      }
      return(out)
    }

    // ---- numbers as text ----

    // The digits of `magnitude` in `radix` (2 to 36, lowercase letters), after a minus sign when `negative`.
    [mut effects(heap_alloc)]
    appendDigits([u64] magnitude, [i32] radix, [bool] negative) {
      if(radix < 2i32 || radix > 36i32) {
        panic(radix)
      }
      [u64] base{convert<u64>(radix)}
      [i32 mut] width{1i32}
      [u64 mut] rest{magnitude / base}
      while(rest != 0u64) {
        width = width + 1i32
        rest = rest / base
      }
      [i32] sign{if(negative, then() { 1i32 }, else() { 0i32 })}
      this.growFor(width + sign)
      if(negative) {
        textStore(this.data, this.fieldLength, 45u8)
      }
      [u64 mut] remaining{magnitude}
      for([i32 mut] k{width - 1i32}, k >= 0i32, k--) {
        [u64] digit{remaining - remaining / base * base}
        remaining = remaining / base
        textStore(this.data, this.fieldLength + sign + k, if(digit < 10u64, then() { convert<u8>(48u64 + digit) }, else() { convert<u8>(87u64 + digit) }))
      }
      this.fieldLength = this.fieldLength + width + sign
      textStore(this.data, this.fieldLength, 0u8)
    }

    [mut effects(heap_alloc)]
    appendU64([u64] value) {
      this.appendDigits(value, 10i32, false)
    }

    [mut effects(heap_alloc)]
    appendI64([i64] value) {
      this.appendI64Radix(value, 10i32)
    }

    [mut effects(heap_alloc)]
    appendI64Radix([i64] value, [i32] radix) {
      [bool] negative{value < 0i64}
      this.appendDigits(if(negative, then() { convert<u64>(0i64 - value) }, else() { convert<u64>(value) }), radix, negative)
    }

    [mut effects(heap_alloc)]
    appendU64Radix([u64] value, [i32] radix) {
      this.appendDigits(value, radix, false)
    }

    [mut effects(heap_alloc)]
    appendBool([bool] value) {
      this.append(if(value, then() { "true" }, else() { "false" }))
    }

    // A float as text: shortest text that reads back as the same f64 (as std::to_chars), or with `precision` digits
    // fixed or scientific.
    [mut effects(heap_alloc)]
    appendF64Style([f64] value, [i32] style, [i32] precision) {
      [i32] length{__pstext_format_f64(value, style, precision, this.data, 0u64)}
      if(length < 0i32) {
        panic(precision)
      }
      this.growFor(length)
      __pstext_format_f64(value, style, precision, textAddress(this.data, this.fieldLength), convert<u64>(length))
      this.fieldLength = this.fieldLength + length
      textStore(this.data, this.fieldLength, 0u8)
    }

    [mut effects(heap_alloc)]
    appendF64([f64] value) {
      this.appendF64Style(value, 0i32, 0i32)
    }

    [mut effects(heap_alloc)]
    appendF32([f32] value) {
      this.appendF64Style(convert<f64>(value), 3i32, 0i32)
    }

    [mut effects(heap_alloc)]
    appendF64Fixed([f64] value, [i32] precision) {
      this.appendF64Style(value, 1i32, precision)
    }

    [mut effects(heap_alloc)]
    appendF64Scientific([f64] value, [i32] precision) {
      this.appendF64Style(value, 2i32, precision)
    }

    // ---- more of std::string's editing members ----

    // Appends `count` bytes at `source`. The source must not be inside this String (it may move when the String grows).
    [mut effects(heap_alloc)]
    appendBytes([Pointer<u8>] source, [i32] amount) {
      if(amount > 0i32) {
        this.growFor(amount)
        moveBytes(textAddress(this.data, this.fieldLength), source, amount)
        this.fieldLength = this.fieldLength + amount
        textStore(this.data, this.fieldLength, 0u8)
      }
    }

    // The first and last byte (the program stops on an empty String).
    [return<u8>]
    front() {
      return(this.byteAt(0i32))
    }

    [return<u8>]
    back() {
      return(this.byteAt(this.fieldLength - 1i32))
    }

    // Removes the last byte (the program stops on an empty String).
    [mut]
    popByte() {
      if(this.fieldLength == 0i32) {
        panic(0i32)
      }
      this.fieldLength = this.fieldLength - 1i32
      textStore(this.data, this.fieldLength, 0u8)
    }

    // Removes the last code point and returns it (the program stops on an empty String).
    [mut, return<i32>]
    pop() {
      if(this.fieldLength == 0i32) {
        panic(0i32)
      }
      [i32 mut] start{this.fieldLength - 1i32}
      while(start > 0i32 && convert<i32>(textLoad(this.data, start)) / 64i32 == 2i32) {
        start = start - 1i32
      }
      [i32] point{codePointAtBytes(this.data, start, this.fieldLength)}
      this.fieldLength = start
      textStore(this.data, start, 0u8)
      return(point)
    }

    // Opens a gap of `extra` bytes at `position`: the tail moves up and the length grows; the gap holds stale bytes
    // until the caller fills it.
    [mut effects(heap_alloc)]
    openGap([i32] position, [i32] extra) {
      if(position < 0i32 || position > this.fieldLength || extra < 0i32) {
        panic(position)
      }
      if(extra > 0i32) {
        this.growFor(extra)
        moveBytes(textAddress(this.data, position + extra), textAddress(this.data, position), this.fieldLength - position)
        this.fieldLength = this.fieldLength + extra
        textStore(this.data, this.fieldLength, 0u8)
      }
    }

    // `times` copies of `value` at `position` (std::string::insert(pos, times, ch)).
    [mut effects(heap_alloc)]
    insertFilled([i32] position, [i32] times, [u8] value) {
      this.openGap(position, times)
      fillBytes(textAddress(this.data, position), value, times)
    }

    [mut effects(heap_alloc)]
    insertByte([i32] position, [u8] value) {
      this.insertFilled(position, 1i32, value)
    }

    // `times` copies of `value` at the end (std::string::append(times, ch)).
    [mut effects(heap_alloc)]
    appendFilled([i32] times, [u8] value) {
      this.insertFilled(this.fieldLength, times, value)
    }

    // Replaces the bytes [start, end) with `times` copies of `value`.
    [mut effects(heap_alloc)]
    replaceFilled([i32] start, [i32] end, [i32] times, [u8] value) {
      this.erase(start, end)
      this.insertFilled(start, times, value)
    }

    // The text becomes `times` copies of `value` (std::string::assign(times, ch)).
    [mut effects(heap_alloc)]
    assignFilled([i32] times, [u8] value) {
      this.clear()
      this.appendFilled(times, value)
    }

    // Grows with copies of `value`, or shrinks to `newCount` bytes; a shrink inside a code point stops the program.
    [mut effects(heap_alloc)]
    resize([i32] newCount, [u8] value) {
      if(newCount < 0i32 || newCount > 1073741823i32) {
        panic(newCount)
      }
      if(newCount > this.fieldLength) {
        this.appendFilled(newCount - this.fieldLength, value)
      }
      if(newCount < this.fieldLength) {
        if(!isCodePointBoundary(this.data, this.fieldLength, newCount)) {
          panic(newCount)
        }
        this.fieldLength = newCount
        textStore(this.data, newCount, 0u8)
      }
    }

    // Exchanges the text with another String (no copying).
    [mut]
    swap([Reference<Self>] other) {
      [i32] oldLength{this.fieldLength}
      [i32] oldCapacity{this.fieldCapacity}
      [Pointer<u8>] oldData{this.data}
      [bool] oldOwns{this.ownsData}
      this.fieldLength = other.fieldLength
      this.fieldCapacity = other.fieldCapacity
      this.data = other.data
      this.ownsData = other.ownsData
      other.fieldLength = oldLength
      other.fieldCapacity = oldCapacity
      other.data = oldData
      other.ownsData = oldOwns
    }

    [mut effects(heap_alloc)]
    Copy([Reference<Self>] other) {
      [i32] size{other.fieldLength}
      this.fieldLength = size
      this.fieldCapacity = 0i32
      this.data = __pstext_alloc(0u64)
      this.ownsData = false
      if(size > 0i32) {
        [Pointer<u8>] block{__pstext_alloc(convert<u64>(size) + 1u64)}
        __pstext_move(block, other.data, convert<u64>(size))
        this.data = block
        this.fieldCapacity = textBlockCapacity(block)
        this.ownsData = true
      }
    }

    [mut]
    Move([Reference<Self>] other) {
      this.fieldLength = other.fieldLength
      this.fieldCapacity = other.fieldCapacity
      this.data = other.data
      this.ownsData = other.ownsData
      other.ownsData = false
    }

    [mut effects(heap_alloc)]
    Destroy() {
      if(this.ownsData) {
        __pstext_free(this.data)
        this.ownsData = false
        this.fieldLength = 0i32
        this.fieldCapacity = 0i32
      }
    }
  }

  // std::to_string and friends: a new String holding the number as text.
  [public return<String> effects(heap_alloc)]
  stringFromI32([i32] value) {
    [String mut] out{stringWithCapacity(11i32)}
    out.appendI64(convert<i64>(value))
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromI64([i64] value) {
    [String mut] out{stringWithCapacity(20i32)}
    out.appendI64(value)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromU64([u64] value) {
    [String mut] out{stringWithCapacity(20i32)}
    out.appendU64(value)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromI64Radix([i64] value, [i32] radix) {
    [String mut] out{stringWithCapacity(24i32)}
    out.appendI64Radix(value, radix)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromU64Radix([u64] value, [i32] radix) {
    [String mut] out{stringWithCapacity(24i32)}
    out.appendU64Radix(value, radix)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromBool([bool] value) {
    [String mut] out{stringWithCapacity(5i32)}
    out.appendBool(value)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromF64([f64] value) {
    [String mut] out{stringWithCapacity(24i32)}
    out.appendF64(value)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromF32([f32] value) {
    [String mut] out{stringWithCapacity(16i32)}
    out.appendF32(value)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromF64Fixed([f64] value, [i32] precision) {
    [String mut] out{stringWithCapacity(24i32)}
    out.appendF64Fixed(value, precision)
    return(out)
  }

  [public return<String> effects(heap_alloc)]
  stringFromF64Scientific([f64] value, [i32] precision) {
    [String mut] out{stringWithCapacity(24i32)}
    out.appendF64Scientific(value, precision)
    return(out)
  }

  // A String of `times` copies of `value` (std::string(times, ch)).
  [public return<String> effects(heap_alloc)]
  stringFilled([i32] times, [u8] value) {
    [String mut] out{stringWithCapacity(times)}
    out.appendFilled(times, value)
    return(out)
  }

  // String.from for text: a new String holding a copy of `text`.
  [public effects(heap_alloc), return<String>]
  stringFrom([string] text) {
    [String mut] out{String{}}
    out.append(text)
    return(out)
  }

  // The command-line argument at `index` as a String (index 0 is the program name; empty when there is
  // no such argument).
  [public effects(heap_alloc), return<String>]
  argumentText([i32] index) {
    return(__pstext_argument(index))
  }

  [public effects(heap_alloc), return<String>]
  stringWithCapacity([i32] capacityWanted) {
    [String mut] out{String{}}
    out.reserve(capacityWanted)
    return(out)
  }

  // Memory statistics of the string heap.
  [public return<i32>]
  stringHeapChunks() {
    return(convert<i32>(__pstext_stat(0u64)))
  }

  [public return<u64>]
  stringHeapBytesInUse() {
    return(__pstext_stat(1u64))
  }

  [public return<u64>]
  stringHeapBytesFree() {
    return(__pstext_stat(2u64))
  }

  [public return<i32>]
  stringHeapLargeBlocks() {
    return(convert<i32>(__pstext_stat(3u64)))
  }

  [public return<u64>]
  stringHeapLargeBytes() {
    return(__pstext_stat(4u64))
  }

  // Live allocations of the slot heap (vector buffers, Function boxes): a copy-and-destroy loop that frees what it
  // makes keeps this flat (VM and optexe).
  [public return<i32>]
  heapLiveBlocks() {
    return(convert<i32>(__pstext_stat(8u64)))
  }

  // Blocks handed out since the program started (a test of how many allocations an expression makes).
  [public return<u64>]
  stringHeapAllocations() {
    return(__pstext_stat(5u64))
  }

  // Strings made while a StringArena is open come from a bump region and are all freed when it ends, in O(1) with no
  // per-string free. `[StringArena] arena{beginStringArena()}` opens one that ends when `arena` goes out of scope.
  // Arenas nest, and the memory limit counts their regions. Text made in an arena must not outlive it: its addresses
  // are invalid after the end, so a later use faults (and the checker rejects the plain escapes).
  [public struct]
  StringArena() {
    [public i32 mut] marker{0i32}

    Destroy() {
      __pstext_arena_end()
    }
  }

  [public return<StringArena>]
  beginStringArena() {
    __pstext_arena_begin()
    return(StringArena{})
  }

  // The arenas that are open, and the bytes of blocks their strings hold.
  [public return<i32>]
  stringArenaDepth() {
    return(convert<i32>(__pstext_stat(6u64)))
  }

  [public return<u64>]
  stringArenaBytes() {
    return(__pstext_stat(7u64))
  }

  [public return<void>]
  setStringMemoryLimit([u64] bytes) {
    __pstext_set_limit(bytes)
  }
  }
}
