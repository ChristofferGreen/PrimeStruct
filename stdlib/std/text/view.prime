// A borrowed view of text and everything built on it: search, parsing, formatting, whole-file text, UTF-8 checking
// (docs/spec/strings-and-views.md). It is a module of its own, `import /std/text/view/*`, so that a program that only
// makes Strings (`import /std/text/*`) does not pay to compile it.

import /std/panic/*
import /std/maybe/*
import /std/text/*
import /std/collections/slice/*
import /std/collections/vector/*

namespace std {
  namespace text {
  namespace view {
  // The address of a string literal's bytes (NUL terminated, valid for the whole run): a byte region the VM and the
  // optimized C++ runtime make the first time the literal is asked for. Not on the native backends yet.
  [host return<Pointer<u8>>]
  __pstext_literal([string] text) {
  }

  // SipHash-1-3 of `count` bytes at `address` with a 64-bit seed, the same value on the VM and the optimized C++ runtime.
  [host return<u64>]
  __pstext_hash([Pointer<u8>] address, [u64] count, [u64] seed) {
  }

  // Decimal text to double (C library conversion, correctly rounded): ok is 1 when the `count` bytes at `address` are a
  // number the C library converts to a finite value; parse gives its bits as an f64. The caller checks the grammar.
  // The VM and the optimized C++ runtime answer them; the native backends do not yet.
  [host return<i32>]
  __pstext_f64_ok([Pointer<u8>] address, [u64] count) {
  }

  [host return<f64>]
  __pstext_parse_f64([Pointer<u8>] address, [u64] count) {
  }

  // Whole files, by a path that is a byte range (not necessarily a literal): the size of the file, or minus its errno;
  // the bytes read into `destination` (up to `capacity`), or minus the errno; the bytes written (`append` 0 replaces
  // the file, 1 appends), 0 or minus the errno. The VM and the optimized C++ runtime answer them; the native backends
  // do not yet.
  [host return<i64>]
  __pstext_file_size([Pointer<u8>] path, [u64] pathCount) {
  }

  [host return<i64>]
  __pstext_file_read([Pointer<u8>] path, [u64] pathCount, [Pointer<u8>] destination, [u64] capacity) {
  }

  [host return<i64>]
  __pstext_file_write([Pointer<u8>] path, [u64] pathCount, [Pointer<u8>] source, [u64] count, [u64] append) {
  }

  // A borrowed, read-only view of text: a pointer to its first byte and a byte count (docs/spec/strings-and-views.md).
  // It copies nothing and owns nothing. A literal becomes a view with `textOf("...")`, a String with `s.view()`; the
  // view is valid while that text is not changed or freed.
  [public struct]
  StringView() {
    [public Pointer<u8> mut] data{__pstext_alloc(0u64)}
    [public i32 mut] fieldLength{0i32}

    [return<i32>]
    count() {
      return(this.fieldLength)
    }

    [return<bool>]
    empty() {
      return(this.fieldLength == 0i32)
    }

    [return<u8>]
    byteAt([i32] index) {
      if(index < 0i32 || index >= this.fieldLength) {
        panic(index)
      }
      return(textLoad(this.data, index))
    }

    [return<bool>]
    equals([/std/text/view/StringView] other) {
      if(other.fieldLength != this.fieldLength) {
        return(false)
      }
      return(compareBytes(this.data, other.data, this.fieldLength) == 0i32)
    }

    [return<bool>]
    equalsText([string] text) {
      return(this.equals(textOf(text)))
    }

    // True when `index` lies between two code points, or at either end of the text. Text is UTF-8, so a byte of the
    // form 10xxxxxx (128 to 191) continues a code point and is no place to cut.
    [return<bool>]
    isBoundary([i32] index) {
      if(index < 0i32 || index > this.fieldLength) {
        return(false)
      }
      if(index == 0i32 || index == this.fieldLength) {
        return(true)
      }
      return(convert<i32>(textLoad(this.data, index)) / 64i32 != 2i32)
    }

    // The bytes [start, end) as a view of the same text. A cut inside a code point, or a range outside the text,
    // stops the program.
    [return<StringView>]
    slice([i32] start, [i32] end) {
      if(start < 0i32 || end < start || end > this.fieldLength) {
        panic(start)
      }
      if(!this.isBoundary(start) || !this.isBoundary(end)) {
        panic(start)
      }
      return(StringView{[data] textAddress(this.data, start), [fieldLength] end - start})
    }

    // Copies the text to `destination` (the caller makes sure `count()` bytes fit; no NUL is added).
    [return<void>]
    copyTo([Pointer<u8>] destination) {
      moveBytes(destination, this.data, this.fieldLength)
    }

    // The text as a read view of its bytes.
    [return<ReadSlice<u8>>]
    bytes() {
      return(readSliceMake<u8>(this.data, this.fieldLength))
    }

    // ---- hashing ----

    // A 64-bit hash of the bytes (SipHash-1-3). `hash()` uses a fixed seed, so it is the same on every run; give
    // `hashSeeded` a secret random seed to make a hash table's order unpredictable to whoever picks the keys.
    [return<u64>]
    hashSeeded([u64] seed) {
      return(__pstext_hash(this.data, convert<u64>(this.fieldLength), seed))
    }

    [return<u64>]
    hash() {
      return(__pstext_hash(this.data, convert<u64>(this.fieldLength), 0u64))
    }

    // ---- comparison and search (byte order; UTF-8 sorts by code point) ----

    // -1, 0 or 1: the first differing byte decides, a shorter text that is a prefix sorts first.
    [return<i32>]
    compare([/std/text/view/StringView] other) {
      [i32] common{if(this.fieldLength < other.fieldLength, then() { this.fieldLength }, else() { other.fieldLength })}
      [i32] order{compareBytes(this.data, other.data, common)}
      if(order != 0i32) {
        return(order)
      }
      if(this.fieldLength < other.fieldLength) {
        return(-1i32)
      }
      if(this.fieldLength > other.fieldLength) {
        return(1i32)
      }
      return(0i32)
    }

    [return<bool>]
    startsWith([/std/text/view/StringView] prefix) {
      if(prefix.fieldLength > this.fieldLength) {
        return(false)
      }
      return(compareBytes(this.data, prefix.data, prefix.fieldLength) == 0i32)
    }

    [return<bool>]
    endsWith([/std/text/view/StringView] suffix) {
      if(suffix.fieldLength > this.fieldLength) {
        return(false)
      }
      return(compareBytes(textAddress(this.data, this.fieldLength - suffix.fieldLength), suffix.data, suffix.fieldLength) == 0i32)
    }

    // The index of the first byte equal to `value`, or -1.
    [return<i32>]
    indexOfByte([u8] value) {
      return(findByte(this.data, this.fieldLength, value))
    }

    // The index of the first place `needle` occurs at or after `from`, or -1. The empty needle occurs at `from`.
    // Linear time (Crochemore-Perrin two-way matching; a single byte uses a byte scan).
    [return<i32>]
    indexOfFrom([/std/text/view/StringView] needle, [i32] from) {
      return(textIndexOfFrom(this.data, this.fieldLength, needle.data, needle.fieldLength, from))
    }

    [return<i32>]
    indexOf([/std/text/view/StringView] needle) {
      return(textIndexOfFrom(this.data, this.fieldLength, needle.data, needle.fieldLength, 0i32))
    }

    // The index of the last place `needle` occurs, or -1.
    [return<i32>]
    lastIndexOf([/std/text/view/StringView] needle) {
      return(textLastIndexOf(this.data, this.fieldLength, needle.data, needle.fieldLength))
    }

    [return<bool>]
    contains([/std/text/view/StringView] needle) {
      return(this.indexOf(needle) >= 0i32)
    }

    // ---- byte-set search (std::string::find_first_of and friends): the index, or -1 ----

    // The first byte at or after `from` that is one of the bytes of `set`.
    [return<i32>]
    findFirstOfFrom([/std/text/view/StringView] set, [i32] from) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, from, true, false))
    }

    [return<i32>]
    findFirstOf([/std/text/view/StringView] set) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, 0i32, true, false))
    }

    // The first byte at or after `from` that is none of the bytes of `set`.
    [return<i32>]
    findFirstNotOfFrom([/std/text/view/StringView] set, [i32] from) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, from, false, false))
    }

    [return<i32>]
    findFirstNotOf([/std/text/view/StringView] set) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, 0i32, false, false))
    }

    // The last byte at or before `upTo` (an index; use count() - 1 for the whole text) that is one of the bytes of `set`.
    [return<i32>]
    findLastOfFrom([/std/text/view/StringView] set, [i32] upTo) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, upTo, true, true))
    }

    [return<i32>]
    findLastOf([/std/text/view/StringView] set) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, this.fieldLength - 1i32, true, true))
    }

    [return<i32>]
    findLastNotOfFrom([/std/text/view/StringView] set, [i32] upTo) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, upTo, false, true))
    }

    [return<i32>]
    findLastNotOf([/std/text/view/StringView] set) {
      return(textFindOfSet(this.data, this.fieldLength, set.data, set.fieldLength, this.fieldLength - 1i32, false, true))
    }

    // A copy of the text that owns its bytes.
    [return<String> effects(heap_alloc)]
    toOwned() {
      [String mut] out{stringWithCapacity(this.fieldLength)}
      out.appendBytes(this.data, this.fieldLength)
      return(out)
    }

    // The pieces between separators as owned Strings (the owned counterpart of splitCount/splitPart).
    [return<vector<String>> effects(heap_alloc)]
    splitOwned([/std/text/view/StringView] separator) {
      [vector<String> mut] pieces{vector<String>{}}
      [i32] total{this.splitCount(separator)}
      for([i32 mut] n{0i32}, n < total, n++) {
        [StringView] piece{this.splitPart(separator, n)}
        pieces.push(piece.toOwned())
      }
      return(pieces)
    }

    // A String with every non-overlapping `from` replaced by `to`, scanning left to right; an empty `from` changes nothing.
    [return<String> effects(heap_alloc)]
    replaceAll([/std/text/view/StringView] from, [/std/text/view/StringView] to) {
      [String mut] out{stringWithCapacity(this.fieldLength)}
      [i32 mut] cursor{0i32}
      if(from.fieldLength > 0i32) {
        while(cursor <= this.fieldLength) {
          [i32] hit{textIndexOfFrom(this.data, this.fieldLength, from.data, from.fieldLength, cursor)}
          if(hit < 0i32) {
            out.appendBytes(textAddress(this.data, cursor), this.fieldLength - cursor)
            return(out)
          }
          out.appendBytes(textAddress(this.data, cursor), hit - cursor)
          out.appendBytes(to.data, to.fieldLength)
          cursor = hit + from.fieldLength
        }
      }
      out.appendBytes(textAddress(this.data, cursor), this.fieldLength - cursor)
      return(out)
    }

    // ---- the same searches as a Maybe (none when absent) ----

    [return<Maybe<i32>>]
    find([/std/text/view/StringView] needle) {
      [i32] at{textIndexOfFrom(this.data, this.fieldLength, needle.data, needle.fieldLength, 0i32)}
      if(at < 0i32) {
        return(none<i32>())
      }
      return(some<i32>(at))
    }

    [return<Maybe<i32>>]
    rfind([/std/text/view/StringView] needle) {
      [i32] at{textLastIndexOf(this.data, this.fieldLength, needle.data, needle.fieldLength)}
      if(at < 0i32) {
        return(none<i32>())
      }
      return(some<i32>(at))
    }

    // The first and last byte, or none for empty text.
    [return<Maybe<u8>>]
    first() {
      if(this.fieldLength == 0i32) {
        return(none<u8>())
      }
      return(some<u8>(textLoad(this.data, 0i32)))
    }

    [return<Maybe<u8>>]
    last() {
      if(this.fieldLength == 0i32) {
        return(none<u8>())
      }
      return(some<u8>(textLoad(this.data, this.fieldLength - 1i32)))
    }

    // ---- trimming (ASCII white space: space, tab, line feed, vertical tab, form feed, carriage return) ----

    [return<StringView>]
    trimStart() {
      [i32 mut] start{0i32}
      while(start < this.fieldLength && isAsciiSpace(textLoad(this.data, start))) {
        start = start + 1i32
      }
      return(StringView{[data] textAddress(this.data, start), [fieldLength] this.fieldLength - start})
    }

    [return<StringView>]
    trimEnd() {
      [i32 mut] end{this.fieldLength}
      while(end > 0i32 && isAsciiSpace(textLoad(this.data, end - 1i32))) {
        end = end - 1i32
      }
      return(StringView{[data] this.data, [fieldLength] end})
    }

    [return<StringView>]
    trim() {
      return(this.trimStart().trimEnd())
    }

    // ---- pieces: views of this text between separators ----

    // How many pieces `splitPart` has: one more than the separators (a non-empty separator).
    [return<i32>]
    splitCount([/std/text/view/StringView] separator) {
      if(separator.fieldLength == 0i32) {
        return(1i32)
      }
      [i32 mut] pieces{1i32}
      [i32 mut] from{0i32}
      while(from <= this.fieldLength) {
        [i32] at{this.indexOfFrom(separator, from)}
        if(at < 0i32) {
          return(pieces)
        }
        pieces = pieces + 1i32
        from = at + separator.fieldLength
      }
      return(pieces)
    }

    // Piece `n` (from 0): the text between the n-th and the next separator. An empty separator gives the whole text.
    [return<StringView>]
    splitPart([/std/text/view/StringView] separator, [i32] n) {
      if(n < 0i32) {
        panic(n)
      }
      [i32 mut] start{0i32}
      if(separator.fieldLength == 0i32) {
        if(n != 0i32) {
          panic(n)
        }
        return(this.slice(0i32, this.fieldLength))
      }
      for([i32 mut] i{0i32}, i < n, i++) {
        [i32] at{this.indexOfFrom(separator, start)}
        if(at < 0i32) {
          panic(n)
        }
        start = at + separator.fieldLength
      }
      [i32] stop{this.indexOfFrom(separator, start)}
      return(this.slice(start, if(stop < 0i32, then() { this.fieldLength }, else() { stop })))
    }

    // Lines end at a line feed; a carriage return before it is not part of the line, and there is no empty
    // line after a final line feed. The empty text has no lines.
    [return<i32>]
    lineCount() {
      if(this.fieldLength == 0i32) {
        return(0i32)
      }
      [i32 mut] lines{0i32}
      [i32 mut] from{0i32}
      while(from < this.fieldLength) {
        [i32] at{findByte(textAddress(this.data, from), this.fieldLength - from, 10u8)}
        lines = lines + 1i32
        if(at < 0i32) {
          return(lines)
        }
        from = from + at + 1i32
      }
      return(lines)
    }

    [return<StringView>]
    lineAt([i32] n) {
      if(n < 0i32) {
        panic(n)
      }
      [i32 mut] start{0i32}
      for([i32 mut] i{0i32}, i < n, i++) {
        [i32] at{findByte(textAddress(this.data, start), this.fieldLength - start, 10u8)}
        if(at < 0i32) {
          panic(n)
        }
        start = start + at + 1i32
      }
      if(start >= this.fieldLength) {
        panic(n)
      }
      [i32] lineBreak{findByte(textAddress(this.data, start), this.fieldLength - start, 10u8)}
      [i32 mut] end{if(lineBreak < 0i32, then() { this.fieldLength }, else() { start + lineBreak })}
      if(end > start && textLoad(this.data, end - 1i32) == 13u8) {
        end = end - 1i32
      }
      return(StringView{[data] textAddress(this.data, start), [fieldLength] end - start})
    }

    // ---- numbers (no value when the text is not exactly a number) ----

    // An optional sign then decimal digits, nothing else, in range: stores the value in `out` and returns true;
    // otherwise returns false and leaves `out` alone. (Maybe-valued forms wait on TODO-5642 and the 64-bit payload.)
    [return<bool>]
    parseI64Into([i64 mut] out) {
      return(textParseI64(this.data, this.fieldLength, out))
    }

    // Digits of `radix` (2 to 36, either case) with an optional sign.
    [return<bool>]
    parseI64RadixInto([i32] radix, [i64 mut] out) {
      return(textParseI64Radix(this.data, this.fieldLength, radix, out))
    }

    // Unsigned digits of `radix` (no sign), up to 2^64 - 1.
    [return<bool>]
    parseU64RadixInto([i32] radix, [u64 mut] out) {
      [u64 mut] magnitude{0u64}
      [bool mut] negative{false}
      if(!textParseInteger(this.data, this.fieldLength, radix, false, magnitude, negative)) {
        return(false)
      }
      out = magnitude
      return(true)
    }

    [return<bool>]
    parseU64Into([u64 mut] out) {
      return(this.parseU64RadixInto(10i32, out))
    }

    [return<u64>]
    parseU64Or([u64] fallback) {
      [u64 mut] value{fallback}
      if(this.parseU64Into(value)) {
        return(value)
      }
      return(fallback)
    }

    [return<i64>]
    parseI64Or([i64] fallback) {
      [i64 mut] value{fallback}
      if(this.parseI64Into(value)) {
        return(value)
      }
      return(fallback)
    }

    // Like parseI64Into, for a value that fits an i32.
    [return<bool>]
    parseI32Into([i32 mut] out) {
      [i64 mut] wide{0i64}
      if(!textParseI64(this.data, this.fieldLength, wide)) {
        return(false)
      }
      if(wide < -2147483648i64 || wide > 2147483647i64) {
        return(false)
      }
      out = convert<i32>(wide)
      return(true)
    }

    // A plain decimal number: an optional sign, digits with an optional fraction (or a fraction alone), and an optional
    // exponent. No white space, no hexadecimal form, no inf or nan. Stores the value in `out` and returns true; false
    // (leaving `out`) for other text or a value too large for an f64.
    [return<bool>]
    parseF64Into([f64 mut] out) {
      if(!isDecimalNumber(this.data, this.fieldLength)) {
        return(false)
      }
      if(__pstext_f64_ok(this.data, convert<u64>(this.fieldLength)) == 0i32) {
        return(false)
      }
      out = __pstext_parse_f64(this.data, convert<u64>(this.fieldLength))
      return(true)
    }

    [return<f64>]
    parseF64Or([f64] fallback) {
      [f64 mut] value{fallback}
      if(this.parseF64Into(value)) {
        return(value)
      }
      return(fallback)
    }

    // The value as a Maybe: none unless the text is exactly an i32.
    [return<Maybe<i32>>]
    parseI32() {
      [i64 mut] wide{0i64}
      if(!textParseI64(this.data, this.fieldLength, wide)) {
        return(none<i32>())
      }
      if(wide < -2147483648i64 || wide > 2147483647i64) {
        return(none<i32>())
      }
      return(some<i32>(convert<i32>(wide)))
    }

    [return<i32>]
    parseI32Or([i32] fallback) {
      [i32 mut] value{fallback}
      if(this.parseI32Into(value)) {
        return(value)
      }
      return(fallback)
    }

    // ---- code points ----

    // The width in bytes of the code point that starts at `offset` (1 to 4), from its lead byte; `offset` must be a
    // boundary inside the text.
    [return<i32>]
    codePointLength([i32] offset) {
      if(offset < 0i32 || offset >= this.fieldLength || !this.isBoundary(offset)) {
        panic(offset)
      }
      [i32] lead{convert<i32>(textLoad(this.data, offset))}
      if(lead < 192i32) {
        return(1i32)
      }
      if(lead < 224i32) {
        return(2i32)
      }
      if(lead < 240i32) {
        return(3i32)
      }
      return(4i32)
    }

    // The code point that starts at `offset` (at most 0x10FFFF, so an i32; there is no u32 type yet). The text is
    // valid UTF-8 (a String or a checked view).
    [return<i32>]
    codePointAt([i32] offset) {
      [i32] width{this.codePointLength(offset)}
      if(offset + width > this.fieldLength) {
        panic(offset)
      }
      [i32] lead{convert<i32>(textLoad(this.data, offset))}
      if(width == 1i32) {
        return(lead)
      }
      [i32 mut] value{lead - (if(width == 2i32, then() { 192i32 }, else() { if(width == 3i32, then() { 224i32 }, else() { 240i32 }) }))}
      for([i32 mut] k{1i32}, k < width, k++) {
        value = value * 64i32 + (convert<i32>(textLoad(this.data, offset + k)) - 128i32)
      }
      return(value)
    }

    // How many code points the text holds: the bytes that are not continuation bytes.
    [return<i32>]
    codePointCount() {
      [i32 mut] total{0i32}
      for([i32 mut] i{0i32}, i < this.fieldLength, i++) {
        if(convert<i32>(textLoad(this.data, i)) / 64i32 != 2i32) {
          total = total + 1i32
        }
      }
      return(total)
    }

    // ---- ASCII case (bytes 128 and up are left alone) ----

    [return<String> effects(heap_alloc)]
    toAsciiLower() {
      [String mut] out{stringWithCapacity(this.fieldLength)}
      for([i32 mut] i{0i32}, i < this.fieldLength, i++) {
        [u8] byte{textLoad(this.data, i)}
        out.pushByte(if(byte >= 65u8 && byte <= 90u8, then() { byte + 32u8 }, else() { byte }))
      }
      return(out)
    }

    [return<String> effects(heap_alloc)]
    toAsciiUpper() {
      [String mut] out{stringWithCapacity(this.fieldLength)}
      for([i32 mut] i{0i32}, i < this.fieldLength, i++) {
        [u8] byte{textLoad(this.data, i)}
        out.pushByte(if(byte >= 97u8 && byte <= 122u8, then() { byte - 32u8 }, else() { byte }))
      }
      return(out)
    }

    [return<bool>]
    equalsIgnoreAsciiCase([/std/text/view/StringView] other) {
      if(other.fieldLength != this.fieldLength) {
        return(false)
      }
      for([i32 mut] i{0i32}, i < this.fieldLength, i++) {
        [u8 mut] a{textLoad(this.data, i)}
        [u8 mut] b{textLoad(other.data, i)}
        if(a >= 65u8 && a <= 90u8) {
          a = a + 32u8
        }
        if(b >= 65u8 && b <= 90u8) {
          b = b + 32u8
        }
        if(a != b) {
          return(false)
        }
      }
      return(true)
    }
  }

  // The view of a string literal's text.
  [public return<StringView>]
  textOf([string] text) {
    return(StringView{[data] __pstext_literal(text), [fieldLength] text.count()})
  }

  // The index of the first (or, backwards, the last) byte of the haystack that is in (or, `inSet` false, is not in) the
  // set, starting at `start` and moving toward the end (or toward the start when `backwards`); -1 when there is none.
  [return<i32>]
  textFindOfSet([Pointer<u8>] hay, [i32] hayCount, [Pointer<u8>] set, [i32] setCount, [i32] start, [bool] inSet,
                [bool] backwards) {
    [i32 mut] at{start}
    if(backwards && at >= hayCount) {
      at = hayCount - 1i32
    }
    if(at < 0i32 && !backwards) {
      at = 0i32
    }
    while(at >= 0i32 && at < hayCount) {
      [bool] member{findByte(set, setCount, textLoad(hay, at)) >= 0i32}
      if(member == inSet) {
        return(at)
      }
      at = if(backwards, then() { at - 1i32 }, else() { at + 1i32 })
    }
    return(-1i32)
  }

  // [+-]? ( digits+ ( '.' digits* )? | '.' digits+ ) ( [eE] [+-]? digits+ )?  and nothing else.
  [return<bool>]
  isDecimalNumber([Pointer<u8>] data, [i32] length) {
    [i32 mut] i{0i32}
    if(length > 0i32 && (textLoad(data, 0i32) == 43u8 || textLoad(data, 0i32) == 45u8)) {
      i = 1i32
    }
    [i32 mut] whole{0i32}
    while(i < length && textLoad(data, i) >= 48u8 && textLoad(data, i) <= 57u8) {
      i = i + 1i32
      whole = whole + 1i32
    }
    [i32 mut] fraction{0i32}
    if(i < length && textLoad(data, i) == 46u8) {
      i = i + 1i32
      while(i < length && textLoad(data, i) >= 48u8 && textLoad(data, i) <= 57u8) {
        i = i + 1i32
        fraction = fraction + 1i32
      }
    }
    if(whole + fraction == 0i32) {
      return(false)
    }
    if(i < length && (textLoad(data, i) == 101u8 || textLoad(data, i) == 69u8)) {
      i = i + 1i32
      if(i < length && (textLoad(data, i) == 43u8 || textLoad(data, i) == 45u8)) {
        i = i + 1i32
      }
      [i32 mut] exponent{0i32}
      while(i < length && textLoad(data, i) >= 48u8 && textLoad(data, i) <= 57u8) {
        i = i + 1i32
        exponent = exponent + 1i32
      }
      if(exponent == 0i32) {
        return(false)
      }
    }
    return(i == length)
  }

  // The index of the first place the needle occurs in the haystack at or after `from`, or -1.
  [return<i32>]
  textIndexOfFrom([Pointer<u8>] hay, [i32] hayCount, [Pointer<u8>] needle, [i32] needleCount, [i32] from) {
    if(from < 0i32 || from > hayCount) {
      return(-1i32)
    }
    [i32] hit{twoWayFind(textAddress(hay, from), hayCount - from, needle, needleCount)}
    if(hit < 0i32) {
      return(-1i32)
    }
    return(from + hit)
  }

  [return<i32>]
  textLastIndexOf([Pointer<u8>] hay, [i32] hayCount, [Pointer<u8>] needle, [i32] needleCount) {
    for([i32 mut] at{hayCount - needleCount}, at >= 0i32, at--) {
      if(compareBytes(textAddress(hay, at), needle, needleCount) == 0i32) {
        return(at)
      }
    }
    return(-1i32)
  }

  // Digits of `radix` (2 to 36, either case) with an optional sign when `isSigned`, nothing else: the magnitude goes to
  // `magnitudeOut` and the sign to `negativeOut`, false for anything that is not exactly an integer that fits the
  // 64-bit type (signed: -2^63 to 2^63 - 1; unsigned: 0 to 2^64 - 1).
  [return<bool>]
  textParseInteger([Pointer<u8>] data, [i32] length, [i32] radix, [bool] isSigned, [u64 mut] magnitudeOut,
                   [bool mut] negativeOut) {
    if(length == 0i32 || radix < 2i32 || radix > 36i32) {
      return(false)
    }
    [i32 mut] i{0i32}
    [bool] negative{isSigned && textLoad(data, 0i32) == 45u8}
    if(isSigned && (negative || textLoad(data, 0i32) == 43u8)) {
      i = 1i32
    }
    if(i == length) {
      return(false)
    }
    [u64] base{convert<u64>(radix)}
    [u64] limit{if(isSigned, then() { if(negative, then() { 9223372036854775808u64 }, else() { 9223372036854775807u64 }) }, else() { 18446744073709551615u64 })}
    [u64 mut] magnitude{0u64}
    while(i < length) {
      [u8] ch{textLoad(data, i)}
      [u64 mut] d{99u64}
      if(ch >= 48u8 && ch <= 57u8) {
        d = convert<u64>(ch - 48u8)
      }
      if(ch >= 97u8 && ch <= 122u8) {
        d = convert<u64>(ch - 87u8)
      }
      if(ch >= 65u8 && ch <= 90u8) {
        d = convert<u64>(ch - 55u8)
      }
      if(d >= base) {
        return(false)
      }
      if(magnitude > (limit - d) / base) {
        return(false)
      }
      magnitude = magnitude * base + d
      i = i + 1i32
    }
    magnitudeOut = magnitude
    negativeOut = negative
    return(true)
  }

  // An optional sign then decimal digits, nothing else, in range: stores the value in `out` and returns true;
  // otherwise returns false and leaves `out` alone.
  [return<bool>]
  textParseI64([Pointer<u8>] data, [i32] length, [i64 mut] out) {
    return(textParseI64Radix(data, length, 10i32, out))
  }

  [return<bool>]
  textParseI64Radix([Pointer<u8>] data, [i32] length, [i32] radix, [i64 mut] out) {
    [u64 mut] magnitude{0u64}
    [bool mut] negative{false}
    if(!textParseInteger(data, length, radix, true, magnitude, negative)) {
      return(false)
    }
    [i64 mut] value{convert<i64>(magnitude)}
    if(negative) {
      value = 0i64 - value
    }
    out = value
    return(true)
  }

  [return<bool>]
  isAsciiSpace([u8] value) {
    return(value == 32u8 || (value >= 9u8 && value <= 13u8))
  }

  // The index in the haystack (`hayCount` bytes at `hay`) of the first occurrence of the needle, or -1; the empty
  // needle occurs at 0. A single byte is a byte scan; longer needles use two-way matching (Crochemore and Perrin,
  // as in glibc's two_way_short_needle): at most about 2 * hayCount byte comparisons, with no allocation.
  [return<i32>]
  twoWayFind([Pointer<u8>] hay, [i32] hayCount, [Pointer<u8>] needle, [i32] needleCount) {
    if(needleCount == 0i32) {
      return(0i32)
    }
    if(needleCount > hayCount) {
      return(-1i32)
    }
    if(needleCount == 1i32) {
      return(findByte(hay, hayCount, textLoad(needle, 0i32)))
    }
    // Critical factorization: the maximal suffix under both byte orders, keeping the longer one.
    [i32 mut] period{1i32}
    [i32 mut] suffixForward{-1i32}
    [i32 mut] j{0i32}
    [i32 mut] k{1i32}
    while(j + k < needleCount) {
      [u8] a{textLoad(needle, j + k)}
      [u8] b{textLoad(needle, suffixForward + k)}
      if(a < b) {
        j = j + k
        k = 1i32
        period = j - suffixForward
      } else {
        if(a == b) {
          if(k != period) {
            k = k + 1i32
          } else {
            j = j + period
            k = 1i32
          }
        } else {
          suffixForward = j
          j = j + 1i32
          k = 1i32
          period = 1i32
        }
      }
    }
    [i32] periodForward{period}
    [i32 mut] suffixReverse{-1i32}
    period = 1i32
    j = 0i32
    k = 1i32
    while(j + k < needleCount) {
      [u8] a{textLoad(needle, j + k)}
      [u8] b{textLoad(needle, suffixReverse + k)}
      if(b < a) {
        j = j + k
        k = 1i32
        period = j - suffixReverse
      } else {
        if(a == b) {
          if(k != period) {
            k = k + 1i32
          } else {
            j = j + period
            k = 1i32
          }
        } else {
          suffixReverse = j
          j = j + 1i32
          k = 1i32
          period = 1i32
        }
      }
    }
    [i32 mut] suffix{suffixReverse + 1i32}
    [i32 mut] finalPeriod{period}
    if(suffixReverse + 1i32 < suffixForward + 1i32) {
      suffix = suffixForward + 1i32
      finalPeriod = periodForward
    }
    [i32 mut] pos{0i32}
    if(compareBytes(needle, textAddress(needle, finalPeriod), suffix) == 0i32) {
      // The needle is periodic: remember how much of the right half the last attempt already matched.
      [i32 mut] memory{0i32}
      while(pos + needleCount <= hayCount) {
        [i32 mut] i{if(suffix > memory, then() { suffix }, else() { memory })}
        while(i < needleCount && textLoad(needle, i) == textLoad(hay, pos + i)) {
          i = i + 1i32
        }
        if(i >= needleCount) {
          i = suffix - 1i32
          while(memory < i + 1i32 && textLoad(needle, i) == textLoad(hay, pos + i)) {
            i = i - 1i32
          }
          if(i + 1i32 < memory + 1i32) {
            return(pos)
          }
          pos = pos + finalPeriod
          memory = needleCount - finalPeriod
        } else {
          pos = pos + i - suffix + 1i32
          memory = 0i32
        }
      }
    } else {
      // The halves differ: any mismatch shifts by the longer half.
      finalPeriod = (if(suffix > needleCount - suffix, then() { suffix }, else() { needleCount - suffix })) + 1i32
      while(pos + needleCount <= hayCount) {
        [i32 mut] i{suffix}
        while(i < needleCount && textLoad(needle, i) == textLoad(hay, pos + i)) {
          i = i + 1i32
        }
        if(i >= needleCount) {
          i = suffix - 1i32
          while(i >= 0i32 && textLoad(needle, i) == textLoad(hay, pos + i)) {
            i = i - 1i32
          }
          if(i < 0i32) {
            return(pos)
          }
          pos = pos + finalPeriod
        } else {
          pos = pos + i - suffix + 1i32
        }
      }
    }
    return(-1i32)
  }

  // The offset of the first byte that starts invalid UTF-8 in the `count` bytes at `data`, or -1 when all of it is
  // valid: no overlong forms, no surrogates, nothing above U+10FFFF, no truncated sequence.
  [public return<i32>]
  utf8ErrorOffset([Pointer<u8>] data, [i32] count) {
    [i32 mut] i{0i32}
    while(i < count) {
      [i32] lead{convert<i32>(textLoad(data, i))}
      [i32 mut] need{0i32}
      [i32 mut] low{128i32}
      [i32 mut] high{191i32}
      [bool mut] valid{lead < 128i32}
      if(lead >= 194i32 && lead <= 223i32) {
        need = 1i32
        valid = true
      }
      if(lead >= 224i32 && lead <= 239i32) {
        need = 2i32
        valid = true
        if(lead == 224i32) {
          low = 160i32
        }
        if(lead == 237i32) {
          high = 159i32
        }
      }
      if(lead >= 240i32 && lead <= 244i32) {
        need = 3i32
        valid = true
        if(lead == 240i32) {
          low = 144i32
        }
        if(lead == 244i32) {
          high = 143i32
        }
      }
      if(!valid) {
        return(i)
      }
      if(need > 0i32 && i + need >= count) {
        return(i)
      }
      for([i32 mut] k{1i32}, k <= need, k++) {
        [i32] next{convert<i32>(textLoad(data, i + k))}
        [i32] floor{if(k == 1i32, then() { low }, else() { 128i32 })}
        [i32] ceiling{if(k == 1i32, then() { high }, else() { 191i32 })}
        if(next < floor || next > ceiling) {
          return(i)
        }
      }
      i = i + need + 1i32
    }
    return(-1i32)
  }

  // A view of the bytes of `bytes`, which must be valid UTF-8: invalid bytes stop the program. Use utf8ErrorOffset
  // first to handle them instead.
  [public return<StringView>]
  textFromBytes([ReadSlice<u8>] bytes) {
    [i32] bad{utf8ErrorOffset(bytes.data, bytes.count())}
    if(bad >= 0i32) {
      panic(bad)
    }
    return(StringView{[data] bytes.data, [fieldLength] bytes.count()})
  }

  // Whether a complete valid UTF-8 sequence starts at `at`; `consumed` is the sequence's length when it does, and
  // otherwise the length of the longest valid prefix of a sequence (1 or more), the part one U+FFFD replaces.
  [return<bool>]
  utf8SequenceAt([Pointer<u8>] data, [i32] count, [i32] at, [i32 mut] consumed) {
    [i32] lead{convert<i32>(textLoad(data, at))}
    [i32 mut] need{0i32}
    [i32 mut] low{128i32}
    [i32 mut] high{191i32}
    [bool mut] valid{lead < 128i32}
    if(lead >= 194i32 && lead <= 223i32) {
      need = 1i32
      valid = true
    }
    if(lead >= 224i32 && lead <= 239i32) {
      need = 2i32
      valid = true
      if(lead == 224i32) {
        low = 160i32
      }
      if(lead == 237i32) {
        high = 159i32
      }
    }
    if(lead >= 240i32 && lead <= 244i32) {
      need = 3i32
      valid = true
      if(lead == 240i32) {
        low = 144i32
      }
      if(lead == 244i32) {
        high = 143i32
      }
    }
    consumed = 1i32
    if(!valid) {
      return(false)
    }
    for([i32 mut] k{1i32}, k <= need, k++) {
      if(at + k >= count) {
        return(false)
      }
      [i32] next{convert<i32>(textLoad(data, at + k))}
      [i32] floor{if(k == 1i32, then() { low }, else() { 128i32 })}
      [i32] ceiling{if(k == 1i32, then() { high }, else() { 191i32 })}
      if(next < floor || next > ceiling) {
        return(false)
      }
      consumed = consumed + 1i32
    }
    return(true)
  }

  // A String from bytes that may be invalid UTF-8: each maximal invalid part becomes one U+FFFD.
  [public return<String> effects(heap_alloc)]
  stringFromUtf8Lossy([ReadSlice<u8>] bytes) {
    [String mut] out{stringWithCapacity(bytes.count())}
    [i32 mut] at{0i32}
    while(at < bytes.count()) {
      [i32 mut] consumed{1i32}
      if(utf8SequenceAt(bytes.data, bytes.count(), at, consumed)) {
        for([i32 mut] k{0i32}, k < consumed, k++) {
          out.pushByte(textLoad(bytes.data, at + k))
        }
      } else {
        out.pushByte(239u8)
        out.pushByte(191u8)
        out.pushByte(189u8)
      }
      at = at + consumed
    }
    return(out)
  }

  // Reads the whole file at `path` into `out`. Returns 0 on success; the C errno of the failure otherwise (2 when the
  // file does not exist); -1 when the file is not valid UTF-8. `out` is left alone on failure.
  [public effects(file_read, heap_alloc), return<i32>]
  readTextInto([/std/text/view/StringView] path, [String mut] out) {
    [i64] size{__pstext_file_size(path.data, convert<u64>(path.fieldLength))}
    if(size < 0i64) {
      return(convert<i32>(0i64 - size))
    }
    if(size > 1073741823i64) {
      return(27i32)
    }
    [String mut] buffer{stringWithCapacity(convert<i32>(size))}
    [i64] got{__pstext_file_read(path.data, convert<u64>(path.fieldLength), buffer.data, convert<u64>(size))}
    if(got < 0i64) {
      return(convert<i32>(0i64 - got))
    }
    buffer.fieldLength = convert<i32>(got)
    if(got > 0i64) {
      textStore(buffer.data, buffer.fieldLength, 0u8)
    }
    if(utf8ErrorOffset(buffer.data, buffer.fieldLength) >= 0i32) {
      return(-1i32)
    }
    out.swap(buffer)
    return(0i32)
  }

  // Writes `text` to the file at `path`, replacing it. Returns 0, or the C errno of the failure.
  [public effects(file_write), return<i32>]
  writeText([/std/text/view/StringView] path, [/std/text/view/StringView] text) {
    return(convert<i32>(0i64 - __pstext_file_write(path.data, convert<u64>(path.fieldLength), text.data, convert<u64>(text.fieldLength), 0u64)))
  }

  // Appends `text` to the file at `path` (created when missing). Returns 0, or the C errno of the failure.
  [public effects(file_write), return<i32>]
  appendText([/std/text/view/StringView] path, [/std/text/view/StringView] text) {
    return(convert<i32>(0i64 - __pstext_file_write(path.data, convert<u64>(path.fieldLength), text.data, convert<u64>(text.fieldLength), 1u64)))
  }

  // The pieces joined with `separator` between them (std::format's `join`, Python's str.join).
  [public return<String> effects(heap_alloc)]
  joinWith([/std/text/view/StringView] separator, [args</std/text/view/StringView>] parts) {
    [String mut] out{stringWithCapacity(16i32)}
    for([i32 mut] i{0i32}, i < parts.count(), i++) {
      if(i > 0i32) {
        out.appendBytes(separator.data, separator.fieldLength)
      }
      [StringView] part{parts[i]}
      out.appendBytes(part.data, part.fieldLength)
    }
    return(out)
  }

  [return<bool>]
  isAlignByte([u8] value) {
    return(value == 60u8 || value == 62u8 || value == 94u8)
  }

  // Text with placeholders filled from the text arguments, after std::format: `{}` takes the next argument, `{N}` the
  // N-th (from 0), `{{` and `}}` are braces, and `{:[[fill]align]width}` pads an argument to `width` code points
  // (`<` left, the default; `>` right; `^` centered; the fill is one ASCII byte, a space by default). Render numbers
  // first (stringFromI64 and friends) and pass their views. A malformed pattern, a missing argument or a fill above
  // ASCII stops the program: the pattern is checked when the call runs, not when it is compiled.
  [public return<String> effects(heap_alloc)]
  formatText([/std/text/view/StringView] pattern, [args</std/text/view/StringView>] values) {
    [String mut] out{stringWithCapacity(pattern.fieldLength + 16i32)}
    [i32] n{pattern.fieldLength}
    [i32 mut] i{0i32}
    [i32 mut] nextArg{0i32}
    while(i < n) {
      [u8] c{textLoad(pattern.data, i)}
      if(c == 123u8) {
        if(i + 1i32 < n && textLoad(pattern.data, i + 1i32) == 123u8) {
          out.pushByte(123u8)
          i = i + 2i32
        } else {
          i = i + 1i32
          [i32 mut] index{-1i32}
          while(i < n && textLoad(pattern.data, i) >= 48u8 && textLoad(pattern.data, i) <= 57u8) {
            index = (if(index < 0i32, then() { 0i32 }, else() { index })) * 10i32 + convert<i32>(textLoad(pattern.data, i)) - 48i32
            i = i + 1i32
          }
          if(index < 0i32) {
            index = nextArg
            nextArg = nextArg + 1i32
          }
          [u8 mut] fillByte{32u8}
          [u8 mut] align{60u8}
          [i32 mut] width{0i32}
          if(i < n && textLoad(pattern.data, i) == 58u8) {
            i = i + 1i32
            if(i + 1i32 < n && isAlignByte(textLoad(pattern.data, i + 1i32))) {
              fillByte = textLoad(pattern.data, i)
              align = textLoad(pattern.data, i + 1i32)
              i = i + 2i32
            } else {
              if(i < n && isAlignByte(textLoad(pattern.data, i))) {
                align = textLoad(pattern.data, i)
                i = i + 1i32
              }
            }
            while(i < n && textLoad(pattern.data, i) >= 48u8 && textLoad(pattern.data, i) <= 57u8) {
              width = width * 10i32 + convert<i32>(textLoad(pattern.data, i)) - 48i32
              i = i + 1i32
            }
          }
          if(i >= n || textLoad(pattern.data, i) != 125u8 || fillByte >= 128u8) {
            panic(i)
          }
          i = i + 1i32
          if(index >= values.count()) {
            panic(index)
          }
          [StringView] arg{values[index]}
          [i32] shown{arg.codePointCount()}
          [i32] padding{if(width > shown, then() { width - shown }, else() { 0i32 })}
          [i32] before{if(align == 62u8, then() { padding }, else() { if(align == 94u8, then() { padding / 2i32 }, else() { 0i32 }) })}
          out.appendFilled(before, fillByte)
          out.appendBytes(arg.data, arg.fieldLength)
          out.appendFilled(padding - before, fillByte)
        }
      } else {
        if(c == 125u8) {
          if(i + 1i32 < n && textLoad(pattern.data, i + 1i32) == 125u8) {
            out.pushByte(125u8)
            i = i + 2i32
          } else {
            panic(i)
          }
        } else {
          out.pushByte(c)
          i = i + 1i32
        }
      }
    }
    return(out)
  }

  // `s.view()` and `s.slice(a, b)` on a String: views of its text (valid until the String changes or is destroyed).
  [public return</std/text/view/StringView>]
  /std/text/String/view([/std/text/String] self) {
    return(/std/text/view/StringView{[data] self.data, [fieldLength] self.fieldLength})
  }

  [public return</std/text/view/StringView>]
  /std/text/String/slice([/std/text/String] self, [i32] start, [i32] end) {
    [/std/text/view/StringView] whole{/std/text/view/StringView{[data] self.data, [fieldLength] self.fieldLength}}
    return(whole.slice(start, end))
  }

  [public return<u64>]
  /std/text/String/hash([/std/text/String] self) {
    return(__pstext_hash(self.data, convert<u64>(self.fieldLength), 0u64))
  }

  // Operators: `a + b`, `==`, `!=`, `<`, `<=`, `>`, `>=` and `s[i]` on text dispatch to these members (byte order).
  [public return<String> effects(heap_alloc)]
  /std/text/String/opPlus([/std/text/String] self, [/std/text/String] other) {
    [String mut] out{stringWithCapacity(self.fieldLength + other.fieldLength)}
    out.appendBytes(self.data, self.fieldLength)
    out.appendBytes(other.data, other.fieldLength)
    return(out)
  }

  // A chain `a + b + c + ...` of three or more Strings is rewritten to this call: the counts are summed, one block is
  // allocated and each part is copied in order. Named parts are not copied and call results stay alive for the call.
  [public return<String> effects(heap_alloc)]
  /std/text/String/opPlusMany([/std/text/String] self, [args</std/text/String>] parts) {
    [i32 mut] total{self.fieldLength}
    for([i32 mut] i{0i32}, i < parts.count(), i++) {
      [StringView] part{parts[i].view()}
      total = total + part.fieldLength
    }
    [String mut] out{stringWithCapacity(total)}
    out.appendBytes(self.data, self.fieldLength)
    for([i32 mut] i{0i32}, i < parts.count(), i++) {
      [StringView] part{parts[i].view()}
      out.appendBytes(part.data, part.fieldLength)
    }
    return(out)
  }

  [public return<bool>]
  /std/text/String/opEqual([/std/text/String] self, [/std/text/String] other) {
    [i32] order{self.view().compare(other.view())}
    return(order == 0i32)
  }

  [public return<bool>]
  /std/text/String/opNotEqual([/std/text/String] self, [/std/text/String] other) {
    [i32] order{self.view().compare(other.view())}
    return(order != 0i32)
  }

  [public return<bool>]
  /std/text/String/opLessThan([/std/text/String] self, [/std/text/String] other) {
    [i32] order{self.view().compare(other.view())}
    return(order < 0i32)
  }

  [public return<bool>]
  /std/text/String/opLessEqual([/std/text/String] self, [/std/text/String] other) {
    [i32] order{self.view().compare(other.view())}
    return(order <= 0i32)
  }

  [public return<bool>]
  /std/text/String/opGreaterThan([/std/text/String] self, [/std/text/String] other) {
    [i32] order{self.view().compare(other.view())}
    return(order > 0i32)
  }

  [public return<bool>]
  /std/text/String/opGreaterEqual([/std/text/String] self, [/std/text/String] other) {
    [i32] order{self.view().compare(other.view())}
    return(order >= 0i32)
  }

  [public return<u8>]
  /std/text/String/opAt([/std/text/String] self, [i32] index) {
    return(self.view().byteAt(index))
  }

  [public return<bool>]
  /std/text/view/StringView/opEqual([/std/text/view/StringView] self, [/std/text/view/StringView] other) {
    [i32] order{self.compare(other)}
    return(order == 0i32)
  }

  [public return<bool>]
  /std/text/view/StringView/opNotEqual([/std/text/view/StringView] self, [/std/text/view/StringView] other) {
    [i32] order{self.compare(other)}
    return(order != 0i32)
  }

  [public return<bool>]
  /std/text/view/StringView/opLessThan([/std/text/view/StringView] self, [/std/text/view/StringView] other) {
    [i32] order{self.compare(other)}
    return(order < 0i32)
  }

  [public return<bool>]
  /std/text/view/StringView/opLessEqual([/std/text/view/StringView] self, [/std/text/view/StringView] other) {
    [i32] order{self.compare(other)}
    return(order <= 0i32)
  }

  [public return<bool>]
  /std/text/view/StringView/opGreaterThan([/std/text/view/StringView] self, [/std/text/view/StringView] other) {
    [i32] order{self.compare(other)}
    return(order > 0i32)
  }

  [public return<bool>]
  /std/text/view/StringView/opGreaterEqual([/std/text/view/StringView] self, [/std/text/view/StringView] other) {
    [i32] order{self.compare(other)}
    return(order >= 0i32)
  }

  [public return<u8>]
  /std/text/view/StringView/opAt([/std/text/view/StringView] self, [i32] index) {
    return(self.byteAt(index))
  }

  // Appends the text of a view to `out` (not a view of `out`'s own text).
  [public effects(heap_alloc), return<void>]
  appendView([String mut] out, [/std/text/view/StringView] other) {
    out.appendBytes(other.data, other.fieldLength)
  }
  }
  }
