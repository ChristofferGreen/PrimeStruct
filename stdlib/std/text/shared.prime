// An immutable, reference-counted text (docs/spec/strings-and-views.md): copying a SharedString shares the bytes and
// adds one to the count, so a clone and a view cost nothing, and the bytes are freed when the last owner is destroyed.
// The block is the text, a 0 byte and then the count as four bytes. This count is a plain integer, not atomic: a
// SharedString may be shared between owners on one thread only. Sending one between threads needs atomics and
// per-thread string heaps, which wait for the concurrency model.
// A module of its own: `import /std/text/shared/*`.

import /std/text/*
import /std/text/view/*

namespace std {
  namespace text {
  namespace shared {
  [public struct]
  SharedString() {
    [private Pointer<u8> mut] bytes{__pstext_alloc(0u64)}
    [private i32 mut] fieldLength{0i32}
    [private bool mut] live{false}

    [return<i32>]
    count() {
      return(this.fieldLength)
    }

    [return<bool>]
    empty() {
      return(this.fieldLength == 0i32)
    }

    // The text as a view, valid while some owner is alive.
    [return</std/text/view/StringView>]
    view() {
      return(/std/text/view/StringView{[data] this.bytes, [fieldLength] this.fieldLength})
    }

    // How many owners share the bytes (0 for an empty SharedString that owns nothing).
    [return<i32>]
    owners() {
      if(!this.live) {
        return(0i32)
      }
      return(readOwners(this.bytes, this.fieldLength))
    }

    // Takes `source` in as the first owner (used by sharedFrom).
    [mut effects(heap_alloc)]
    fill([/std/text/view/StringView] source) {
      [i32] size{source.fieldLength}
      this.bytes = __pstext_alloc(convert<u64>(size) + 5u64)
      moveBytes(this.bytes, source.data, size)
      textStore(this.bytes, size, 0u8)
      this.fieldLength = size
      this.live = true
      writeOwners(this.bytes, size, 1i32)
    }

    [mut effects(heap_alloc)]
    Copy([Reference<Self>] other) {
      this.bytes = other.bytes
      this.fieldLength = other.fieldLength
      this.live = other.live
      if(other.live) {
        writeOwners(other.bytes, other.fieldLength, readOwners(other.bytes, other.fieldLength) + 1i32)
      }
    }

    [mut]
    Move([Reference<Self>] other) {
      this.bytes = other.bytes
      this.fieldLength = other.fieldLength
      this.live = other.live
      other.live = false
    }

    [mut effects(heap_alloc)]
    Destroy() {
      if(this.live) {
        [i32] remaining{readOwners(this.bytes, this.fieldLength) - 1i32}
        if(remaining == 0i32) {
          __pstext_free(this.bytes)
        } else {
          writeOwners(this.bytes, this.fieldLength, remaining)
        }
        this.live = false
      }
    }
  }

  // The count lives after the text and its 0 byte, so the bytes start at the block and need no offset pointer.
  [return<i32>]
  readOwners([Pointer<u8>] block, [i32] length) {
    [i32] at{length + 1i32}
    return(convert<i32>(textLoad(block, at)) + convert<i32>(textLoad(block, at + 1i32)) * 256i32 +
           convert<i32>(textLoad(block, at + 2i32)) * 65536i32 + convert<i32>(textLoad(block, at + 3i32)) * 16777216i32)
  }

  [return<void>]
  writeOwners([Pointer<u8> mut] block, [i32] length, [i32] owners) {
    [i32] at{length + 1i32}
    [i32] high1{owners / 256i32}
    [i32] high2{high1 / 256i32}
    [i32] high3{high2 / 256i32}
    textStore(block, at, convert<u8>(owners - high1 * 256i32))
    textStore(block, at + 1i32, convert<u8>(high1 - high2 * 256i32))
    textStore(block, at + 2i32, convert<u8>(high2 - high3 * 256i32))
    textStore(block, at + 3i32, convert<u8>(high3))
  }

  // A SharedString holding a copy of `text`.
  [public effects(heap_alloc), return<SharedString>]
  sharedFrom([/std/text/view/StringView] text) {
    [SharedString mut] out{SharedString{}}
    out.fill(text)
    return(out)
  }
  }
  }
}
