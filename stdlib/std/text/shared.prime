// An immutable, reference-counted text (docs/spec/strings-and-views.md): copying a SharedString shares the bytes and
// adds one to the count, so a clone and a view cost nothing, and the bytes are freed when the last owner is destroyed.
// The count is one heap slot of its own, beside the block of the text and its 0 byte, and is counted with the atomic
// operations of `/std/sync`: a SharedString is sendable, its owners may live on different threads, and the last one
// frees the text and the count on whichever thread it is (docs/MultithreadingPrototype.md, Heaps).
// A module of its own: `import /std/text/shared/*`.

import /std/text/*
import /std/text/view/*
import /std/sync/*

namespace std {
  namespace text {
  namespace shared {
  [public struct sendable]
  SharedString() {
    [private Pointer<u8> mut] bytes{__pstext_alloc(0u64)}
    [private Pointer<i64> mut] ownerCount{/std/intrinsics/memory/alloc<i64>(0i32)}
    [private i32 mut] fieldLength{0i32}
    [private bool mut] live{false}

    [return<i32>]
    count() {
      return(this.fieldLength)
    }

    [return<bool>]
    empty() {
      return(this.fieldLength == 0i32)
    }

    // The text as a view, valid while some owner is alive.
    [return</std/text/view/StringView>]
    view() {
      return(/std/text/view/StringView{[data] this.bytes, [fieldLength] this.fieldLength})
    }

    // How many owners share the bytes (0 for an empty SharedString that owns nothing).
    [return<i32>]
    owners() {
      if(!this.live) {
        return(0i32)
      }
      return(sharedOwnersLoad(this.ownerCount))
    }

    // Takes `source` in as the first owner (used by sharedFrom).
    [mut effects(heap_alloc)]
    fill([/std/text/view/StringView] source) {
      [i32] size{source.fieldLength}
      this.bytes = __pstext_alloc(convert<u64>(size) + 1u64)
      moveBytes(this.bytes, source.data, size)
      textStore(this.bytes, size, 0u8)
      this.fieldLength = size
      this.live = true
      this.ownerCount = sharedOwnersAlloc()
    }

    [mut]
    Copy([Reference<Self>] other) {
      this.bytes = other.bytes
      this.ownerCount = other.ownerCount
      this.fieldLength = other.fieldLength
      this.live = other.live
      if(other.live) {
        sharedOwnersAdd(other.ownerCount)
      }
    }

    [mut]
    Move([Reference<Self>] other) {
      this.bytes = other.bytes
      this.ownerCount = other.ownerCount
      this.fieldLength = other.fieldLength
      this.live = other.live
      other.live = false
    }

    [mut effects(heap_alloc)]
    Destroy() {
      if(this.live) {
        if(sharedOwnersRelease(this.ownerCount)) {
          __pstext_free(this.bytes)
        }
        this.live = false
      }
    }
  }

  // The count of a new SharedString: one heap slot holding 1.
  [unsafe effects(heap_alloc), return<Pointer<i64>>]
  sharedOwnersAlloc() {
    [Pointer<i64>] count{/std/intrinsics/memory/alloc<i64>(1i32)}
    /std/sync/__psatomic_store_i64(count, 1i64)
    return(count)
  }

  [unsafe return<i32>]
  sharedOwnersLoad([Pointer<i64>] count) {
    return(convert<i32>(/std/sync/__psatomic_load_i64(count)))
  }

  // One more owner.
  [unsafe return<void>]
  sharedOwnersAdd([Pointer<i64>] count) {
    /std/sync/__psatomic_add_i64(count, 1i64)
  }

  // An owner is gone; the last one frees the count and returns true, and then frees the text.
  [unsafe effects(heap_alloc), return<bool>]
  sharedOwnersRelease([Pointer<i64>] count) {
    if(/std/sync/__psatomic_add_i64(count, -1i64) == 1i64) {
      /std/intrinsics/memory/free(count)
      return(true)
    }
    return(false)
  }

  // A SharedString holding a copy of `text`.
  [public effects(heap_alloc), return<SharedString>]
  sharedFrom([/std/text/view/StringView] text) {
    [SharedString mut] out{SharedString{}}
    out.fill(text)
    return(out)
  }
  }
  }
}
