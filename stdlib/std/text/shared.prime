// An immutable, reference-counted text (docs/spec/strings-and-views.md): copying a SharedString shares the bytes and
// adds one to the count, so a clone and a view cost nothing, and the bytes are freed when the last owner is destroyed.
// The block is the owner count as one 8-byte integer, then the text and its 0 byte: one allocation holds both, and the
// count is the 8 bytes before the text. Every byte region of the heap starts at a multiple of 8 and so does every text
// block, which makes the count an aligned cell for the atomic operations of `/std/sync`. A SharedString is sendable:
// its owners may live on different threads, and the last one frees the block on whichever thread it is
// (docs/MultithreadingPrototype.md, Heaps).
// A module of its own: `import /std/text/shared/*`.

import /std/text/*
import /std/text/view/*
import /std/sync/*

namespace std {
  namespace text {
  namespace shared {
  [public struct sendable]
  SharedString() {
    [private Pointer<u8> mut] bytes{__pstext_alloc(0u64)}
    [private i32 mut] fieldLength{0i32}
    [private bool mut] live{false}

    [return<i32>]
    count() {
      return(this.fieldLength)
    }

    [return<bool>]
    empty() {
      return(this.fieldLength == 0i32)
    }

    // The text as a view, valid while some owner is alive.
    [return</std/text/view/StringView>]
    view() {
      return(/std/text/view/StringView{[data] this.bytes, [fieldLength] this.fieldLength})
    }

    // How many owners share the bytes (0 for an empty SharedString that owns nothing).
    [return<i32>]
    owners() {
      if(!this.live) {
        return(0i32)
      }
      return(sharedOwnersLoad(sharedOwnersCell(this.bytes)))
    }

    // Takes `source` in as the first owner (used by sharedFrom).
    [mut effects(heap_alloc)]
    fill([/std/text/view/StringView] source) {
      [i32] size{source.fieldLength}
      [Pointer<u8>] block{__pstext_alloc(convert<u64>(size) + 9u64)}
      this.bytes = textAddress(block, 8i32)
      moveBytes(this.bytes, source.data, size)
      textStore(this.bytes, size, 0u8)
      this.fieldLength = size
      this.live = true
      sharedOwnersStart(sharedOwnersCell(this.bytes))
    }

    [mut]
    Copy([Reference<Self>] other) {
      this.bytes = other.bytes
      this.fieldLength = other.fieldLength
      this.live = other.live
      if(other.live) {
        sharedOwnersAdd(sharedOwnersCell(other.bytes))
      }
    }

    [mut]
    Move([Reference<Self>] other) {
      this.bytes = other.bytes
      this.fieldLength = other.fieldLength
      this.live = other.live
      other.live = false
    }

    [mut effects(heap_alloc)]
    Destroy() {
      if(this.live) {
        if(sharedOwnersRelease(sharedOwnersCell(this.bytes))) {
          __pstext_free(textAddress(this.bytes, -8i32))
        }
        this.live = false
      }
    }
  }

  // The count of the block: the aligned 8 bytes before the text.
  [unsafe return<Pointer<i64>>]
  sharedOwnersCell([Pointer<u8>] text) {
    [Pointer<u8>] address{textAddress(text, -8i32)}
    return(/std/intrinsics/memory/reinterpret<i64>(address))
  }

  // The count of a new SharedString is 1.
  [unsafe return<void>]
  sharedOwnersStart([Pointer<i64>] count) {
    /std/sync/__psatomic_store_i64(count, 1i64)
  }

  [unsafe return<i32>]
  sharedOwnersLoad([Pointer<i64>] count) {
    return(convert<i32>(/std/sync/__psatomic_load_i64(count)))
  }

  // One more owner.
  [unsafe return<void>]
  sharedOwnersAdd([Pointer<i64>] count) {
    /std/sync/__psatomic_add_i64(count, 1i64)
  }

  // An owner is gone; the last one returns true, and then frees the block that holds the count.
  [unsafe return<bool>]
  sharedOwnersRelease([Pointer<i64>] count) {
    return(/std/sync/__psatomic_add_i64(count, -1i64) == 1i64)
  }

  // A SharedString holding a copy of `text`.
  [public effects(heap_alloc), return<SharedString>]
  sharedFrom([/std/text/view/StringView] text) {
    [SharedString mut] out{SharedString{}}
    out.fill(text)
    return(out)
  }
  }
  }
}
