// A text that must not leak: a password, a token, a key (docs/spec/strings-and-views.md). `Secret` is not a String and
// has no view, so it cannot be printed, formatted or concatenated by accident: the ways to read it are `reveal()` (a
// view) and the two comparisons. Destroying a Secret zeroes its block before the String frees it. The field holding the
// text is declared private, but the compiler does not enforce field visibility yet (TODO-5511), so code that
// names the field can still read it.
// A module of its own: `import /std/text/secret/*`.

import /std/panic/*
import /std/text/*
import /std/text/view/*

namespace std {
  namespace text {
  namespace secret {
  // 0 exactly when the two byte ranges have the same length and the same bytes. The loop always runs over the longer
  // range and has no data-dependent branch: the work depends on the lengths, never on where the bytes differ.
  [return<bool>]
  constantTimeEquals([Pointer<u8>] aData, [i32] aCount, [Pointer<u8>] bData, [i32] bCount) {
    [i32] longer{if(aCount > bCount, then() { aCount }, else() { bCount })}
    [i64] lengthGap{convert<i64>(aCount - bCount)}
    [i64 mut] difference{lengthGap * lengthGap}
    for([i32 mut] i{0i32}, i < longer, i++) {
      [i64] x{if(i < aCount, then() { convert<i64>(textLoad(aData, i)) }, else() { 0i64 })}
      [i64] y{if(i < bCount, then() { convert<i64>(textLoad(bData, i)) }, else() { 0i64 })}
      [i64] d{x - y}
      difference = difference + d * d
    }
    return(difference == 0i64)
  }

  [public struct]
  Secret() {
    [private String mut] text{String{}}

    [return<i32>]
    count() {
      return(this.text.count())
    }

    [return<bool>]
    empty() {
      return(this.text.count() == 0i32)
    }

    // The text as a view, for the one place that must read it (a hash, a header). Valid while this Secret is alive.
    [return</std/text/view/StringView>]
    reveal() {
      return(/std/text/view/StringView{[data] this.text.data, [fieldLength] this.text.fieldLength})
    }

    // Whether two Secrets hold the same text, comparing without stopping at the first difference.
    [return<bool>]
    equalsConstantTime([/std/text/secret/Secret] other) {
      return(constantTimeEquals(this.text.data, this.text.fieldLength, other.text.data, other.text.fieldLength))
    }

    [return<bool>]
    equalsViewConstantTime([/std/text/view/StringView] other) {
      return(constantTimeEquals(this.text.data, this.text.fieldLength, other.data, other.fieldLength))
    }

    // Copies `text` in (used by secretOf).
    [mut effects(heap_alloc)]
    fill([/std/text/view/StringView] source) {
      this.text.appendBytes(source.data, source.fieldLength)
    }

    [mut effects(heap_alloc)]
    Destroy() {
      fillBytes(this.text.data, 0u8, this.text.capacity())
    }
  }

  // A Secret holding a copy of `text`.
  [public effects(heap_alloc), return<Secret>]
  secretOf([/std/text/view/StringView] text) {
    [Secret mut] out{Secret{}}
    out.fill(text)
    return(out)
  }
  }
  }
}
