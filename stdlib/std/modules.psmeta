# Stdlib module inclusion metadata.
# The compile pipeline consumes source_file for module roots whose import root
# should include one deterministic .prime file instead of scanning a directory.

[module]
root = /std/gfx
source_file = std/gfx/gfx.prime

[module]
root = /std/gfx/experimental
source_file = std/gfx/experimental.prime

[module]
root = /std/text
source_file = std/text/string.prime

[module]
root = /std/text/view
source_file = std/text/view.prime

[module]
root = /std/text/secret
source_file = std/text/secret.prime

[module]
root = /std/text/string_map
source_file = std/text/string_map.prime

[module]
root = /std/text/interner
source_file = std/text/interner.prime
