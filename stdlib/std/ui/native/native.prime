  }

  [public return<bool> effects(none)]
  quit() {
    return(ps_ui_menu_add_standard(this.handle, 8i32))
  }

  [public return<bool> effects(none)]
  about() {
    return(ps_ui_menu_add_standard(this.handle, 9i32))
  }
}

// Controls for a settings window: values are handles. A control is held by one form or tabs, or is a
// window's content; `widget()` is the generic handle a form, tabs or window takes.
[public struct]
Widget() {
  [public u64] handle{0u64}
}

[public struct]
Label() {
  [public u64] handle{0u64}

  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  [public return<bool> effects(none)]
  setText([string] value) {
    return(ps_ui_label_set_text(this.handle, value))
  }
}

[public struct]
CheckBox() {
  [public u64] handle{0u64}

  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  // The program's own change: it produces no event.
  [public return<bool> effects(none)]
  setChecked([bool] checked) {
    return(ps_ui_checkbox_set_checked(this.handle, checked))
  }

  [public return<bool> effects(none)]
  isChecked() {
    return(ps_ui_checkbox_checked(this.handle))
  }
}

[public struct]
Popup() {
  [public u64] handle{0u64}

  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  // Items are added in order; the first one is chosen at first.
  [public return<bool> effects(none)]
  addItem([string] title) {
    return(ps_ui_popup_add_item(this.handle, title))
  }

  [public return<bool> effects(none)]
  select([i32] index) {
    return(ps_ui_popup_select(this.handle, index))
  }

  // The chosen item's index (-1 without items).
  [public return<i32> effects(none)]
  selected() {
    return(ps_ui_popup_selected(this.handle))
  }
}

// A push button; the user's click is an `AppEvent.controlChanged` carrying it.
[public struct]
Button() {
  [public u64] handle{0u64}

  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  [public return<bool> effects(none)]
  setTitle([/std/text/String] title) {
    return(ps_ui_button_set_title(this.handle, title))
  }
}

// A list of text rows, any number of them selected; the user's change of the selection is an
// `AppEvent.controlChanged` carrying it (the program's own changes make no event).
[public struct]
ItemList() {
  [public u64] handle{0u64}

  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  [public return<bool> effects(none)]
  addItem([/std/text/String] text) {
    return(ps_ui_list_add_item(this.handle, text))
  }

  [public return<bool> effects(none)]
  setItem([i32] index, [/std/text/String] text) {
    return(ps_ui_list_set_item(this.handle, index, text))
  }

  [public return<i32> effects(none)]
  count() {
    return(ps_ui_list_item_count(this.handle))
  }

  [public return<bool> effects(none)]
  setSelected([i32] index, [bool] selected) {
    return(ps_ui_list_set_selected(this.handle, index, selected))
  }

  [public return<bool> effects(none)]
  isSelected([i32] index) {
    return(ps_ui_list_is_selected(this.handle, index))
  }
}

// A column of rows: headings, a label with a control, or a control alone in the controls' column.
[public struct]
Form() {
  [public u64] handle{0u64}

  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  [public return<bool> effects(none)]
  heading([string] title) {
    return(ps_ui_form_add_heading(this.handle, title))
  }

  [public return<bool> effects(none)]
  row([string] label, [Widget] control) {
    return(ps_ui_form_add_row(this.handle, label, control.handle))
  }

  [public return<bool> effects(none)]
  control([Widget] control) {
    return(ps_ui_form_add_control(this.handle, control.handle))
  }
}

// Pages under a row of tab titles; the first page added is shown.
[public struct]
Tabs() {
  [public u64] handle{0u64}

  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  [public return<bool> effects(none)]
  add([string] title, [Widget] content) {
    return(ps_ui_tabs_add(this.handle, title, content.handle))
  }

  [public return<bool> effects(none)]
  select([i32] index) {
    return(ps_ui_tabs_select(this.handle, index))
  }
}

// What waitEvent() returns. Typing, selection, clipboard and undo are handled by
// the native text view and never reach the program. `controlChanged` carries the check box or
// pop-up the user changed.
[public sum]
AppEvent {
  quitRequested
  [i32] command
  [Window] windowCloseRequested
  [Window] textChanged
  [Widget] controlChanged
  [i32] openFile
}

[public struct]
App() {
  [public bool] started{false}

  [public return<void> effects(none)]
  quit() {
    ps_ui_quit()
  }

  [public return<Window> effects(none)]
  window([string] title, [i32] width, [i32] height) {
    [Window] created{[handle] ps_ui_window_create(title, width, height)}
    return(created)
  }

  // The window the user is working in (the selected tab); handle 0 when none is open.
  [public return<Window> effects(none)]
  activeWindow() {
    [Window] active{[handle] ps_ui_active_window()}
    return(active)
  }

  [public return<i32> effects(none)]
  windowCount() {
    return(ps_ui_window_count())
  }

  // The index-th open window in creation order.
  [public return<Window> effects(none)]
  windowAt([i32] index) {
    [Window] found{[handle] ps_ui_window_at(index)}
    return(found)
  }

  [public return<TextView> effects(none)]
  textView() {
    [TextView] created{[handle] ps_ui_text_view_create()}
    return(created)
  }

  [public return<Menu> effects(none)]
  menu([string] title) {
    [Menu] created{[handle] ps_ui_menu_create(title)}
    return(created)
  }

  [public return<Toolbar> effects(none)]
  toolbar() {
    [Toolbar] created{[handle] ps_ui_toolbar_create()}
    return(created)
  }

  [public return<Label> effects(none)]
  label([string] text) {
    [Label] created{[handle] ps_ui_label_create(text)}
    return(created)
  }

  [public return<CheckBox> effects(none)]
  checkBox([string] title, [bool] checked) {
    [CheckBox] created{[handle] ps_ui_checkbox_create(title, checked)}
    return(created)
  }

  [public return<Popup> effects(none)]
  popup() {
    [Popup] created{[handle] ps_ui_popup_create()}
    return(created)
  }

  [public return<Form> effects(none)]
  form() {
    [Form] created{[handle] ps_ui_form_create()}
    return(created)
  }

  [public return<Tabs> effects(none)]
  tabs() {
    [Tabs] created{[handle] ps_ui_tabs_create()}
    return(created)
  }

  // How the source and the page of a markdown preview scroll together: 0 independently, 1 linearly (the same
  // fraction), 2 by block (the same source line; the default), 3 the page follows the text cursor.
  [public return<bool> effects(none)]
  setPreviewScrollMode([i32] mode) {
    return(ps_ui_preview_set_scroll_mode(mode))
  }

  // Waits on the events and calls the handlers registered in `handlers` until the app quits (handlers.prime,
  // `AppHandlers.run`). The low level beside it is `waitEvent`.
  [public effects(heap_alloc)]
  run<State>([AppHandlers<State> mut] handlers) {
    handlers.run()
  }

  [public return<AppEvent> effects(none)]
  waitEvent() {
    [i32] kind{ps_ui_wait_event()}
    if(kind == 1i32) {
      [AppEvent] event{[command] ps_ui_event_command()}
      return(event)
    }
    if(kind == 2i32) {
      [Window] window{[handle] ps_ui_event_window()}
      [AppEvent] event{[windowCloseRequested] window}
      return(event)
    }
    if(kind == 3i32) {
      [Window] window{[handle] ps_ui_event_window()}
      [AppEvent] event{[textChanged] window}
      return(event)
    }
    if(kind == 5i32) {
      [Widget] widget{[handle] ps_ui_event_widget()}
      [AppEvent] event{[controlChanged] widget}
      return(event)
    }
    if(kind == 6i32) {
      [AppEvent] event{[openFile] 0i32}
      return(event)
    }
    [AppEvent] event{}
    return(event)
  }

  // The path of the file an `openFile` event asks to open (valid until the next waitEvent).
  [public return</std/text/String> effects(none)]
  eventText() {
    return(ps_ui_event_text())
  }

  [public return<ItemList> effects(none)]
  itemList() {
    [ItemList] created{[handle] ps_ui_list_create()}
    return(created)
  }

  [public return<Button> effects(none)]
  button([string] title) {
    [Button] created{[handle] ps_ui_button_create(title)}
    return(created)
  }

  // The file types the app declares it can open: a name ("Markdown") and its extensions ("md,markdown").
  [public return<i32> effects(none)]
  documentTypeCount() {
    return(ps_ui_document_type_count())
  }

  [public return</std/text/String> effects(none)]
  documentTypeName([i32] index) {
    return(ps_ui_document_type_name(index))
  }

  [public return</std/text/String> effects(none)]
  documentTypeExtensions([i32] index) {
    return(ps_ui_document_type_extensions(index))
  }

  // The path of this app's bundle ("" when it does not run from one).
  [public return</std/text/String> effects(none)]
  appPath() {
    return(ps_ui_app_path())
  }

  // The application the system opens files of this extension with ("" when unknown).
  [public return</std/text/String> effects(none)]
  defaultApp([/std/text/String] extension) {
    return(ps_ui_default_app(extension))
  }

  // Makes the application at the path `application` ("" for this app) the default for the comma separated
  // extensions.
  [public return<bool> effects(none)]
  setDefaultApp([/std/text/String] extensions, [/std/text/String] application) {
    return(ps_ui_set_default_app(extensions, application))
  }

  // Why the last loadFile/saveFile failed; empty when none has.
  [public return</std/text/String> effects(none)]
  lastError() {
    return(ps_ui_last_error())
  }

  [public return</std/text/String> effects(none)]
  openPanel([string] title) {
    return(ps_ui_open_panel(title))
  }

  [public return</std/text/String> effects(none)]
  savePanel([string] title, [string] suggestedName) {
    return(ps_ui_save_panel(title, suggestedName))
  }

  // The recent files list (the platform's, kept between runs).
  [public return<bool> effects(none)]
  addRecent([/std/text/String] path) {
    return(ps_ui_recent_add(path))
  }

  [public return</std/text/String> effects(none)]
  recentPath([i32] index) {
    return(ps_ui_recent_path(index))
  }

  [public return<bool> effects(none)]
  clearRecent() {
    return(ps_ui_recent_clear())
  }

  // Integers and lists of texts the app keeps between runs.
  [public return<i32> effects(none)]
  intPref([string] key, [i32] fallback) {
    return(ps_ui_pref_get_int(key, fallback))
  }

  [public return<bool> effects(none)]
  setIntPref([string] key, [i32] value) {
    return(ps_ui_pref_set_int(key, value))
  }

  [public return<bool> effects(none)]
  listClear([string] key) {
    return(ps_ui_pref_list_clear(key))
  }

  [public return<bool> effects(none)]
  listAdd([string] key, [/std/text/String] item) {
    return(ps_ui_pref_list_add(key, item))
  }

  [public return<i32> effects(none)]
  listCount([string] key) {
    return(ps_ui_pref_list_count(key))
  }

  [public return</std/text/String> effects(none)]
  listGet([string] key, [i32] index) {
    return(ps_ui_pref_list_get(key, index))
  }

  // A boolean the app keeps between runs: the stored value, or `fallback` when none was stored.
  [public return<bool> effects(none)]
  boolPref([string] key, [bool] fallback) {
    return(ps_ui_pref_get_bool(key, fallback))
  }

  [public return<bool> effects(none)]
  setBoolPref([string] key, [bool] value) {
    return(ps_ui_pref_set_bool(key, value))
  }

  // True when the last openPanel/savePanel returned a path, false when cancelled.
  [public return<bool> effects(none)]
  panelChosen() {
    return(ps_ui_panel_chosen())
  }

  [public return<i32> effects(none)]
  alert([string] message, [/std/text/String] detail, [string] buttons) {
    return(ps_ui_alert(message, detail, buttons))
  }
}

// Starts the app on the calling thread; `started` is false when the backend
// cannot start.
[public return<App> effects(none)]
start_app([string] name) {
  [bool] ok{ps_ui_init(name)}
  [App] app{[started] ok}
  return(app)
}

}
}
}
