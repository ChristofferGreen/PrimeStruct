namespace std {
namespace ui {
namespace native {

[public struct]
Window() {
  [public u64] handle{0u64}

  [public return<bool> effects(none)]
  setTitle([/std/text/String] title) {
    return(ps_ui_window_set_title(this.handle, title))
  }

  // Remembers the window's position and size between runs under `name`.
  [public return<bool> effects(none)]
  setAutosaveName([string] name) {
    return(ps_ui_window_set_autosave_name(this.handle, name))
  }

  [public return<bool> effects(none)]
  setContent([TextView] view) {
    return(ps_ui_window_set_content(this.handle, view.handle))
  }

  // A control (usually a form or tabs) as the window's content, as in a settings window.
  [public return<bool> effects(none)]
  setContentWidget([Widget] widget) {
    return(ps_ui_window_set_content(this.handle, widget.handle))
  }

  // A settings window: never a tab, sized to fit its content, no minimize or zoom.
  [public return<bool> effects(none)]
  setSettingsStyle() {
    return(ps_ui_window_set_style(this.handle, 1i32))
  }

  [public return<bool> effects(none)]
  setEdited([bool] edited) {
    return(ps_ui_window_set_edited(this.handle, edited))
  }

  [public return<bool> effects(none)]
  show() {
    return(ps_ui_window_show(this.handle))
  }

  // Joins `tab` to this window's tab group and selects it.
  [public return<bool> effects(none)]
  addTab([Window] tab) {
    return(ps_ui_window_add_tab(this.handle, tab.handle))
  }

  // Joins `tab` to this window's tab group right after this window, behind the selected tab: it is neither shown nor
  // selected, and the platform builds what it shows (layout, toolbar, preview page) when the user first picks it.
  [public return<bool> effects(none)]
  addBackgroundTab([Window] tab) {
    return(ps_ui_window_add_background_tab(this.handle, tab.handle))
  }

  // The tabs of this window's group in tab-bar order (1 when it has no group).
  [public return<i32> effects(none)]
  tabCount() {
    return(ps_ui_window_tab_count(this.handle))
  }

  [public return<Window> effects(none)]
  tabAt([i32] index) {
    [Window] found{[handle] ps_ui_window_tab_at(this.handle, index)}
    return(found)
  }

  // Selects this window's tab and makes it the active window.
  [public return<bool> effects(none)]
  select() {
    return(ps_ui_window_select(this.handle))
  }

  [public return<TextView> effects(none)]
  content() {
    [TextView] view{[handle] ps_ui_window_content(this.handle)}
    return(view)
  }

  // The file the window's document is saved to ("" when none); stored by the backend.
  [public return<bool> effects(none)]
  setPath([/std/text/String] file) {
    return(ps_ui_window_set_path(this.handle, file))
  }

  [public return</std/text/String> effects(none)]
  path() {
    return(ps_ui_window_path(this.handle))
  }

  [public return<bool> effects(none)]
  hasPath() {
    return(ps_ui_window_has_path(this.handle))
  }

  // The markdown preview beside the window's text view: on or off, whether it is on, and rendering it
  // again after the text changed.
  [public return<bool> effects(none)]
  setPreview([bool] on) {
    return(ps_ui_window_set_preview(this.handle, on))
  }

  [public return<bool> effects(none)]
  hasPreview() {
    return(ps_ui_window_has_preview(this.handle))
  }

  [public return<bool> effects(none)]
  refreshPreview() {
    return(ps_ui_window_refresh_preview(this.handle))
  }

  // How much of the window the preview takes: 0 the text alone, 1 text and page, 2 the page alone.
  [public return<bool> effects(none)]
  setPreviewMode([i32] mode) {
    return(ps_ui_window_set_preview_mode(this.handle, mode))
  }

  [public return<i32> effects(none)]
  previewMode() {
    return(ps_ui_window_preview_mode(this.handle))
  }

  // Shows `bar` above the content; hideToolbar() takes it away again.
  [public return<bool> effects(none)]
  setToolbar([Toolbar] bar) {
    return(ps_ui_window_set_toolbar(this.handle, bar.handle))
  }

  [public return<bool> effects(none)]
  hideToolbar() {
    return(ps_ui_window_set_toolbar(this.handle, 0u64))
  }

  // Runs PrimeScript `text` (named `name`) on the embedded interpreter and shows its output in the output pane under
  // the content; `endCommand` arrives as a command when the run ends. False when a run is going or the interpreter
  // cannot load.
  [public return<bool> effects(none)]
  runScript([/std/text/String] name, [/std/text/String] text, [i32] endCommand) {
    return(ps_ui_script_run(this.handle, name, text, endCommand))
  }

  // The same run whose end calls the handler of `end` (`AppHandlers.command`).
  [public return<bool> effects(none)]
  runScriptCommand([/std/text/String] name, [/std/text/String] text, [Command] end) {
    return(ps_ui_script_run(this.handle, name, text, end.id))
  }

  [public return<bool> effects(none)]
  stopScript() {
    return(ps_ui_script_stop(this.handle))
  }

  [public return<bool> effects(none)]
  scriptRunning() {
    return(ps_ui_script_running(this.handle))
  }

  [public return<bool> effects(none)]
  setOutputVisible([bool] visible) {
    return(ps_ui_window_set_output_visible(this.handle, visible))
  }

  [public return<bool> effects(none)]
  outputVisible() {
    return(ps_ui_window_output_visible(this.handle))
  }

  // Marks the segment with `commandId` of the toolbar as selected.
  [public return<bool> effects(none)]
  selectToolbarItem([i32] commandId) {
    return(ps_ui_window_toolbar_select(this.handle, commandId))
  }

  [public return<bool> effects(none)]
  selectToolbarCommand([Command] command) {
    return(ps_ui_window_toolbar_select(this.handle, command.id))
  }

  [public return<bool> effects(none)]
  close() {
    return(ps_ui_window_close(this.handle))
  }
}

[public struct]
TextView() {
  [public u64] handle{0u64}

  // The generic handle of the view, for the pointer and key handlers of `AppHandlers` (`onKeyDown(text.widget(), h)`).
  [public return<Widget> effects(none)]
  widget() {
    [Widget] generic{[handle] this.handle}
    return(generic)
  }

  [public return</std/text/String> effects(none)]
  text() {
    return(ps_ui_text_view_get_text(this.handle))
  }

  [public return<bool> effects(none)]
  setText([/std/text/String] value) {
    return(ps_ui_text_view_set_text(this.handle, value))
  }

  [public return<bool> effects(none)]
  setMonospace([bool] monospace) {
    return(ps_ui_text_view_set_monospace(this.handle, monospace))
  }

  // The size of the text in points (6 to 96).
  [public return<bool> effects(none)]
  setFontSize([i32] points) {
    return(ps_ui_text_view_set_font_size(this.handle, points))
  }

  // The backend reads the UTF-8 file itself; false (see App.lastError()) when it
  // cannot be read or is not valid UTF-8. A successful load leaves the view unmodified.
  [public return<bool> effects(none)]
  loadFile([/std/text/String] path) {
    return(ps_ui_text_view_load_file(this.handle, path))
  }

  // Writes the text to the file; call clearModified() once the text counts as saved.
  [public return<bool> effects(none)]
  saveFile([/std/text/String] path) {
    return(ps_ui_text_view_save_file(this.handle, path))
  }

  // Removes all style runs (see addStyle).
  [public return<bool> effects(none)]
  clearStyles() {
    return(ps_ui_text_view_clear_styles(this.handle))
  }

  // Colours the UTF-8 byte range [startByte, endByte) with 0xRRGGBB; flags: 1 bold, 2 italic.
  // False for an empty range or one that is not on code point boundaries inside the text.
  // Later runs win where they overlap; replacing the text drops all runs.
  [public return<bool> effects(none)]
  addStyle([i32] startByte, [i32] endByte, [i32] rgb, [i32] flags) {
    return(ps_ui_text_view_add_style(this.handle, startByte, endByte, rgb, flags))
  }

  // Syntax highlighting for the language of the file name `path` (by extension:
  // .prime, C/C++, .py, .json, .md); anything else just clears the styles.
  [public return<bool> effects(none)]
  highlight([/std/text/String] path) {
    return(ps_ui_text_view_highlight(this.handle, path))
  }

  // Shows or hides a bar of line numbers (one per paragraph) to the left of the text.
  [public return<bool> effects(none)]
  setLineNumbers([bool] visible) {
    return(ps_ui_text_view_set_line_numbers(this.handle, visible))
  }

  // Wraps long lines at the view's width (the default) or lets them run to the right.
  [public return<bool> effects(none)]
  setWrapping([bool] wrap) {
    return(ps_ui_text_view_set_wrapping(this.handle, wrap))
  }

  [public return<bool> effects(none)]
  isModified() {
    return(ps_ui_text_view_is_modified(this.handle))
  }

  [public return<bool> effects(none)]
  clearModified() {
    return(ps_ui_text_view_clear_modified(this.handle))
  }

  // Applies a markdown editing operation (PS_UI_MARKDOWN_*: bold, a list, a table row, ...) to the text and the
  // selection as one undoable change; `a` and `b` are its arguments. False when it does not apply.
  [public return<bool> effects(none)]
  markdownEdit([i32] operation, [i32] a, [i32] b) {
    return(ps_ui_text_view_markdown_edit(this.handle, operation, a, b))
  }

  // Tab and Shift-Tab move between the cells of a markdown table.
  [public return<bool> effects(none)]
  setMarkdownEditing([bool] on) {
    return(ps_ui_text_view_set_markdown_editing(this.handle, on))
  }
}

// A row of buttons above a window's content; every item is a command, like a menu item.
[public struct]
Toolbar() {
  [public u64] handle{0u64}

  [public return<bool> effects(none)]
  button([string] title, [string] symbol, [i32] commandId) {
    return(ps_ui_toolbar_add_button(this.handle, title, symbol, commandId))
  }

  // A button that calls the handler of `command` (`AppHandlers.command`).
  [public return<bool> effects(none)]
  button([string] title, [string] symbol, [Command] command) {
    return(ps_ui_toolbar_add_button(this.handle, title, symbol, command.id))
  }

  // `button` of a command, for an argument that is a method call such as `commands.at(1i32)`: the overloads of
  // `button` are chosen by the type of the argument, and a method call has no type known there.
  [public return<bool> effects(none)]
  commandButton([string] title, [string] symbol, [Command] command) {
    return(ps_ui_toolbar_add_button(this.handle, title, symbol, command.id))
  }

  // Segments titled by `titles` (separated by |) with the commands firstCommandId, firstCommandId + 1, ...
  [public return<bool> effects(none)]
  segments([string] titles, [i32] firstCommandId) {
    return(ps_ui_toolbar_add_segments(this.handle, titles, firstCommandId))
  }

  // Segments that call the handler of `commands` (`AppHandlers.commandRange`) with the offset of the chosen one; the
  // range has one command per title.
  [public return<bool> effects(none)]
  commandSegments([string] titles, [CommandRange] commands) {
    return(ps_ui_toolbar_add_segments(this.handle, titles, commands.first))
  }

  [public return<bool> effects(none)]
  menu([string] title, [string] symbol, [Menu] items) {
    return(ps_ui_toolbar_add_menu(this.handle, title, symbol, items.handle))
  }

  [public return<bool> effects(none)]
  separator() {
    return(ps_ui_toolbar_add_separator(this.handle))
  }
}

[public struct]
Menu() {
  [public u64] handle{0u64}

  [public return<bool> effects(none)]
  item([string] title, [string] shortcut, [i32] commandId) {
    return(ps_ui_menu_add_item(this.handle, title, shortcut, commandId))
  }

  // An item that calls the handler of `command` (`AppHandlers.command`) when it is chosen.
  [public return<bool> effects(none)]
  item([string] title, [string] shortcut, [Command] command) {
    return(ps_ui_menu_add_item(this.handle, title, shortcut, command.id))
  }

  // `item` of a command, for an argument that is a method call such as `commands.at(1i32)`: the overloads of `item`
  // are chosen by the type of the argument, and a method call has no type known there.
  [public return<bool> effects(none)]
  commandItem([string] title, [string] shortcut, [Command] command) {
    return(ps_ui_menu_add_item(this.handle, title, shortcut, command.id))
  }

  // Puts or removes a check mark on the items added with `commandId`.
  [public return<bool> effects(none)]
  setChecked([i32] commandId, [bool] checked) {
    return(ps_ui_menu_set_checked(this.handle, commandId, checked))
  }

  // Puts or removes the check mark on the items of `command`.
  [public return<bool> effects(none)]
  setChecked([Command] command, [bool] checked) {
    return(ps_ui_menu_set_checked(this.handle, command.id, checked))
  }

  [public return<bool> effects(none)]
  setCommandChecked([Command] command, [bool] checked) {
    return(ps_ui_menu_set_checked(this.handle, command.id, checked))
  }

  // The check mark of the items with `commandId` shows whether the active window has a preview.
  [public return<bool> effects(none)]
  followPreview([i32] commandId) {
    return(ps_ui_menu_follow_preview(this.handle, commandId))
  }

  [public return<bool> effects(none)]
  followPreviewCommand([Command] command) {
    return(ps_ui_menu_follow_preview(this.handle, command.id))
  }

  // Adds an item that opens `child`, a menu that is not in the bar.
  [public return<bool> effects(none)]
  submenu([string] title, [Menu] child) {
    return(ps_ui_menu_add_submenu(this.handle, title, child.handle))
  }

  [public return<bool> effects(none)]
  clear() {
    return(ps_ui_menu_clear(this.handle))
  }

  // Appends one item per recent file (most recent first, at most maxItems) with the command ids
  // firstCommandId, firstCommandId + 1, ...; returns how many it added.
  [public return<i32> effects(none)]
  addRecentFiles([i32] firstCommandId, [i32] maxItems) {
    return(ps_ui_menu_add_recent_files(this.handle, firstCommandId, maxItems))
  }

  // The same items with the commands of `commands` (`AppHandlers.commandRange`), at most one per command: choosing
  // the file at offset i calls the range's handler with i, the index `App.recentPath` takes.
  [public return<i32> effects(none)]
  addRecentFileCommands([CommandRange] commands) {
    return(ps_ui_menu_add_recent_files(this.handle, commands.first, commands.count))
  }

  [public return<bool> effects(none)]
  separator() {
    return(ps_ui_menu_add_separator(this.handle))
  }

  [public return<bool> effects(none)]
  addToBar() {
    return(ps_ui_menu_bar_add(this.handle))
  }

  // The application menu replaces the platform's default one and comes first.
  [public return<bool> effects(none)]
  addToBarAsApp() {
    return(ps_ui_menu_bar_add_role(this.handle, 1i32))
  }

  // The platform lists the open windows in the Window menu.
  [public return<bool> effects(none)]
  addToBarAsWindow() {
    return(ps_ui_menu_bar_add_role(this.handle, 2i32))
  }

  [public return<bool> effects(none)]
  addToBarAsHelp() {
    return(ps_ui_menu_bar_add_role(this.handle, 3i32))
  }

  [public return<bool> effects(none)]
  hide() {
    return(ps_ui_menu_add_standard(this.handle, 10i32))
  }

  [public return<bool> effects(none)]
  hideOthers() {
    return(ps_ui_menu_add_standard(this.handle, 11i32))
  }

  [public return<bool> effects(none)]
  minimize() {
    return(ps_ui_menu_add_standard(this.handle, 12i32))
  }

  [public return<bool> effects(none)]
  zoom() {
    return(ps_ui_menu_add_standard(this.handle, 13i32))
  }

  [public return<bool> effects(none)]
  bringAllToFront() {
    return(ps_ui_menu_add_standard(this.handle, 14i32))
  }

  [public return<bool> effects(none)]
  fullScreen() {
    return(ps_ui_menu_add_standard(this.handle, 15i32))
  }

  [public return<bool> effects(none)]
  help() {
    return(ps_ui_menu_add_standard(this.handle, 16i32))
  }

  [public return<bool> effects(none)]
  showTabBar() {
    return(ps_ui_menu_add_standard(this.handle, 17i32))
  }

  [public return<bool> effects(none)]
  mergeAllWindows() {
    return(ps_ui_menu_add_standard(this.handle, 18i32))
  }

  [public return<bool> effects(none)]
  moveTabToNewWindow() {
    return(ps_ui_menu_add_standard(this.handle, 19i32))
  }

  [public return<bool> effects(none)]
  nextTab() {
    return(ps_ui_menu_add_standard(this.handle, 20i32))
  }

  [public return<bool> effects(none)]
  previousTab() {
    return(ps_ui_menu_add_standard(this.handle, 21i32))
  }

  [public return<bool> effects(none)]
  undo() {
    return(ps_ui_menu_add_standard(this.handle, 1i32))
  }

  [public return<bool> effects(none)]
  redo() {
    return(ps_ui_menu_add_standard(this.handle, 2i32))
  }

  [public return<bool> effects(none)]
  cut() {
    return(ps_ui_menu_add_standard(this.handle, 3i32))
  }

  [public return<bool> effects(none)]
  copy() {
    return(ps_ui_menu_add_standard(this.handle, 4i32))
  }

  [public return<bool> effects(none)]
