namespace std {
namespace ui {
namespace native {

[public struct]
Window() {
  [public u64] handle{0u64}

  [public return<bool>]
  setTitle([/std/text/String] title) {
    return(ps_ui_window_set_title(this.handle, title))
  }

  [public return<bool>]
  setContent([TextView] view) {
    return(ps_ui_window_set_content(this.handle, view.handle))
  }

  [public return<bool>]
  setEdited([bool] edited) {
    return(ps_ui_window_set_edited(this.handle, edited))
  }

  [public return<bool>]
  show() {
    return(ps_ui_window_show(this.handle))
  }

  // Joins `tab` to this window's tab group and selects it.
  [public return<bool>]
  addTab([Window] tab) {
    return(ps_ui_window_add_tab(this.handle, tab.handle))
  }

  // The tabs of this window's group in tab-bar order (1 when it has no group).
  [public return<i32>]
  tabCount() {
    return(ps_ui_window_tab_count(this.handle))
  }

  [public return<Window>]
  tabAt([i32] index) {
    [Window] found{[handle] ps_ui_window_tab_at(this.handle, index)}
    return(found)
  }

  // Selects this window's tab and makes it the active window.
  [public return<bool>]
  select() {
    return(ps_ui_window_select(this.handle))
  }

  [public return<TextView>]
  content() {
    [TextView] view{[handle] ps_ui_window_content(this.handle)}
    return(view)
  }

  // The file the window's document is saved to ("" when none); stored by the backend.
  [public return<bool>]
  setPath([/std/text/String] file) {
    return(ps_ui_window_set_path(this.handle, file))
  }

  [public return</std/text/String>]
  path() {
    return(ps_ui_window_path(this.handle))
  }

  [public return<bool>]
  hasPath() {
    return(ps_ui_window_has_path(this.handle))
  }

  [public return<bool>]
  close() {
    return(ps_ui_window_close(this.handle))
  }
}

[public struct]
TextView() {
  [public u64] handle{0u64}

  [public return</std/text/String>]
  text() {
    return(ps_ui_text_view_get_text(this.handle))
  }

  [public return<bool>]
  setText([/std/text/String] value) {
    return(ps_ui_text_view_set_text(this.handle, value))
  }

  [public return<bool>]
  setMonospace([bool] monospace) {
    return(ps_ui_text_view_set_monospace(this.handle, monospace))
  }

  // The backend reads the UTF-8 file itself; false (see App.lastError()) when it
  // cannot be read or is not valid UTF-8. A successful load leaves the view unmodified.
  [public return<bool>]
  loadFile([/std/text/String] path) {
    return(ps_ui_text_view_load_file(this.handle, path))
  }

  // Writes the text to the file; call clearModified() once the text counts as saved.
  [public return<bool>]
  saveFile([/std/text/String] path) {
    return(ps_ui_text_view_save_file(this.handle, path))
  }

  // Removes all style runs (see addStyle).
  [public return<bool>]
  clearStyles() {
    return(ps_ui_text_view_clear_styles(this.handle))
  }

  // Colours the UTF-8 byte range [startByte, endByte) with 0xRRGGBB; flags: 1 bold, 2 italic.
  // False for an empty range or one that is not on code point boundaries inside the text.
  // Later runs win where they overlap; replacing the text drops all runs.
  [public return<bool>]
  addStyle([i32] startByte, [i32] endByte, [i32] rgb, [i32] flags) {
    return(ps_ui_text_view_add_style(this.handle, startByte, endByte, rgb, flags))
  }

  // Syntax highlighting for the language of the file name `path` (by extension:
  // .prime, C/C++, .py, .json, .md); anything else just clears the styles.
  [public return<bool>]
  highlight([/std/text/String] path) {
    return(ps_ui_text_view_highlight(this.handle, path))
  }

  // Shows or hides a bar of line numbers (one per paragraph) to the left of the text.
  [public return<bool>]
  setLineNumbers([bool] visible) {
    return(ps_ui_text_view_set_line_numbers(this.handle, visible))
  }

  // Wraps long lines at the view's width (the default) or lets them run to the right.
  [public return<bool>]
  setWrapping([bool] wrap) {
    return(ps_ui_text_view_set_wrapping(this.handle, wrap))
  }

  [public return<bool>]
  isModified() {
    return(ps_ui_text_view_is_modified(this.handle))
  }

  [public return<bool>]
  clearModified() {
    return(ps_ui_text_view_clear_modified(this.handle))
  }
}

[public struct]
Menu() {
  [public u64] handle{0u64}

  [public return<bool>]
  item([string] title, [string] shortcut, [i32] commandId) {
    return(ps_ui_menu_add_item(this.handle, title, shortcut, commandId))
  }

  // Puts or removes a check mark on the items added with `commandId`.
  [public return<bool>]
  setChecked([i32] commandId, [bool] checked) {
    return(ps_ui_menu_set_checked(this.handle, commandId, checked))
  }

  // Adds an item that opens `child`, a menu that is not in the bar.
  [public return<bool>]
  submenu([string] title, [Menu] child) {
    return(ps_ui_menu_add_submenu(this.handle, title, child.handle))
  }

  [public return<bool>]
  clear() {
    return(ps_ui_menu_clear(this.handle))
  }

  // Appends one item per recent file (most recent first, at most maxItems) with the command ids
  // firstCommandId, firstCommandId + 1, ...; returns how many it added.
  [public return<i32>]
  addRecentFiles([i32] firstCommandId, [i32] maxItems) {
    return(ps_ui_menu_add_recent_files(this.handle, firstCommandId, maxItems))
  }

  [public return<bool>]
  separator() {
    return(ps_ui_menu_add_separator(this.handle))
  }

  [public return<bool>]
  addToBar() {
    return(ps_ui_menu_bar_add(this.handle))
  }

  // The application menu replaces the platform's default one and comes first.
  [public return<bool>]
  addToBarAsApp() {
    return(ps_ui_menu_bar_add_role(this.handle, 1i32))
  }

  // The platform lists the open windows in the Window menu.
  [public return<bool>]
  addToBarAsWindow() {
    return(ps_ui_menu_bar_add_role(this.handle, 2i32))
  }

  [public return<bool>]
  addToBarAsHelp() {
    return(ps_ui_menu_bar_add_role(this.handle, 3i32))
  }

  [public return<bool>]
  hide() {
    return(ps_ui_menu_add_standard(this.handle, 10i32))
  }

  [public return<bool>]
  hideOthers() {
    return(ps_ui_menu_add_standard(this.handle, 11i32))
  }

  [public return<bool>]
  minimize() {
    return(ps_ui_menu_add_standard(this.handle, 12i32))
  }

  [public return<bool>]
  zoom() {
    return(ps_ui_menu_add_standard(this.handle, 13i32))
  }

  [public return<bool>]
  bringAllToFront() {
    return(ps_ui_menu_add_standard(this.handle, 14i32))
  }

  [public return<bool>]
  fullScreen() {
    return(ps_ui_menu_add_standard(this.handle, 15i32))
  }

  [public return<bool>]
  help() {
    return(ps_ui_menu_add_standard(this.handle, 16i32))
  }

  [public return<bool>]
  showTabBar() {
    return(ps_ui_menu_add_standard(this.handle, 17i32))
  }

  [public return<bool>]
  mergeAllWindows() {
    return(ps_ui_menu_add_standard(this.handle, 18i32))
  }

  [public return<bool>]
  moveTabToNewWindow() {
    return(ps_ui_menu_add_standard(this.handle, 19i32))
  }

  [public return<bool>]
  nextTab() {
    return(ps_ui_menu_add_standard(this.handle, 20i32))
  }

  [public return<bool>]
  previousTab() {
    return(ps_ui_menu_add_standard(this.handle, 21i32))
  }

  [public return<bool>]
  undo() {
    return(ps_ui_menu_add_standard(this.handle, 1i32))
  }

  [public return<bool>]
  redo() {
    return(ps_ui_menu_add_standard(this.handle, 2i32))
  }

  [public return<bool>]
  cut() {
    return(ps_ui_menu_add_standard(this.handle, 3i32))
  }

  [public return<bool>]
  copy() {
    return(ps_ui_menu_add_standard(this.handle, 4i32))
  }

  [public return<bool>]
  paste() {
    return(ps_ui_menu_add_standard(this.handle, 5i32))
  }

  [public return<bool>]
  selectAll() {
    return(ps_ui_menu_add_standard(this.handle, 6i32))
  }

  [public return<bool>]
  find() {
    return(ps_ui_menu_add_standard(this.handle, 7i32))
  }

  [public return<bool>]
  quit() {
    return(ps_ui_menu_add_standard(this.handle, 8i32))
  }

  [public return<bool>]
  about() {
    return(ps_ui_menu_add_standard(this.handle, 9i32))
  }
}

// What waitEvent() returns. Typing, selection, clipboard and undo are handled by
// the native text view and never reach the program.
[public sum]
AppEvent {
  quitRequested
  [i32] command
  [Window] windowCloseRequested
  [Window] textChanged
}

[public struct]
App() {
  [public bool] started{false}

  [public return<void>]
  quit() {
    ps_ui_quit()
  }

  [public return<Window>]
  window([string] title, [i32] width, [i32] height) {
    [Window] created{[handle] ps_ui_window_create(title, width, height)}
    return(created)
  }

  // The window the user is working in (the selected tab); handle 0 when none is open.
  [public return<Window>]
  activeWindow() {
    [Window] active{[handle] ps_ui_active_window()}
    return(active)
  }

  [public return<i32>]
  windowCount() {
    return(ps_ui_window_count())
  }

  // The index-th open window in creation order.
  [public return<Window>]
  windowAt([i32] index) {
    [Window] found{[handle] ps_ui_window_at(index)}
    return(found)
  }

  [public return<TextView>]
  textView() {
    [TextView] created{[handle] ps_ui_text_view_create()}
    return(created)
  }

  [public return<Menu>]
  menu([string] title) {
    [Menu] created{[handle] ps_ui_menu_create(title)}
    return(created)
  }

  [public return<AppEvent>]
  waitEvent() {
    [i32] kind{ps_ui_wait_event()}
    if(kind == 1i32) {
      [AppEvent] event{[command] ps_ui_event_command()}
      return(event)
    }
    if(kind == 2i32) {
      [Window] window{[handle] ps_ui_event_window()}
      [AppEvent] event{[windowCloseRequested] window}
      return(event)
    }
    if(kind == 3i32) {
      [Window] window{[handle] ps_ui_event_window()}
      [AppEvent] event{[textChanged] window}
      return(event)
    }
    [AppEvent] event{}
    return(event)
  }

  // Why the last loadFile/saveFile failed; empty when none has.
  [public return</std/text/String>]
  lastError() {
    return(ps_ui_last_error())
  }

  [public return</std/text/String>]
  openPanel([string] title) {
    return(ps_ui_open_panel(title))
  }

  [public return</std/text/String>]
  savePanel([string] title, [string] suggestedName) {
    return(ps_ui_save_panel(title, suggestedName))
  }

  // The recent files list (the platform's, kept between runs).
  [public return<bool>]
  addRecent([/std/text/String] path) {
    return(ps_ui_recent_add(path))
  }

  [public return</std/text/String>]
  recentPath([i32] index) {
    return(ps_ui_recent_path(index))
  }

  [public return<bool>]
  clearRecent() {
    return(ps_ui_recent_clear())
  }

  // A boolean the app keeps between runs: the stored value, or `fallback` when none was stored.
  [public return<bool>]
  boolPref([string] key, [bool] fallback) {
    return(ps_ui_pref_get_bool(key, fallback))
  }

  [public return<bool>]
  setBoolPref([string] key, [bool] value) {
    return(ps_ui_pref_set_bool(key, value))
  }

  // True when the last openPanel/savePanel returned a path, false when cancelled.
  [public return<bool>]
  panelChosen() {
    return(ps_ui_panel_chosen())
  }

  [public return<i32>]
  alert([string] message, [/std/text/String] detail, [string] buttons) {
    return(ps_ui_alert(message, detail, buttons))
  }
}

// Starts the app on the calling thread; `started` is false when the backend
// cannot start.
[public return<App>]
start_app([string] name) {
  [bool] ok{ps_ui_init(name)}
  [App] app{[started] ok}
  return(app)
}

}
}
}
