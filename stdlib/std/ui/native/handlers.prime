// Native controls that take handler closures (docs/spec/stdlib-reference.md, Native UI; docs/WebAppsPlan.md,
// principle 7). An `AppHandlers<State>` holds the app's state and a table of handlers, each registered once, at setup:
// a click handler for a button, a change handler for a check box, pop-up or list, the commands of menu items and
// toolbar buttons, a range of commands for items that come in a row (toolbar segments, recent files), and the pointer
// and key handlers of any control or text view. `app.run(handlers)` then waits on the events and calls the handler of
// each, until the app quits. The command ids and widget handles that `App.waitEvent` reports stay inside this table.
import /std/collections/*
import /std/text/*
import /std/ui/events/*

namespace std {
namespace ui {
namespace native {

  // A command that `AppHandlers.command` registered with its handler: a menu item (`Menu.commandItem(title, shortcut,
  // command)`) or a toolbar button (`Toolbar.commandButton(title, symbol, command)`) that the user chooses calls it.
  // One command may sit in a menu and a toolbar at once; both call the same closure. The id is the one the C ABI
  // carries.
  [public struct]
  Command() {
    [public i32] id{0i32}
  }

  // `count` commands in a row that `AppHandlers.commandRange` registered with one handler, which gets the offset of
  // the chosen one (0 for the first). The controls that take consecutive ids take the whole range
  // (`Toolbar.commandSegments(titles, range)`, `Menu.addRecentFileCommands(range)`); a menu item or a toolbar button
  // takes one of them as a `Command` (`range.at(offset)`).
  [public struct]
  CommandRange() {
    [public i32] first{0i32}
    [public i32] count{0i32}

    // The command at `offset`, 0 to count - 1.
    [public return<Command>]
    at([i32] offset) {
      [i32] id{this.first + offset}
      return(Command{[id] id})
    }
  }

  // The handler of a command, of a button's click or of a pointer event.
  [public struct]
  NativeClickHandler<State>() {
    [public Function<void, Reference<State>, PointerEvent> mut] handler
  }

  // The handler of a range of commands: it gets the offset of the chosen command in the range.
  [public struct]
  NativeRangeHandler<State>() {
    [public Function<void, Reference<State>, i32> mut] handler
  }

  // Finds a control the state holds, for controls made after setup: it gives the control's handle, or 0 while there
  // is none.
  [public struct]
  NativeFindHandler<State>() {
    [public Function<u64, Reference<State>> mut] handler
  }

  // The handler of a check box's, pop-up's or list's change; its widget and kind lie in `AppHandlers.changeWidgets`
  // and `changeKinds` at the same index.
  [public struct]
  NativeChangeHandler<State>() {
    [public Function<void, Reference<State>, ChangeEvent> mut] handler
  }

  // The handler of a key pressed or released in a widget; its widget and event lie in `AppHandlers.keyWidgets` and
  // `keyKinds` at the same index.
  [public struct]
  NativeKeyHandler<State>() {
    [public Function<void, Reference<State>, KeyEvent> mut] handler
  }

  // The handler of a request to close a window, or of the user's change of a window's text.
  [public struct]
  NativeWindowHandler<State>() {
    [public Function<void, Reference<State>, Window> mut] handler
  }

  // The handler of the system's request to open a file (`AppEvent.openFile`): it gets the file's path.
  [public struct]
  NativeFileHandler<State>() {
    [public Function<void, Reference<State>, /std/text/String> mut] handler
  }

  // The handler of a request to quit: true lets the app quit, false keeps it running. An `afterEvent` handler has the
  // same type: true keeps `run` going.
  [public struct]
  NativeQuitHandler<State>() {
    [public Function<bool, Reference<State>> mut] handler
  }

  // The state of a native app and the handlers of its controls. Build it with the state (`AppHandlers<Counter>{[state]
  // Counter{}}`), register the handlers while the windows are set up, and pass it to `app.run(handlers)`.
  //
  // The handlers of one type sit in one vector and `run` calls each vector from one place: the native backend inlines
  // a `Function` call with every closure of its type, at each call site (struct methods are not real calls there yet,
  // TODO-5740), so an app's handlers are compiled once. The keys (widgets, kinds, command ids) are vectors of their
  // own: reading a `u64` or `i32` field of an element after the first faults on the VM (TODO-5733).
  [public struct]
  AppHandlers<State>() {
    // The state that every handler reads and changes; it comes to each handler as its first argument.
    [public State mut] state
    // Every handler that gets a `PointerEvent`: the commands, the clicks of buttons, the pointer handlers.
    [public vector<NativeClickHandler<State>> mut] clicks{vector<NativeClickHandler<State>>()}
    // What each command id handed out calls: command `first_command_id() + i` is `clicks[commandSlots[i]]` when that
    // slot is 0 or more, and otherwise one of the range `ranges[-1 - commandSlots[i]]`, whose first command is
    // `first_command_id() + rangeFirsts[-1 - commandSlots[i]]`.
    [public vector<i32> mut] commandSlots{vector<i32>()}
    [public vector<NativeRangeHandler<State>> mut] ranges{vector<NativeRangeHandler<State>>()}
    [public vector<i32> mut] rangeFirsts{vector<i32>()}
    // The buttons with a click handler, and the handler's index in `clicks`.
    [public vector<u64> mut] clickWidgets{vector<u64>()}
    [public vector<i32> mut] clickHandlers{vector<i32>()}
    // The change handlers; `changeWidgets[i]` is the control of `changes[i]` (0 for one that `changeFinds` finds) and
    // `changeKinds[i]` says how its event is read: 1 for a check box, 2 for a pop-up, 3 for a list (`change_event`).
    [public vector<NativeChangeHandler<State>> mut] changes{vector<NativeChangeHandler<State>>()}
    [public vector<u64> mut] changeWidgets{vector<u64>()}
    [public vector<i32> mut] changeKinds{vector<i32>()}
    // The controls the state holds (`onClickOf`, `on...ChangeOf`): `finds[i]` finds the control of the click handler
    // `clicks[findTargets[i]]` when `findIsClick[i]`, otherwise of the change handler `changes[findTargets[i]]`.
    [public vector<NativeFindHandler<State>> mut] finds{vector<NativeFindHandler<State>>()}
    [public vector<bool> mut] findIsClick{vector<bool>()}
    [public vector<i32> mut] findTargets{vector<i32>()}
    // The close and text handlers, and which one of each is called (the last registered; -1 for none).
    [public vector<NativeWindowHandler<State>> mut] windowHandlers{vector<NativeWindowHandler<State>>()}
    [public i32 mut] closeHandler{-1i32}
    [public i32 mut] textHandler{-1i32}
    [public vector<NativeFileHandler<State>> mut] opens{vector<NativeFileHandler<State>>()}
    // The quit and after-event handlers, and which one of each is called.
    [public vector<NativeQuitHandler<State>> mut] decisions{vector<NativeQuitHandler<State>>()}
    [public i32 mut] quitHandler{-1i32}
    [public i32 mut] afterHandler{-1i32}
    // The pointer and key handlers: `clicks[pointerHandlers[i]]` handles the event `pointerKinds[i]` of the widget
    // `pointerWidgets[i]`, `keys[i]` the event `keyKinds[i]` of `keyWidgets[i]`. The kinds are the bits of
    // `ps_ui_widget_watch`: 1 the pointer entering, 2 a press, 4 a release, 8 a key down, 16 a key up.
    [public vector<u64> mut] pointerWidgets{vector<u64>()}
    [public vector<i32> mut] pointerKinds{vector<i32>()}
    [public vector<i32> mut] pointerHandlers{vector<i32>()}
    [public vector<NativeKeyHandler<State>> mut] keys{vector<NativeKeyHandler<State>>()}
    [public vector<u64> mut] keyWidgets{vector<u64>()}
    [public vector<i32> mut] keyKinds{vector<i32>()}

    // Registers `handler` as a command and returns it, to add to menus and toolbars. Choosing the command calls the
    // handler with a click of the primary button without a position: the C ABI reports no pointer details. The ids
    // count up from `first_command_id()` (1000000), above the ones programs pick by hand for `waitEvent`, in the
    // order of registration, shared with `commandRange`.
    [mut effects(heap_alloc) return<Command>]
    command([Function<void, Reference<State>, PointerEvent> move] handler) {
      [i32] id{first_command_id() + this.commandSlots.count()}
      this.commandSlots.push(this.addClick(handler))
      return(Command{[id] id})
    }

    // Registers `count` commands in a row with one handler and returns them; choosing one calls the handler with its
    // offset in the range. For the controls that take consecutive ids (`Toolbar.commandSegments`,
    // `Menu.addRecentFileCommands`), and for items that differ by a number, such as Show Tab 1 to 9.
    [mut effects(heap_alloc) return<CommandRange>]
    commandRange([i32] count, [Function<void, Reference<State>, i32> move] handler) {
      [i32] first{this.commandSlots.count()}
      [i32] slot{-1i32 - this.ranges.count()}
      for([i32 mut] index{0i32}; index < count; ++index) {
        this.commandSlots.push(slot)
      }
      this.ranges.push(NativeRangeHandler<State>{[handler] handler})
      this.rangeFirsts.push(first)
      [i32] firstId{first_command_id() + first}
      return(CommandRange{[first] firstId, [count] count})
    }

    // Adds a handler of a `PointerEvent` and gives its index in `clicks`.
    [mut effects(heap_alloc) return<i32>]
    addClick([Function<void, Reference<State>, PointerEvent> move] handler) {
      [i32] index{this.clicks.count()}
      this.clicks.push(NativeClickHandler<State>{[handler] handler})
      return(index)
    }

    // Registers the handler of a click on `button`; the event is a primary-button click without a position.
    [mut effects(heap_alloc)]
    onClick([Button] button, [Function<void, Reference<State>, PointerEvent> move] handler) {
      this.clickHandlers.push(this.addClick(handler))
      this.clickWidgets.push(button.handle)
    }

    // The change handlers have a name per control rather than one `onChange` overloaded on the control: same-arity
    // overloads of a generic struct's methods do not resolve yet (TODO-5735).

    // Registers the handler of the user's click on `box`; the event's `checked` is the box's new state.
    [mut effects(heap_alloc)]
    onCheckBoxChange([CheckBox] box, [Function<void, Reference<State>, ChangeEvent> move] handler) {
      [i32] index{this.addChange(box.handle, 1i32, handler)}
    }

    // Registers the handler of the user's choice in `popup`; the event's `index` is the chosen item.
    [mut effects(heap_alloc)]
    onPopupChange([Popup] popup, [Function<void, Reference<State>, ChangeEvent> move] handler) {
      [i32] index{this.addChange(popup.handle, 2i32, handler)}
    }

    // Registers the handler of the user's change of the selection of `list`; the event's `index` is the first
    // selected row, or -1 when none is.
    [mut effects(heap_alloc)]
    onListChange([ItemList] list, [Function<void, Reference<State>, ChangeEvent> move] handler) {
      [i32] index{this.addChange(list.handle, 3i32, handler)}
    }

    // Adds a change handler and gives its index in `changes`.
    [mut effects(heap_alloc) return<i32>]
    addChange([u64] widget, [i32] kind, [Function<void, Reference<State>, ChangeEvent> move] handler) {
      [i32] index{this.changes.count()}
      this.changes.push(NativeChangeHandler<State>{[handler] handler})
      this.changeWidgets.push(widget)
      this.changeKinds.push(kind)
      return(index)
    }

    // The same handlers for controls that do not exist yet at setup, such as the controls of a window the app builds
    // when the user first asks for it: `find` gives the control's handle from the state when an event comes (0 while
    // there is none), so the handler is still registered once, at setup.

    // Registers the handler of a click on the button that `find` gives.
    [mut effects(heap_alloc)]
    onClickOf([Function<u64, Reference<State>> move] find,
              [Function<void, Reference<State>, PointerEvent> move] handler) {
      this.addFind(find, true, this.addClick(handler))
    }

    [mut effects(heap_alloc)]
    onCheckBoxChangeOf([Function<u64, Reference<State>> move] find,
                       [Function<void, Reference<State>, ChangeEvent> move] handler) {
      this.addFind(find, false, this.addChange(0u64, 1i32, handler))
    }

    [mut effects(heap_alloc)]
    onPopupChangeOf([Function<u64, Reference<State>> move] find,
                    [Function<void, Reference<State>, ChangeEvent> move] handler) {
      this.addFind(find, false, this.addChange(0u64, 2i32, handler))
    }

    [mut effects(heap_alloc)]
    onListChangeOf([Function<u64, Reference<State>> move] find,
                   [Function<void, Reference<State>, ChangeEvent> move] handler) {
      this.addFind(find, false, this.addChange(0u64, 3i32, handler))
    }

    [mut effects(heap_alloc)]
    addFind([Function<u64, Reference<State>> move] find, [bool] isClick, [i32] target) {
      this.finds.push(NativeFindHandler<State>{[handler] find})
      this.findIsClick.push(isClick)
      this.findTargets.push(target)
    }

    // The pointer and key handlers take any control or text view as a `Widget` (`button.widget()`, `text.widget()`),
    // not one method per control: same-arity overloads of a generic struct's methods do not resolve yet (TODO-5735).
    // Registering one asks the platform for that event of the widget (`ps_ui_widget_watch`); widgets without such
    // handlers are not watched, so the platform tracks nothing for them. A later handler for the same event of a
    // widget replaces an earlier one. The events have a position from the widget's top left corner (a text view's
    // visible part) and the modifiers held.

    // Registers the handler of the pointer moving onto `control`; the event has no button and `clickCount` 0. The
    // pointer leaving it calls nothing.
    [mut effects(heap_alloc)]
    onMouseOver([Widget] control, [Function<void, Reference<State>, PointerEvent> move] handler) {
      this.addPointerHandler(control, 1i32, handler)
    }

    // Registers the handler of a pointer button pressed on `control`; `clickCount` is 2 for the second press of a
    // double click.
    [mut effects(heap_alloc)]
    onMouseDown([Widget] control, [Function<void, Reference<State>, PointerEvent> move] handler) {
      this.addPointerHandler(control, 2i32, handler)
    }

    // Registers the handler of the release of a press on `control` (wherever the pointer is then). A whole click on a
    // button calls its press, its release and then its `onClick` handler.
    [mut effects(heap_alloc)]
    onMouseUp([Widget] control, [Function<void, Reference<State>, PointerEvent> move] handler) {
      this.addPointerHandler(control, 4i32, handler)
    }

    // Registers the handler of a key pressed while `control` has focus. A text view keeps the keys it uses (typing,
    // editing and moving keys, its shortcuts): its handler sees only the others, such as Escape and Command
    // combinations it has no use for.
    [mut effects(heap_alloc)]
    onKeyDown([Widget] control, [Function<void, Reference<State>, KeyEvent> move] handler) {
      this.addKeyHandler(control, 8i32, handler)
    }

    // Registers the handler of a key released while `control` has focus (in a text view, a key whose press it did not
    // keep).
    [mut effects(heap_alloc)]
    onKeyUp([Widget] control, [Function<void, Reference<State>, KeyEvent> move] handler) {
      this.addKeyHandler(control, 16i32, handler)
    }

    [mut effects(heap_alloc)]
    addPointerHandler([Widget] control, [i32] bit, [Function<void, Reference<State>, PointerEvent> move] handler) {
      this.pointerHandlers.push(this.addClick(handler))
      this.pointerWidgets.push(control.handle)
      this.pointerKinds.push(bit)
      this.watchWidget(control.handle)
    }

    [mut effects(heap_alloc)]
    addKeyHandler([Widget] control, [i32] bit, [Function<void, Reference<State>, KeyEvent> move] handler) {
      this.keys.push(NativeKeyHandler<State>{[handler] handler})
      this.keyWidgets.push(control.handle)
      this.keyKinds.push(bit)
      this.watchWidget(control.handle)
    }

    // Asks the platform for the events of `widget` that have handlers.
    watchWidget([u64] widget) {
      [i32 mut] mask{0i32}
      for([i32 mut] index{0i32}; index < this.pointerWidgets.count(); ++index) {
        [u64] control{this.pointerWidgets[index]}
        [i32] bit{this.pointerKinds[index]}
        if(control == widget && !has_watch_bit(mask, bit)) {
          mask = mask + bit
        }
      }
      for([i32 mut] index{0i32}; index < this.keyWidgets.count(); ++index) {
        [u64] control{this.keyWidgets[index]}
        [i32] bit{this.keyKinds[index]}
        if(control == widget && !has_watch_bit(mask, bit)) {
          mask = mask + bit
        }
      }
      ps_ui_widget_watch(widget, mask)
    }

    // Registers the handler of a request to close any of the app's windows (its close button, or a standard Close
    // item); it gets the window and closes it or keeps it open. Without one, the window closes. A later handler
    // replaces an earlier one.
    [mut effects(heap_alloc)]
    onWindowClose([Function<void, Reference<State>, Window> move] handler) {
      this.closeHandler = this.addWindowHandler(handler)
    }

    // Registers the handler of the user's change of the text in any window's text view; it gets the window.
    [mut effects(heap_alloc)]
    onTextChange([Function<void, Reference<State>, Window> move] handler) {
      this.textHandler = this.addWindowHandler(handler)
    }

    [mut effects(heap_alloc) return<i32>]
    addWindowHandler([Function<void, Reference<State>, Window> move] handler) {
      [i32] index{this.windowHandlers.count()}
      this.windowHandlers.push(NativeWindowHandler<State>{[handler] handler})
      return(index)
    }

    // Registers the handler of the system's request to open a file (a file dropped on the app's icon, or opened
    // with it); it gets the path.
    [mut effects(heap_alloc)]
    onOpenFile([Function<void, Reference<State>, /std/text/String> move] handler) {
      this.opens.push(NativeFileHandler<State>{[handler] handler})
    }

    // Registers the handler of a request to quit (the Quit item, or the system's): `run` returns when it gives
    // true. Without one, a request to quit ends `run`.
    [mut effects(heap_alloc)]
    onQuit([Function<bool, Reference<State>> move] handler) {
      this.quitHandler = this.addDecision(handler)
    }

    // Registers the handler that runs after every event, whether a handler took it or not: the place to bring what
    // the handlers changed on screen once (menus and toolbars that follow the documents, a saved session). `run`
    // returns when it gives false. With one, the app decides when it ends, so a close request after which no window
    // is open no longer ends `run` by itself (a request to quit that no `onQuit` handler refuses still does, after
    // this handler). A later handler replaces an earlier one.
    [mut effects(heap_alloc)]
    afterEvent([Function<bool, Reference<State>> move] handler) {
      this.afterHandler = this.addDecision(handler)
    }

    [mut effects(heap_alloc) return<i32>]
    addDecision([Function<bool, Reference<State>> move] handler) {
      [i32] index{this.decisions.count()}
      this.decisions.push(NativeQuitHandler<State>{[handler] handler})
      return(index)
    }

    // Waits on the app's events and calls their handlers until the app quits: a request to quit that no `onQuit`
    // handler refuses, a close request after which no window is open, or, with `afterEvent`, an event after which its
    // handler gives false. Events without a handler are dropped, except a close request, which closes its window. It
    // reads the event kinds of the C ABI as `App.waitEvent` does (a kind it does not know is a request to quit),
    // without the `AppEvent` sum: a `pick` in a method of a generic struct does not lower yet (TODO-5736).
    [mut effects(heap_alloc)]
    run() {
      [Reference<State>] state{location(this.state)}
      [bool mut] running{true}
      while(running) {
        [i32] kind{ps_ui_wait_event()}
        // What the event calls, found first so that each kind of handler is called from one place below: an index
        // into `clicks`, `ranges`, `changes`, `windowHandlers` or `keys` (-1 for none), with its event.
        [i32 mut] click{-1i32}
        [PointerEvent mut] pointer{PointerEvent{[button] PointerButton.primary, [clickCount] 1i32}}
        [i32 mut] range{-1i32}
        [i32 mut] offset{0i32}
        [i32 mut] change{-1i32}
        [u64 mut] changed{0u64}
        [i32 mut] windowHandler{-1i32}
        [Window mut] window{Window{}}
        [i32 mut] key{-1i32}
        [bool mut] quitting{false}
        if(kind == 1i32) {
          [i32] id{ps_ui_event_command()}
          [i32] at{id - first_command_id()}
          // An id that `command` or `commandRange` did not hand out has no handler.
          if(at >= 0i32 && at < this.commandSlots.count()) {
            [i32] slot{this.commandSlots[at]}
            if(slot >= 0i32) {
              click = slot
            } else {
              range = -1i32 - slot
              offset = at - this.rangeFirsts[range]
            }
          }
        }
        if(kind == 2i32) {
          [Window] closing{[handle] ps_ui_event_window()}
          window = closing
          windowHandler = this.closeHandler
          if(windowHandler < 0i32) {
            window.close()
          }
        }
        if(kind == 3i32) {
          [Window] edited{[handle] ps_ui_event_window()}
          window = edited
          windowHandler = this.textHandler
        }
        if(kind == 5i32) {
          [u64] widget{ps_ui_event_widget()}
          for([i32 mut] index{0i32}; click < 0i32 && index < this.clickWidgets.count(); ++index) {
            [u64] button{this.clickWidgets[index]}
            if(button == widget) {
              click = this.clickHandlers[index]
            }
          }
          for([i32 mut] index{0i32}; click < 0i32 && change < 0i32 && index < this.changeWidgets.count(); ++index) {
            [u64] control{this.changeWidgets[index]}
            if(control != 0u64 && control == widget) {
              change = index
            }
          }
          for([i32 mut] index{0i32}; click < 0i32 && change < 0i32 && index < this.finds.count(); ++index) {
            [u64] control{this.finds[index].handler(state)}
            if(control != 0u64 && control == widget) {
              [i32] target{this.findTargets[index]}
              if(this.findIsClick[index]) {
                click = target
              } else {
                change = target
              }
            }
          }
          changed = widget
        }
        if(kind == 6i32) {
          if(this.opens.count() > 0i32) {
            [/std/text/String] path{ps_ui_event_text()}
            this.opens[this.opens.count() - 1i32].handler(state, path)
          }
        }
        if(kind >= 7i32 && kind <= 10i32) {
          // The pointer entering (7) or leaving (8) a widget, a press (9) or release (10) on it; they come only for
          // widgets with such handlers. The last handler registered for the event of the widget is called (the
          // pointer leaving, bit 0, has none).
          [i32] bit{pointer_watch_bit(kind)}
          [u64] widget{ps_ui_event_widget()}
          [i32 mut] index{this.pointerWidgets.count() - 1i32}
          while(click < 0i32 && index >= 0i32) {
            [u64] control{this.pointerWidgets[index]}
            [i32] watched{this.pointerKinds[index]}
            if(control == widget && watched == bit) {
              click = this.pointerHandlers[index]
              pointer = pointer_event()
            }
            index = index - 1i32
          }
        }
        if(kind == 11i32 || kind == 12i32) {
          // A key down (11) or up (12) in a widget with such a handler.
          [i32] bit{key_watch_bit(kind)}
          [u64] widget{ps_ui_event_widget()}
          [i32 mut] index{this.keyWidgets.count() - 1i32}
          while(key < 0i32 && index >= 0i32) {
            [u64] control{this.keyWidgets[index]}
            [i32] watched{this.keyKinds[index]}
            if(control == widget && watched == bit) {
              key = index
            }
            index = index - 1i32
          }
        }
        if(kind == 4i32 || kind < 1i32 || kind > 12i32) {
          quitting = true
        }

        if(click >= 0i32) {
          this.clicks[click].handler(state, pointer)
        }
        if(range >= 0i32) {
          this.ranges[range].handler(state, offset)
        }
        if(change >= 0i32) {
          [ChangeEvent] event{change_event(changed, this.changeKinds[change])}
          this.changes[change].handler(state, event)
        }
        if(windowHandler >= 0i32) {
          this.windowHandlers[windowHandler].handler(state, window)
        }
        if(key >= 0i32) {
          [KeyEvent] event{key_event()}
          this.keys[key].handler(state, event)
        }
        // A close request ends `run` when no window is open afterwards, unless the app decides (`afterEvent`).
        if(kind == 2i32 && this.afterHandler < 0i32) {
          running = ps_ui_window_count() > 0i32
        }
        // The quit handler, then the after-event handler, from one call site: a quit request that the quit handler
        // does not refuse ends `run`, as does an after-event handler that gives false.
        [i32 mut] step{0i32}
        if(!quitting) {
          step = 1i32
        }
        while(step < 2i32) {
          [i32 mut] decision{this.afterHandler}
          if(step == 0i32) {
            decision = this.quitHandler
            if(decision < 0i32) {
              running = false
            }
          }
          if(decision >= 0i32) {
            [bool] said{this.decisions[decision].handler(state)}
            if(step == 0i32) {
              running = running && !said
            } else {
              running = running && said
            }
          }
          step = step + 1i32
        }
      }
    }
  }

  // The id `AppHandlers.command` gives its first command; the next one gets the next id, and so on.
  [public return<i32>]
  first_command_id() {
    return(1000000i32)
  }

  // Whether the watch bit `bit`, a power of two, is set in `mask`. There are no bitwise operators.
  [return<bool>]
  has_watch_bit([i32] mask, [i32] bit) {
    [i32] above{mask / bit}
    return(above - (above / 2i32) * 2i32 == 1i32)
  }

  // The watch bit of a pointer event kind: 1 for the pointer entering (7), 2 for a press (9), 4 for a release (10);
  // 0 for the pointer leaving (8), which has no handler.
  [return<i32>]
  pointer_watch_bit([i32] kind) {
    if(kind == 7i32) {
      return(1i32)
    }
    if(kind == 9i32) {
      return(2i32)
    }
    if(kind == 10i32) {
      return(4i32)
    }
    return(0i32)
  }

  // The watch bit of a key event kind: 8 for a key down (11), 16 for a key up (12).
  [return<i32>]
  key_watch_bit([i32] kind) {
    if(kind == 11i32) {
      return(8i32)
    }
    return(16i32)
  }

  // The pointer event the platform reports now.
  [return<PointerEvent>]
  pointer_event() {
    [i32] code{ps_ui_event_button()}
    [PointerButton mut] button{PointerButton.none}
    if(code == 0i32) {
      button = PointerButton.primary
    }
    if(code == 1i32) {
      button = PointerButton.secondary
    }
    if(code == 2i32) {
      button = PointerButton.middle
    }
    [i32] x{ps_ui_event_x()}
    [i32] y{ps_ui_event_y()}
    [Modifiers] modifiers{Modifiers{[bits] ps_ui_event_modifiers()}}
    [i32] clicks{ps_ui_event_click_count()}
    return(PointerEvent{[button] button, [x] x, [y] y, [hasPosition] true, [modifiers] modifiers, [clickCount] clicks})
  }

  // The key event the platform reports now.
  [return<KeyEvent>]
  key_event() {
    [Key] key{Key{[code] ps_ui_event_key()}}
    [Modifiers] modifiers{Modifiers{[bits] ps_ui_event_modifiers()}}
    [bool] repeated{ps_ui_event_repeat()}
    return(KeyEvent{[key] key, [modifiers] modifiers, [isRepeat] repeated})
  }

  // The change event of `widget`, read from it now: a check box (`kind` 1), a pop-up (2) or a list (3).
  [return<ChangeEvent>]
  change_event([u64] widget, [i32] kind) {
    if(kind == 1i32) {
      return(ChangeEvent{[checked] ps_ui_checkbox_checked(widget)})
    }
    if(kind == 2i32) {
      return(ChangeEvent{[index] ps_ui_popup_selected(widget)})
    }
    [i32] rows{ps_ui_list_item_count(widget)}
    for([i32 mut] row{0i32}; row < rows; ++row) {
      if(ps_ui_list_is_selected(widget, row)) {
        return(ChangeEvent{[index] row})
      }
    }
    return(ChangeEvent{})
  }

}
}
}
