// Canonical vector module with merged implementation.
import /std/collections/buffer_checked/*
import /std/collections/buffer_unchecked/*
import /std/panic/*

namespace std {
  namespace collections {
  namespace vector {
  [effects(heap_alloc), return<Pointer<T>>]
  vectorAllocStorage<T>([i32] count) {
    return(bufferAlloc<T>(count))
  }

  [effects(heap_alloc), return<void>]
  vectorFreeStorage<T>([Pointer<uninitialized<T>>] ptr) {
    bufferFreeUninitialized<T>(ptr)
  }

  [public struct collection_type]
  Vector<T>() {
    [public i32] fieldCount
    [public i32] fieldCapacity
    [public Pointer<uninitialized<T>>] data{vectorAllocStorage<uninitialized<T>>(1)}
    [bool mut] ownsData{true}

    [return<i32>]
    field_count() {
      return(this.fieldCount)
    }

    [return<i32>]
    field_capacity() {
      return(this.fieldCapacity)
    }

    [mut]
    set_field_count([i32] value) {
      if(value < 0 || value > this.fieldCapacity) {
        panic(value)
      }
      this.fieldCount = value
    }

    [mut]
    set_field_capacity([i32] value) {
      if(value < 0 || this.fieldCount > value || value > 1073741823) {
        panic(value)
      }
      this.fieldCapacity = value
    }

    [mut]
    Copy([Reference<Self>] other) {
      this.fieldCount = other.fieldCount
      this.fieldCapacity = other.fieldCapacity
      this.data = other.data
      this.ownsData = false
    }

    [mut]
    Move([Reference<Self>] other) {
      this.fieldCount = other.fieldCount
      this.fieldCapacity = other.fieldCapacity
      this.data = other.data
      this.ownsData = other.ownsData
      other.ownsData = false
    }

    [mut effects(heap_alloc)]
    Destroy() {
      if(this.ownsData) {
        [Pointer<uninitialized<T>>] dataPtr{this.data}
        vectorCheckShape<T>(this)
        vectorDropRange<T>(this, this.fieldCount)
        vectorFreeStorage<T>(dataPtr)
        this.ownsData = false
        this.fieldCount = 0
        this.fieldCapacity = 0
      }
    }

  }

  [return<Pointer<uninitialized<T>>>]
  vectorSlotUnsafe<T>([Vector<T>] values, [i32] index) {
    vectorCheckShape<T>(values)
    if(index < 0 || index >= values.field_capacity()) {
      panic(index)
    }
    return(bufferOffsetUnsafe<uninitialized<T>>(values.data, index))
  }

  [return<void>]
  vectorInitSlot<T>([Vector<T> mut] values, [i32] index, [T] value) {
    [Pointer<uninitialized<T>> mut] slot{vectorSlotUnsafe<T>(values, index)}
    init(*slot, value)
  }

  [return<void>]
  vectorDropSlot<T>([Vector<T> mut] values, [i32] index) {
    [Pointer<uninitialized<T>> mut] slot{vectorSlotUnsafe<T>(values, index)}
    drop(*slot)
  }

  [return<T>]
  vectorTakeSlot<T>([Vector<T> mut] values, [i32] index) {
    [Pointer<uninitialized<T>> mut] slot{vectorSlotUnsafe<T>(values, index)}
    return(take(*slot))
  }

  [return<Reference<T>>]
  vectorBorrowSlot<T>([Vector<T>] values, [i32] index) {
    [Pointer<uninitialized<T>>] slot{vectorSlotUnsafe<T>(values, index)}
    return(borrow(*slot))
  }

  [return<void>]
  vectorDropRange<T>([Vector<T> mut] values, [i32] limit) {
    vectorCheckShape<T>(values)
    if(limit < 0 || limit > values.field_capacity()) {
      panic(limit)
    }
    for([i32 mut] index{0}, index < limit, index++) {
      vectorDropSlot<T>(values, index)
    }
  }

  [effects(heap_alloc), return<void>]
  vectorMovePrefixToBuffer<T>([Pointer<uninitialized<T>> mut] dst, [Vector<T> mut] values, [i32] limit) {
    for([i32 mut] index{0}, index < limit, index++) {
      [Pointer<uninitialized<T>> mut] nextSlot{
          bufferOffsetUnsafe<uninitialized<T>>(dst, index)}
      init(*nextSlot, vectorTakeSlot<T>(values, index))
    }
  }

  [effects(heap_alloc), return<Vector<T>>]
  vectorAlloc<T>([i32] count, [i32] capacity) {
    [mut] allocCount{capacity}
    if(allocCount == 0) {
      allocCount = 1
    }
    return(Vector<T>{
        [fieldCount] count,
        [fieldCapacity] capacity,
        [data] vectorAllocStorage<uninitialized<T>>(allocCount),
        [ownsData] true})
  }

  [return<void>]
  vectorCheckShape<T>([Vector<T>] values) {
    if(values.field_count() < 0 || values.field_capacity() < 0 ||
       values.field_count() > values.field_capacity() ||
       values.field_capacity() > 1073741823) {
      panic(0)
    }
  }

  [return<void>]
  vectorCheckIndex<T>([Vector<T>] values, [i32] index) {
    vectorCheckShape<T>(values)
    if(index < 0 || index >= values.field_count() || index >= values.field_capacity()) {
      panic(index)
    }
  }

  [effects(heap_alloc), return<void>]
  vectorReserveInternal<T>([Vector<T> mut] values, [i32] capacity) {
    vectorCheckShape<T>(values)
    if(capacity < 0) {
      panic(capacity)
    }
    if(capacity > 1073741823) {
      panic(capacity)
    }
    if(capacity > values.field_capacity()) {
      [mut] allocCount{capacity}
      if(allocCount == 0) {
        allocCount = 1
      }
      [Pointer<uninitialized<T>> mut] grown{
          vectorAllocStorage<uninitialized<T>>(allocCount)}
      vectorMovePrefixToBuffer<T>(grown, values, values.field_count())
      vectorFreeStorage<T>(values.data)
      values.data = grown
      values.fieldCapacity = capacity
    }
  }

  [public effects(heap_alloc), return<Vector<T>>]
  vector<T>([args<T>] values) {
    [i32] valueCount{values.count()}
    [mut] out{vectorAlloc<T>(valueCount, valueCount)}
    for([i32 mut] index{0i32}, index < valueCount, index++) {
      vectorInitSlot<T>(out, index, /at(values, index))
    }
    return(out)
  }

  [public return<i32>]
  vectorCount<T>([Vector<T>] values) {
    vectorCheckShape<T>(values)
    return(values.field_count())
  }

  [public return<i32>]
  vectorCountRef<T>([Reference<Vector<T>>] values) {
    [Vector<T>] materialized{values}
    vectorCheckShape<T>(materialized)
    return(materialized.field_count())
  }

  [public return<i32>]
  vectorCapacity<T>([Vector<T>] values) {
    vectorCheckShape<T>(values)
    return(values.field_capacity())
  }

  [public return<i32>]
  vectorCapacityRef<T>([Reference<Vector<T>>] values) {
    [Vector<T>] materialized{values}
    vectorCheckShape<T>(materialized)
    return(materialized.field_capacity())
  }

  [public effects(heap_alloc), return<void>]
  vectorReserve<T>([Vector<T> mut] values, [i32] capacity) {
    vectorReserveInternal<T>(values, capacity)
  }

  [public effects(heap_alloc), return<void>]
  vectorPush<T>([Vector<T> mut] values, [T] value) {
    vectorCheckShape<T>(values)
    if(values.field_count() == values.field_capacity()) {
      [i32 mut] nextCapacity{values.field_capacity()}
      if(nextCapacity == 0) {
        nextCapacity = 1
      } else {
        if(nextCapacity > 536870911) {
          nextCapacity = 1073741824
        } else {
          nextCapacity = nextCapacity + nextCapacity
        }
      }
      vectorReserveInternal<T>(values, nextCapacity)
    }
    vectorInitSlot<T>(values, values.field_count(), value)
    values.fieldCount = values.fieldCount + 1
  }

  [public effects(heap_alloc), return<void>]
  vectorPop<T>([Vector<T> mut] values) {
    vectorCheckShape<T>(values)
    if(values.field_count() == 0) {
      panic(0)
    } else {
      lastIndex{values.field_count() - 1}
      vectorDropSlot<T>(values, lastIndex)
      values.fieldCount = lastIndex
    }
  }

  [public effects(heap_alloc), return<void>]
  vectorClear<T>([Vector<T> mut] values) {
    vectorCheckShape<T>(values)
    vectorDropRange<T>(values, values.field_count())
    values.fieldCount = 0
  }

  [public effects(heap_alloc), return<void>]
  vectorRemoveAt<T>([Vector<T> mut] values, [i32] index) {
    vectorCheckIndex<T>(values, index)
    lastIndex{values.field_count() - 1}
    vectorDropSlot<T>(values, index)
    for([i32 mut] current{index}, current < lastIndex, current++) {
      vectorInitSlot<T>(values, current, vectorTakeSlot<T>(values, current + 1))
    }
    values.fieldCount = lastIndex
  }

  [public effects(heap_alloc), return<void>]
  vectorRemoveSwap<T>([Vector<T> mut] values, [i32] index) {
    vectorCheckIndex<T>(values, index)
    lastIndex{values.field_count() - 1}
    if(index < lastIndex) {
      vectorDropSlot<T>(values, index)
      vectorInitSlot<T>(values, index, vectorTakeSlot<T>(values, lastIndex))
    } else {
      vectorDropSlot<T>(values, lastIndex)
    }
    values.fieldCount = lastIndex
  }

  [public return<T>]
  vectorAt<T>([Vector<T>] values, [i32] index) {
    vectorCheckIndex<T>(values, index)
    return(*(vectorBorrowSlot<T>(values, index)))
  }

  [public return<T>]
  vectorAtUnsafe<T>([Vector<T>] values, [i32] index) {
    return(*(vectorBorrowSlot<T>(values, index)))
  }
  }
  }
}

// Short-named canonical entry points that expose each surface member via the
// rooted /std/collections/vector/<name> path. These delegate to the long-named
// implementations above and serve as the source of truth for surface member
// derivation in StdlibSurfaceRegistry (TODO-4635).

[public return<i32>]
/std/collections/vector/count<T>([/std/collections/vector/Vector<T>] values) {
  return(/std/collections/vector/vectorCount<T>(values))
}

[public return<i32>]
/std/collections/vector/capacity<T>([/std/collections/vector/Vector<T>] values) {
  return(/std/collections/vector/vectorCapacity<T>(values))
}

[public effects(heap_alloc), return<void>]
/std/collections/vector/push<T>([/std/collections/vector/Vector<T> mut] values, [T] value) {
  /std/collections/vector/vectorPush<T>(values, value)
}

[public effects(heap_alloc), return<void>]
/std/collections/vector/pop<T>([/std/collections/vector/Vector<T> mut] values) {
  /std/collections/vector/vectorPop<T>(values)
}

[public effects(heap_alloc), return<void>]
/std/collections/vector/reserve<T>([/std/collections/vector/Vector<T> mut] values, [i32] capacity) {
  /std/collections/vector/vectorReserve<T>(values, capacity)
}

[public effects(heap_alloc), return<void>]
/std/collections/vector/clear<T>([/std/collections/vector/Vector<T> mut] values) {
  /std/collections/vector/vectorClear<T>(values)
}

[public effects(heap_alloc), return<void>]
/std/collections/vector/remove_at<T>([/std/collections/vector/Vector<T> mut] values, [i32] index) {
  /std/collections/vector/vectorRemoveAt<T>(values, index)
}

[public effects(heap_alloc), return<void>]
/std/collections/vector/remove_swap<T>([/std/collections/vector/Vector<T> mut] values, [i32] index) {
  /std/collections/vector/vectorRemoveSwap<T>(values, index)
}

[public return<T>]
/std/collections/vector/at<T>([/std/collections/vector/Vector<T>] values, [i32] index) {
  return(/std/collections/vector/vectorAt<T>(values, index))
}

[public return<T>]
/std/collections/vector/at_unsafe<T>([/std/collections/vector/Vector<T>] values, [i32] index) {
  return(/std/collections/vector/vectorAtUnsafe<T>(values, index))
}
