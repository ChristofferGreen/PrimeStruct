  [return<Pointer<uninitialized<T>>>]
  soaColumnSlotUnsafe<T>([SoaColumn<T>] values, [i32] index) {
    soaColumnCheckShape<T>(values)
    if(index < 0i32 || !(index < values.field_capacity())) {
      panic(index)
    }
    return(bufferOffsetUnsafe<uninitialized<T>>(values.data, index))
  }

  [public return<Pointer<uninitialized<Field>>>]
  soaColumnFieldSlotUnsafe<Struct, Field>([SoaColumn<Struct>] values, [i32] index, [i32] fieldIndex) {
    soaColumnCheckShape<Struct>(values)
    if(index < 0i32 || !(index < values.field_capacity())) {
      panic(index)
    }
    [i32] fieldCount{/Struct/SoaSchemaFieldCount()}
    if(fieldIndex < 0i32 || fieldIndex >= fieldCount) {
      panic(fieldIndex)
    }
    [i32] stride{/Struct/SoaSchemaElementStride()}
    [i32] fieldOffset{/Struct/SoaSchemaFieldOffset(fieldIndex)}
    [i32] elementOffset{index * stride + fieldOffset}
    [Pointer<i32>] baseBytes{
        bufferReinterpretBytes<uninitialized<Struct>>(values.data)}
    [Pointer<i32>] fieldBytes{
        bufferOffsetBytesUnsafe(baseBytes, elementOffset)}
    return(bufferReinterpretFromBytes<uninitialized<Field>>(fieldBytes))
  }

  [public return<SoaFieldView<Field>>]
  soaColumnFieldViewUnsafe<Struct, Field>([SoaColumn<Struct>] values, [i32] fieldIndex) {
    soaColumnCheckShape<Struct>(values)
    [i32] fieldCount{/Struct/SoaSchemaFieldCount()}
    if(fieldIndex < 0i32 || fieldIndex >= fieldCount) {
      panic(fieldIndex)
    }
    [i32] stride{/Struct/SoaSchemaElementStride()}
    [i32] fieldOffset{/Struct/SoaSchemaFieldOffset(fieldIndex)}
    [Pointer<i32>] baseBytes{
        bufferReinterpretBytes<uninitialized<Struct>>(values.data)}
    [Pointer<i32>] fieldBytes{
        bufferOffsetBytesUnsafe(baseBytes, fieldOffset)}
    [Pointer<uninitialized<Field>>] fieldBase{
        bufferReinterpretFromBytes<uninitialized<Field>>(fieldBytes)}
    return(SoaFieldView<Field>{
        values.field_count(),
        values.field_capacity(),
        fieldBase,
        stride})
  }

  [return<void>]
  soaFieldViewCheckShape<T>([SoaFieldView<T>] values) {
    if(values.field_count() < 0i32 || values.field_capacity() < 0i32 || values.field_count() > values.field_capacity() || values.field_capacity() > 1073741823i32 || values.stride < 1i32) {
      panic(0i32)
    }
  }

  [return<void>]
  soaFieldViewCheckIndex<T>([SoaFieldView<T>] values, [i32] index) {
    soaFieldViewCheckShape<T>(values)
    if(index < 0i32 || !(index < values.field_count()) || !(index < values.field_capacity())) {
      panic(index)
    }
  }

  [return<Pointer<uninitialized<T>>>]
  soaFieldViewSlotUnsafe<T>([SoaFieldView<T>] values, [i32] index) {
    soaFieldViewCheckIndex<T>(values, index)
    [i32] byteOffset{index * values.stride}
    [Pointer<i32>] baseBytes{
        bufferReinterpretBytes<uninitialized<T>>(values.data)}
    [Pointer<i32>] slotBytes{
        bufferOffsetBytesUnsafe(baseBytes, byteOffset)}
    return(bufferReinterpretFromBytes<uninitialized<T>>(slotBytes))
  }

  [public return<T>]
  soaFieldViewRead<T>([SoaFieldView<T>] values, [i32] index) {
    return(*(soaFieldViewSlotUnsafe<T>(values, index)))
  }

  [public return<Reference<T>>]
  soaFieldViewRef<T>([SoaFieldView<T>] values, [i32] index) {
    return(borrow(*(soaFieldViewSlotUnsafe<T>(values, index))))
  }

  [return<void>]
  soaColumnInitSlot<T>([SoaColumn<T> mut] values, [i32] index, [T move] value) {
    [Pointer<uninitialized<T>> mut] slot{soaColumnSlotUnsafe<T>(values, index)}
    init(*slot, value)
  }

  [return<void>]
  soaColumnDropSlot<T>([SoaColumn<T> mut] values, [i32] index) {
    [Pointer<uninitialized<T>> mut] slot{soaColumnSlotUnsafe<T>(values, index)}
    drop(*slot)
  }

  [return<T>]
  soaColumnTakeSlot<T>([SoaColumn<T> mut] values, [i32] index) {
