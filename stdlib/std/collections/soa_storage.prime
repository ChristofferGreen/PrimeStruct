  [public struct collection_type]
  SoaColumn<T>() {
    [public i32] count
    [public i32] capacity
    [public Pointer<uninitialized<T>>] data{bufferAlloc<uninitialized<T>>(1i32)}
    [bool mut] ownsData{true}

    [return<i32>]
    field_count() {
      return(this.count)
    }

    [return<i32>]
    field_capacity() {
      return(this.capacity)
    }

    [mut return<void>]
    set_field_count([i32] value) {
      if(value < 0i32 || value > this.capacity) {
        panic(value)
      }
      this.count = value
    }

    [mut return<void>]
    set_field_capacity([i32] value) {
      if(value < 0i32 || this.count > value || value > 1073741823i32) {
        panic(value)
      }
      this.capacity = value
    }

    [mut]
    Copy([Reference<Self>] other) {
      this.count = other.count
      this.capacity = other.capacity
      this.data = other.data
      this.ownsData = false
    }

    [mut]
    Move([Reference<Self>] other) {
      this.count = other.count
      this.capacity = other.capacity
      this.data = other.data
      this.ownsData = other.ownsData
      other.ownsData = false
    }

    [mut effects(heap_alloc)]
    Destroy() {
      if(this.ownsData) {
        soaColumnCheckShape<T>(this)
        soaColumnDropRange<T>(this, this.count)
        bufferFreeUninitialized<T>(this.data)
        this.ownsData = false
        this.count = 0i32
        this.capacity = 0i32
      }
    }
  }

  [public struct]
  SoaFieldView<T>() {
    [public i32] count
    [public i32] capacity
    [public Pointer<uninitialized<T>>] data{bufferAlloc<uninitialized<T>>(1i32)}
    [public i32] stride

    [return<i32>]
    field_count() {
      return(this.count)
    }

    [return<i32>]
    field_capacity() {
      return(this.capacity)
    }
  }

  [public return<never>]
  soaArbitraryWidthPending<T>([i32] fieldCount) {
    panic(fieldCount)
  }

  [public return<i32>]
  soaSupportedFieldCount<T>() {
    [i32] fieldCount{meta.field_count<T>()}
    if(fieldCount < 1i32 || fieldCount > 16i32) {
      soaArbitraryWidthPending<T>(fieldCount)
    }
    return(fieldCount)
  }

