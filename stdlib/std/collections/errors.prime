namespace std {
  namespace collections {
  [public struct]
  ContainerError() {
    [public i32] code{0i32}
  }

  namespace ContainerError {
    [public return<string> effects(none)]
    why([ContainerError] err) {
      if(err.code == 1i32) {
        return("container missing key"utf8)
      }
      if(err.code == 2i32) {
        return("container index out of bounds"utf8)
      }
      if(err.code == 3i32) {
        return("container empty"utf8)
      }
      if(err.code == 4i32) {
        return("container capacity exceeded"utf8)
      }
      return("container error"utf8)
    }

    [public return<Result<ContainerError>> effects(none)]
    status([ContainerError] err) {
      return(err.code)
    }

    [public return<ContainerError> effects(none)]
    missingKey() {
      return(ContainerError{1i32})
    }

    [public return<ContainerError> effects(none)]
    missing_key() {
      return(missingKey())
    }

    [public return<ContainerError> effects(none)]
    indexOutOfBounds() {
      return(ContainerError{2i32})
    }

    [public return<ContainerError> effects(none)]
    index_out_of_bounds() {
      return(indexOutOfBounds())
    }

    [public return<ContainerError> effects(none)]
    empty() {
      return(ContainerError{3i32})
    }

    [public return<ContainerError> effects(none)]
    capacityExceeded() {
      return(ContainerError{4i32})
    }

    [public return<ContainerError> effects(none)]
    capacity_exceeded() {
      return(capacityExceeded())
    }

    [public return<Result<T, ContainerError>> effects(none)]
    result<T>([ContainerError] err) {
      return(convert<i64>(err.code) * 4294967296i64)
    }
  }

