// Shared equality methods for collection key lookups.

[public return<bool>]
/i32/equal([i32] self, [i32] other) {
  return(self == other)
}

[public return<bool>]
/i64/equal([i64] self, [i64] other) {
  return(self == other)
}

[public return<bool>]
/u64/equal([u64] self, [u64] other) {
  return(self == other)
}

[public return<bool>]
/f32/equal([f32] self, [f32] other) {
  return(self == other)
}

[public return<bool>]
/f64/equal([f64] self, [f64] other) {
  return(self == other)
}

[public return<bool>]
/bool/equal([bool] self, [bool] other) {
  return(self == other)
}

[public return<bool>]
/string/equal([string] self, [string] other) {
  [i32] limit{count(self)}
  if(limit != count(other)) {
    return(false)
  }
  for([i32 mut] index{0i32}, index < limit, index++) {
    if(at(self, index) != at(other, index)) {
      return(false)
    }
  }
  return(true)
}
