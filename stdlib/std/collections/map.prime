  }

  [public return<V> Comparable<K>]
  at<K, V>([MapValue<K, V>] entries, [K] key) {
    return(mapAt<K, V>(entries, key))
  }

  [public return<V> Comparable<K>]
  at_ref<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    return(mapAtRef<K, V>(entries, key))
  }

  [public return<V> Comparable<K>]
  mapAtUnsafe<K, V>([MapValue<K, V>] entries, [K] key) {
    [Vector<V>] payloads{entries.payloads}
    return(vectorAtUnsafe<V>(
        payloads,
        findIndex<K, V>(entries, key)))
  }

  [public return<V> Comparable<K>]
  mapAtUnsafeRef<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    [Vector<V>] payloads{entries.payloads}
    return(vectorAtUnsafe<V>(
        payloads,
        findIndexRef<K, V>(entries, key)))
  }

  [public return<V> Comparable<K>]
  at_unsafe<K, V>([MapValue<K, V>] entries, [K] key) {
