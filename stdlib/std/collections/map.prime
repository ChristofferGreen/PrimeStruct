// Standalone canonical stdlib-owned map implementation.
// This module intentionally does not import the retired native map implementation.
import /std/collections/equality/*
import /std/collections/errors/*
import /std/collections/vector/*

namespace std {
  namespace collections {
  namespace map {
  [public struct]
  Entry<K, V>() {
    [public K] key
    [public V] value
  }

  // member_prefix="map"
  [public struct key_value_type]
  MapValue<K, V>() {
    [public Vector<K> mut] keys{vector<K>()}
    [public Vector<V> mut] payloads{vector<V>()}

    [public return<i32>]
    mapCount() {
      [Vector<K>] keys{this.keys}
      return(vectorCount<K>(keys))
    }

    [public return<bool> Comparable<K>]
    mapContains([K] key) {
      [Vector<K>] keys{this.keys}
      [i32] limit{vectorCount<K>(keys)}
      return(findIndex<K, V>(this, key) < limit)
    }

    [public return<Result<V, ContainerError>> Comparable<K>]
    mapTryAt([K] key) {
      [i32] index{findIndex<K, V>(this, key)}
      [Vector<V>] payloads{this.payloads}
      [Vector<K>] keys{this.keys}
      [i32] limit{vectorCount<K>(keys)}
      if(index < limit) {
        return(Result.ok(vectorAtUnsafe<V>(payloads, index)))
      }
      return(/ContainerError/result<V>(/ContainerError/missingKey()))
    }

    [public return<V> Comparable<K>]
    mapAt([K] key) {
      [i32] index{findIndex<K, V>(this, key)}
      [Vector<V>] payloads{this.payloads}
      [Vector<K>] keys{this.keys}
      [i32] limit{vectorCount<K>(keys)}
      if(index < limit) {
        return(vectorAtUnsafe<V>(payloads, index))
      }
      return(vectorAt<V>(payloads, index))
    }

    [public return<V> Comparable<K>]
    mapAtUnsafe([K] key) {
      [Vector<V>] payloads{this.payloads}
      return(vectorAtUnsafe<V>(
          payloads,
          findIndex<K, V>(this, key)))
    }

    [public effects(heap_alloc), return<void> Comparable<K>]
    mapInsert([K] key, [V] value) {
      [i32] index{findIndex<K, V>(this, key)}
      [Vector<K> mut] keys{this.keys}
      [Vector<V> mut] payloads{this.payloads}
      [i32] limit{vectorCount<K>(keys)}
      if(index < limit) {
        overwriteSlot<V>(payloads, index, value)
        this.payloads = payloads
      } else {
        vectorPush<K>(keys, key)
        vectorPush<V>(payloads, value)
        this.keys = keys
        this.payloads = payloads
      }
    }

    [public mut]
    Move([Reference<Self>] other) {
      this.keys = other.keys
      this.payloads = other.payloads
      other.keys = vector<K>()
      other.payloads = vector<V>()
    }
  }

  [public return<Entry<K, V>>]
  entry<K, V>([K] key, [V] value) {
    return(Entry<K, V>{key, value})
  }

  [public effects(heap_alloc), return<MapValue<K, V>>]
  mapNew<K, V>() {
    return(MapValue<K, V>{})
  }

  [return<bool>]
  keysEqual<K>([K] left, [K] right) {
    return(left.equal(right))
  }

  [effects(heap_alloc), return<void> Comparable<K>]
  mapInsertEntry<K, V>([MapValue<K, V> mut] out, [Entry<K, V>] entry) {
    mapInsert<K, V>(out, entry.key, entry.value)
  }

  [public effects(heap_alloc), return<MapValue<K, V>>]
  map<K, V>() {
    return(mapNew<K, V>())
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>([args<Entry<K, V>>] entries) {
    [MapValue<K, V> mut] out{mapNew<K, V>()}
    valueCount{entries.count()}
    for([i32 mut] index{0i32}, index < valueCount, index++) {
      mapInsertEntry<K, V>(out, /at(entries, index))
    }
    return(out)
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>([K] firstKey, [V] firstValue) {
    return(map<K, V>(entry<K, V>(firstKey, firstValue)))
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>(
      [K] firstKey, [V] firstValue,
      [K] secondKey, [V] secondValue) {
    return(map<K, V>(
        entry<K, V>(firstKey, firstValue),
        entry<K, V>(secondKey, secondValue)))
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>(
      [K] firstKey, [V] firstValue,
      [K] secondKey, [V] secondValue,
      [K] thirdKey, [V] thirdValue) {
    return(map<K, V>(
        entry<K, V>(firstKey, firstValue),
        entry<K, V>(secondKey, secondValue),
        entry<K, V>(thirdKey, thirdValue)))
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>(
      [K] firstKey, [V] firstValue,
      [K] secondKey, [V] secondValue,
      [K] thirdKey, [V] thirdValue,
      [K] fourthKey, [V] fourthValue) {
    return(map<K, V>(
        entry<K, V>(firstKey, firstValue),
        entry<K, V>(secondKey, secondValue),
        entry<K, V>(thirdKey, thirdValue),
        entry<K, V>(fourthKey, fourthValue)))
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>(
      [K] firstKey, [V] firstValue,
      [K] secondKey, [V] secondValue,
      [K] thirdKey, [V] thirdValue,
      [K] fourthKey, [V] fourthValue,
      [K] fifthKey, [V] fifthValue) {
    return(map<K, V>(
        entry<K, V>(firstKey, firstValue),
        entry<K, V>(secondKey, secondValue),
        entry<K, V>(thirdKey, thirdValue),
        entry<K, V>(fourthKey, fourthValue),
        entry<K, V>(fifthKey, fifthValue)))
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>(
      [K] firstKey, [V] firstValue,
      [K] secondKey, [V] secondValue,
      [K] thirdKey, [V] thirdValue,
      [K] fourthKey, [V] fourthValue,
      [K] fifthKey, [V] fifthValue,
      [K] sixthKey, [V] sixthValue) {
    return(map<K, V>(
        entry<K, V>(firstKey, firstValue),
        entry<K, V>(secondKey, secondValue),
        entry<K, V>(thirdKey, thirdValue),
        entry<K, V>(fourthKey, fourthValue),
        entry<K, V>(fifthKey, fifthValue),
        entry<K, V>(sixthKey, sixthValue)))
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>(
      [K] firstKey, [V] firstValue,
      [K] secondKey, [V] secondValue,
      [K] thirdKey, [V] thirdValue,
      [K] fourthKey, [V] fourthValue,
      [K] fifthKey, [V] fifthValue,
      [K] sixthKey, [V] sixthValue,
      [K] seventhKey, [V] seventhValue) {
    return(map<K, V>(
        entry<K, V>(firstKey, firstValue),
        entry<K, V>(secondKey, secondValue),
        entry<K, V>(thirdKey, thirdValue),
        entry<K, V>(fourthKey, fourthValue),
        entry<K, V>(fifthKey, fifthValue),
        entry<K, V>(sixthKey, sixthValue),
        entry<K, V>(seventhKey, seventhValue)))
  }

  [public effects(heap_alloc), return<MapValue<K, V>> Comparable<K>]
  map<K, V>(
      [K] firstKey, [V] firstValue,
      [K] secondKey, [V] secondValue,
      [K] thirdKey, [V] thirdValue,
      [K] fourthKey, [V] fourthValue,
      [K] fifthKey, [V] fifthValue,
      [K] sixthKey, [V] sixthValue,
      [K] seventhKey, [V] seventhValue,
      [K] eighthKey, [V] eighthValue) {
    return(map<K, V>(
        entry<K, V>(firstKey, firstValue),
        entry<K, V>(secondKey, secondValue),
        entry<K, V>(thirdKey, thirdValue),
        entry<K, V>(fourthKey, fourthValue),
        entry<K, V>(fifthKey, fifthValue),
        entry<K, V>(sixthKey, sixthValue),
        entry<K, V>(seventhKey, seventhValue),
        entry<K, V>(eighthKey, eighthValue)))
  }

  [public return<i32>]
  mapCount<K, V>([MapValue<K, V>] entries) {
    [Vector<K>] keys{entries.keys}
    return(vectorCount<K>(keys))
  }

  [public return<i32>]
  mapCountRef<K, V>([Reference<MapValue<K, V>>] entries) {
    [Vector<K>] keys{entries.keys}
    return(vectorCount<K>(keys))
  }

  [public return<i32>]
  count<K, V>([MapValue<K, V>] entries) {
    return(mapCount<K, V>(entries))
  }

  [public return<i32>]
  count_ref<K, V>([Reference<MapValue<K, V>>] entries) {
    return(mapCountRef<K, V>(entries))
  }

  [return<i32> Comparable<K>]
  findIndex<K, V>([MapValue<K, V>] entries, [K] key) {
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
    for([i32 mut] index{0i32}, index < limit, index++) {
      if(keysEqual<K>(vectorAt<K>(keys, index), key)) {
        return(index)
      }
    }
    return(limit)
  }

  [return<i32> Comparable<K>]
  findIndexRef<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
    for([i32 mut] index{0i32}, index < limit, index++) {
      if(keysEqual<K>(vectorAt<K>(keys, index), key)) {
        return(index)
      }
    }
    return(limit)
  }

  [return<void>]
  overwriteSlot<T>([Vector<T> mut] values, [i32] index, [T] value) {
    [Reference<T> mut] slot{vectorBorrowSlot<T>(values, index)}
    *slot = value
  }

  [public effects(heap_alloc), return<void> Comparable<K>]
  mapInsert<K, V>([MapValue<K, V> mut] entries, [K] key, [V] value) {
    [i32] index{findIndex<K, V>(entries, key)}
    [Vector<K> mut] keys{entries.keys}
    [Vector<V> mut] payloads{entries.payloads}
    if(index < mapCount<K, V>(entries)) {
      overwriteSlot<V>(payloads, index, value)
      entries.payloads = payloads
    } else {
      vectorPush<K>(keys, key)
      vectorPush<V>(payloads, value)
      entries.keys = keys
      entries.payloads = payloads
    }
  }

  [public effects(heap_alloc), return<void> Comparable<K>]
  mapInsertRef<K, V>([Reference<MapValue<K, V>> mut] entries, [K] key, [V] value) {
    [i32] index{findIndexRef<K, V>(entries, key)}
    [Vector<K> mut] keys{entries.keys}
    [Vector<V> mut] payloads{entries.payloads}
    if(index < mapCountRef<K, V>(entries)) {
      overwriteSlot<V>(payloads, index, value)
      entries.payloads = payloads
    } else {
      vectorPush<K>(keys, key)
      vectorPush<V>(payloads, value)
      entries.keys = keys
      entries.payloads = payloads
    }
  }

  [public effects(heap_alloc), return<void> Comparable<K>]
  insert<K, V>([MapValue<K, V> mut] entries, [K] key, [V] value) {
    [i32] index{findIndex<K, V>(entries, key)}
    [Vector<K> mut] keys{entries.keys}
    [Vector<V> mut] payloads{entries.payloads}
    if(index < mapCount<K, V>(entries)) {
      overwriteSlot<V>(payloads, index, value)
      entries.payloads = payloads
    } else {
      vectorPush<K>(keys, key)
      vectorPush<V>(payloads, value)
      entries.keys = keys
      entries.payloads = payloads
    }
  }

  [public effects(heap_alloc), return<void> Comparable<K>]
  insert_ref<K, V>([Reference<MapValue<K, V>> mut] entries, [K] key, [V] value) {
    mapInsertRef<K, V>(entries, key, value)
  }

  [public return<bool> Comparable<K>]
  mapContains<K, V>([MapValue<K, V>] entries, [K] key) {
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
    return(findIndex<K, V>(entries, key) < limit)
  }

  [public return<bool> Comparable<K>]
  mapContainsRef<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
    return(findIndexRef<K, V>(entries, key) < limit)
  }

  [public return<bool> Comparable<K>]
  contains<K, V>([MapValue<K, V>] entries, [K] key) {
    return(mapContains<K, V>(entries, key))
  }

  [public return<bool> Comparable<K>]
  contains_ref<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    return(mapContainsRef<K, V>(entries, key))
  }

  [public return<Result<V, ContainerError>> Comparable<K>]
  mapTryAt<K, V>([MapValue<K, V>] entries, [K] key) {
    [i32] index{findIndex<K, V>(entries, key)}
    [Vector<V>] payloads{entries.payloads}
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
    if(index < limit) {
      return(Result.ok(vectorAtUnsafe<V>(payloads, index)))
    }
    return(/ContainerError/result<V>(/ContainerError/missingKey()))
  }

  [public return<Result<V, ContainerError>> Comparable<K>]
  mapTryAtRef<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    [i32] index{findIndexRef<K, V>(entries, key)}
    [Vector<V>] payloads{entries.payloads}
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
    if(index < limit) {
      return(Result.ok(vectorAtUnsafe<V>(payloads, index)))
    }
    return(/ContainerError/result<V>(/ContainerError/missingKey()))
  }

  [public return<Result<V, ContainerError>> Comparable<K>]
  tryAt<K, V>([MapValue<K, V>] entries, [K] key) {
    return(mapTryAt<K, V>(entries, key))
  }

  [public return<Result<V, ContainerError>> Comparable<K>]
  tryAt_ref<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    return(mapTryAtRef<K, V>(entries, key))
  }

  [public return<V> Comparable<K>]
  mapAt<K, V>([MapValue<K, V>] entries, [K] key) {
    [i32] index{findIndex<K, V>(entries, key)}
    [Vector<V>] payloads{entries.payloads}
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
    if(index < limit) {
      return(vectorAtUnsafe<V>(payloads, index))
    }
    return(vectorAt<V>(payloads, index))
  }

  [public return<V> Comparable<K>]
  mapAtRef<K, V>([Reference<MapValue<K, V>>] entries, [K] key) {
    [i32] index{findIndexRef<K, V>(entries, key)}
    [Vector<V>] payloads{entries.payloads}
    [Vector<K>] keys{entries.keys}
    [i32] limit{vectorCount<K>(keys)}
