  [public effects(heap_alloc), return<void>]
  soaColumnPush<T>([SoaColumn<T> mut] values, [T move] value) {
    soaColumnCheckShape<T>(values)
    if(values.field_count() == values.field_capacity()) {
      [i32 mut] nextCapacity{values.field_capacity()}
      if(nextCapacity == 0i32) {
        nextCapacity = 1i32
      } else {
        if(nextCapacity > 536870911i32) {
          nextCapacity = 1073741824i32
        } else {
          nextCapacity = nextCapacity + nextCapacity
        }
      }
      soaColumnReserve<T>(values, nextCapacity)
    }
    soaColumnInitSlot<T>(values, values.field_count(), value)
    values.set_field_count(values.field_count() + 1i32)
  }

