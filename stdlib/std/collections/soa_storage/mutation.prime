                                                                                       [T12] thirteenthValue,
                                                                                       [T13] fourteenthValue,
                                                                                       [T14] fifteenthValue,
                                                                                       [T15] sixteenthValue) {
    soaColumns16CheckShape<T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13, T14, T15>(values)
    [Reference<SoaColumn<T0>>] first{location(values.first)}
    [Reference<SoaColumn<T1>>] second{location(values.second)}
    [Reference<SoaColumn<T2>>] third{location(values.third)}
    [Reference<SoaColumn<T3>>] fourth{location(values.fourth)}
    [Reference<SoaColumn<T4>>] fifth{location(values.fifth)}
    [Reference<SoaColumn<T5>>] sixth{location(values.sixth)}
    [Reference<SoaColumn<T6>>] seventh{location(values.seventh)}
    [Reference<SoaColumn<T7>>] eighth{location(values.eighth)}
    [Reference<SoaColumn<T8>>] ninth{location(values.ninth)}
    [Reference<SoaColumn<T9>>] tenth{location(values.tenth)}
    [Reference<SoaColumn<T10>>] eleventh{location(values.eleventh)}
    [Reference<SoaColumn<T11>>] twelfth{location(values.twelfth)}
    [Reference<SoaColumn<T12>>] thirteenth{location(values.thirteenth)}
    [Reference<SoaColumn<T13>>] fourteenth{location(values.fourteenth)}
    [Reference<SoaColumn<T14>>] fifteenth{location(values.fifteenth)}
    [Reference<SoaColumn<T15>>] sixteenth{location(values.sixteenth)}
    if(soaColumnCount<T0>(first) == soaColumnCapacity<T0>(first)) {
      [i32 mut] nextCapacity{soaColumnCapacity<T0>(first)}
      if(nextCapacity == 0i32) {
        nextCapacity = 1i32
      } else {
        if(nextCapacity > 536870911i32) {
          nextCapacity = 1073741824i32
        } else {
          nextCapacity = nextCapacity + nextCapacity
        }
      }
      soaColumnReserve<T0>(first, nextCapacity)
      soaColumnReserve<T1>(second, nextCapacity)
      soaColumnReserve<T2>(third, nextCapacity)
      soaColumnReserve<T3>(fourth, nextCapacity)
      soaColumnReserve<T4>(fifth, nextCapacity)
      soaColumnReserve<T5>(sixth, nextCapacity)
      soaColumnReserve<T6>(seventh, nextCapacity)
      soaColumnReserve<T7>(eighth, nextCapacity)
      soaColumnReserve<T8>(ninth, nextCapacity)
      soaColumnReserve<T9>(tenth, nextCapacity)
      soaColumnReserve<T10>(eleventh, nextCapacity)
      soaColumnReserve<T11>(twelfth, nextCapacity)
      soaColumnReserve<T12>(thirteenth, nextCapacity)
      soaColumnReserve<T13>(fourteenth, nextCapacity)
      soaColumnReserve<T14>(fifteenth, nextCapacity)
      soaColumnReserve<T15>(sixteenth, nextCapacity)
    }
    soaColumnPush<T0>(first, firstValue)
    soaColumnPush<T1>(second, secondValue)
    soaColumnPush<T2>(third, thirdValue)
    soaColumnPush<T3>(fourth, fourthValue)
    soaColumnPush<T4>(fifth, fifthValue)
    soaColumnPush<T5>(sixth, sixthValue)
