namespace std {
  namespace collections {
  namespace soa_storage {
  [public return<T>]
  soaColumnRead<T>([SoaColumn<T>] values, [i32] index) {
    soaColumnCheckIndex<T>(values, index)
    return(*(soaColumnBorrowSlot<T>(values, index)))
  }

  [public return<T0>]
  soaColumns2ReadFirst<T0, T1>([Reference<SoaColumns2<T0, T1>>] values, [i32] index) {
    soaColumns2CheckShape<T0, T1>(values)
    [Reference<SoaColumn<T0>>] first{values.first}
    return(soaColumnRead<T0>(first, index))
  }

  [public return<T1>]
  soaColumns2ReadSecond<T0, T1>([Reference<SoaColumns2<T0, T1>>] values, [i32] index) {
