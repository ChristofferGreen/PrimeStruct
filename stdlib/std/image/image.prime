          return(0i32)
        } else {
          if(distanceMaxBits <= 0i32) {
            return(1i32)
          }
          [mut] lengthBase{0i32}
          [mut] lengthExtraBits{0i32}
          lengthInfoStatus{pngLengthInfo(symbol, lengthBase, lengthExtraBits)}
          if(lengthInfoStatus != 0i32) {
            return(1i32)
          }
          [mut] lengthExtraValue{0i32}
          if(lengthExtraBits > 0i32) {
            lengthExtraStatus{pngReadBits(compressed, byteIndex, bitIndex, lengthExtraBits, lengthExtraValue)}
            if(lengthExtraStatus != 0i32) {
              return(1i32)
            }
          }
          matchLength{lengthBase + lengthExtraValue}
          [mut] distanceSymbol{0i32}
          distanceStatus{pngHuffmanDecodeSymbol(compressed, byteIndex, bitIndex, distanceLengths,
                                                distanceMaxBits, distanceSymbol)}
          if(distanceStatus != 0i32) {
            return(1i32)
          }
          [mut] distanceBase{0i32}
          [mut] distanceExtraBits{0i32}
          distanceInfoStatus{pngDistanceInfo(distanceSymbol, distanceBase, distanceExtraBits)}
          if(distanceInfoStatus != 0i32) {
            return(1i32)
          }
          [mut] distanceExtraValue{0i32}
          if(distanceExtraBits > 0i32) {
            distanceExtraStatus{pngReadBits(compressed, byteIndex, bitIndex, distanceExtraBits, distanceExtraValue)}
            if(distanceExtraStatus != 0i32) {
              return(1i32)
            }
          }
          copyStatus{pngInflateCopyFromOutput(output, distanceBase + distanceExtraValue, matchLength)}
          if(copyStatus != 0i32) {
            return(1i32)
          }
        }
      }
    }
    return(1i32)
  }

  [effects(heap_alloc), return<int>]
  pngInflateDeflateBlocks([vector<i32>] compressed, [vector<i32> mut] output) {
    clear(output)
    compressedCount{count(compressed)}
    if(compressedCount < 7i32) {
      return(1i32)
    }

    if(!(pngZlibHeaderValid(compressed[0i32], compressed[1i32]))) {

      return(1i32)

    }

    [mut] byteIndex{2i32}
    [mut] bitIndex{0i32}
    while(true) {
      [mut] isFinal{0i32}
      finalStatus{pngReadBits(compressed, byteIndex, bitIndex, 1i32, isFinal)}
      if(finalStatus != 0i32) {
        return(1i32)
      }
      [mut] blockType{0i32}
      blockStatus{pngReadBits(compressed, byteIndex, bitIndex, 2i32, blockType)}
      if(blockStatus != 0i32) {
        return(1i32)
      }
      [mut] inflateStatus{0i32}
      if(blockType == 0i32) {
        inflateStatus = pngInflateStoredBlock(compressed, byteIndex, bitIndex, output)
      } else {
        if(blockType == 1i32) {
          inflateStatus = pngInflateFixedHuffmanBlock(compressed, byteIndex, bitIndex, output)
        } else {
          if(blockType == 2i32) {
            inflateStatus = pngInflateDynamicHuffmanBlock(compressed, byteIndex, bitIndex, output)
          } else {
            return(1i32)
          }
        }
      }
      if(inflateStatus != 0i32) {
        return(inflateStatus)
      }
      if(isFinal == 1i32) {
        if(bitIndex != 0i32) {
          bitIndex = 0i32
          byteIndex = byteIndex + 1i32
        }
        if(compressedCount - byteIndex != 4i32) {
          return(1i32)
        }
        adlerBHigh{compressed[byteIndex]}
        adlerBLow{compressed[byteIndex + 1i32]}
        adlerAHigh{compressed[byteIndex + 2i32]}
        adlerALow{compressed[byteIndex + 3i32]}
        if(!(pngAdlerValid(output, adlerBHigh, adlerBLow, adlerAHigh, adlerALow))) {
          return(1i32)
        }
        return(0i32)
      }
    }
    return(1i32)
  }

  [effects(heap_alloc), return<int>]
  pngDecodeScanlines([vector<i32>] rawBytes, [i32] width, [i32] height, [i32] bitDepth, [i32] colorType,
                     [i32] interlace, [vector<i32>] paletteBytes, [vector<i32> mut] pixels) {
    clear(pixels)
    if(colorType != 0i32 && colorType != 2i32 && colorType != 3i32 && colorType != 4i32 && colorType != 6i32) {
      return(2i32)
    }
    if(!(pngDecodeBitDepthSupported(bitDepth, colorType))) {
      return(2i32)
    }
    if(colorType == 3i32) {
      if(count(paletteBytes) == 0i32 || pngMod(count(paletteBytes), 3i32) != 0i32 || count(paletteBytes) > 768i32) {
        return(1i32)
      }
    }

    [mut] offset{0i32}
    if(interlace == 0i32) {
      rowStatus{pngDecodeRows(rawBytes, offset, width, height, bitDepth, colorType, paletteBytes, pixels)}
      if(rowStatus != 0i32) {
        clear(pixels)
        return(rowStatus)
      }
    } else {
       if(interlace != 1i32) {
         return(2i32)
       }
       initStatus{pngInitRgbPixels(width, height, pixels)}
       if(initStatus != 0i32) {
         clear(pixels)
         return(1i32)
       }
       [mut] passPixels{vector<i32>()}
      [mut] passIndex{0i32}
      while(passIndex < 7i32) {
        passStartX{pngAdam7PassStartX(passIndex)}
        passStartY{pngAdam7PassStartY(passIndex)}
        passStepX{pngAdam7PassStepX(passIndex)}
        passStepY{pngAdam7PassStepY(passIndex)}
        passWidth{pngAdam7PassSpan(width, passStartX, passStepX)}
        passHeight{pngAdam7PassSpan(height, passStartY, passStepY)}
        if(passWidth > 0i32 && passHeight > 0i32) {
          passStatus{pngDecodeRows(rawBytes, offset, passWidth, passHeight, bitDepth, colorType, paletteBytes, passPixels)}
          if(passStatus != 0i32) {
            clear(pixels)
            return(passStatus)
          }
          [mut] passRow{0i32}
          while(passRow < passHeight) {
            [mut] passColumn{0i32}
            while(passColumn < passWidth) {
              imageX{passStartX + passColumn * passStepX}
              imageY{passStartY + passRow * passStepY}
              sourceOffset{(passRow * passWidth + passColumn) * 3i32}
              targetOffset{(imageY * width + imageX) * 3i32}
              pixels[targetOffset] = passPixels[sourceOffset]
              pixels[targetOffset + 1i32] = passPixels[sourceOffset + 1i32]
              pixels[targetOffset + 2i32] = passPixels[sourceOffset + 2i32]
              passColumn++
            }
            passRow++
          }
        }
        passIndex++
      }
    }
    if(offset != count(rawBytes)) {
      clear(pixels)
      return(1i32)
    }
    return(0i32)
  }

  namespace ppm {
    [effects(file_read, heap_alloc), return<int> on_error<FileError, ignoreFileError>]
    readImpl([i32 mut] width, [i32 mut] height, [vector<i32> mut] pixels, [string] path) {
      [File<Read>] file{File<Read>(path)?}
      [mut] hasPending{0i32}
      [mut] pendingByte{0i32}
      [mut] byte{0i32}
      [mut] formatByte{0i32}
      [mut] status{ppmNextByte(file, hasPending, pendingByte, byte)}
      if(status != 0i32 || byte != 80i32) {
        return(1i32)
      }

      status = ppmNextByte(file, hasPending, pendingByte, byte)
      if(status != 0i32 || byte != 51i32 && byte != 54i32) {
        return(1i32)
      } else {
        formatByte = byte
      }
      status = ppmNextByte(file, hasPending, pendingByte, byte)
      if(status != 0i32) {
        return(1i32)
      }
      if(ppmIsWhitespace(byte) || byte == 35i32) {
        hasPending = 1i32
        pendingByte = byte
      } else {
        return(1i32)
      }

      [mut] parsedWidth{0i32}
      [mut] parsedHeight{0i32}
      [mut] maxValue{0i32}
      status = ppmReadAsciiInt(file, hasPending, pendingByte, parsedWidth)
      if(status != 0i32) {
        return(1i32)
      }
      status = ppmReadAsciiInt(file, hasPending, pendingByte, parsedHeight)
      if(status != 0i32) {
        return(1i32)
      }
      status = ppmReadAsciiInt(file, hasPending, pendingByte, maxValue)
      if(status != 0i32 || maxValue != 255i32 || parsedWidth <= 0i32 || parsedHeight <= 0i32) {
        return(1i32)
      }

      [mut] pixelCount{0i32}
      if(!(imageRgbWritePixelCount(parsedWidth, parsedHeight, pixelCount))) {
        return(1i32)
      }
      [mut] index{0i32}
      [mut] component{0i32}
      if(formatByte == 51i32) {
        while(index < pixelCount) {
          status = ppmReadAsciiInt(file, hasPending, pendingByte, component)
          if(status != 0i32 || component < 0i32 || component > 255i32) {
            resetReadOutputs(width, height, pixels)
            return(1i32)
          }
          push(pixels, component)
          index++
        }
      } else {
        status = ppmReadBinaryRasterLead(file, hasPending, pendingByte, component)
        if(status != 0i32) {
          return(1i32)
        }
        push(pixels, component)
        index = 1i32
        while(index < pixelCount) {
          status = ppmReadByteStatus(file, component)
          if(status != 0i32) {
            resetReadOutputs(width, height, pixels)
            return(1i32)
          }
          push(pixels, component)
          index++
        }
      }

      width = parsedWidth
      height = parsedHeight
      return(0i32)
    }

    [public return<Result<ImageError>> effects(file_read, heap_alloc)]
    read([i32 mut] width, [i32 mut] height, [vector<i32> mut] pixels, [string] path) {
      resetReadOutputs(width, height, pixels)
      status{readImpl(width, height, pixels, path)}
      if(status != 0i32) {
        resetReadOutputs(width, height, pixels)
        return(invalidOperation())
      }
      return(Result.ok())
    }

    [effects(file_write), return<int> on_error<FileError, ignoreFileError>]
    writeImpl([string] path, [i32] width, [i32] height, [vector<i32>] pixels) {
      if(!(ppmWriteInputValid(width, height, pixels))) {
        return(1i32)
      }

      [File<Write>] file{File<Write>(path)?}
      [mut] status{ppmWriteHeader(file, width, height)}
      if(status != 0i32) {
        return(1i32)
      }

      pixelCount{pixels.count()}
      [mut] index{0i32}
      while(index < pixelCount) {
        status = ppmWriteComponent(file, pixels[index])
        if(status != 0i32) {
          return(1i32)
        }
        ++index
      }
      return(0i32)
    }

    [public return<Result<ImageError>> effects(file_write)]
    write([string] path, [i32] width, [i32] height, [vector<i32>] pixels) {
      status{writeImpl(path, width, height, pixels)}
      if(status != 0i32) {
        return(invalidOperation())
      }
      return(Result.ok())
    }
  }

  namespace png {
    [effects(file_read, heap_alloc), return<int> on_error<FileError, ignoreFileError>]
    readImpl([i32 mut] width, [i32 mut] height, [vector<i32> mut] pixels, [string] path) {
      [File<Read>] file{File<Read>(path)?}
      signatureStatus{pngValidateSignature(file)}
      if(signatureStatus != 0i32) {
        return(1i32)
      }

      [mut] sawIhdr{0i32}
      [mut] sawIdat{0i32}
      [mut] sawPlte{0i32}
      [mut] sawPostIdatChunk{0i32}
      [mut] parsedWidth{0i32}
      [mut] parsedHeight{0i32}
      [mut] bitDepth{0i32}
      [mut] colorType{0i32}
      [mut] interlace{0i32}
      [mut] idatBytes{vector<i32>()}
      [mut] plteBytes{vector<i32>()}
      [mut] rawBytes{vector<i32>()}
      while(true) {
        [mut] chunkLength{0i32}
        lengthStatus{pngReadU32Be(file, chunkLength)}
        if(lengthStatus != 0i32 || chunkLength < 0i32) {
          return(1i32)
        }
        [mut] typeA{0i32}
        [mut] typeB{0i32}
        [mut] typeC{0i32}
        [mut] typeD{0i32}
        typeStatus{pngReadChunkType(file, typeA, typeB, typeC, typeD)}
        if(typeStatus != 0i32) {
          return(1i32)
        }
        if(sawIhdr == 0i32) {
          if(!(pngChunkIsIhdr(typeA, typeB, typeC, typeD)) || chunkLength != 13i32) {
            return(1i32)
          }
          sawIhdr = 1i32
          ihdrStatus{pngReadIhdr(file, parsedWidth, parsedHeight, bitDepth, colorType, interlace)}
          if(ihdrStatus != 0i32) {
            return(1i32)
          }
          [mut] ihdrCrcA{0i32}
          [mut] ihdrCrcB{0i32}
          [mut] ihdrCrcC{0i32}
          [mut] ihdrCrcD{0i32}
          ihdrCrcStatus{pngReadChunkType(file, ihdrCrcA, ihdrCrcB, ihdrCrcC, ihdrCrcD)}
          if(ihdrCrcStatus != 0i32) {
            return(1i32)
          }
          [mut] ihdrBytes{vector<i32>()}
          pngAppendU32Be(parsedWidth, ihdrBytes)
          pngAppendU32Be(parsedHeight, ihdrBytes)
          push(ihdrBytes, bitDepth)
          push(ihdrBytes, colorType)
          push(ihdrBytes, 0i32)
          push(ihdrBytes, 0i32)
          push(ihdrBytes, interlace)
          if(!(pngChunkCrcMatches(typeA, typeB, typeC, typeD, ihdrBytes, ihdrCrcA, ihdrCrcB, ihdrCrcC, ihdrCrcD))) {
            return(1i32)
          }
        } else {
          if(pngChunkIsIhdr(typeA, typeB, typeC, typeD)) {
            return(1i32)
          }
          if(pngChunkIsPlte(typeA, typeB, typeC, typeD)) {
            if(sawPlte != 0i32 || sawIdat != 0i32) {
              return(1i32)
            }
            sawPlte = 1i32
          }
          if(sawPostIdatChunk != 0i32 && pngChunkIsIdat(typeA, typeB, typeC, typeD)) {
            return(1i32)
          }
          if(sawIdat != 0i32 && !(pngChunkIsIdat(typeA, typeB, typeC, typeD)) && !(pngChunkIsIend(typeA, typeB, typeC, typeD)) && !(pngChunkIsAncillary(typeA))) {
            return(1i32)
          }
          [mut] chunkBytes{vector<i32>()}
          payloadStatus{pngAppendBytes(file, chunkLength, chunkBytes)}
          if(payloadStatus != 0i32) {
            return(1i32)
          }
          [mut] crcA{0i32}
          [mut] crcB{0i32}
          [mut] crcC{0i32}
          [mut] crcD{0i32}
          crcStatus{pngReadChunkType(file, crcA, crcB, crcC, crcD)}
          if(crcStatus != 0i32) {
            return(1i32)
          }
          if(!(pngChunkIsAncillary(typeA)) && !(pngChunkCrcMatches(typeA, typeB, typeC, typeD, chunkBytes, crcA, crcB, crcC, crcD))) {
            return(1i32)
          }
          if(pngChunkIsPlte(typeA, typeB, typeC, typeD)) {
            if(count(chunkBytes) == 0i32 || pngMod(count(chunkBytes), 3i32) != 0i32 || count(chunkBytes) > 768i32) {
              return(1i32)
            }
            clear(plteBytes)
            pngAppendVectorBytes(chunkBytes, plteBytes)
          }
          if(sawIdat != 0i32 && !(pngChunkIsIdat(typeA, typeB, typeC, typeD))) {
            sawPostIdatChunk = 1i32
          }
          if(pngChunkIsIdat(typeA, typeB, typeC, typeD)) {
            sawIdat = 1i32
            pngAppendVectorBytes(chunkBytes, idatBytes)
          }
          if(pngChunkIsIend(typeA, typeB, typeC, typeD)) {
            if(chunkLength != 0i32 || sawIdat == 0i32) {
              return(1i32)
            } else {
              inflateStatus{pngInflateDeflateBlocks(idatBytes, rawBytes)}
              if(inflateStatus == 1i32) {
                return(1i32)
              }
              if(inflateStatus == 2i32) {
                return(2i32)
              }
              if(colorType == 3i32 && count(plteBytes) == 0i32) {
                return(1i32)
              }
              decodeStatus{pngDecodeScanlines(rawBytes, parsedWidth, parsedHeight, bitDepth, colorType, interlace, plteBytes, pixels)}
              if(decodeStatus == 1i32) {
                resetReadOutputs(width, height, pixels)
                return(1i32)
              }
              if(decodeStatus == 2i32) {
                resetReadOutputs(width, height, pixels)
                return(2i32)
              }
              width = parsedWidth
              height = parsedHeight
              return(0i32)
            }
          }
        }
      }
      return(1i32)
    }

    [public return<Result<ImageError>> effects(file_read, heap_alloc)]
    read([i32 mut] width, [i32 mut] height, [vector<i32> mut] pixels, [string] path) {
      resetReadOutputs(width, height, pixels)
      status{readImpl(width, height, pixels, path)}
      if(status == 1i32) {
        resetReadOutputs(width, height, pixels)
        return(invalidOperation())
      }
      if(status == 2i32) {
        resetReadOutputs(width, height, pixels)
        return(unsupported_read())
      }
      return(Result.ok())
    }

    [effects(file_write), return<int> on_error<FileError, ignoreFileError>]
    writeImpl([string] path, [i32] width, [i32] height, [vector<i32>] pixels) {
      if(!(ppmWriteInputValid(width, height, pixels))) {
        return(1i32)
      }
      [mut] rawByteCount{0i32}
      [mut] payloadLength{0i32}
      if(!(pngWriteSizingValid(width, height, rawByteCount, payloadLength))) {
        return(1i32)
      }

      [File<Write>] file{File<Write>(path)?}
      signatureStatus{pngWriteSignature(file)}
      if(signatureStatus != 0i32) {
        return(signatureStatus)
      }
      ihdrStatus{pngWriteIhdrChunk(file, width, height)}
      if(ihdrStatus != 0i32) {
        return(ihdrStatus)
      }
      idatStatus{pngWriteIdatChunk(file, width, height, pixels, rawByteCount, payloadLength)}
      if(idatStatus != 0i32) {
        return(idatStatus)
      }
      return(pngWriteIendChunk(file))
    }

    [public return<Result<ImageError>> effects(file_write)]
    write([string] path, [i32] width, [i32] height, [vector<i32>] pixels) {
      status{writeImpl(path, width, height, pixels)}
      if(status != 0i32) {
        return(invalidOperation())
      }
      return(Result.ok())
    }
  }
}
