  }

  [effects(heap_alloc), return<int>]
  pngDecodeRows([vector<i32>] rawBytes, [i32 mut] offset, [i32] width, [i32] height, [i32] bitDepth, [i32] colorType,
                [vector<i32>] paletteBytes, [vector<i32> mut] pixels) {
    clear(pixels)
    if(offset < 0i32 || offset > count(rawBytes)) {
      return(1i32)
    }

    [mut] pixelCount{0i32}
    if(!(imageRgbWritePixelCount(width, height, pixelCount))) {
      clear(pixels)
      return(1i32)
    }
    reserve(pixels, pixelCount)

    bytesPerPixel{pngFilterBytesPerPixel(bitDepth, colorType)}
    [mut] scanlineBytes{0i32}
    if(!(pngScanlineBytesValid(width, bitDepth, colorType, scanlineBytes))) {
      clear(pixels)
      return(1i32)
    }
    requiredRowBytesWide{convert<i64>(height) * (convert<i64>(scanlineBytes) + 1i64)}
    if(requiredRowBytesWide <= 0i64 || requiredRowBytesWide > 2147483647i64) {
      clear(pixels)
      return(1i32)
    }
    if(count(rawBytes) - offset < convert<i32>(requiredRowBytesWide)) {
      return(1i32)
    }

    [mut] row{0i32}
    [mut] rowBytes{vector<i32>()}
    [mut] previousRowBytes{vector<i32>()}
    while(row < height) {
      filterType{rawBytes[offset]}
      if(filterType != 0i32 && filterType != 1i32 && filterType != 2i32 && filterType != 3i32 && filterType != 4i32) {
        clear(pixels)
        return(1i32)
      }
      offset = offset + 1i32
      clear(rowBytes)
      [mut] byteIndex{0i32}
      while(byteIndex < scanlineBytes) {
        [mut] reconstructed{rawBytes[offset + byteIndex]}
        [mut] leftByte{0i32}
        [mut] upByte{0i32}
        [mut] upLeftByte{0i32}
        if(byteIndex >= bytesPerPixel) {
          leftByte = rowBytes[byteIndex - bytesPerPixel]
        }
        if(byteIndex < count(previousRowBytes)) {
          upByte = previousRowBytes[byteIndex]
        }
        if(byteIndex >= bytesPerPixel && byteIndex - bytesPerPixel < count(previousRowBytes)) {
          upLeftByte = previousRowBytes[byteIndex - bytesPerPixel]
        }
        if(filterType == 1i32 && byteIndex >= bytesPerPixel) {
          reconstructed = pngMod(reconstructed + leftByte, 256i32)
        }
        if(filterType == 2i32 && byteIndex < count(previousRowBytes)) {
          reconstructed = pngMod(reconstructed + upByte, 256i32)
        }
        if(filterType == 3i32) {
          reconstructed = pngMod(reconstructed + (leftByte + upByte) / 2i32, 256i32)
        }
        if(filterType == 4i32) {
          reconstructed = pngMod(reconstructed + pngPaethPredictor(leftByte, upByte, upLeftByte), 256i32)
        }
        push(rowBytes, reconstructed)
        byteIndex++
      }
      if(bitDepth < 8i32) {
        [mut] pixelIndex{0i32}
        while(pixelIndex < width) {
          sample{pngPackedSampleAt(rowBytes, pixelIndex, bitDepth)}
          if(colorType == 0i32) {
            grayByte{pngScalePackedSampleToByte(sample, bitDepth)}
            push(pixels, grayByte)
            push(pixels, grayByte)
            push(pixels, grayByte)
          } else {
            paletteOffset{sample * 3i32}
            if(paletteOffset + 2i32 >= count(paletteBytes)) {
              clear(pixels)
              return(1i32)
            }
            push(pixels, paletteBytes[paletteOffset])
            push(pixels, paletteBytes[paletteOffset + 1i32])
            push(pixels, paletteBytes[paletteOffset + 2i32])
          }
          pixelIndex++
        }
      } else {
        [mut] pixelByteIndex{0i32}
        channelByteStride{bitDepth / 8i32}
        while(pixelByteIndex < scanlineBytes) {
          if(colorType == 0i32) {
            grayByte{pngScanlineChannelByte(rowBytes, pixelByteIndex, bitDepth)}
            push(pixels, grayByte)
            push(pixels, grayByte)
            push(pixels, grayByte)
          } else {
            if(colorType == 4i32) {
              grayByte{pngScanlineChannelByte(rowBytes, pixelByteIndex, bitDepth)}
              push(pixels, grayByte)
              push(pixels, grayByte)
              push(pixels, grayByte)
            } else {
              if(colorType == 3i32) {
                paletteOffset{rowBytes[pixelByteIndex] * 3i32}
                if(paletteOffset + 2i32 >= count(paletteBytes)) {
                  clear(pixels)
                  return(1i32)
                }
                push(pixels, paletteBytes[paletteOffset])
                push(pixels, paletteBytes[paletteOffset + 1i32])
                push(pixels, paletteBytes[paletteOffset + 2i32])
              } else {
                push(pixels, pngScanlineChannelByte(rowBytes, pixelByteIndex, bitDepth))
                push(pixels, pngScanlineChannelByte(rowBytes, pixelByteIndex + channelByteStride, bitDepth))
                push(pixels, pngScanlineChannelByte(rowBytes, pixelByteIndex + channelByteStride * 2i32, bitDepth))
              }
            }
          }
          pixelByteIndex = pixelByteIndex + bytesPerPixel
        }
      }
      clear(previousRowBytes)
      [mut] previousRowIndex{0i32}
      while(previousRowIndex < scanlineBytes) {
        push(previousRowBytes, rowBytes[previousRowIndex])
        previousRowIndex++
      }
      offset = offset + scanlineBytes
      row++
    }
    return(0i32)
  }

  [return<bool>]
