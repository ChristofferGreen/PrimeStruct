  [return<void>]
  ignoreFileError([FileError] err) {
  }

  // The codec and deflate helpers below intentionally keep explicit
  // * calls because they are byte-oriented
  // substrate plumbing rather than the public-facing image wrapper layer
  // above, which should prefer the readable surface syntax when possible.

  [return<bool>]
  ppmIsWhitespace([i32] value) {
    return(value == 32i32 || value == 9i32 || value == 10i32 || value == 13i32)
  }

  [return<bool>]
  ppmIsDigit([i32] value) {
    return(value >= 48i32 && value <= 57i32)
  }

  [return<i32>]
  ppmDigitValue([i32] value) {
    return(value - 48i32)
  }

  [effects(file_read), return<int> on_error<FileError, ignoreFileError>]
  ppmReadByteStatus([File<Read>] file, [i32 mut] value) {
    file.readByte(value)?
    return(0i32)
  }

  [effects(file_read), return<int>]
  ppmSkipComment([File<Read>] file) {
    [mut] byte{0i32}
    while(true) {
      status{ppmReadByteStatus(file, byte)}
      if(status != 0i32) {
        if(fileErrorIsEof(status)) {
          return(0i32)
        } else {
          return(status)
        }
      }
      if(byte == 10i32 || byte == 13i32) {
        return(0i32)
      }
    }
    return(0i32)
  }

  [effects(file_read), return<int>]
  ppmNextByte([File<Read>] file, [i32 mut] hasPending, [i32 mut] pendingByte, [i32 mut] value) {
    if(hasPending == 1i32) {
      value = pendingByte
      hasPending = 0i32
      return(0i32)
    }
    return(ppmReadByteStatus(file, value))
  }

  [effects(file_read), return<int>]
  ppmReadAsciiInt([File<Read>] file, [i32 mut] hasPending, [i32 mut] pendingByte, [i32 mut] value) {
    value = 0i32
    [mut] started{0i32}
    [mut] byte{0i32}
    while(true) {
      status{ppmNextByte(file, hasPending, pendingByte, byte)}
      if(status != 0i32) {
        if(started == 1i32) {
          if(fileErrorIsEof(status)) {
            return(0i32)
          } else {
            return(status)
          }
        } else {
          return(status)
        }
      }
      if(started == 0i32) {
        if(ppmIsWhitespace(byte)) {
        } else {
          if(byte == 35i32) {
            commentStatus{ppmSkipComment(file)}
            if(commentStatus != 0i32) {
              return(commentStatus)
            }
          } else {
            if(ppmIsDigit(byte)) {
              started = 1i32
              value = ppmDigitValue(byte)
            } else {
              return(1i32)
            }
          }
        }
      } else {
        if(ppmIsDigit(byte)) {
          value = value * 10i32 + ppmDigitValue(byte)
        } else {
          hasPending = 1i32
          pendingByte = byte
          return(0i32)
        }
      }
    }
    return(0i32)
  }

  [effects(file_read), return<int>]
  ppmReadBinaryRasterLead([File<Read>] file, [i32 mut] hasPending, [i32 mut] pendingByte, [i32 mut] value) {
    [mut] sawWhitespace{0i32}
    while(true) {
      status{ppmNextByte(file, hasPending, pendingByte, value)}
      if(status != 0i32) {
        return(status)
      }
      if(ppmIsWhitespace(value)) {
        sawWhitespace = 1i32
      } else {
        if(sawWhitespace == 1i32) {
          return(0i32)
        } else {
          return(1i32)
        }
      }
    }
    return(0i32)
  }

  [effects(heap_alloc), return<void>]
  resetReadOutputs([i32 mut] width, [i32 mut] height, [vector<i32> mut] pixels) {
    width = 0i32
    height = 0i32
    clear(pixels)
  }

  [return<bool>]
  imageRgbWritePixelCount([i32] width, [i32] height, [i32 mut] pixelCount) {
    pixelCount = 0i32
    if(width <= 0i32 || height <= 0i32) {
      return(false)
    }

    pixelCountWide{convert<i64>(width) * convert<i64>(height) * 3i64}
    if(pixelCountWide <= 0i64 || pixelCountWide > 2147483647i64) {
      return(false)
    }
    pixelCount = convert<i32>(pixelCountWide)
    return(true)
  }

  [return<bool>]
  ppmWriteInputValid([i32] width, [i32] height, [vector<i32>] pixels) {
    pixelCount{pixels.count()}
    [mut] expectedPixelCount{0i32}
    if(!imageRgbWritePixelCount(width, height, expectedPixelCount)) {
      return(false)
    }
    if(pixelCount != expectedPixelCount) {
      return(false)
    }

    [mut] index{0i32}
    while(index < pixelCount) {
      component{pixels[index]}
      if(component < 0i32 || component > 255i32) {
        return(false)
      }
      ++index
    }
    return(true)
  }

  [effects(file_write), return<int> on_error<FileError, ignoreFileError>]
  ppmWriteHeader([File<Write>] file, [i32] width, [i32] height) {
    file.write("P3\n"utf8, width, " "utf8, height, "\n255\n"utf8)?
    return(0i32)
  }

  [effects(file_write), return<int> on_error<FileError, ignoreFileError>]
  ppmWriteComponent([File<Write>] file, [i32] value) {
    file.write(value, "\n"utf8)?
    return(0i32)
  }

  [effects(file_read), return<int>]
  pngReadU32Be([File<Read>] file, [i32 mut] value) {
    value = 0i32
    [mut] index{0i32}
    [mut] byte{0i32}
    while(index < 4i32) {
      status{ppmReadByteStatus(file, byte)}
      if(status != 0i32) {
        return(status)
      }
      if(byte < 0i32 || byte > 255i32) {
        return(1i32)
      }
      value = value * 256i32 + byte
      index++
    }
    return(0i32)
  }

  [effects(file_read), return<int>]
  pngSkipBytes([File<Read>] file, [i32] count) {
    if(count < 0i32) {
      return(1i32)
    }
    [mut] remaining{count}
    [mut] byte{0i32}
    while(remaining > 0i32) {
      status{ppmReadByteStatus(file, byte)}
      if(status != 0i32) {
        return(status)
      }
      remaining = remaining - 1i32
    }
    return(0i32)
  }

  [effects(file_read), return<int>]
  pngReadChunkType([File<Read>] file, [i32 mut] a, [i32 mut] b, [i32 mut] c, [i32 mut] d) {
    statusA{ppmReadByteStatus(file, a)}
    if(statusA != 0i32) {
      return(statusA)
    }
    statusB{ppmReadByteStatus(file, b)}
    if(statusB != 0i32) {
      return(statusB)
    }
    statusC{ppmReadByteStatus(file, c)}
    if(statusC != 0i32) {
      return(statusC)
    }
    return(ppmReadByteStatus(file, d))
  }

  [return<bool>]
  pngChunkIsIhdr([i32] a, [i32] b, [i32] c, [i32] d) {
    return(a == 73i32 && b == 72i32 && c == 68i32 && d == 82i32)
  }

  [return<bool>]
  pngChunkIsIdat([i32] a, [i32] b, [i32] c, [i32] d) {
    return(a == 73i32 && b == 68i32 && c == 65i32 && d == 84i32)
  }

  [return<bool>]
  pngChunkIsIend([i32] a, [i32] b, [i32] c, [i32] d) {
    return(a == 73i32 && b == 69i32 && c == 78i32 && d == 68i32)
  }

  [return<bool>]
  pngChunkIsPlte([i32] a, [i32] b, [i32] c, [i32] d) {
    return(a == 80i32 && b == 76i32 && c == 84i32 && d == 69i32)
  }

  [return<bool>]
  pngChunkIsAncillary([i32] a) {
