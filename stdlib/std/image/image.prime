  }

  [return<bool>]
  pngBitDepthAllowed([i32] bitDepth, [i32] a, [i32] b, [i32] c, [i32] d, [i32] valueE) {
    return(bitDepth == a || bitDepth == b || bitDepth == c || bitDepth == d || bitDepth == valueE)
  }

  [return<bool>]
  pngIhdrFieldsValid([i32] bitDepth, [i32] colorType, [i32] compression, [i32] filter, [i32] interlace) {
    if(compression != 0i32 || filter != 0i32 || interlace != 0i32 && interlace != 1i32) {
      return(false)
    }
    if(colorType == 0i32) {
      return(pngBitDepthAllowed(bitDepth, 1i32, 2i32, 4i32, 8i32, 16i32))
    }
    if(colorType == 2i32) {
      return(bitDepth == 8i32 || bitDepth == 16i32)
    }
    if(colorType == 3i32) {
      return(pngBitDepthAllowed(bitDepth, 1i32, 2i32, 4i32, 8i32, -1i32))
    }
    if(colorType == 4i32) {
      return(bitDepth == 8i32 || bitDepth == 16i32)
    }
    if(colorType == 6i32) {
      return(bitDepth == 8i32 || bitDepth == 16i32)
    }
    return(false)
  }

  [effects(file_read), return<int>]
  pngValidateSignature([File<Read>] file) {
    [mut] byte{0i32}
    status0{ppmReadByteStatus(file, byte)}
    if(status0 != 0i32) {
      return(status0)
