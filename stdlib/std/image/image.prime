  [return<i32>]
  pngPaethPredictor([i32] left, [i32] up, [i32] upLeft) {
    predictor{left + up - upLeft}
    leftDistance{/std/math/abs(predictor - left)}
    upDistance{/std/math/abs(predictor - up)}
    upLeftDistance{/std/math/abs(predictor - upLeft)}
    if(leftDistance <= upDistance && leftDistance <= upLeftDistance) {
      return(left)
    }
    if(upDistance <= upLeftDistance) {
      return(up)
    }
    return(upLeft)
  }

  [return<i32>]
  pngColorTypeSamplesPerPixel([i32] colorType) {
    if(colorType == 0i32 || colorType == 3i32) {
      return(1i32)
    }
    if(colorType == 2i32) {
      return(3i32)
    }
    if(colorType == 4i32) {
      return(2i32)
    }
    return(4i32)
  }

  [return<bool>]
  pngDecodeBitDepthSupported([i32] bitDepth, [i32] colorType) {
    if(colorType == 0i32) {
      return(pngBitDepthAllowed(bitDepth, 1i32, 2i32, 4i32, 8i32, 16i32))
    }
    if(colorType == 2i32 || colorType == 6i32) {
      return(bitDepth == 8i32 || bitDepth == 16i32)
    }
    if(colorType == 4i32) {
      return(bitDepth == 8i32 || bitDepth == 16i32)
    }
    if(colorType == 3i32) {
      return(pngBitDepthAllowed(bitDepth, 1i32, 2i32, 4i32, 8i32, -1i32))
    }
    return(false)
  }

  [return<i32>]
  pngFilterBytesPerPixel([i32] bitDepth, [i32] colorType) {
    return((pngColorTypeSamplesPerPixel(colorType) * bitDepth + 7i32) / 8i32)
  }

  [return<i32>]
  pngScanlineBytes([i32] width, [i32] bitDepth, [i32] colorType) {
    return((width * pngColorTypeSamplesPerPixel(colorType) * bitDepth + 7i32) / 8i32)
  }

  [return<bool>]
  pngScanlineBytesValid([i32] width, [i32] bitDepth, [i32] colorType, [i32 mut] scanlineBytes) {
    scanlineBytes = 0i32
    if(width <= 0i32) {
      return(false)
    }
    scanlineBitsWide{
        convert<i64>(width) * convert<i64>(pngColorTypeSamplesPerPixel(colorType)) * convert<i64>(bitDepth)}
    if(scanlineBitsWide <= 0i64 || scanlineBitsWide > 17179869176i64) {
      return(false)
    }
    scanlineBytesWide{(scanlineBitsWide + 7i64) / 8i64}
    if(scanlineBytesWide > 2147483647i64) {
      return(false)
    }
    scanlineBytes = convert<i32>(scanlineBytesWide)
    return(true)
  }

  [return<i32>]
  pngSampleValueCount([i32] bitDepth) {
    [mut] valueCount{1i32}
    [mut] shift{0i32}
    while(shift < bitDepth) {
      valueCount = valueCount * 2i32
      shift++
    }
    return(valueCount)
  }

  [return<i32>]
  pngPackedSampleAt([vector<i32>] rowBytes, [i32] pixelIndex, [i32] bitDepth) {
    samplesPerByte{8i32 / bitDepth}
    byteIndex{pixelIndex / samplesPerByte}
    sampleIndex{pngMod(pixelIndex, samplesPerByte)}
    shiftAmount{(samplesPerByte - 1i32 - sampleIndex) * bitDepth}
    [mut] shifted{rowBytes[byteIndex]}
    [mut] shiftCount{0i32}
    while(shiftCount < shiftAmount) {
      shifted = shifted / 2i32
      shiftCount++
    }
    return(pngMod(shifted, pngSampleValueCount(bitDepth)))
  }

  [return<i32>]
  pngScalePackedSampleToByte([i32] sample, [i32] bitDepth) {
    maxSample{pngSampleValueCount(bitDepth) - 1i32}
    if(maxSample <= 0i32) {
      return(0i32)
    }
    return(sample * 255i32 / maxSample)
  }

  [return<i32>]
  pngScaleU16SampleToByte([i32] highByte, [i32] lowByte) {
    return((highByte * 256i32 + lowByte) / 257i32)
  }

  [return<i32>]
