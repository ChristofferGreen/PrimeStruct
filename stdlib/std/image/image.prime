    crc = pngCrc32UpdateByte(crc, typeA)
    statusB{pngWriteByte(file, typeB)}
    if(statusB != 0i32) {
      return(statusB)
    }
    crc = pngCrc32UpdateByte(crc, typeB)
    statusC{pngWriteByte(file, typeC)}
    if(statusC != 0i32) {
