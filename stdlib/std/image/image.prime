      [mut] shifted{bytes[byteIndex]}
      [mut] shiftCount{0i32}
      while(shiftCount < bitIndex) {
        shifted = shifted / 2i32
        shiftCount++
      }
      value = value + pngMod(shifted, 2i32) * factor
      factor = factor * 2i32
      bitIndex = bitIndex + 1i32
      if(bitIndex == 8i32) {
        bitIndex = 0i32
        byteIndex = byteIndex + 1i32
      }
      readCount++
    }
    return(0i32)
  }

