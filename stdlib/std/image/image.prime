    return(b / 256i32 == bHigh && pngMod(b, 256i32) == bLow && a / 256i32 == aHigh && pngMod(a, 256i32) == aLow)
  }

  [return<i32>]
  pngReadBits([vector<i32>] bytes, [i32 mut] byteIndex, [i32 mut] bitIndex, [i32] countBits, [i32 mut] value) {
    value = 0i32
    len{count(bytes)}
    [mut] factor{1i32}
    [mut] readCount{0i32}
    while(readCount < countBits) {
      if(byteIndex >= len) {
        return(1i32)
