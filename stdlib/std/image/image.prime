  [return<i32>]
  pngStoredBlockCount([i32] rawByteCount) {
    if(rawByteCount <= 0i32) {
      return(0i32)
    }
    return((rawByteCount + 65534i32) / 65535i32)
  }

  [return<i32>]
  pngZlibStoredPayloadLength([i32] rawByteCount) {
    return(rawByteCount + pngStoredBlockCount(rawByteCount) * 5i32 + 6i32)
  }

  [return<bool>]
  pngWriteSizingValid([i32] width, [i32] height, [i32 mut] rawByteCount, [i32 mut] payloadLength) {
    rawByteCount = 0i32
    payloadLength = 0i32
    [mut] pixelCount{0i32}
    if(!(imageRgbWritePixelCount(width, height, pixelCount))) {
      return(false)
    }

    rawByteCountWide{convert<i64>(pixelCount) + convert<i64>(height)}
    if(rawByteCountWide <= 0i64 || rawByteCountWide > 2147483647i64) {
      return(false)
    }

    storedBlockCountWide{(rawByteCountWide + 65534i64) / 65535i64}
    payloadLengthWide{rawByteCountWide + storedBlockCountWide * 5i64 + 6i64}
    if(payloadLengthWide > 2147483647i64) {
      return(false)
    }

    rawByteCount = convert<i32>(rawByteCountWide)
    payloadLength = convert<i32>(payloadLengthWide)
    return(true)
  }

  [return<void>]
  pngAdlerUpdateByte([i32] byte, [i32 mut] a, [i32 mut] b) {
    a = pngMod(a + byte, 65521i32)
    b = pngMod(b + a, 65521i32)
  }

  [effects(file_write), return<int>]
  pngWriteSignature([File<Write>] file) {
    status0{pngWriteByte(file, 137i32)}
    if(status0 != 0i32) {
      return(status0)
    }
    status1{pngWriteByte(file, 80i32)}
    if(status1 != 0i32) {
