    if(byte != 137i32) {
      return(1i32)
    }
    status1{ppmReadByteStatus(file, byte)}
    if(status1 != 0i32) {
      return(status1)
    }
    if(byte != 80i32) {
      return(1i32)
    }
    status2{ppmReadByteStatus(file, byte)}
    if(status2 != 0i32) {
      return(status2)
    }
    if(byte != 78i32) {
      return(1i32)
    }
    status3{ppmReadByteStatus(file, byte)}
    if(status3 != 0i32) {
      return(status3)
    }
    if(byte != 71i32) {
      return(1i32)
    }
    status4{ppmReadByteStatus(file, byte)}
    if(status4 != 0i32) {
      return(status4)
    }
    if(byte != 13i32) {
      return(1i32)
    }
    status5{ppmReadByteStatus(file, byte)}
    if(status5 != 0i32) {
      return(status5)
    }
    if(byte != 10i32) {
      return(1i32)
    }
    status6{ppmReadByteStatus(file, byte)}
    if(status6 != 0i32) {
      return(status6)
    }
    if(byte != 26i32) {
      return(1i32)
    }
    status7{ppmReadByteStatus(file, byte)}
    if(status7 != 0i32) {
      return(status7)
    }
    if(byte != 10i32) {
      return(1i32)
    }
    return(0i32)
  }

  [effects(file_read), return<int>]
  pngReadIhdr([File<Read>] file, [i32 mut] width, [i32 mut] height, [i32 mut] bitDepthOut,
              [i32 mut] colorTypeOut, [i32 mut] interlaceOut) {
    [mut] parsedWidth{0i32}
    [mut] parsedHeight{0i32}
    widthStatus{pngReadU32Be(file, parsedWidth)}
    if(widthStatus != 0i32) {
      return(widthStatus)
    }
    heightStatus{pngReadU32Be(file, parsedHeight)}
    if(heightStatus != 0i32) {
      return(heightStatus)
    }
    [mut] bitDepth{0i32}
    bitDepthStatus{ppmReadByteStatus(file, bitDepth)}
    if(bitDepthStatus != 0i32) {
      return(bitDepthStatus)
    }
    [mut] colorType{0i32}
    colorTypeStatus{ppmReadByteStatus(file, colorType)}
    if(colorTypeStatus != 0i32) {
      return(colorTypeStatus)
    }
    [mut] compression{0i32}
    compressionStatus{ppmReadByteStatus(file, compression)}
    if(compressionStatus != 0i32) {
      return(compressionStatus)
    }
    [mut] filter{0i32}
    filterStatus{ppmReadByteStatus(file, filter)}
    if(filterStatus != 0i32) {
      return(filterStatus)
    }
    [mut] interlace{0i32}
    interlaceStatus{ppmReadByteStatus(file, interlace)}
    if(interlaceStatus != 0i32) {
      return(interlaceStatus)
    }
    if(parsedWidth <= 0i32 || parsedHeight <= 0i32 || !(pngIhdrFieldsValid(bitDepth, colorType, compression, filter, interlace))) {
      return(1i32)
    }
    width = parsedWidth
    height = parsedHeight
    bitDepthOut = bitDepth
    colorTypeOut = colorType
    interlaceOut = interlace
    return(0i32)
  }

  [return<i32>]
  pngMod([i32] value, [i32] divisor) {
    return(value - value / divisor * divisor)
  }

  [return<u64>]
  pngModU64([u64] value, [u64] divisor) {
    return(value - value / divisor * divisor)
  }

  [return<u64>]
  pngXorU64([u64] left, [u64] right) {
    [mut] currentLeft{left}
    [mut] currentRight{right}
    [mut] factor{1u64}
    [mut] value{0u64}
    while(currentLeft > 0u64 || currentRight > 0u64) {
      leftBit{pngModU64(currentLeft, 2u64)}
      rightBit{pngModU64(currentRight, 2u64)}
      if(leftBit != rightBit) {
        value = value + factor
      }
      currentLeft = currentLeft / 2u64
      currentRight = currentRight / 2u64
      factor = factor * 2u64
    }
    return(value)
  }

  [effects(heap_alloc), return<void>]
  pngAppendVectorBytes([vector<i32>] bytes, [vector<i32> mut] out) {
    [mut] index{0i32}
    while(index < count(bytes)) {
      push(out, bytes[index])
      index++
    }
  }

  [effects(heap_alloc), return<void>]
  pngAppendU32Be([i32] value, [vector<i32> mut] out) {
    push(out, value / 16777216i32)
    push(out, pngMod(value / 65536i32, 256i32))
    push(out, pngMod(value / 256i32, 256i32))
    push(out, pngMod(value, 256i32))
  }

  [return<u64>]
  pngCrc32UpdateByte([u64] crc, [i32] byte) {
    [mut] current{pngXorU64(crc, convert<u64>(byte))}
    [mut] bit{0i32}
    while(bit < 8i32) {
      if(pngModU64(current, 2u64) == 1u64) {
        current = pngXorU64(current / 2u64, 3988292384u64)
      } else {
        current = current / 2u64
      }
      bit++
    }
    return(current)
  }

  [return<u64>]
  pngChunkCrc([i32] typeA, [i32] typeB, [i32] typeC, [i32] typeD, [vector<i32>] payload) {
    [mut] crc{4294967295u64}
    crc = pngCrc32UpdateByte(crc, typeA)
    crc = pngCrc32UpdateByte(crc, typeB)
    crc = pngCrc32UpdateByte(crc, typeC)
    crc = pngCrc32UpdateByte(crc, typeD)
    [mut] index{0i32}
    while(index < count(payload)) {
      crc = pngCrc32UpdateByte(crc, payload[index])
      index++
    }
    return(pngXorU64(crc, 4294967295u64))
  }

  [return<bool>]
  pngChunkCrcMatches([i32] typeA, [i32] typeB, [i32] typeC, [i32] typeD, [vector<i32>] payload,
                     [i32] crcA, [i32] crcB, [i32] crcC, [i32] crcD) {
    crc{pngChunkCrc(typeA, typeB, typeC, typeD, payload)}
    return(crc / 16777216u64 == convert<u64>(crcA) && pngModU64(crc / 65536u64, 256u64) == convert<u64>(crcB) && pngModU64(crc / 256u64, 256u64) == convert<u64>(crcC) && pngModU64(crc, 256u64) == convert<u64>(crcD))
  }

  [effects(file_write), return<int> on_error<FileError, ignoreFileError>]
  pngWriteByte([File<Write>] file, [i32] value) {
    if(value < 0i32 || value > 255i32) {
      return(1i32)
    }
    file.writeByte(value)?
    return(0i32)
  }

  [effects(file_write), return<int>]
  pngWriteU32Be([File<Write>] file, [i32] value) {
    if(value < 0i32) {
      return(1i32)
    }
    byteA{value / 16777216i32}
    byteB{pngMod(value / 65536i32, 256i32)}
    byteC{pngMod(value / 256i32, 256i32)}
    byteD{pngMod(value, 256i32)}
    statusA{pngWriteByte(file, byteA)}
    if(statusA != 0i32) {
      return(statusA)
    }
    statusB{pngWriteByte(file, byteB)}
    if(statusB != 0i32) {
      return(statusB)
    }
    statusC{pngWriteByte(file, byteC)}
    if(statusC != 0i32) {
      return(statusC)
    }
    return(pngWriteByte(file, byteD))
  }

  [effects(file_write), return<int>]
  pngWriteU32BeU64([File<Write>] file, [u64] value) {
    byteA{convert<i32>(value / 16777216u64)}
    byteB{convert<i32>(pngModU64(value / 65536u64, 256u64))}
    byteC{convert<i32>(pngModU64(value / 256u64, 256u64))}
    byteD{convert<i32>(pngModU64(value, 256u64))}
    statusA{pngWriteByte(file, byteA)}
    if(statusA != 0i32) {
      return(statusA)
    }
    statusB{pngWriteByte(file, byteB)}
    if(statusB != 0i32) {
      return(statusB)
    }
    statusC{pngWriteByte(file, byteC)}
    if(statusC != 0i32) {
      return(statusC)
    }
    return(pngWriteByte(file, byteD))
  }

