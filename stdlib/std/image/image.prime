  [return<i32>]
  pngCanonicalCodeForSymbol([vector<i32>] lengths, [i32] targetSymbol) {
    targetLength{lengths[targetSymbol]}
    if(targetLength == 0i32) {
      return(-1i32)
    }

    [mut] code{0i32}
    [mut] length{1i32}
    while(length < targetLength) {
      code = (code + pngCountCodeLength(lengths, length)) * 2i32
      length++
    }

    [mut] offset{0i32}
    [mut] index{0i32}
    while(index < targetSymbol) {
      if(lengths[index] == targetLength) {
        offset++
      }
      index++
    }
