// Directory listing and file metadata (docs/spec/stdlib-reference.md, /std/dir). `listDirectory` asks the
// runtime for the entries of one directory: the VM and the optimized C++ backend (`--emit=optexe`) answer the
// `__pstext_dir_list` host function themselves, so no shim is linked. It reads one level and does not follow into
// subdirectories; `/std/glob` is built on top of it.
import /std/file/*
import /std/text/*
import /std/text/view/*
import /std/collections/vector/*

// Writes the listing as text, one line per entry, "<kind> <size> <seconds> <name>\n" sorted bytewise by name, into
// `destination` when it fits in `capacity` bytes. Returns the size of the whole listing, or minus the errno.
[host return<i64>]
__pstext_dir_list([Pointer<u8>] path, [u64] pathCount, [Pointer<u8>] destination, [u64] capacity) {
}

namespace std {
namespace dir {

  // One entry of a directory. `kind` is `dirKindFile()`, `dirKindDirectory()` or `dirKindOther()`; a symbolic link
  // is followed, so it has the kind of its target, and a dangling link is `other`. `size` is the byte size of a
  // regular file and 0 for anything else. `modifiedSeconds` is the modification time in seconds since the Unix epoch.
  [public struct]
  DirEntry() {
    [public String mut] name{stringFrom("")}
    [public i32 mut] kind{0i32}
    [public i64 mut] size{0i64}
    [public i64 mut] modifiedSeconds{0i64}

    [return<bool> effects(none)]
    isFile() {
      return(this.kind == 0i32)
    }

    [return<bool> effects(none)]
    isDirectory() {
      return(this.kind == 1i32)
    }
  }

  [public return<i32> effects(none)]
  dirKindFile() {
    return(0i32)
  }

  [public return<i32> effects(none)]
  dirKindDirectory() {
    return(1i32)
  }

  [public return<i32> effects(none)]
  dirKindOther() {
    return(2i32)
  }

  // The number that starts at `at` and ends before the next space, which is skipped: `at` moves past it.
  [return<i64> effects(none)]
  dir_listing_number([String] listing, [i32 mut] at) {
    [bool] negative{listing.byteAt(at) == 45u8}
    if(negative) {
      at = at + 1i32
    }
    [i64 mut] value{0i64}
    while(listing.byteAt(at) != 32u8) {
      value = value * 10i64 + convert<i64>(listing.byteAt(at) - 48u8)
      at = at + 1i32
    }
    at = at + 1i32
    if(negative) {
      return(0i64 - value)
    }
    return(value)
  }

  // Replaces `out` with the entries of the directory `path`, sorted bytewise by name, "." and ".." left out. Returns
  // `Result.ok()`, or the errno of the failure as a `FileError` (2 when the directory does not exist, 20 when `path`
  // is not a directory, 13 when it cannot be read); `out` is left alone on failure. A name that contains a line feed
  // is not listed. The listing is not a snapshot: a directory that changes while it is read gives either state.
  [public unsafe return<Result<FileError>> effects(file_read, heap_alloc)]
  listDirectory([StringView] path, [vector<DirEntry> mut] out) {
    [i64 mut] needed{__pstext_dir_list(path.data, convert<u64>(path.fieldLength), path.data, 0u64)}
    if(needed < 0i64) {
      [FileError] failure{convert<i32>(0i64 - needed)}
      return(failure)
    }
    [String mut] listing{stringWithCapacity(convert<i32>(needed))}
    [i64] got{__pstext_dir_list(path.data, convert<u64>(path.fieldLength), listing.data, convert<u64>(needed))}
    if(got < 0i64) {
      [FileError] failure{convert<i32>(0i64 - got)}
      return(failure)
    }
    if(got > needed) {
      // The directory grew between the two calls: read again with room for all of it.
      listing = stringWithCapacity(convert<i32>(got))
      needed = __pstext_dir_list(path.data, convert<u64>(path.fieldLength), listing.data, convert<u64>(got))
      if(needed < 0i64) {
        [FileError] failure{convert<i32>(0i64 - needed)}
        return(failure)
      }
    } else {
      needed = got
    }
    if(needed > 0i64) {
      listing.fieldLength = convert<i32>(needed)
      // The terminator after the bytes the host wrote.
      [Pointer<u8> mut] bytes{listing.data}
      [Pointer<u8> mut] terminator{/std/intrinsics/memory/at_unsafe(bytes, listing.fieldLength)}
      *terminator = 0u8
    }
    out.clear()
    [i32 mut] at{0i32}
    while(at < listing.count()) {
      [DirEntry mut] entry{DirEntry{}}
      [u8] kind{listing.byteAt(at)}
      entry.kind = if(kind == 70u8, then() { 0i32 }, else() { if(kind == 68u8, then() { 1i32 }, else() { 2i32 }) })
      at = at + 2i32
      entry.size = dir_listing_number(listing, at)
      entry.modifiedSeconds = dir_listing_number(listing, at)
      [i32] start{at}
      while(listing.byteAt(at) != 10u8) {
        at = at + 1i32
      }
      entry.name = listing.view().slice(start, at).toOwned()
      at = at + 1i32
      out.push(entry)
    }
    return(Result.ok())
  }

}
}
