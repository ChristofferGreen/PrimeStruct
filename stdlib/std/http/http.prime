// HTTP/1.1 requests and responses for single-threaded servers (docs/spec/stdlib-reference.md, /std/http). Pure code:
// it parses bytes that have already arrived and builds response bytes, so it runs and is tested on the VM. The socket
// loop is /std/http/server. The subset: `Content-Length` bodies, `Connection: close`; no chunked encoding.
import /std/collections/*
import /std/text/*
import /std/text/view/*

namespace std {
namespace http {

  // A parsed request: views into the bytes it was parsed from, so it allocates nothing and is valid while those
  // bytes are. `outcome()` says whether the parse is complete; the other fields are set only when it is.
  [public struct]
  Request() {
    // "GET", "POST", ...
    [public StringView mut] method{StringView{}}
    // The request target as sent: the path and the query.
    [public StringView mut] target{StringView{}}
    // The target before "?".
    [public StringView mut] path{StringView{}}
    // The target after "?", without it; empty when there is none.
    [public StringView mut] query{StringView{}}
    // "HTTP/1.1" or "HTTP/1.0".
    [public StringView mut] version{StringView{}}
    // The header lines, separated by CR LF, without the blank line that ends them.
    [public StringView mut] headers{StringView{}}
    // The `Content-Length` bytes after the head.
    [public StringView mut] body{StringView{}}
    // The pattern of the route that `Router.call` matched, which `pathParam` reads; empty outside a router.
    [public StringView mut] route{StringView{}}
    [i32 mut] outcomeCode{1i32}
    [i32 mut] byteCount{0i32}

    // 0 when the request is complete, 1 when more bytes are needed, or the status to answer when the bytes are not an
    // acceptable request: 400 (malformed), 413 (body too large), 501 (Transfer-Encoding), 505 (HTTP version).
    [return<i32>]
    outcome() {
      return(this.outcomeCode)
    }

    [return<bool>]
    isComplete() {
      return(this.outcomeCode == 0i32)
    }

    [return<bool>]
    needsMore() {
      return(this.outcomeCode == 1i32)
    }

    // How many bytes the complete request took: the head and the body.
    [return<i32>]
    length() {
      return(this.byteCount)
    }

    // The value of the first header called `name` (ASCII case-insensitive), without surrounding white space; empty
    // when there is none.
    [return<StringView>]
    header([StringView] name) {
      [i32 mut] index{0i32}
      [i32] count{this.headerCount()}
      while(index < count) {
        [StringView] line{this.headerLine(index)}
        [StringView] lineName{header_line_name(line)}
        if(lineName.equalsIgnoreAsciiCase(name)) {
          return(header_line_value(line))
        }
        index = index + 1i32
      }
      return(StringView{})
    }

    // Whether a header called `name` is present (ASCII case-insensitive).
    [return<bool>]
    hasHeader([StringView] name) {
      [i32 mut] index{0i32}
      [i32] count{this.headerCount()}
      while(index < count) {
        [StringView] line{this.headerLine(index)}
        [StringView] lineName{header_line_name(line)}
        if(lineName.equalsIgnoreAsciiCase(name)) {
          return(true)
        }
        index = index + 1i32
      }
      return(false)
    }

    // How many header lines the request has.
    [return<i32>]
    headerCount() {
      if(this.headers.empty()) {
        return(0i32)
      }
      return(this.headers.splitCount("\r\n"))
    }

    // The name of header line `index` as sent.
    [return<StringView>]
    headerName([i32] index) {
      [StringView] line{this.headerLine(index)}
      return(header_line_name(line))
    }

    // The value of header line `index`, without surrounding white space.
    [return<StringView>]
    headerValue([i32] index) {
      [StringView] line{this.headerLine(index)}
      return(header_line_value(line))
    }

    [return<StringView>]
    headerLine([i32] index) {
      return(this.headers.splitPart("\r\n", index))
    }

    // The path segment that the `:name` segment of the matched route pattern stands for, as sent (not decoded), or an
    // empty view when the pattern has no such segment or no route matched.
    [return<StringView>]
    pathParam([StringView] name) {
      return(path_param(this.route, this.path, name))
    }

    // The first query parameter called `name`, decoded ("+" is a space, "%XX" the byte XX). Empty when the parameter
    // is missing, has no value, holds a malformed escape or decodes to bytes that are not UTF-8; `hasQueryParam` tells
    // a missing parameter from an empty one. A name is compared with the decoded parameter names.
    [return<String> effects(heap_alloc)]
    queryParam([StringView] name) {
      return(urlencoded_value(urlencoded_pair(this.query, name)))
    }

    // Whether the query has a parameter called `name`, with or without a value.
    [return<bool>]
    hasQueryParam([StringView] name) {
      [StringView] pair{urlencoded_pair(this.query, name)}
      return(!pair.empty())
    }

    // The first parameter called `name` of an `application/x-www-form-urlencoded` body, decoded as `queryParam`
    // decodes. Empty when the body is of another type (see `isFormBody`).
    [return<String> effects(heap_alloc)]
    formParam([StringView] name) {
      if(!this.isFormBody()) {
        return(String{})
      }
      return(urlencoded_value(urlencoded_pair(this.body, name)))
    }

    // Whether the body is a form with a parameter called `name`, with or without a value.
    [return<bool>]
    hasFormParam([StringView] name) {
      if(!this.isFormBody()) {
        return(false)
      }
      [StringView] pair{urlencoded_pair(this.body, name)}
      return(!pair.empty())
    }

    // Whether `Content-Type` is `application/x-www-form-urlencoded` (ASCII case-insensitive), ignoring parameters
    // such as `; charset=utf-8`.
    [return<bool>]
    isFormBody() {
      [StringView] contentType{this.header("Content-Type")}
      [i32] semicolon{contentType.indexOfByte(59u8)}
      [i32] end{if(semicolon < 0i32, then() { contentType.count() }, else() { semicolon })}
      [StringView] media{contentType.slice(0i32, end).trim()}
      return(media.equalsIgnoreAsciiCase("application/x-www-form-urlencoded"))
    }
  }

  // The part of a header line before its colon.
  [return<StringView>]
  header_line_name([StringView] line) {
    [i32] colon{line.indexOfByte(58u8)}
    if(colon < 0i32) {
      return(line)
    }
    return(line.slice(0i32, colon))
  }

  // The part of a header line after its colon, trimmed.
  [return<StringView>]
  header_line_value([StringView] line) {
    [i32] colon{line.indexOfByte(58u8)}
    if(colon < 0i32) {
      return(StringView{})
    }
    return(line.slice(colon + 1i32, line.count()).trim())
  }

  // The first "&"-separated pair of `text` whose decoded name (the part before "=", or all of it) is `name`, or an
  // empty view. A pair that matches is never empty, since an empty pair is skipped.
  [return<StringView>]
  urlencoded_pair([StringView] text, [StringView] name) {
    [i32 mut] start{0i32}
    while(start < text.count()) {
      [i32] found{text.indexOfFrom("&", start)}
      [i32] end{if(found < 0i32, then() { text.count() }, else() { found })}
      [StringView] pair{text.slice(start, end)}
      if(!pair.empty()) {
        [i32] equals{pair.indexOfByte(61u8)}
        [i32] keyEnd{if(equals < 0i32, then() { pair.count() }, else() { equals })}
        [StringView] key{pair.slice(0i32, keyEnd)}
        if(urlencoded_equals(key, name)) {
          return(pair)
        }
      }
      start = end + 1i32
    }
    return(StringView{})
  }

  // The decoded value of `pair` (the part after its first "="), or an empty String when it has none, holds a
  // malformed escape or decodes to bytes that are not UTF-8.
  [return<String> effects(heap_alloc)]
  urlencoded_value([StringView] pair) {
    [String mut] out{String{}}
    [i32] equals{pair.indexOfByte(61u8)}
    if(equals < 0i32) {
      return(out)
    }
    [i32 mut] index{equals + 1i32}
    while(index < pair.count()) {
      [i32] byte{urlencoded_byte_at(pair, index)}
      if(byte < 0i32) {
        return(String{})
      }
      out.pushByte(convert<u8>(byte))
      index = index + urlencoded_width_at(pair, index)
    }
    if(utf8ErrorOffset(out.data, out.count()) >= 0i32) {
      return(String{})
    }
    return(out)
  }

  // Whether `encoded` decodes to exactly the bytes of `name`. A malformed escape matches nothing.
  [return<bool>]
  urlencoded_equals([StringView] encoded, [StringView] name) {
    [i32 mut] index{0i32}
    [i32 mut] matched{0i32}
    while(index < encoded.count()) {
      [i32] byte{urlencoded_byte_at(encoded, index)}
      if(byte < 0i32 || matched >= name.count()) {
        return(false)
      }
      if(convert<i32>(name.byteAt(matched)) != byte) {
        return(false)
      }
      matched = matched + 1i32
      index = index + urlencoded_width_at(encoded, index)
    }
    return(matched == name.count())
  }

  // The byte that the encoding at `index` of `text` stands for: a space for "+", XX for "%XX", else the byte itself;
  // -1 for a "%" not followed by two hex digits.
  [return<i32>]
  urlencoded_byte_at([StringView] text, [i32] index) {
    [u8] byte{text.byteAt(index)}
    if(byte == 43u8) {
      return(32i32)
    }
    if(byte != 37u8) {
      return(convert<i32>(byte))
    }
    if(index + 2i32 >= text.count()) {
      return(-1i32)
    }
    [i32] high{hex_digit_value(text.byteAt(index + 1i32))}
    [i32] low{hex_digit_value(text.byteAt(index + 2i32))}
    if(high < 0i32 || low < 0i32) {
      return(-1i32)
    }
    return(high * 16i32 + low)
  }

  // How many bytes the encoding at `index` of `text` takes: 3 for "%XX", else 1.
  [return<i32>]
  urlencoded_width_at([StringView] text, [i32] index) {
    if(text.byteAt(index) == 37u8) {
      return(3i32)
    }
    return(1i32)
  }

  // The value of an ASCII hex digit, or -1.
  [return<i32>]
  hex_digit_value([u8] byte) {
    if(byte >= 48u8 && byte <= 57u8) {
      return(convert<i32>(byte) - 48i32)
    }
    if(byte >= 65u8 && byte <= 70u8) {
      return(convert<i32>(byte) - 55i32)
    }
    if(byte >= 97u8 && byte <= 102u8) {
      return(convert<i32>(byte) - 87i32)
    }
    return(-1i32)
  }

  // A request that is not complete: `code` is 1 (need more bytes) or the status to answer.
  [return<Request>]
  incomplete_request([i32] code) {
    return(Request{[outcomeCode] code})
  }

  // Whether `text` is a method token: one or more ASCII capital letters.
  [return<bool>]
  is_method_token([StringView] text) {
    if(text.empty()) {
      return(false)
    }
    [i32 mut] index{0i32}
    while(index < text.count()) {
      [u8] byte{text.byteAt(index)}
      if(byte < 65u8 || byte > 90u8) {
        return(false)
      }
      index = index + 1i32
    }
    return(true)
  }

  // Whether `text` is a header name: one or more visible ASCII bytes other than the colon.
  [return<bool>]
  is_header_name([StringView] text) {
    if(text.empty()) {
      return(false)
    }
    [i32 mut] index{0i32}
    while(index < text.count()) {
      [u8] byte{text.byteAt(index)}
      if(byte <= 32u8 || byte >= 127u8 || byte == 58u8) {
        return(false)
      }
      index = index + 1i32
    }
    return(true)
  }

  // Whether `text` is one or more ASCII digits.
  [return<bool>]
  is_digits([StringView] text) {
    if(text.empty()) {
      return(false)
    }
    [i32 mut] index{0i32}
    while(index < text.count()) {
      [u8] byte{text.byteAt(index)}
      if(byte < 48u8 || byte > 57u8) {
        return(false)
      }
      index = index + 1i32
    }
    return(true)
  }

  // 0 when every header line is well formed, else 400.
  [return<i32>]
  check_header_lines([StringView] headers) {
    if(headers.empty()) {
      return(0i32)
    }
    [i32] count{headers.splitCount("\r\n")}
    [i32 mut] index{0i32}
    while(index < count) {
      [StringView] line{headers.splitPart("\r\n", index)}
      [i32] colon{line.indexOfByte(58u8)}
      if(colon <= 0i32) {
        return(400i32)
      }
      [StringView] name{line.slice(0i32, colon)}
      if(!is_header_name(name)) {
        return(400i32)
      }
      index = index + 1i32
    }
    return(0i32)
  }

  // Parses one request from the start of `text`, the bytes that have arrived so far. A body over `maxBodyBytes`
  // answers 413. Bytes after a complete request (a pipelined next one) are left alone: see `length()`.
  [public return<Request>]
  parseRequest([StringView] text, [i32] maxBodyBytes) {
    [i32] headEnd{text.indexOf("\r\n\r\n")}
    [i32] lineEnd{text.indexOf("\r\n")}
    if(headEnd < 0i32) {
      // A request line that is already complete can be rejected before the rest arrives.
      if(lineEnd < 0i32) {
        return(incomplete_request(1i32))
      }
    }
    [StringView] line{text.slice(0i32, lineEnd)}
    [i32] firstSpace{line.indexOfByte(32u8)}
    if(firstSpace <= 0i32) {
      return(incomplete_request(400i32))
    }
    [StringView] method{line.slice(0i32, firstSpace)}
    [StringView] afterMethod{line.slice(firstSpace + 1i32, line.count())}
    [i32] secondSpace{afterMethod.indexOfByte(32u8)}
    if(secondSpace <= 0i32 || !is_method_token(method)) {
      return(incomplete_request(400i32))
    }
    [StringView] target{afterMethod.slice(0i32, secondSpace)}
    [StringView] version{afterMethod.slice(secondSpace + 1i32, afterMethod.count())}
    if(target.byteAt(0i32) != 47u8 || version.indexOfByte(32u8) >= 0i32) {
      return(incomplete_request(400i32))
    }
    if(!version.equalsText("HTTP/1.1") && !version.equalsText("HTTP/1.0")) {
      if(version.startsWith("HTTP/")) {
        return(incomplete_request(505i32))
      }
      return(incomplete_request(400i32))
    }
    if(headEnd < 0i32) {
      return(incomplete_request(1i32))
    }
    [StringView] headers{if(headEnd > lineEnd, then() { text.slice(lineEnd + 2i32, headEnd) }, else() { StringView{} })}
    [i32] headerCheck{check_header_lines(headers)}
    if(headerCheck != 0i32) {
      return(incomplete_request(headerCheck))
    }
    [Request] head{Request{[headers] headers}}
    if(head.hasHeader("Transfer-Encoding")) {
      return(incomplete_request(501i32))
    }
    [i32 mut] bodyLength{0i32}
    if(head.hasHeader("Content-Length")) {
      [StringView] lengthText{head.header("Content-Length")}
      if(!is_digits(lengthText) || lengthText.count() > 9i32) {
        if(is_digits(lengthText)) {
          return(incomplete_request(413i32))
        }
        return(incomplete_request(400i32))
      }
      lengthText.parseI32Into(bodyLength)
    }
    if(bodyLength > maxBodyBytes) {
      return(incomplete_request(413i32))
    }
    [i32] bodyStart{headEnd + 4i32}
    if(text.count() - bodyStart < bodyLength) {
      return(incomplete_request(1i32))
    }
    [i32] question{target.indexOfByte(63u8)}
    [i32] pathEnd{if(question >= 0i32, then() { question }, else() { target.count() })}
    [i32] queryStart{if(question >= 0i32, then() { question + 1i32 }, else() { target.count() })}
    return(Request{[method] method, [target] target, [path] target.slice(0i32, pathEnd),
                   [query] target.slice(queryStart, target.count()), [version] version, [headers] headers,
                   [body] text.slice(bodyStart, bodyStart + bodyLength), [outcomeCode] 0i32,
                   [byteCount] bodyStart + bodyLength})
  }

  // Parses one request from raw bytes, which may end inside a UTF-8 sequence that has not fully arrived. Bytes that
  // are not UTF-8 answer 400.
  [public return<Request>]
  parseRequestBytes([ReadSlice<u8>] bytes, [i32] maxBodyBytes) {
    [i32] count{bytes.count()}
    [i32] bad{utf8ErrorOffset(bytes.data, count)}
    [i32] validCount{if(bad < 0i32, then() { count }, else() { bad })}
    [Request] request{parseRequest(StringView{[data] bytes.data, [fieldLength] validCount}, maxBodyBytes)}
    if(bad < 0i32 || !request.needsMore()) {
      return(request)
    }
    // More bytes may finish the sequence that starts at `bad`; a longer invalid run can never be valid.
    if(count - bad < 4i32) {
      return(incomplete_request(1i32))
    }
    return(incomplete_request(400i32))
  }


  // A response under construction. `serve` reuses one, calling `clear()` between requests.
  [public struct]
  Response() {
    // The status code, 200 unless the handler sets another.
    [public i32 mut] status{200i32}
    // The body bytes.
    [public String mut] body{String{}}
    // The header lines added so far, each ending in CR LF.
    [public String mut] headerLines{String{}}

    // Adds a header line. CR and LF bytes are dropped from `name` and `value`, so a header cannot end the head early.
    // `Content-Length` and `Connection` are written by `serialize()`; do not add them.
    [mut effects(heap_alloc)]
    header([StringView] name, [StringView] value) {
      this.appendHeaderText(name)
      this.headerLines.append(": ")
      this.appendHeaderText(value)
      this.headerLines.append("\r\n")
    }

    // Appends `text` to the header lines without its CR and LF bytes. A method rather than a function taking the
    // field: a field passed to a `[String mut]` parameter is mistyped (TODO-5694).
    [mut effects(heap_alloc)]
    appendHeaderText([StringView] text) {
      [i32 mut] index{0i32}
      while(index < text.count()) {
        [u8] byte{text.byteAt(index)}
        if(byte != 13u8 && byte != 10u8) {
          this.headerLines.pushByte(byte)
        }
        index = index + 1i32
      }
    }

    // Replaces the body with `text` and sets its `Content-Type`.
    [mut effects(heap_alloc)]
    text([StringView] text, [StringView] contentType) {
      this.body.clear()
      this.body.appendBytes(text.data, text.count())
      this.header("Content-Type", contentType)
    }

    // Replaces the body with `page`, such as the `out` of a /std/html `Writer`, and sets
    // `Content-Type: text/html; charset=utf-8`. The bytes are copied into the body, whose buffer is kept between
    // requests.
    [mut effects(heap_alloc)]
    html([String] page) {
      this.body.clear()
      this.body.appendBytes(page.data, page.count())
      this.header("Content-Type", "text/html; charset=utf-8")
    }

    // A 303 See Other to `location`: the answer to a form POST, which the browser follows with a GET of `location`
    // (post/redirect/get).
    [mut effects(heap_alloc)]
    redirect([StringView] location) {
      this.redirect(303i32, location)
    }

    // A redirect with `status` (such as 301, 302, 307 or 308) to `location`. It sets `Location` and empties the body.
    [mut effects(heap_alloc)]
    redirect([i32] status, [StringView] location) {
      this.status = status
      this.body.clear()
      this.header("Location", location)
    }

    // Back to an empty 200 response, keeping the buffers for the next request.
    [mut]
    clear() {
      this.status = 200i32
      this.body.clear()
      this.headerLines.clear()
    }

    // The response as sent: the status line, the header lines, `Content-Length` (except for 1xx, 204 and 304, which
    // have no body), `Connection: close`, a blank line and the body.
    [return<String> effects(heap_alloc)]
    serialize() {
      [String mut] out{String{}}
      append_status_line(out, this.status)
      out.appendBytes(this.headerLines.data, this.headerLines.count())
      [bool] bodyless{status_has_no_body(this.status)}
      if(!bodyless) {
        out.append("Content-Length: ")
        out.appendI64(convert<i64>(this.body.count()))
        out.append("\r\n")
      }
      out.append("Connection: close\r\n\r\n")
      if(!bodyless) {
        out.appendBytes(this.body.data, this.body.count())
      }
      return(out)
    }
  }

  // Whether a response with `code` has no body.
  [return<bool>]
  status_has_no_body([i32] code) {
    return((code >= 100i32 && code < 200i32) || code == 204i32 || code == 304i32)
  }

  // Appends "HTTP/1.1 <code> <reason>\r\n".
  [effects(heap_alloc)]
  append_status_line([String mut] out, [i32] code) {
    out.append("HTTP/1.1 ")
    out.appendI64(convert<i64>(code))
    out.append(" ")
    out.append(reasonPhrase(code))
    out.append("\r\n")
  }

  // The reason phrase of a status code (RFC 9110), or "" for a code without one here.
  [public return<string>]
  reasonPhrase([i32] code) {
    if(code == 200i32) {
      return("OK")
    }
    if(code == 201i32) {
      return("Created")
    }
    if(code == 204i32) {
      return("No Content")
    }
    if(code == 301i32) {
      return("Moved Permanently")
    }
    if(code == 302i32) {
      return("Found")
    }
    if(code == 303i32) {
      return("See Other")
    }
    if(code == 304i32) {
      return("Not Modified")
    }
    if(code == 307i32) {
      return("Temporary Redirect")
    }
    if(code == 308i32) {
      return("Permanent Redirect")
    }
    if(code == 400i32) {
      return("Bad Request")
    }
    if(code == 401i32) {
      return("Unauthorized")
    }
    if(code == 403i32) {
      return("Forbidden")
    }
    if(code == 404i32) {
      return("Not Found")
    }
    if(code == 405i32) {
      return("Method Not Allowed")
    }
    if(code == 408i32) {
      return("Request Timeout")
    }
    if(code == 413i32) {
      return("Content Too Large")
    }
    if(code == 500i32) {
      return("Internal Server Error")
    }
    if(code == 501i32) {
      return("Not Implemented")
    }
    if(code == 503i32) {
      return("Service Unavailable")
    }
    if(code == 505i32) {
      return("HTTP Version Not Supported")
    }
    return("")
  }

  // A bare response with `code` and no body, as the server sends for a request it rejects.
  [public return<String> effects(heap_alloc)]
  statusResponse([i32] code) {
    [String mut] out{String{}}
    append_status_line(out, code)
    out.append("Content-Length: 0\r\nConnection: close\r\n\r\n")
    return(out)
  }


  // The type of a route's handler: it fills the response for the request. A name for the `Function` type that a
  // `Router` and an `AppRouter` take (`[RequestHandler move] handler`); a lambda passes where it is expected.
  [public alias<Function<void, Request, Reference<Response>>>]
  RequestHandler() {}

  // One route of a Router: a method, a pattern and the handler it calls.
  [public struct]
  Route() {
    [public LiteralText] method{LiteralText{}}
    [public LiteralText] pattern{LiteralText{}}
    [public RequestHandler mut] handler
  }

  // Whether `path` matches `pattern`: for a pattern ending in "*", any path that starts with the text before the "*";
  // else the same segments, where a `:name` segment matches any one non-empty segment.
  [return<bool>]
  pattern_matches([StringView] pattern, [StringView] path) {
    if(pattern.endsWith("*")) {
      [StringView] prefix{pattern.slice(0i32, pattern.count() - 1i32)}
      return(path.startsWith(prefix))
    }
    if(pattern.indexOfByte(58u8) < 0i32) {
      return(pattern.equals(path))
    }
    [i32 mut] patternStart{0i32}
    [i32 mut] pathStart{0i32}
    while(true) {
      [i32] patternEnd{segment_end(pattern, patternStart)}
      [i32] pathEnd{segment_end(path, pathStart)}
      [StringView] want{pattern.slice(patternStart, patternEnd)}
      [StringView] got{path.slice(pathStart, pathEnd)}
      if(want.startsWith(":")) {
        if(got.empty()) {
          return(false)
        }
      } else {
        if(!want.equals(got)) {
          return(false)
        }
      }
      if(patternEnd == pattern.count() || pathEnd == path.count()) {
        return(patternEnd == pattern.count() && pathEnd == path.count())
      }
      patternStart = patternEnd + 1i32
      pathStart = pathEnd + 1i32
    }
    return(false)
  }

  // Whether `path` matches the route pattern `pattern`, as `Router` and `AppRouter` match their routes. Page layers
  // that keep their own route tables, such as /std/web, use it to match the same way.
  [public return<bool>]
  routeMatches([StringView] pattern, [StringView] path) {
    return(pattern_matches(pattern, path))
  }

  // The segment of `path` at the place of the `:name` segment of `pattern`, or an empty view. `path` is one that
  // matches `pattern`; a pattern ending in "*" has no parameters.
  [return<StringView>]
  path_param([StringView] pattern, [StringView] path, [StringView] name) {
    if(pattern.endsWith("*")) {
      return(StringView{})
    }
    [i32 mut] patternStart{0i32}
    [i32 mut] pathStart{0i32}
    while(patternStart < pattern.count() && pathStart <= path.count()) {
      [i32] patternEnd{segment_end(pattern, patternStart)}
      [i32] pathEnd{segment_end(path, pathStart)}
      [StringView] want{pattern.slice(patternStart, patternEnd)}
      if(want.startsWith(":")) {
        [StringView] wantName{want.slice(1i32, want.count())}
        if(wantName.equals(name)) {
          return(path.slice(pathStart, pathEnd))
        }
      }
      patternStart = patternEnd + 1i32
      pathStart = pathEnd + 1i32
    }
    return(StringView{})
  }

  // The end of the "/"-separated segment of `text` that starts at `start`.
  [return<i32>]
  segment_end([StringView] text, [i32] start) {
    [i32] slash{text.indexOfFrom("/", start)}
    if(slash < 0i32) {
      return(text.count())
    }
    return(slash)
  }

  // Calls the handler of the first route whose method and pattern match the request. When no route matches, the
  // response is 405 if a route matches the path under another method, else 404. A Router is itself a handler, so it
  // can be passed to `serve` or wrapped in middleware.
  [public struct]
  Router() {
    [public vector<Route> mut] routes{vector<Route>()}

    // Adds a route for `method` (such as "GET") and `pattern`: a path whose `:name` segments match any one segment
    // (read them with `request.pathParam(name)`), or a literal prefix ending in "*".
    [mut effects(heap_alloc)]
    route([string] method, [string] pattern, [RequestHandler move] handler) {
      this.routes.push(Route{[method] literalTextOf(method), [pattern] literalTextOf(pattern), [handler] handler})
    }

    [mut effects(heap_alloc)]
    get([string] pattern, [RequestHandler move] handler) {
      this.route("GET", pattern, handler)
    }

    [mut effects(heap_alloc)]
    post([string] pattern, [RequestHandler move] handler) {
      this.route("POST", pattern, handler)
    }

    [mut effects(heap_alloc)]
    put([string] pattern, [RequestHandler move] handler) {
      this.route("PUT", pattern, handler)
    }

    [mut effects(heap_alloc)]
    delete([string] pattern, [RequestHandler move] handler) {
      this.route("DELETE", pattern, handler)
    }

    // Dispatches one request.
    [mut effects(heap_alloc)]
    call([Request] request, [Reference<Response>] response) {
      [bool mut] pathMatched{false}
      [i32 mut] index{0i32}
      while(index < this.routes.count()) {
        [StringView] pattern{this.routes[index].pattern.view()}
        [StringView] method{this.routes[index].method.view()}
        if(pattern_matches(pattern, request.path)) {
          if(request.method.equals(method)) {
            [Request mut] routed{request}
            routed.route = pattern
            this.routes[index].handler(routed, response)
            return()
          }
          pathMatched = true
        }
        index = index + 1i32
      }
      response.status = if(pathMatched, then() { 405i32 }, else() { 404i32 })
    }
  }

  // The type of a route's handler when the app has state: `RequestHandler` that also takes the state first
  // (`[StateRequestHandler<State> move] handler`).
  [public alias<Function<void, Reference<State>, Request, Reference<Response>>>]
  StateRequestHandler<State>() {}

  // One route of an AppRouter: a Route whose handler also takes the app's state.
  [public struct]
  AppRoute<State>() {
    [public LiteralText] method{LiteralText{}}
    [public LiteralText] pattern{LiteralText{}}
    [public StateRequestHandler<State> mut] handler
  }

  // A Router that holds the app's state and passes it to each handler as a `Reference<State>` first argument. A
  // stored handler cannot capture the state by reference, so this is how routes share it. It is a handler itself.
  [public struct]
  AppRouter<State>() {
    // The state every route reads and changes, such as a struct of the app's records.
    [public State mut] state
    [public vector<AppRoute<State>> mut] routes{vector<AppRoute<State>>()}

    // Adds a route as `Router.route` does; the handler takes the state first.
    [mut effects(heap_alloc)]
    route([string] method,
          [string] pattern,
          [StateRequestHandler<State> move] handler) {
      this.routes.push(AppRoute<State>{[method] literalTextOf(method), [pattern] literalTextOf(pattern), [handler] handler})
    }

    [mut effects(heap_alloc)]
    get([string] pattern, [StateRequestHandler<State> move] handler) {
      this.route("GET", pattern, handler)
    }

    [mut effects(heap_alloc)]
    post([string] pattern, [StateRequestHandler<State> move] handler) {
      this.route("POST", pattern, handler)
    }

    [mut effects(heap_alloc)]
    put([string] pattern, [StateRequestHandler<State> move] handler) {
      this.route("PUT", pattern, handler)
    }

    [mut effects(heap_alloc)]
    delete([string] pattern, [StateRequestHandler<State> move] handler) {
      this.route("DELETE", pattern, handler)
    }

    // Dispatches one request as `Router.call` does, passing the state to the handler.
    [mut effects(heap_alloc)]
    call([Request] request, [Reference<Response>] response) {
      [bool mut] pathMatched{false}
      [i32 mut] index{0i32}
      while(index < this.routes.count()) {
        [StringView] pattern{this.routes[index].pattern.view()}
        [StringView] method{this.routes[index].method.view()}
        if(pattern_matches(pattern, request.path)) {
          if(request.method.equals(method)) {
            [Request mut] routed{request}
            routed.route = pattern
            this.routes[index].handler(location(this.state), routed, response)
            return()
          }
          pathMatched = true
        }
        index = index + 1i32
      }
      response.status = if(pathMatched, then() { 405i32 }, else() { 404i32 })
    }
  }

}
}
