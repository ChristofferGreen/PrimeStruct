// An HTTP/1.1 server loop over /std/net (docs/spec/stdlib-reference.md, /std/http/server). Build an app with both
// shims:
//   primec --emit=optexe app.prime -o app --link-arg <stdlib>/std/net/native/net_shim.cpp \
//     --link-arg <stdlib>/std/os/os_posix.cpp
// `serve`: one thread waits on the listener and up to `maxConnections` open connections at once and serves whichever
// is ready: accept, read what has arrived until the request is complete or rejected, call the handler, write the
// response, close. A silent or slow client holds only its own slot, for at most `readTimeoutMs`; only writing a
// response blocks the loop, for at most `writeTimeoutMs`.
// `serveWorkers`: the same loop only accepts and watches; worker tasks read, call the handler one at a time inside a
// `Mutex` and write, so a slow write holds one worker and not the loop.
import /std/collections/*
import /std/http/*
import /std/net/*
import /std/os/*
import /std/sync/*
import /std/text/*
import /std/text/view/*

namespace std {
namespace http {
namespace server {

  // How a server listens and how long it waits.
  [public struct]
  ServerConfig() {
    // The TCP port; 0 picks a free one (see `announce`).
    [public i32] port{8080i32}
    // How many connections may wait to be accepted.
    [public i32] backlog{64i32}
    // The largest request, head and body together; a larger one is answered 413.
    [public i32] maxRequestBytes{65536i32}
    // How often the loop wakes up to check whether it should stop.
    [public i32] acceptTimeoutMs{500i32}
    // How long a client has to send its whole request.
    [public i32] readTimeoutMs{5000i32}
    // How long writing a response may take.
    [public i32] writeTimeoutMs{5000i32}
    // Listen on 127.0.0.1 only (tests, local tools) instead of every interface.
    [public bool] loopbackOnly{false}
    // Print "listening on <port>" to stderr once listening.
    [public bool] announce{true}
    // How many connections are read at once. While all are open, new connections wait in the listen backlog.
    [public i32] maxConnections{16i32}
    // How many worker tasks `serveWorkers` starts; 0 starts one per processor. `serve` ignores it.
    [public i32] workers{0i32}
  }

  // Why `serve` could not start: a /std/net code from listening.
  [public struct]
  ServeError() {
    [public i32] code{0i32}
  }

  namespace ServeError {
    [public return<string>]
    why([ServeError] err) {
      if(err.code == -101i32 || err.code == -113i32) {
        return("cannot listen: sockets are not permitted here"utf8)
      }
      // EADDRINUSE is 48 on macOS and 98 on Linux.
      if(err.code == -148i32 || err.code == -198i32) {
        return("cannot listen: the port is in use"utf8)
      }
      return("cannot listen"utf8)
    }
  }

  // Sends all of `text`, or as much as the timeout allows.
  [effects(net_io)]
  send_text([i32] connection, [String] text, [i32] timeoutMs) {
    send(connection, text.data, convert<u64>(text.count()), timeoutMs)
  }

  // The open connections of `serveUntil`. Slot i holds one socket (-1 when free), its state (0 free, 1 reading a
  // request, 2 draining after a rejected request), its deadline and a count (bytes read while reading, rounds of
  // input while draining). Its bytes are [i * maxRequestBytes, (i + 1) * maxRequestBytes) of the loop's `buffers`,
  // which grows to cover slot i the first time it is used.
  [struct]
  Connections() {
    [vector<i32> mut] sockets{vector<i32>()}
    [vector<i32> mut] states{vector<i32>()}
    [vector<i64> mut] deadlines{vector<i64>()}
    [vector<i32> mut] counts{vector<i32>()}
  }

  // How long a rejected connection is drained between rounds of input, and how many rounds it may take.
  [return<i64>]
  drain_wait_ms() {
    return(50i64)
  }

  [return<i32>]
  drain_rounds() {
    return(8i32)
  }

  // Whether a recv result means "nothing yet" rather than data, end of input or a failure.
  [return<bool>]
  not_ready([i64] got) {
    return(got == convert<i64>(timeoutCode()) || got == convert<i64>(againCode()) || got == convert<i64>(interruptedCode()))
  }

  // Marks `socket` in `interest` (one byte per descriptor, grown with zeros as needed) to be watched by `poll`.
  [effects(heap_alloc)]
  watch_socket([vector<u8> mut] interest, [i32] socket) {
    while(interest.count() <= socket) {
      interest.push(0u8)
    }
    interest[socket] = 1u8
  }

  // Whether `socket` was ready in the last `poll` over `interest`; clears its byte so it is no longer watched.
  [return<bool>]
  take_ready([vector<u8> mut] interest, [i32] socket) {
    if(socket < 0i32 || socket >= interest.count()) {
      return(false)
    }
    [bool] ready{interest[socket] == 2u8}
    interest[socket] = 0u8
    return(ready)
  }

  // Waits on the sockets marked in `interest`; a timeout or a signal leaves nothing ready.
  [effects(net_io)]
  wait_ready([vector<u8> mut] interest, [i64] timeoutMs) {
    [i32] length{interest.count()}
    [mut] window{interest.sliceMut(0i32, length)}
    poll(window.data, convert<u64>(length), convert<i32>(timeoutMs))
  }

  // Closes the socket in `slot` and frees the slot.
  [effects(net_io)]
  close_slot([Connections mut] table, [i32] slot) {
    close(table.sockets[slot])
    table.sockets[slot] = -1i32
    table.states[slot] = 0i32
  }

  // Puts a new connection in the first free slot (the caller checked that one is free).
  [effects(heap_alloc)]
  open_slot([Connections mut] table, [vector<u8> mut] buffers, [i32] connection, [ServerConfig] config) {
    [i32 mut] slot{0i32}
    while(table.states[slot] != 0i32) {
      slot = slot + 1i32
    }
    [i32] end{(slot + 1i32) * config.maxRequestBytes}
    while(buffers.count() < end) {
      buffers.push(0u8)
    }
    table.sockets[slot] = connection
    table.states[slot] = 1i32
    table.counts[slot] = 0i32
    table.deadlines[slot] = monotonicMs() + convert<i64>(config.readTimeoutMs)
  }

  // Answers a rejected request with a bare status. Closing with unread input would reset the connection and could
  // discard the answer, so the slot drains what is still arriving for a moment first.
  [effects(net_io, heap_alloc)]
  reject_slot([Connections mut] table, [i32] slot, [i32] status, [ServerConfig] config) {
    [String] bytes{statusResponse(status)}
    send_text(table.sockets[slot], bytes, config.writeTimeoutMs)
    table.states[slot] = 2i32
    table.counts[slot] = 0i32
    table.deadlines[slot] = monotonicMs() + drain_wait_ms()
  }

  // Reads what has arrived on a ready reading slot. A complete request is handed to the handler, answered and
  // closed; a rejected one, or one that does not fit in `maxRequestBytes` (413), is answered and drained; a closed or
  // failed connection is dropped without an answer.
  [effects(net_io, heap_alloc)]
  read_slot<Handler>([Handler mut] handler,
                     [Connections mut] table,
                     [vector<u8> mut] buffers,
                     [i32] slot,
                     [ServerConfig] config,
                     [Response mut] response) {
    [i32] capacity{config.maxRequestBytes}
    [i32] base{slot * capacity}
    [i32] connection{table.sockets[slot]}
    [i32] received{table.counts[slot]}
    [mut] window{buffers.sliceMut(base + received, base + capacity)}
    [i64] got{recv(connection, window.data, convert<u64>(capacity - received), 0i32)}
    if(not_ready(got)) {
      return()
    }
    if(got <= 0i64) {
      close_slot(table, slot)
      return()
    }
    [i32] total{received + convert<i32>(got)}
    table.counts[slot] = total
    [Request] request{parseRequestBytes(buffers.slice(base, base + total), capacity)}
    [i32] outcome{request.outcome()}
    if(outcome == 0i32) {
      response.clear()
      handler(request, location(response))
      [String] bytes{response.serialize()}
      send_text(connection, bytes, config.writeTimeoutMs)
      close_slot(table, slot)
      return()
    }
    if(outcome >= 400i32) {
      reject_slot(table, slot, outcome, config)
      return()
    }
    if(total >= capacity) {
      reject_slot(table, slot, 413i32, config)
    }
  }

  // Discards what has arrived on a ready draining slot; closes it at end of input or after `drain_rounds()` rounds.
  [effects(net_io)]
  drain_slot([Connections mut] table, [vector<u8> mut] buffers, [i32] slot, [ServerConfig] config) {
    [i32] capacity{config.maxRequestBytes}
    [i32] base{slot * capacity}
    [mut] window{buffers.sliceMut(base, base + capacity)}
    [i64] got{recv(table.sockets[slot], window.data, convert<u64>(capacity), 0i32)}
    if(not_ready(got)) {
      return()
    }
    [i32] rounds{table.counts[slot] + 1i32}
    if(got <= 0i64 || rounds >= drain_rounds()) {
      close_slot(table, slot)
      return()
    }
    table.counts[slot] = rounds
    table.deadlines[slot] = monotonicMs() + drain_wait_ms()
  }

  // Serves requests with `handler`, any callable taking (Request, Reference<Response>), until `stop()` is true. The
  // stop condition is checked at least every `acceptTimeoutMs` and whenever a signal interrupts the wait. Returns an
  // error only when it cannot listen.
  [public effects(net_io, heap_alloc, io_err) return<Result<ServeError>>]
  serveUntil<Handler, Stop>([Handler mut] handler, [ServerConfig] config, [Stop mut] stop) {
    [i32] listener{if(config.loopbackOnly, then() { listenLoopback(config.port, config.backlog) }, else() { listen(config.port, config.backlog) })}
    if(listener < 0i32) {
      return(listener)
    }
    if(config.announce) {
      [i32] port{localPort(listener)}
      print_error("listening on ")
      print_line_error(port)
    }
    [i32] slots{if(config.maxConnections > 0i32, then() { config.maxConnections }, else() { 1i32 })}
    [Connections mut] table{Connections{}}
    [i32 mut] slot{0i32}
    while(slot < slots) {
      table.sockets.push(-1i32)
      table.states.push(0i32)
      table.deadlines.push(0i64)
      table.counts.push(0i32)
      slot = slot + 1i32
    }
    [vector<u8> mut] buffers{vector<u8>()}
    [vector<u8> mut] interest{vector<u8>()}
    [Response mut] response{Response{}}
    while(!stop()) {
      // Wait on every open connection, and on the listener while a slot is free, until the first deadline.
      [i64] now{monotonicMs()}
      [i64 mut] wait{convert<i64>(config.acceptTimeoutMs)}
      [i32 mut] open{0i32}
      slot = 0i32
      while(slot < slots) {
        if(table.states[slot] != 0i32) {
          watch_socket(interest, table.sockets[slot])
          open = open + 1i32
          [i64] remaining{table.deadlines[slot] - now}
          [i64] left{if(remaining > 0i64, then() { remaining }, else() { 0i64 })}
          if(wait < 0i64 || left < wait) {
            wait = left
          }
        }
        slot = slot + 1i32
      }
      [bool] room{open < slots}
      if(room) {
        watch_socket(interest, listener)
      }
      // After a timeout or a signal nothing is ready; the loop then checks deadlines and `stop()`.
      wait_ready(interest, wait)
      [i64] after{monotonicMs()}
      slot = 0i32
      while(slot < slots) {
        if(table.states[slot] != 0i32) {
          if(take_ready(interest, table.sockets[slot])) {
            if(table.states[slot] == 1i32) {
              read_slot(handler, table, buffers, slot, config, response)
            } else {
              drain_slot(table, buffers, slot, config)
            }
          }
          // A reading slot gets `readTimeoutMs` for its whole request; a draining slot waits briefly for more input.
          if(table.states[slot] != 0i32 && after >= table.deadlines[slot]) {
            close_slot(table, slot)
          }
        }
        slot = slot + 1i32
      }
      if(room && take_ready(interest, listener)) {
        [i32] connection{accept(listener, 0i32)}
        if(connection >= 0i32) {
          open_slot(table, buffers, connection, config)
        }
      }
    }
    slot = 0i32
    while(slot < slots) {
      if(table.states[slot] != 0i32) {
        close_slot(table, slot)
      }
      slot = slot + 1i32
    }
    close(listener)
    return(Result.ok())
  }

  // Serves requests with `handler` until the process receives SIGTERM or SIGINT (/std/os stopRequested()).
  [public effects(net_io, heap_alloc, io_err) return<Result<ServeError>>]
  serve<Handler>([Handler mut] handler, [ServerConfig] config) {
    [mut] untilSignal{[]() { return(stopRequested()) }}
    return(serveUntil(handler, config, untilSignal))
  }


  // ---- serveWorkers: one thread polls and accepts, worker tasks answer ----

  // Where the request bytes of the slots are: slot i owns [i * capacity, (i + 1) * capacity) of `base`. The poller
  // and the workers share the block, and a slot's bytes belong to whichever of them holds the slot, which is what
  // makes the pointer safe to send.
  [struct sendable]
  SlotBuffers() {
    [Pointer<u8>] base
    [i32] capacity{0i32}
  }

  // A readable connection on its way to a worker: its slot, its socket and how many bytes it has sent so far.
  [public struct]
  SlotJob() {
    [i32] slot{0i32}
    [i32] socket{-1i32}
    [i32] received{0i32}
  }

  // A slot on its way back to the poller. `state` is 0 when the worker closed the connection (answered, or the
  // client went away), 1 when the request is still incomplete and the connection is to be watched again, and 2 when
  // the request was rejected and the connection is to be drained.
  [public struct]
  SlotDone() {
    [i32] slot{0i32}
    [i32] socket{-1i32}
    [i32] received{0i32}
    [i32] state{0i32}
  }

  // The most workers `serveWorkers` starts.
  [return<i32>]
  max_workers() {
    return(64i32)
  }

  // The block that holds every slot's request bytes.
  [effects(heap_alloc) return<String>]
  slot_store([i32] bytes) {
    [String mut] store{String{}}
    store.reserve(bytes)
    return(store)
  }

  [return<SlotBuffers>]
  slot_buffers([Reference<String>] store, [i32] capacity) {
    return(SlotBuffers{[base] store.data, [capacity] capacity})
  }

  [unsafe return<Pointer<u8>>]
  slot_bytes([SlotBuffers] buffers, [i32] slot, [i32] offset) {
    [Pointer<u8>] base{buffers.base}
    return(/std/intrinsics/memory/at_unsafe(base, slot * buffers.capacity + offset))
  }

  // A worker's turn with a readable connection: reads what has arrived and, once the request is complete, calls the
  // handler inside the app's mutex and answers. Only the handler call holds the mutex; reading, parsing, serializing
  // and sending run beside the other workers.
  [effects(net_io, heap_alloc, lock, atomic) return<SlotDone>]
  work_slot([Mutex<Function<void, Request, Reference<Response>>>] app,
            [SlotJob] job,
            [Atomic<i32>] stopping,
            [SlotBuffers] buffers,
            [ServerConfig] config,
            [String mut] own,
            [Response mut] response) {
    [i32] capacity{buffers.capacity}
    [i32] connection{job.socket}
    if(stopping.load() != 0i32) {
      close(connection)
      return(SlotDone{[slot] job.slot, [socket] connection, [received] 0i32, [state] 0i32})
    }
    [i64] got{recv(connection, slot_bytes(buffers, job.slot, job.received), convert<u64>(capacity - job.received), 0i32)}
    if(not_ready(got)) {
      return(SlotDone{[slot] job.slot, [socket] connection, [received] job.received, [state] 1i32})
    }
    if(got <= 0i64) {
      close(connection)
      return(SlotDone{[slot] job.slot, [socket] connection, [received] 0i32, [state] 0i32})
    }
    [i32] total{job.received + convert<i32>(got)}
    // Parsed from a copy in this worker's own block: a byte of a block another thread allocated (the slots are the
    // poller's) is checked against the other arena's tables, about 1.17 times the instructions of a byte of the
    // worker's own block since TODO-5872 (twice the cost of `serve` before). Dropping the copy was not measured on
    // an idle machine, so it stays.
    own.clear()
    own.appendBytes(slot_bytes(buffers, job.slot, 0i32), total)
    [Request] request{parseRequestBytes(readSliceMake<u8>(own.data, total), capacity)}
    [i32] outcome{request.outcome()}
    if(outcome == 0i32) {
      response.clear()
      [mut] answer{[ref request, ref response]([Reference<Function<void, Request, Reference<Response>>>] handler) {
        handler(request, location(response))
      }}
      app.locked(answer)
      [String] bytes{response.serialize()}
      send_text(connection, bytes, config.writeTimeoutMs)
      close(connection)
      return(SlotDone{[slot] job.slot, [socket] connection, [received] 0i32, [state] 0i32})
    }
    [i32] status{if(outcome >= 400i32, then() { outcome }, else() { if(total >= capacity, then() { 413i32 }, else() { 0i32 }) })}
    if(status != 0i32) {
      [String] bytes{statusResponse(status)}
      send_text(connection, bytes, config.writeTimeoutMs)
      return(SlotDone{[slot] job.slot, [socket] connection, [received] 0i32, [state] 2i32})
    }
    return(SlotDone{[slot] job.slot, [socket] connection, [received] total, [state] 1i32})
  }

  // Hands a finished slot back to the poller. A slot whose connection is closed needs no wake: the poller takes it
  // back on its next round, and only waits for one when every slot is taken (`full`). A connection that is to be
  // watched again wakes it.
  [effects(net_io, channel, atomic)]
  return_slot([Channel<SlotDone>] finished, [Atomic<i32>] ready, [Atomic<i32>] full, [i32] wakeWriter, [SlotDone] done) {
    [bool] watched{done.state != 0i32}
    finished.send(done)
    ready.add(1i32)
    if(watched || full.load() != 0i32) {
      wake(wakeWriter)
    }
  }

  // One worker task: takes readable connections from `jobs` until the channel is closed and empty. It keeps one
  // `Response` and one block of `maxRequestBytes` for the request it is parsing, as `serve` keeps one of each.
  [effects(net_io, heap_alloc, lock, channel, atomic) return<void>]
  work_slots([Mutex<Function<void, Request, Reference<Response>>>] app,
             [Channel<SlotJob>] jobs,
             [Channel<SlotDone>] finished,
             [Atomic<i32>] ready,
             [Atomic<i32>] full,
             [Atomic<i32>] stopping,
             [SlotBuffers] buffers,
             [i32] wakeWriter,
             [ServerConfig] config) {
    // A stop signal does not interrupt this worker's reads and writes; the poller sees it through `stopSignalFd`.
    blockStopSignals()
    [String mut] own{String{}}
    own.reserve(buffers.capacity)
    [Response mut] response{Response{}}
    [bool mut] open{true}
    while(open) {
      pick(jobs.receive()) {
        none {
          open = false
        }
        some(job) {
          return_slot(finished, ready, full, wakeWriter, work_slot(app, job, stopping, buffers, config, own, response))
        }
      }
    }
  }

  // Takes back one slot a worker has finished with.
  [effects(net_io)]
  take_slot([Connections mut] table, [SlotDone] done) {
    [i32] slot{done.slot}
    if(done.state == 0i32) {
      table.sockets[slot] = -1i32
      table.states[slot] = 0i32
      return()
    }
    table.states[slot] = done.state
    table.counts[slot] = done.received
    if(done.state == 2i32) {
      table.deadlines[slot] = monotonicMs() + drain_wait_ms()
    }
  }

  // Takes back every slot the workers have finished with so far. `ready` counts what is in `finished`, so no
  // `receive` waits.
  [effects(net_io, channel, atomic)]
  take_slots([Connections mut] table, [Channel<SlotDone>] finished, [Atomic<i32>] ready) {
    [i32 mut] left{ready.exchange(0i32)}
    while(left > 0i32) {
      pick(finished.receive()) {
        none {
        }
        some(done) {
          take_slot(table, done)
        }
      }
      left = left - 1i32
    }
  }

  // Discards what has arrived on a ready draining slot, as `drain_slot` does, into the slot's own bytes.
  [effects(net_io)]
  drain_shared_slot([Connections mut] table, [SlotBuffers] buffers, [i32] slot) {
    [i64] got{recv(table.sockets[slot], slot_bytes(buffers, slot, 0i32), convert<u64>(buffers.capacity), 0i32)}
    if(not_ready(got)) {
      return()
    }
    [i32] rounds{table.counts[slot] + 1i32}
    if(got <= 0i64 || rounds >= drain_rounds()) {
      close_slot(table, slot)
      return()
    }
    table.counts[slot] = rounds
    table.deadlines[slot] = monotonicMs() + drain_wait_ms()
  }

  // The poller of `serveWorkersUntil`: accepts, watches the open connections and the wake pipe, hands each new and
  // each readable connection to the workers (slot state 3: a worker has it, so it is neither watched nor timed out here) and takes
  // back the slots they return. It never waits for a worker: both channels hold one entry per slot. When `stop()`
  // is true it stops listening, closes the connections no worker holds and closes `jobs`, which ends the workers
  // once each has finished the request it is answering.
  [effects(net_io, heap_alloc, channel, atomic)]
  poll_slots<Stop>([Channel<SlotJob>] jobs,
                   [Channel<SlotDone>] finished,
                   [Atomic<i32>] ready,
                   [Atomic<i32>] full,
                   [Atomic<i32>] stopping,
                   [SlotBuffers] buffers,
                   [ServerConfig] config,
                   [i32] listener,
                   [i32] wakeReader,
                   [i32] slots,
                   [Stop mut] stop) {
    [Connections mut] table{Connections{}}
    [i32 mut] slot{0i32}
    while(slot < slots) {
      table.sockets.push(-1i32)
      table.states.push(0i32)
      table.deadlines.push(0i64)
      table.counts.push(0i32)
      slot = slot + 1i32
    }
    [vector<u8> mut] interest{vector<u8>()}
    // Readable once SIGTERM or SIGINT has arrived, on whichever thread and however early.
    [i32] stopSignal{stopSignalFd()}
    while(!stop()) {
      [i64] now{monotonicMs()}
      [i64 mut] wait{convert<i64>(config.acceptTimeoutMs)}
      [i32 mut] open{0i32}
      slot = 0i32
      while(slot < slots) {
        [i32] state{table.states[slot]}
        if(state != 0i32) {
          open = open + 1i32
        }
        if(state == 1i32 || state == 2i32) {
          watch_socket(interest, table.sockets[slot])
          [i64] remaining{table.deadlines[slot] - now}
          [i64] left{if(remaining > 0i64, then() { remaining }, else() { 0i64 })}
          if(wait < 0i64 || left < wait) {
            wait = left
          }
        }
        slot = slot + 1i32
      }
      [bool] room{open < slots}
      if(room) {
        watch_socket(interest, listener)
      }
      watch_socket(interest, wakeReader)
      // Watched only until the signal has been seen, so a `stop` that ignores the signal does not spin. A signal
      // that arrives after this check makes the descriptor readable, so the wait below returns at once.
      [bool] watchStop{stopSignal >= 0i32 && !stopRequested()}
      if(watchStop) {
        watch_socket(interest, stopSignal)
      }
      // With every slot taken nothing arrives on the listener, so a worker that closes a connection has to wake this
      // wait. `full` asks for that; a slot handed back before a worker could see it is in `ready` already.
      if(!room) {
        full.store(1i32)
        if(ready.load() > 0i32) {
          wait = 0i64
        }
      }
      wait_ready(interest, wait)
      if(!room) {
        full.store(0i32)
      }
      [i64] after{monotonicMs()}
      if(watchStop) {
        take_ready(interest, stopSignal)
      }
      if(take_ready(interest, wakeReader)) {
        takeWakes(wakeReader)
      }
      slot = 0i32
      while(slot < slots) {
        [i32] state{table.states[slot]}
        if(state == 1i32 || state == 2i32) {
          [bool] readable{take_ready(interest, table.sockets[slot])}
          if(readable && state == 1i32) {
            table.states[slot] = 3i32
            jobs.send(SlotJob{[slot] slot, [socket] table.sockets[slot], [received] table.counts[slot]})
          } else {
            if(readable) {
              drain_shared_slot(table, buffers, slot)
            }
            // A reading slot gets `readTimeoutMs` for its whole request; a draining slot waits briefly for more.
            if(table.states[slot] != 0i32 && after >= table.deadlines[slot]) {
              close_slot(table, slot)
            }
          }
        }
        slot = slot + 1i32
      }
      // After the pass over the slots, so a slot that comes back is watched before it can time out.
      take_slots(table, finished, ready)
      if(room && take_ready(interest, listener)) {
        [i32] connection{accept(listener, 0i32)}
        if(connection >= 0i32) {
          [i32 mut] free{0i32}
          while(table.states[free] != 0i32) {
            free = free + 1i32
          }
          // Straight to a worker: the request of a new connection has usually arrived with it. When it has not,
          // the worker hands the slot back to be watched until `readTimeoutMs` from now.
          table.sockets[free] = connection
          table.states[free] = 3i32
          table.counts[free] = 0i32
          table.deadlines[free] = monotonicMs() + convert<i64>(config.readTimeoutMs)
          jobs.send(SlotJob{[slot] free, [socket] connection, [received] 0i32})
        }
      }
    }
    close(listener)
    stopping.store(1i32)
    jobs.close()
    slot = 0i32
    while(slot < slots) {
      if(table.states[slot] == 1i32 || table.states[slot] == 2i32) {
        close_slot(table, slot)
      }
      slot = slot + 1i32
    }
  }

  // Starts `remaining` more workers and then runs the poller on this task; each level waits for the worker it
  // started, so every worker has ended when the first call returns.
  [effects(net_io, heap_alloc, task, lock, channel, atomic)]
  run_workers<Stop>([Mutex<Function<void, Request, Reference<Response>>>] app,
                    [Channel<SlotJob>] jobs,
                    [Channel<SlotDone>] finished,
                    [Atomic<i32>] ready,
                    [Atomic<i32>] full,
                    [Atomic<i32>] stopping,
                    [SlotBuffers] buffers,
                    [ServerConfig] config,
                    [i32] listener,
                    [WakePipe] pipe,
                    [i32] slots,
                    [i32] remaining,
                    [Stop mut] stop) {
    if(remaining <= 0i32) {
      poll_slots<Stop>(jobs, finished, ready, full, stopping, buffers, config, listener, pipe.reader, slots, stop)
      return()
    }
    [Task<void>] worker{[spawn] work_slots(app, jobs, finished, ready, full, stopping, buffers, pipe.writer, config)}
    run_workers<Stop>(app, jobs, finished, ready, full, stopping, buffers, config, listener, pipe, slots, remaining - 1i32, stop)
    wait(worker)
  }

  // Closes the connection of a slot that a worker handed back after the poller had stopped.
  [effects(net_io)]
  close_returned([SlotDone] done) {
    if(done.state != 0i32) {
      close(done.socket)
    }
  }

  // `serveUntil` with worker tasks (threads on optexe): this task polls and accepts, and `config.workers` workers
  // read, parse, call the handler and answer. The handler moves into a `Mutex` and every request calls it inside
  // `locked`, one at a time, so a `Router`, `AppRouter<State>` or `WebApp<State>` keeps plain state; receiving,
  // parsing, serializing and sending run in parallel. The handler must be sendable. When `stop()` is true the
  // server stops listening and closes the connections that wait for input at once, and returns when each worker
  // has finished the request it is answering.
  [public effects(net_io, heap_alloc, io_err, task, lock, channel, atomic) return<Result<ServeError>>]
  serveWorkersUntil<Handler, Stop>([Handler move] handler, [ServerConfig] config, [Stop mut] stop) {
    [i32] listener{if(config.loopbackOnly, then() { listenLoopback(config.port, config.backlog) }, else() { listen(config.port, config.backlog) })}
    if(listener < 0i32) {
      return(listener)
    }
    [WakePipe] pipe{wakePipe()}
    if(pipe.reader < 0i32) {
      close(listener)
      return(pipe.reader)
    }
    if(config.announce) {
      [i32] port{localPort(listener)}
      print_error("listening on ")
      print_line_error(port)
    }
    [i32] capacity{if(config.maxRequestBytes > 0i32, then() { config.maxRequestBytes }, else() { 1i32 })}
    // The slots' bytes are one block of at most 1 GiB, so many slots of large requests are cut to what fits.
    [i32] fitting{1073741824i32 / capacity}
    [i32] wanted{if(config.maxConnections > 0i32, then() { config.maxConnections }, else() { 1i32 })}
    [i32] slots{if(wanted < fitting, then() { wanted }, else() { fitting })}
    [i32] asked{if(config.workers > 0i32, then() { config.workers }, else() { cpuCount() })}
    [i32] workers{if(asked < max_workers(), then() { asked }, else() { max_workers() })}
    [String mut] store{slot_store(slots * capacity)}
    [SlotBuffers] buffers{slot_buffers(store, capacity)}
    // Workers are not generic: the handler is called as a `Function`, which also requires it to be sendable.
    [Function<void, Request, Reference<Response>> mut] erased{[mut inner{handler}]([Request] request, [Reference<Response>] response) {
      inner(request, response)
    }}
    app{Mutex<Function<void, Request, Reference<Response>>>{move(erased)}}
    jobs{Channel<SlotJob>{[capacity] slots}}
    finished{Channel<SlotDone>{[capacity] slots}}
    ready{Atomic<i32>{0i32}}
    full{Atomic<i32>{0i32}}
    stopping{Atomic<i32>{0i32}}
    run_workers<Stop>(app, jobs, finished, ready, full, stopping, buffers, config, listener, pipe, slots, workers, stop)
    // Every worker has ended. What they handed back since the poller stopped is still open.
    [i32 mut] left{ready.exchange(0i32)}
    while(left > 0i32) {
      pick(finished.receive()) {
        none {
        }
        some(done) {
          close_returned(done)
        }
      }
      left = left - 1i32
    }
    close(pipe.reader)
    close(pipe.writer)
    return(Result.ok())
  }

  // `serveWorkersUntil` until the process receives SIGTERM or SIGINT (/std/os stopRequested()).
  [public effects(net_io, heap_alloc, io_err, task, lock, channel, atomic) return<Result<ServeError>>]
  serveWorkers<Handler>([Handler move] handler, [ServerConfig] config) {
    [mut] untilSignal{[]() { return(stopRequested()) }}
    return(serveWorkersUntil(handler, config, untilSignal))
  }


  // Middleware: a handler that calls `next` and then logs "METHOD target STATUS Nms" for the request through /std/os
  // logLine. It is generic, so `next` is called directly; wrap a Router or any other handler.
  [public effects(heap_alloc)]
  withRequestLog<Next>([Next move] next) {
    return([mut inner{next}]([Request] request, [Reference<Response>] response) {
      [i64] start{monotonicMs()}
      inner(request, response)
      [i64] elapsed{monotonicMs() - start}
      [String mut] line{String{}}
      line.appendBytes(request.method.data, request.method.count())
      line.append(" ")
      line.appendBytes(request.target.data, request.target.count())
      line.append(" ")
      line.appendI64(convert<i64>(response.status))
      line.append(" ")
      line.appendI64(elapsed)
      line.append("ms")
      logLine(line)
    })
  }

}
}
}
